<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
    <RazorCompileOnPublish>true</RazorCompileOnPublish>
    <UserSecretsId>InovaGed-Web-Local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Só deixa o RuntimeCompilation, que realmente é um pacote separado -->
    <PackageReference Include="BCrypt.Net-Core" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="QRCoder" />
    <!-- Direct reference on the executable guarantees this runtime asset is published. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InovaGed.Application\InovaGed.Application.csproj" />
    <ProjectReference Include="..\InovaGed.Domain\InovaGed.Domain.csproj" />
    <ProjectReference Include="..\InovaGed.Infrastructure\InovaGed.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\Classification\" />
    <Folder Include="Models\Pacs\" />
  </ItemGroup>

</Project>
