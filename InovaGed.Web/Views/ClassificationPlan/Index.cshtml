@model InovaGed.Application.Classification.ClassificationPlanDashboard
@{ViewData["Title"]="Plano de Classificação e Temporalidade";ViewData["WorkspaceVariant"]="wide";}
@section Styles{<link rel="stylesheet" href="~/css/classification-plan.css" asp-append-version="true"/>}
<div class="classification-page"><section class="classification-hero atlas-page-hero"><div><span>Arquivística · Instrumentos 2.0</span><h1>Plano de Classificação e Temporalidade</h1><p>Organize classes documentais, regras de guarda, fases, eventos e destinação final dos documentos.</p></div><nav class="classification-hero-actions" aria-label="Ações do plano"><a class="btn btn-light" asp-action="Create">Nova classe</a><a class="btn btn-outline-light" asp-action="Import">Importar plano</a><a class="btn btn-outline-light" asp-action="ReviewQueue">Fila de revisão</a></nav></section>
<div class="classification-kpis"><article><b>@Model.Classes</b><span>Classes ativas</span></article><article><b>@Model.ClassesWithoutRule</b><span>Classes sem prazo</span></article><article><b>@Model.RulesInReview</b><span>Pendências de revisão</span></article><article><b>v@Model.PublishedVersion</b><span>Versões do plano</span></article><article><b>@Model.PendingChanges</b><span>Itens importados</span></article><article><b>@Model.PermanentDestinations</b><span>Regras de temporalidade</span></article></div>
<section class="classification-guidance"><div><strong>Comece pela árvore</strong><span>Localize uma classe ou consulte os atalhos para temporalidade, versões e revisão.</span></div><form method="get" asp-action="Tree"><label class="visually-hidden" for="classification-search">Buscar classe</label><input id="classification-search" name="q" type="search" placeholder="Código ou título da classe" /><button type="submit" class="btn btn-primary">Buscar</button></form></section><section class="classification-action-section"><header><span>Atalhos de gestão</span><h2>Operações do plano</h2><p>Acesse a árvore, regras, versões e relatórios sem perder o contexto.</p></header><div class="classification-actions"><a asp-action="Tree"><app-icon name="folder"/> <b>Árvore de classificação</b><span>Organize funções e atividades.</span></a><a asp-action="RetentionRules"><app-icon name="clock"/><b>Tabela de temporalidade</b><span>Defina fases, eventos e destino.</span></a><a asp-action="ReviewQueue"><app-icon name="clipboard-check"/><b>Revisão arquivística</b><span>Trate pendências sem publicar.</span></a><a asp-action="Import"><app-icon name="upload"/><b>Importação assistida</b><span>Valide CSV antes de confirmar.</span></a><a asp-action="Versions"><app-icon name="history"/><b>Versões publicadas</b><span>Snapshots imutáveis do plano.</span></a><a asp-action="Compare"><app-icon name="git-branch"/><b>Comparar versões</b><span>Veja inclusões, remoções e alterações.</span></a><a asp-action="PrintCurrent"><app-icon name="report"/><b>Relatórios</b><span>Consulte e imprima o plano vigente.</span></a></div></section>@if (Model.Classes == 0) { <section class="classification-empty" role="status"><app-icon name="folder" size="32" decorative="true" /><h2>O plano ainda não possui classes</h2><p>Crie a primeira classe ou importe um plano validado para começar.</p><a class="btn btn-primary" asp-action="Create">Criar primeira classe</a></section> }</div>
