@model InovaGed.Application.Classification.ClassificationPlanDashboard
@{ViewData["Title"]="Plano de Classificação e Temporalidade";ViewData["WorkspaceVariant"]="wide";}
@section Styles{<link rel="stylesheet" href="~/css/classification-plan.css" asp-append-version="true"/>}
<div class="classification-page"><section class="classification-hero"><div><span>Arquivística · Instrumentos 2.0</span><h1>Plano de Classificação e Temporalidade</h1><p>Gerencie classes documentais, regras de guarda, eventos condicionantes, destinação final e versões dos instrumentos arquivísticos.</p></div><a class="btn btn-light" asp-action="Create">Nova classe</a></section>
<div class="classification-kpis"><article><b>@Model.Classes</b><span>Classes cadastradas</span></article><article><b>@Model.ClassesWithoutRule</b><span>Classes sem regra</span></article><article><b>@Model.RulesInReview</b><span>Regras aguardando revisão</span></article><article><b>v@Model.PublishedVersion</b><span>Versão publicada</span></article><article><b>@Model.PendingChanges</b><span>Alterações pendentes</span></article><article><b>@Model.PermanentDestinations</b><span>Destinações permanentes</span></article></div>
<div class="classification-actions"><a asp-action="Tree"><app-icon name="folder"/> <b>Árvore de classificação</b><span>Organize funções e atividades.</span></a><a asp-action="RetentionRules"><app-icon name="clock"/><b>Tabela de temporalidade</b><span>Defina fases, eventos e destino.</span></a><a asp-action="ReviewQueue"><app-icon name="clipboard-check"/><b>Revisão arquivística</b><span>Trate pendências sem publicar.</span></a><a asp-action="Import"><app-icon name="upload"/><b>Importação assistida</b><span>Valide CSV antes de confirmar.</span></a><a asp-action="Versions"><app-icon name="history"/><b>Versões publicadas</b><span>Snapshots imutáveis do plano.</span></a><a asp-action="Compare"><app-icon name="git-branch"/><b>Comparar versões</b><span>Veja inclusões, remoções e alterações.</span></a></div></div>
