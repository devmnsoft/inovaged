@model IReadOnlyList<InovaGed.Web.Controllers.ClassificationPlanController.ImportPreviewRow>
@using InovaGed.Web.Models.Atlas
@{
    ViewData["Title"] = "Importação assistida";
    var header = new AtlasPageHeaderVm(
        "Importação assistida",
        "O plano vigente não é apagado. A pré-visualização mostra código, nome e classe pai antes de gravar.",
        "upload",
        "Plano de classificação",
        [new AtlasPageAction("Voltar ao plano", Url.Action("Index")!, "arrow-left")]);
}
@section Styles { <link rel="stylesheet" href="~/css/classification-plan.css" asp-append-version="true" /> }
<div class="classification-page">
    <partial name="Atlas/_PageHeader" model="header" />
    <form method="post" enctype="multipart/form-data" class="classification-form">
        @Html.AntiForgeryToken()
        <label>Arquivo CSV com as colunas code, title e parent_code
            <input type="file" name="file" accept=".csv,text/csv" required />
        </label>
        <button class="btn btn-primary" type="submit">Validar arquivo</button>
    </form>
    @if (Model.Any())
    {
        var ready = Model.All(row => row.Error is null);
        <section class="classification-import-preview">
            <h2>Pré-visualização</h2>
            <p>@(ready ? "Todas as linhas estão prontas. Selecione o arquivo outra vez para confirmar a gravação." : "Corrija as linhas com erro antes de confirmar.")</p>
            <div class="table-responsive">
                <table class="table table-hover align-middle atlas-table">
                    <thead>
                        <tr><th>Linha</th><th>Código</th><th>Nome da classe</th><th>Classe pai</th><th>Validação</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td>@row.Line</td>
                            <td>@row.Code</td>
                            <td>@row.Title</td>
                            <td>@(string.IsNullOrWhiteSpace(row.ParentCode) ? "—" : row.ParentCode)</td>
                            <td>@(row.Error ?? "Pronto")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (ready)
            {
                <form method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="file" name="file" accept=".csv,text/csv" required />
                    <input type="hidden" name="confirm" value="true" />
                    <button class="btn btn-primary" type="submit">Confirmar importação</button>
                </form>
            }
        </section>
    }
</div>
