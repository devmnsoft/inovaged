@model IReadOnlyList<InovaGed.Web.Controllers.ClassificationPlanController.ImportPreviewRow>
@{ViewData["Title"]="Importação assistida";}@section Styles{<link rel="stylesheet" href="~/css/classification-plan.css"/>}<div class="classification-page"><header class="classification-heading"><h1>Importação assistida</h1><p>O plano atual nunca será apagado. Valide a prévia antes de confirmar.</p></header><form method="post" enctype="multipart/form-data" class="classification-form"><label>Arquivo CSV<input type="file" name="file" accept=".csv,text/csv" required/></label><button class="btn btn-primary">Validar arquivo</button></form>@if(Model.Any()){<section class="classification-import-preview"><h2>Pré-visualização</h2><table class="table"><thead><tr><th>Linha</th><th>Código</th><th>Título</th><th>Classe pai</th><th>Validação</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Line</td><td>@r.Code</td><td>@r.Title</td><td>@r.ParentCode</td><td>@(r.Error??"Pronto")</td></tr>}</tbody></table>@if(Model.All(x=>x.Error is null)){<form method="post" enctype="multipart/form-data"><div class="alert alert-info">Para segurança, selecione novamente o arquivo e confirme.</div><input type="file" name="file" accept=".csv" required/><input type="hidden" name="confirm" value="true"/><button class="btn btn-success">Confirmar importação</button></form>}</section>}</div>
