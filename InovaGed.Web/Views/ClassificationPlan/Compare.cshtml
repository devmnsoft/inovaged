@model InovaGed.Application.Classification.ClassificationVersionCompareResult
@{ViewData["Title"]="Comparar versões";var versions=(IReadOnlyList<InovaGed.Application.Classification.ClassificationVersionItem>)ViewBag.Versions;}@section Styles{<link rel="stylesheet" href="~/css/classification-plan.css"/>}<div class="classification-page"><header class="classification-heading"><h1>Comparar versões</h1></header><form method="post" class="classification-compare-picker"><label>Versão origem<select name="fromVersionId" required><option value="">Selecione</option>@foreach(var v in versions){<option value="@v.Id">Versão @v.VersionNumber</option>}</select></label><label>Versão destino<select name="toVersionId" required><option value="">Selecione</option>@foreach(var v in versions){<option value="@v.Id">Versão @v.VersionNumber</option>}</select></label><button class="btn btn-primary">Comparar</button></form><div class="classification-compare-grid">@foreach(var d in Model.Differences){<article><span class="diff diff-@d.Kind.ToLowerInvariant()">@d.Kind</span><b>@d.Entity · @d.Code</b><p>@d.Description</p></article>}</div></div>
