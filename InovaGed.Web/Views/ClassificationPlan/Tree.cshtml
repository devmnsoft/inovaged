@model IReadOnlyList<InovaGed.Application.Classification.ClassificationTreeNode>
@{ViewData["Title"]="Árvore de classificação";ViewData["WorkspaceVariant"]="wide";}
@section Styles{<link rel="stylesheet" href="~/css/classification-plan.css"/>}
<div class="classification-page"><header class="classification-heading"><div><a asp-action="Index">Plano 2.0</a><h1>Árvore de classificação</h1></div><a class="btn btn-primary" asp-action="Create">Nova classe</a></header><div class="classification-tree-layout"><section class="classification-tree-panel"><input class="form-control mb-3" type="search" placeholder="Buscar por código ou título" data-tree-search/>
@if(!Model.Any()){<div class="classification-empty"><b>Nenhuma classe cadastrada.</b><p>Comece importando um plano existente ou criando a primeira classe documental.</p><a asp-action="Import">Importar plano</a></div>}else{@foreach(var n in Model){<article class="classification-node-card" data-search="@n.Code @n.Title"><div><strong>@n.Code · @n.Title</strong><small>@(n.ActivityType??"—") · @n.ReviewStatus</small></div><span class="status">@(n.HasRetentionRule?"Com regra":"Sem regra")</span><a asp-action="Tree" asp-route-selected="@n.Id">Detalhes</a></article>}}</section><aside class="classification-details-panel">@{var selected=Model.FirstOrDefault(x=>x.Id==(Guid?)ViewBag.Selected);}@if(selected is null){<h2>Detalhes da classe</h2><p>Selecione uma classe para consultar seus vínculos.</p>}else{<span class="status">@selected.ReviewStatus</span><h2>@selected.Code · @selected.Title</h2><p>Atividade @selected.ActivityType. @(selected.HasRetentionRule?"Regra de temporalidade vinculada.":"Ainda sem regra de temporalidade.")</p><div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@selected.Id">Editar classe</a><a class="btn btn-outline-primary" asp-action="Create" asp-route-parentId="@selected.Id">Criar subclasse</a><a class="btn btn-primary" asp-action="RetentionRule" asp-route-id="@selected.Id">Temporalidade</a></div>}</aside></div></div>
@section Scripts{<script>document.querySelector('[data-tree-search]')?.addEventListener('input',e=>document.querySelectorAll('[data-search]').forEach(x=>x.hidden=!x.dataset.search.toLowerCase().includes(e.target.value.toLowerCase())));</script>}
