@model IReadOnlyList<InovaGed.Application.ClassificationPlans.ClassificationVersionRow>
@{
    ViewData["Title"] = "Versões PCD/TTD";
}

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">Versões do PCD/TTD</h2>
        <div class="text-muted">Publicar versão cria snapshot e permite imprimir evidência.</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/ClassificationPlan">
            <app-icon name="arrow-left"></app-icon> Voltar
        </a>
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#publishModal">
            <app-icon name="upload"></app-icon> Publicar
        </button>
    </div>
</div>

<form id="publishForm" method="post" action="/ClassificationPlan/Publish">
    @Html.AntiForgeryToken()
</form>
<div class="modal fade" id="publishModal" tabindex="-1" aria-labelledby="publishTitle" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="publishTitle">Publicar nova versão</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><label class="form-label" for="versionTitle">Título</label><input class="form-control" id="versionTitle" maxlength="150" required /><label class="form-label mt-3" for="versionNotes">Notas da versão</label><textarea class="form-control" id="versionNotes" rows="4"></textarea><div id="publishError" class="text-danger mt-3" role="alert"></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" type="button" onclick="publishVersion()">Publicar snapshot</button></div></div></div></div>

<div class="card">
    <div class="card-body table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th style="width:100px">Versão</th>
                    <th>Título</th>
                    <th style="width:200px">Publicado em</th>
                    <th style="width:180px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td><span class="badge bg-secondary">V@v.VersionNo</span></td>
                        <td>@v.Title</td>
                        <td>@v.PublishedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" target="_blank"
                               href="/ClassificationPlan/PrintVersion?versionId=@v.Id">
                                <app-icon name="print"></app-icon> Imprimir
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        async function publishVersion(){
            const title = document.getElementById("versionTitle").value.trim();
            const notes = document.getElementById("versionNotes").value.trim();
            const error = document.getElementById("publishError");
            if(!title) { error.textContent = "Informe o título da versão."; return; }

            const form = document.getElementById("publishForm");
            const fd = new FormData(form);
            fd.append("title", title);
            fd.append("notes", notes);

            const r = await fetch(form.action, { method:"POST", body: fd });
            const j = await r.json().catch(()=>null);

            if(!r.ok || !j?.ok){
                error.textContent = j?.error || "Falha ao publicar.";
                return;
            }
            location.reload();
        }
    </script>
}
