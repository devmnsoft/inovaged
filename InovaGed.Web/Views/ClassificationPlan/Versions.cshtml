@model IReadOnlyList<InovaGed.Application.Classification.ClassificationVersionItem>
@{ViewData["Title"]="Versões dos Instrumentos";ViewData["WorkspaceVariant"]="wide";}
@section Styles { <link rel="stylesheet" href="~/css/classification-plan.css" asp-append-version="true" /> }
<div class="classification-page"><header class="classification-heading"><div><a asp-action="Index">Plano 2.0</a><h1>Versões dos instrumentos</h1></div><form method="post" asp-action="PublishVersion"><input name="notes" placeholder="Notas da publicação"/><button class="btn btn-primary">Publicar nova versão</button></form></header><div class="classification-version-grid">@foreach(var v in Model){<article class="classification-version-card"><span>@v.Status</span><h2>Versão @v.VersionNumber</h2><p>@v.Title</p><dl><dt>Publicado em</dt><dd>@(v.PublishedAt?.ToString("dd/MM/yyyy HH:mm")??"—")</dd><dt>Classes / regras</dt><dd>@v.ClassCount / @v.RuleCount</dd><dt>Notas</dt><dd>@(v.Notes??"Sem notas")</dd></dl></article>}</div></div>
