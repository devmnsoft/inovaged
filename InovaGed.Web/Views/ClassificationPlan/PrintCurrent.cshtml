@model IReadOnlyList<InovaGed.Application.ClassificationPlans.ClassificationNodeRow>
@{
    Layout = null;
    var children = Model.GroupBy(item => item.ParentId).ToDictionary(group => group.Key, group => group.OrderBy(item => item.Code).ToList());
    var rows = new List<(int Level, InovaGed.Application.ClassificationPlans.ClassificationNodeRow Node)>();
    void Walk(Guid? parentId, int level)
    {
        if (!children.TryGetValue(parentId, out var list)) return;
        foreach (var node in list)
        {
            rows.Add((level, node));
            Walk(node.Id, level + 1);
        }
    }
    Walk(null, 0);
    if (rows.Count == 0)
    {
        foreach (var node in Model.OrderBy(item => item.Code)) rows.Add((0, node));
    }
}
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <title>Pré-visualização do plano vigente</title>
    <link rel="stylesheet" href="/css/classification-plan.css" />
</head>
<body>
    <main class="plan-print">
        <header>
            <div>
                <p class="plan-print-kicker">Plano de classificação e temporalidade</p>
                <h1>Plano vigente</h1>
                <p>Gerado em @DateTime.Now.ToString("dd/MM/yyyy HH:mm"). O nome é o da classe. Esta folha não executa eliminação nem transferência.</p>
            </div>
            <div class="plan-print-toolbar">
                <button class="btn btn-primary" type="button" onclick="window.print()">Imprimir</button>
                <a class="btn btn-outline-secondary" href="/ClassificationPlan">Voltar</a>
            </div>
        </header>
        <table class="atlas-table">
            <thead>
                <tr><th>Código</th><th>Classe</th><th>Fase corrente</th><th>Fase intermediária</th><th>Destino</th></tr>
            </thead>
            <tbody>
            @if (rows.Count == 0)
            {
                <tr><td colspan="5">Nenhuma classe vigente para pré-visualizar.</td></tr>
            }
            @foreach (var row in rows)
            {
                <tr>
                    <td class="code">@row.Node.Code</td>
                    <td style="padding-left:@(1 + row.Level)rem">@row.Node.Name</td>
                    <td>@Term(row.Node.RetActiveYears, row.Node.RetActiveMonths, row.Node.RetActiveDays)</td>
                    <td>@Term(row.Node.RetArchiveYears, row.Node.RetArchiveMonths, row.Node.RetArchiveDays)</td>
                    <td>@row.Node.FinalDestination</td>
                </tr>
            }
            </tbody>
        </table>
    </main>
</body>
</html>
@functions {
    private static string Term(int years, int months, int days)
    {
        if (years == 0 && months == 0 && days == 0) return "Não informado";
        var parts = new List<string>();
        if (years > 0) parts.Add($"{years} ano(s)");
        if (months > 0) parts.Add($"{months} mês(es)");
        if (days > 0) parts.Add($"{days} dia(s)");
        return string.Join(", ", parts);
    }
}
