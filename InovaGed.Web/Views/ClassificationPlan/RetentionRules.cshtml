@model IReadOnlyList<InovaGed.Application.Classification.RetentionRuleListItem>
@{ViewData["Title"]="Tabela de Temporalidade";ViewData["WorkspaceVariant"]="wide";}@section Styles{<link rel="stylesheet" href="~/css/classification-plan.css"/>}<div class="classification-page"><header class="classification-heading"><div><a asp-action="Index">Plano 2.0</a><h1>Tabela de Temporalidade Documental</h1></div></header><div class="table-responsive classification-rule-table"><table class="table"><thead><tr><th>Código</th><th>Classe</th><th>Fase corrente</th><th>Intermediária</th><th>Destino final</th><th>Evento</th><th>Base legal</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td><b>@r.Code</b></td><td>@r.Title</td><td>@(r.CurrentPhaseYears?.ToString()??"—") anos</td><td>@(r.IntermediatePhaseYears?.ToString()??"—") anos</td><td><span class="destination destination-@r.FinalDestination.ToLowerInvariant()">@r.FinalDestination</span></td><td>@(r.TriggerEvent??"—")</td><td>@(r.LegalBasis??"Ausente")</td><td>@r.ReviewStatus</td><td><a asp-action="RetentionRule" asp-route-id="@r.ClassificationNodeId">Editar</a></td></tr>}</tbody></table></div><a class="btn btn-outline-primary" asp-action="Tree">Selecionar classe para criar regra</a></div>
