@model InovaGed.Web.Controllers.ClassificationPlanController.ReviewQueueVm
@{ViewData["Title"]="Revisão Arquivística";}
@section Styles { <link rel="stylesheet" href="~/css/classification-plan.css" asp-append-version="true" /> }
<div class="classification-page classification-review-queue"><header class="classification-heading"><div><a asp-action="Index">Plano 2.0</a><h1>Fila de revisão arquivística</h1><p>Aprovação controlada; nenhum item é publicado automaticamente.</p></div></header><div class="classification-compare-grid"><section><h2>Classes em rascunho <span>@Model.DraftClasses.Count</span></h2>@foreach(var n in Model.DraftClasses){<article><b>@n.Code · @n.Title</b><p>@(n.HasRetentionRule?"Regra vinculada":"Classe sem regra — criar tarefa CLASSIFICATION_REVIEW")</p><a asp-action="Edit" asp-route-id="@n.Id">Revisar</a></article>}</section><section><h2>Regras em rascunho <span>@Model.DraftRules.Count</span></h2>@foreach(var r in Model.DraftRules){<article><b>@r.Code · @r.Title</b><p>@(string.IsNullOrWhiteSpace(r.LegalBasis)?"Base legal ausente — LEGAL_BASIS_REVIEW":"Base legal informada")</p><a asp-action="RetentionRule" asp-route-id="@r.ClassificationNodeId">Revisar</a></article>}</section></div></div>
