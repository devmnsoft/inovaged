@model InovaGed.Web.Controllers.ClassificationPlanController.RuleForm
@{ViewData["Title"]="Regra de temporalidade";var nodes=(IReadOnlyList<InovaGed.Application.Classification.ClassificationTreeNode>)ViewBag.Nodes;}@section Styles{<link rel="stylesheet" href="~/css/classification-plan.css"/>}<div class="classification-page"><header class="classification-heading"><h1>Regra de temporalidade</h1></header><form method="post" asp-action="SaveRetentionRule" class="classification-form"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="form-grid"><label class="wide">Classificação<select asp-for="ClassificationNodeId" required>@foreach(var n in nodes){<option value="@n.Id">@n.Code · @n.Title</option>}</select></label><label>Prazo fase corrente (anos)<input asp-for="CurrentPhaseYears" min="0"/></label><label>Prazo fase intermediária (anos)<input asp-for="IntermediatePhaseYears" min="0"/></label><label>Destino final<select asp-for="FinalDestination"><option value="GUARDA_PERMANENTE">Guarda permanente</option><option value="ELIMINACAO">Eliminação</option><option value="REVISAO">Revisão</option><option value="AGUARDANDO_EVENTO">Aguardando evento</option></select></label><label>Evento condicionante<input asp-for="TriggerEvent"/></label><label class="wide">Descrição do evento<textarea asp-for="TriggerDescription"></textarea></label><label>Base legal<input asp-for="LegalBasis"/></label><label>Status<select asp-for="ReviewStatus"><option value="DRAFT">Rascunho</option><option value="IN_REVIEW">Em revisão</option><option value="APPROVED">Aprovado</option></select></label><label>Vigência inicial<input asp-for="EffectiveFrom" type="date"/></label><label>Vigência final<input asp-for="EffectiveTo" type="date"/></label><label class="wide">Observação<textarea asp-for="Observation"></textarea></label></div><footer><a class="btn btn-light" asp-action="RetentionRules">Cancelar</a><button class="btn btn-primary">Salvar regra</button></footer></form></div>
