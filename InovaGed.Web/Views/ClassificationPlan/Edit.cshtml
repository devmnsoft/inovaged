@model InovaGed.Web.Controllers.ClassificationPlanController.NodeForm
@{ViewData["Title"]=Model.Id.HasValue?"Editar classe":"Nova classe";var nodes=(IReadOnlyList<InovaGed.Application.Classification.ClassificationTreeNode>)(ViewBag.Nodes??Array.Empty<InovaGed.Application.Classification.ClassificationTreeNode>());}
@section Styles{<link rel="stylesheet" href="~/css/classification-plan.css"/>}<div class="classification-page"><header class="classification-heading"><div><a asp-action="Tree">Árvore</a><h1>@ViewData["Title"]</h1></div></header><form method="post" class="classification-form"><div asp-validation-summary="All" class="text-danger"></div><div class="form-grid"><label>Código<input asp-for="Code" required/></label><label>Título<input asp-for="Title" required/></label><label>Classe pai<select asp-for="ParentId"><option value="">Raiz do plano</option>@foreach(var n in nodes){<option value="@n.Id">@n.Code · @n.Title</option>}</select></label><label>Tipo de atividade<select asp-for="ActivityType"><option>MEIO</option><option>FIM</option></select></label><label class="wide">Descrição<textarea asp-for="Description"></textarea></label><label>Função documental<input asp-for="DocumentFunction"/></label><label>Fonte normativa<input asp-for="NormativeSource"/></label><label>Palavras-chave<input asp-for="Keywords"/></label><label>Ordem<input asp-for="DisplayOrder" type="number"/></label><label>Status<select asp-for="ReviewStatus"><option value="DRAFT">Rascunho</option><option value="IN_REVIEW">Em revisão</option><option value="APPROVED">Aprovado</option></select></label><label class="check"><input asp-for="IsActive"/> Classe ativa</label></div><footer><a class="btn btn-light" asp-action="Tree">Cancelar</a><button class="btn btn-primary">Salvar classe</button></footer></form></div>
