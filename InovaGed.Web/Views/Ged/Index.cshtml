                <button class="btn-close" type="button" data-bs-dismiss="modal"></button>
            </div>

            <form method="post"
                  enctype="multipart/form-data"
                  asp-action="Upload"
                  asp-controller="Ged"
                  class="js-feedback-form">
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <input type="hidden" name="folderId" value="@Model.CurrentFolderId" />

                    <div class="mb-3">
                        <label class="form-label">Arquivo</label>
                        <input class="form-control" type="file" name="file" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Título</label>
                        <input class="form-control" type="text" name="title" />
                    </div>

                    <div class="card border-warning-subtle mb-3">
                        <div class="card-body py-3">
                            <div class="fw-semibold mb-2"><app-icon class="me-1" name="folder-move" size="16" decorative="true" />Tipo de documento enviado</div>
                            <div class="form-check mb-2">
                                <input class="form-check-input js-upload-partial-mode" type="radio" name="uploadPartialMode" id="uploadDocumentComplete" value="complete" checked>
                                <label class="form-check-label fw-semibold" for="uploadDocumentComplete">Documento completo</label>
                                <div class="form-text">Use quando o arquivo enviado já representa o documento inteiro.</div>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input js-upload-partial-mode" type="radio" name="uploadPartialMode" id="uploadDocumentIncomplete" value="partial" @(canManagePartialDocuments ? null : "disabled")>
                                <label class="form-check-label fw-semibold" for="uploadDocumentIncomplete">Documento incompleto</label>
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-placement="right" title="Documento fracionado" data-bs-content="Documento incompleto é um documento enviado parcialmente e que poderá receber novas partes futuramente. Exemplo: um documento de agendamento foi digitalizado pela metade hoje e a outra parte será enviada depois." aria-label="Ajuda sobre documento incompleto"><app-icon name="circle-question" size="16" decorative="true" /></button>
                                <div class="form-text">Use quando o documento está sendo enviado em partes e será complementado futuramente.@(!canManagePartialDocuments ? " Permissão necessária: DOCUMENT_PART_MARK_INCOMPLETE ou DOCUMENT_PART_ADD." : "")</div>
                            </div>
                            <div id="uploadPartialFields" class="alert alert-warning mt-3 mb-0 d-none">
                                <input type="hidden" name="isDocumentPart" id="uploadIsDocumentPart" value="false" />
                                <div class="mb-2"><app-icon class="me-1" name="warning" size="16" decorative="true" />Documento incompleto é um documento enviado parcialmente e que poderá receber novas partes futuramente. Exemplo: um documento de agendamento foi digitalizado pela metade hoje e a outra parte será enviada depois.</div>
                                <div class="row g-2">
                                    <div class="col-sm-4">
                                        <label class="form-label" for="uploadPartNumber">Parte número</label>
                                        <input type="number" class="form-control" name="partNumber" id="uploadPartNumber" min="1" step="1" value="1" />
                                    </div>
                                    <div class="col-sm-4">
                                        <label class="form-label" for="uploadTotalParts">Total previsto (opcional)</label>
                                        <input type="number" class="form-control" name="totalParts" id="uploadTotalParts" min="1" step="1" placeholder="Ex.: 2" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="uploadPartialNotes">Observação (opcional)</label>
                                        <textarea class="form-control" name="partialNotes" id="uploadPartialNotes" rows="2" placeholder="Primeira parte do agendamento, complemento será enviado posteriormente."></textarea>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="uploadExistingPartialDocumentId">Vincular a documento incompleto existente (opcional)</label>
                                        <input type="text" class="form-control" name="existingDocumentId" id="uploadExistingPartialDocumentId" placeholder="UUID do documento incompleto, quando esta for uma nova parte" />
                                        <div class="form-text">Use apenas quando o arquivo enviado deve complementar um documento incompleto já cadastrado.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-primary"
                            type="submit"
                    @(Model.CurrentFolderId == null ? "disabled" : "")>
                        <span class="btn-text">Enviar</span>
                        <span class="btn-loading d-none"><span class="spinner-border spinner-border-sm me-1"></span>Enviando...</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="bulkUploadModal" tabindex="-1" aria-hidden="true" data-folder-id="@Model.CurrentFolderId" data-upload-folder-id="@currentUploadFolderId" data-listing-folder-id="@currentListingFolderId" data-can-receive-documents="@(currentCanReceiveDocuments ? "true" : "false")" data-folder-virtual="@(uploadFolderIsVirtual ? "true" : "false")" data-is-virtual="@(uploadFolderIsVirtual ? "true" : "false")" data-folder-name="@uploadFolderLabel" data-allow-legacy-upload-fallback="@(allowLegacyUploadFallback ? "true" : "false")" data-use-chunked-upload="@(uploadOptions.UseChunkedUpload ? "true" : "false")" data-chunk-size-mb="@uploadOptions.ChunkSizeMb" data-chunked-threshold-mb="@uploadOptions.ChunkedThresholdMb" data-upload-timeout-seconds="@uploadOptions.UploadTimeoutSeconds">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><div><h5 class="modal-title">Adicionar documentos em lote</h5><small class="text-muted">Envie vários arquivos diretamente para a pasta selecionada.</small></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <input type="hidden" id="bulkFolderId" value="@currentUploadFolderId" />
        <input type="hidden" id="bulkUploadFolderId" value="@currentUploadFolderId" />
        <input type="hidden" id="bulkListingFolderId" value="@currentListingFolderId" />
        <input type="hidden" id="bulkUploadRequestedFolderId" value="@Model.CurrentFolderId" />
        <div id="bulkUploadFolderNotice" class="alert @(uploadFolderIsVirtual ? "alert-warning" : "alert-info") py-2">
            <strong>Destino selecionado:</strong> @uploadFolderLabel. O sistema validará o destino ao iniciar o upload.
        </div>
        <div id="bulkUploadMessage" class="d-none alert"></div>
        <div class="card border-warning-subtle mb-3">
            <div class="card-body py-3">
                <div class="fw-semibold mb-2"><app-icon class="me-1" name="folder-move" size="16" decorative="true" />Tipo de documento enviado</div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="bulkPartialMode" id="bulkUploadComplete" value="complete" checked>
                    <label class="form-check-label fw-semibold" for="bulkUploadComplete">Documento completo</label>
                    <div class="form-text">Use quando o arquivo enviado já representa o documento inteiro.</div>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="bulkPartialMode" id="bulkUploadIncomplete" value="partial" @(canManagePartialDocuments ? null : "disabled")>
                    <label class="form-check-label fw-semibold" for="bulkUploadIncomplete">Documento incompleto</label>
                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-placement="right" title="Documento fracionado" data-bs-content="Documento incompleto é um documento enviado parcialmente e que poderá receber novas partes futuramente. Exemplo: um documento de agendamento foi digitalizado pela metade hoje e a outra parte será enviada depois." aria-label="Ajuda sobre documento incompleto"><app-icon name="circle-question" size="16" decorative="true" /></button>
                    <div class="form-text">Use quando o documento está sendo enviado em partes e será complementado futuramente.@(!canManagePartialDocuments ? " Permissão necessária: DOCUMENT_PART_MARK_INCOMPLETE ou DOCUMENT_PART_ADD." : "")</div>
                </div>
                <div id="bulkPartialFields" class="alert alert-warning row g-2 mt-3 mb-0 d-none">
                    <div class="col-12 small"><app-icon class="me-1" name="warning" size="16" decorative="true" />Documento incompleto é um documento enviado parcialmente e que poderá receber novas partes futuramente. Exemplo: um documento de agendamento foi digitalizado pela metade hoje e a outra parte será enviada depois.</div>
                    <div class="col-sm-4">
                        <label class="form-label" for="bulkPartialPartNumber">Parte número</label>
                        <input type="number" class="form-control" id="bulkPartialPartNumber" min="1" step="1" value="1">
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label" for="bulkPartialTotalParts">Total previsto (opcional)</label>
                        <input type="number" class="form-control" id="bulkPartialTotalParts" min="1" step="1">
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label" for="bulkPartialExistingDocumentId">Vincular a documento existente</label>
                        <input type="text" class="form-control" id="bulkPartialExistingDocumentId" placeholder="UUID opcional">
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="bulkPartialNotes">Observação</label>
                        <textarea class="form-control" id="bulkPartialNotes" rows="2" placeholder="Contexto da parte, pendências ou orientação para consolidação."></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div id="bulkDropzone" class="border border-2 border-secondary-subtle rounded p-4 text-center mb-3" style="border-style:dashed !important; cursor:pointer;">
            <app-icon class="fs-1 d-block mb-2" name="upload-cloud" size="16" decorative="true" /><strong>Arraste arquivos aqui ou clique para selecionar</strong>
            <input id="bulkFileInput" type="file" multiple class="d-none" />
        </div>
        <div class="border rounded-3 p-3 mb-3 bg-light">
            <div class="fw-semibold mb-2">Verificar duplicidade</div>
            <div class="d-flex gap-3 flex-wrap small">
                <label class="form-check-label"><input class="form-check-input" type="radio" name="bulkDuplicateCheckScope" value="CURRENT_FOLDER" checked /> Apenas nesta pasta</label>
                <label class="form-check-label"><input class="form-check-input" type="radio" name="bulkDuplicateCheckScope" value="CURRENT_FOLDER_AND_SUBFOLDERS" /> Nesta pasta e subpastas</label>
                <label class="form-check-label"><input class="form-check-input" type="radio" name="bulkDuplicateCheckScope" value="ALL_SYSTEM" /> Sistema todo</label>
            </div>
            <div class="form-text">Por padrão, o sistema verifica duplicidade apenas na pasta de destino. Isso evita alertas desnecessários quando pacientes possuem novos exames com nomes parecidos em outras pastas.</div>
        </div>
        <div id="bulkDuplicateDecision" class="alert alert-warning d-none"><strong>Foram encontrados arquivos possivelmente duplicados</strong><div class="small mb-1">Alguns arquivos possuem o mesmo nome ou características semelhantes a documentos já existentes. Isso pode ser uma duplicidade real ou um novo exame do mesmo paciente. Confira as informações antes de continuar.</div><div class="small mb-2">O sistema não bloqueará o envio. Você pode enviar mesmo assim, salvar como nova versão, renomear ou ignorar.</div><ul id="bulkDuplicateList" class="mb-2"></ul><div class="btn-group btn-group-sm flex-wrap"><button type="button" class="btn btn-outline-info" id="btnDupAnalyze">Analisar um por um</button><button type="button" class="btn btn-outline-danger" id="btnDupUploadAnyway">Enviar todos mesmo assim</button><button type="button" class="btn btn-outline-primary" id="btnDupNewVersion">Salvar como nova versão</button><button type="button" class="btn btn-outline-secondary" id="btnDupRename">Renomear novos arquivos</button><button type="button" class="btn btn-outline-secondary" id="btnDupSkip">Ignorar duplicados</button><button type="button" class="btn btn-outline-dark" id="btnDupCancel">Cancelar envio</button></div></div><div class="d-flex justify-content-between align-items-center mb-2"><strong>Arquivos selecionados</strong><button class="btn btn-sm btn-outline-secondary" id="btnBulkClear">Limpar lista</button></div><div id="bulkSummary" class="small text-muted mb-2"></div>
        <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Arquivo</th><th>Tamanho</th><th>Status</th><th>Progresso</th><th></th></tr></thead><tbody id="bulkFileList"></tbody></table></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn btn-outline-info d-none" id="btnBulkRefreshFolder" onclick="window.location.reload();">Atualizar pasta</button><button type="button" class="btn btn-outline-primary d-none" id="btnStartNewBulkBatch">Novo lote</button><a class="btn btn-outline-dark d-none" id="btnBulkViewLog" href="/Ged/Uploads">Ver log do lote</a><button type="button" class="btn btn-outline-warning d-none" id="btnBulkRetryFailed">Tentar novamente falhos</button><button type="button" class="btn btn-outline-secondary d-none" id="btnClearSuccessfulUploads">Limpar enviados</button><button type="button" class="btn btn-primary" id="btnBulkUploadSubmit" @(Model.CurrentFolderId == null ? "disabled" : "")>Enviar documentos</button></div>
    </div>
  </div>
</div>


