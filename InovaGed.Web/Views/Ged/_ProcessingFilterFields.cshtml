@model InovaGed.Application.Ged.Processing.ProcessingCenterCriteria
<input type="hidden" name="status" value="@Model.StatusGroup" />
<input type="hidden" name="lane" value="@Model.Lane" />
<input type="hidden" name="q" value="@(Model.NameLike?.Trim('%'))" />
<input type="hidden" name="from" value="@Model.From.UtcDateTime.ToString("yyyy-MM-dd")" />
<input type="hidden" name="to" value="@Model.To.UtcDateTime.AddDays(-1).ToString("yyyy-MM-dd")" />
<input type="hidden" name="userId" value="@Model.UserId" />
<input type="hidden" name="documentTypeId" value="@Model.DocumentTypeId" />
