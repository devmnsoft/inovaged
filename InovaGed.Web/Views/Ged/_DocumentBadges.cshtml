@model InovaGed.Web.Models.Ged.DocumentBadgesVM
@{
    var badges = new List<(string Css, string Icon, string Label, string Title)>();

    if (Model.IsRestricted)
        badges.Add(("ged-badge-danger", "roles", "Restrito", "Acesso limitado por política de segurança"));
    if (Model.IsPartial)
        badges.Add(("ged-badge-warning", "document-version", "Parcial", "Documento composto por partes"));
    if (Model.ShowOcrBadge)
    {
        var ocrReady = string.Equals(Model.OcrStatus, "COMPLETED", StringComparison.OrdinalIgnoreCase)
            || string.Equals(Model.OcrStatus, "AVAILABLE", StringComparison.OrdinalIgnoreCase);
        badges.Add(ocrReady
            ? ("ged-badge-success", "ocr-success", "OCR pronto", "Texto pesquisável disponível")
            : ("ged-badge-muted", "ocr-pending", "OCR pendente", "Extração de texto ainda não concluída"));
    }
    if (Model.ShowPreviewBadge && string.Equals(Model.PreviewStatus, "FAILED", StringComparison.OrdinalIgnoreCase))
        badges.Add(("ged-badge-danger", "error", "Preview falhou", "A visualização não pôde ser gerada"));
    if (Model.ShowClassificationBadge)
    {
        var classified = string.Equals(Model.ClassificationStatus, "CLASSIFIED", StringComparison.OrdinalIgnoreCase);
        badges.Add(classified
            ? ("ged-badge-success", "classification", "Classificado", "Classificação arquivística aplicada")
            : ("ged-badge-muted", "classification", "Sem classificação", "Classificação arquivística pendente"));
    }
    if (Model.ShowRetentionBadge)
        badges.Add(Model.IsOverdue
            ? ("ged-badge-danger", "warning", "Vencido", "Prazo de temporalidade vencido")
            : ("ged-badge-info", "check", Model.RetentionStatus ?? "Temporalidade", "Situação da temporalidade"));
    if (Model.ShowSignatureBadge && string.Equals(Model.SignatureStatus, "VALID", StringComparison.OrdinalIgnoreCase))
        badges.Add(("ged-badge-success", "check", "Assinado", "Assinatura criptográfica validada"));

    var visibleBadges = badges.Take(3).ToArray();
    var overflowBadges = badges.Skip(3).ToArray();
}
<div class="ged-document-badges" aria-label="Status do documento">
    @foreach (var badge in visibleBadges)
    {
        <span class="badge ged-badge @badge.Css" title="@badge.Title"><app-icon name="@badge.Icon" size="16" decorative="true" />@badge.Label</span>
    }
    @if (overflowBadges.Length > 0)
    {
        var overflowTitle = string.Join(", ", overflowBadges.Select(item => item.Label));
        <button type="button" class="badge ged-badge ged-badge-more" title="@overflowTitle" aria-label="Mais estados: @overflowTitle">+@overflowBadges.Length</button>
    }
</div>
