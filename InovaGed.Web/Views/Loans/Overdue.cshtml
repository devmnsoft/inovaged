@using InovaGed.Application.Ged.Loans
@using InovaGed.Web.Models.Atlas
@model IReadOnlyList<LoanRowDto>
@{ ViewData["Title"]="Empréstimos vencidos"; var now=DateTime.UtcNow; var header=new AtlasPageHeaderVm("Empréstimos vencidos", "Cobrança, SLA e devolução em uma fila operacional", "clock", "Operação premium", null, new (string, string?)[] { ("Empréstimos", "/Loans"), ("Vencidos", null) }); }
<div class="atlas-prime-page"><partial name="Atlas/_PageHeader" model="header" />
@if(TempData["Ok"] is string ok){<div class="callout callout-success" role="status">@ok</div>}@if(TempData["Err"] is string err){<div class="callout callout-danger" role="alert">@err</div>}
<div class="row g-3 mb-3"><div class="col"><div class="card card-body"><small>Total vencidos</small><strong>@Model.Count</strong></div></div><div class="col"><div class="card card-body"><small>Hoje</small><strong>@Model.Count(x=>x.DueAt.Date==now.Date)</strong></div></div><div class="col"><div class="card card-body"><small>1–7 dias</small><strong>@Model.Count(x=>(now-x.DueAt).TotalDays>=1&&(now-x.DueAt).TotalDays<=7)</strong></div></div><div class="col"><div class="card card-body"><small>8–30 dias</small><strong>@Model.Count(x=>(now-x.DueAt).TotalDays>7&&(now-x.DueAt).TotalDays<=30)</strong></div></div><div class="col"><div class="card card-body"><small>Mais de 30</small><strong>@Model.Count(x=>(now-x.DueAt).TotalDays>30)</strong></div></div></div>
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-md-3"><label class="form-label">Solicitante</label><input class="form-control" name="requester" /></div><div class="col-md-2"><label class="form-label">Status</label><input class="form-control" name="status" /></div><div class="col-md-2"><label class="form-label">Tipo</label><input class="form-control" name="type" /></div><div class="col-md-2"><label class="form-label">Prioridade</label><input class="form-control" name="priority" /></div><div class="col-md-2"><label class="form-label">Entrega</label><input class="form-control" name="deliveryMode" /></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-outline-primary">Filtrar</button></div></div></form>
<div class="d-flex gap-2 mb-3"><form method="post" action="/Loans/Overdue/Run">@Html.AntiForgeryToken()<button class="btn btn-warning"><app-icon name="clock" size="16" /> Executar rotina de vencidos</button></form><a class="btn btn-outline-secondary" href="/Loans/Reports?OverdueOnly=true">Relatório / CSV</a></div>
<form method="post" action="/Loans/Overdue/Collect"><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th><span class="visually-hidden">Selecionar</span></th><th>Protocolo</th><th>Status</th><th>Solicitante</th><th>Vencimento</th><th>Atraso</th><th>Prioridade</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td><input class="form-check-input" type="checkbox" name="ids" value="@r.Id" /></td><td>@r.ProtocolNo</td><td><span class="badge text-bg-danger">@r.Status</span></td><td>@r.RequesterName</td><td>@r.DueAt.ToString("dd/MM/yyyy")</td><td>@Math.Max(0,(now-r.DueAt).Days) dias</td><td>@(r.Priority??"NORMAL")</td><td><a class="btn btn-sm btn-outline-primary" href="/Loans/@r.Id">Detalhes</a></td></tr>}@if(Model.Count==0){<tr><td colspan="8" class="text-muted">Nenhum vencido no seu escopo.</td></tr>}</tbody></table></div>@Html.AntiForgeryToken()<button class="btn btn-danger" @(Model.Count==0?"disabled":null)>Registrar cobrança selecionada</button></form>
</div>
