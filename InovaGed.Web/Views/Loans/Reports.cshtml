@using InovaGed.Application.Ged.Loans
@model LoanReportResult
@using InovaGed.Web.Models.Atlas
@{ ViewData["Title"]="Relatórios de empréstimos"; var header = new AtlasPageHeaderVm("Relatórios de empréstimos", "Indicadores operacionais e rastreáveis", "chart-bar", "Operação premium", null, null); }
<div class="atlas-prime-page"><partial name="Atlas/_PageHeader" model="header" />
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-md-2"><label class="form-label">De</label><input class="form-control" type="date" name="From" /></div><div class="col-md-2"><label class="form-label">Até</label><input class="form-control" type="date" name="To" /></div><div class="col-md-2"><label class="form-label">Status</label><input class="form-control" name="Status" /></div><div class="col-md-2"><label class="form-label">Solicitante</label><input class="form-control" name="Requester" /></div><div class="col-md-2"><label class="form-label">Setor</label><input class="form-control" name="Sector" /></div><div class="col-md-2 d-flex align-items-end gap-1"><button class="btn btn-primary">Filtrar</button><button class="btn btn-outline-secondary" name="format" value="csv">CSV</button></div></div></form>
<div class="row g-3 mb-3"><div class="col"><div class="card card-body"><small>Total</small><strong>@Model.Total</strong></div></div><div class="col"><div class="card card-body"><small>Vencidos</small><strong>@Model.Overdue</strong></div></div><div class="col"><div class="card card-body"><small>Atraso médio</small><strong>@Model.AverageDelayDays.ToString("N1") dias</strong></div></div><div class="col"><div class="card card-body"><small>Cobranças</small><strong>@Model.Collections</strong></div></div></div>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Protocolo</th><th>Solicitante</th><th>Setor</th><th>Status</th><th>Entrega</th><th>Vencimento</th><th>Atraso</th><th>Cobranças</th></tr></thead><tbody>@foreach(var r in Model.Rows){<tr><td><a href="/Loans/@r.Id">@r.ProtocolNo</a></td><td>@r.RequesterName</td><td>@r.Sector</td><td><span class="badge text-bg-secondary">@r.Status</span></td><td>@r.DeliveryMode</td><td>@r.DueAt.ToString("dd/MM/yyyy")</td><td>@r.DaysLate dias</td><td>@r.CollectionCount</td></tr>}@if(Model.Rows.Count==0){<tr><td colspan="8" class="text-muted">Nenhum resultado para os filtros.</td></tr>}</tbody></table></div>

</div>
