@model InovaGed.Web.Models.Commercial.PasswordRequestViewModel
@{Layout="_PublicLayout";ViewData["Title"]="Recuperar senha";}<form method="post" class="form"><h2>Recuperar acesso</h2>@if(ViewBag.Sent==true){<p>Se houver uma conta com esse e-mail, enviaremos as instruções de recuperação.</p>}else{<p>Informe seu e-mail. A resposta é a mesma, exista ou não uma conta.</p><label asp-for="Email">E-mail</label><input asp-for="Email"><button class="button">Enviar instruções</button>}</form>
