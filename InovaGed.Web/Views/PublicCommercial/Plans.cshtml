@model IReadOnlyList<InovaGed.Web.Models.Commercial.PublicPlan>
@{Layout="_PublicLayout";ViewData["Title"]="Planos";}<section class="section"><div class="eyebrow">Planos</div><h1>Comece no ritmo da sua gestão.</h1><p class="lead">Limites transparentes e evolução sem ruptura.</p><div class="grid four">@foreach(var p in Model){<article class="card @(p.Code=="GROWTH"?"featured":"")"><h2>@p.Name</h2><div class="price">@(p.MonthlyPrice==0&&p.Code!="FREE"?"Sob consulta":p.MonthlyPrice.ToString("C0"))</div><p>@(p.Diagnostics==int.MaxValue?"Diagnósticos sob medida":$"{p.Diagnostics} diagnósticos")</p><p>@(p.Responses==int.MaxValue?"Respostas sob medida":$"{p.Responses} respostas/mês")</p><p>Relatórios: @p.Reports</p><p>Inteligência: @p.Intelligence</p><a class="button" href="@(p.Code=="ENTERPRISE"?"/demonstracao":"/cadastro?plan="+p.Code)">@(p.Code=="FREE"?"Começar grátis":p.Code=="ENTERPRISE"?"Falar com consultor":"Iniciar teste")</a></article>}</div><p><a href="/planos/comparar">Ver comparativo completo →</a></p></section>
