@model InovaGed.Web.Models.Commercial.SignupViewModel
@{Layout="_PublicLayout";ViewData["Title"]="Começar teste grátis";}<form method="post" class="form"><div class="eyebrow">Teste controlado</div><h2>Crie seu espaço Valora.</h2><p class="muted">Você será o administrador da organização e seguirá direto para a configuração inicial.</p><div asp-validation-summary="ModelOnly"></div><div class="fields"><div><label asp-for="Name">Nome</label><input asp-for="Name"><span asp-validation-for="Name"></span></div><div><label asp-for="Email">E-mail profissional</label><input asp-for="Email"></div><div><label asp-for="Phone">Telefone</label><input asp-for="Phone"></div><div><label asp-for="JobTitle">Cargo</label><input asp-for="JobTitle"></div><div><label asp-for="OrganizationName">Empresa</label><input asp-for="OrganizationName"></div><div><label asp-for="Cnpj">CNPJ (opcional)</label><input asp-for="Cnpj"></div><div><label asp-for="PlanCode">Plano</label><select asp-for="PlanCode"><option>FREE</option><option>START</option><option>GROWTH</option></select></div><div><label asp-for="Password">Senha</label><input asp-for="Password"><small>12+ caracteres, maiúscula, minúscula, número e símbolo.</small></div></div><div class="honeypot"><input asp-for="Website" tabindex="-1" autocomplete="off"></div><p><label><input asp-for="AcceptTerms" style="width:auto"> Li e aceito os <a href="/termos">termos</a> e a <a href="/privacidade">política de privacidade</a>.</label></p><button class="button">Criar conta e iniciar onboarding</button></form>
