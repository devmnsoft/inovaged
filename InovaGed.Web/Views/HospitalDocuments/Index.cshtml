@{
    ViewData["Title"] = "Busca de Documentos Hospitalares";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hospital-documents.css" asp-append-version="true" />
}

<div class="hospital-documents-page hospital-search-page" data-hospital-documents-page>
    <section class="hospital-search-hero" aria-labelledby="hospitalSearchTitle">
        <div class="hospital-hero-grid">
            <div class="hospital-hero-main">
                <span class="hospital-secure-badge"><app-icon name="security" size="16" decorative="true" /> Consulta segura somente leitura</span>
                <h1 id="hospitalSearchTitle">Busca de Documentos Hospitalares</h1>
                <p class="hospital-hero-subtitle">Localize documentos por nome, prontuário, termo do OCR, paciente, exame ou conteúdo textual.</p>

                <form id="hospitalSearchForm" class="hospital-search-form" autocomplete="off">
                    <div class="hospital-search-input-wrap hospital-search-box-wrapper">
                        <label class="visually-hidden" for="searchInput">Termo de busca hospitalar</label>
                        <app-icon class="hospital-search-icon" name="search" size="18" decorative="true" />
                        <input id="searchInput" class="hospital-search-input" type="search" autocomplete="off" placeholder="Busque por nome, prontuário, APAC, carcinoma, exame, laudo ou trecho do OCR..." aria-describedby="searchHelp" aria-controls="suggestions" />
                        <button id="btnClearSearch" class="hospital-input-clear" type="button" aria-label="Limpar busca"><app-icon name="close" size="14" decorative="true" /></button>
                        <div id="suggestions" class="hospital-suggestions hospital-suggestions-dropdown" role="listbox" aria-label="Sugestões de busca"></div>
                    </div>

                    <label class="visually-hidden" for="typeFilter">Tipo documental</label>
                    <select id="typeFilter" class="hospital-type-select" aria-label="Tipo documental">
                        <option value="">Todos os tipos</option>
                        <option value="pdf">PDF</option>
                        <option value="word">Documento Word</option>
                        <option value="image">Imagem digitalizada</option>
                    </select>

                    <button id="btnSearch" type="submit" class="hospital-btn-primary"><span class="btn-label">Pesquisar</span></button>
                    <button id="btnOpenAssistant" class="hospital-btn-assistant" type="button" data-bs-toggle="offcanvas" data-bs-target="#documentAssistantCanvas"><app-icon name="sparkles" size="16" decorative="true" /> Busca inteligente</button>
                    <button id="btnAdvancedFilters" class="hospital-btn-secondary" type="button" data-bs-toggle="offcanvas" data-bs-target="#advancedFiltersCanvas" aria-controls="advancedFiltersCanvas"><app-icon name="filter" size="16" decorative="true" /> Filtros</button>
                </form>

                <div id="searchHelp" class="hospital-search-help">Digite uma informação e pressione Enter ou clique em Pesquisar.</div>

                <div class="hospital-quick-chips" aria-label="Filtros rápidos">
                    <button type="button" class="hospital-filter-chip" data-chip="type" data-type="pdf">PDF</button>
                    <button type="button" class="hospital-filter-chip" data-chip="type" data-type="image">Imagens</button>
                    <button type="button" class="hospital-filter-chip" data-chip="ocr" data-ocr="with">Com OCR</button>
                    <button type="button" class="hospital-filter-chip" data-chip="ocr" data-ocr="without">Sem OCR</button>
                    <button type="button" class="hospital-filter-chip" data-chip="recent" data-recent="true">Últimos 7 dias</button>
                    <button type="button" class="hospital-filter-chip" data-chip="term" data-term="prontuário">Prontuários</button>
                    <button type="button" class="hospital-filter-chip" data-chip="term" data-term="exame">Exames</button>
                    <button type="button" class="hospital-filter-chip" data-chip="term" data-term="laudo">Laudos</button>
                    <button type="button" class="hospital-filter-chip" data-chip="term" data-term="APAC">APAC</button>
                    <button type="button" class="hospital-filter-chip" data-chip="term" data-term="oncologia">Oncologia</button>
                    <button type="button" class="hospital-filter-chip" data-chip="term" data-term="contrato">Contratos/Administrativo</button>
                </div>

                <div id="activeFilters" class="hospital-active-filters" aria-live="polite"></div>
            </div>
        </div>
    </section>

    <section class="hospital-results-shell" aria-label="Central de resultados hospitalares">
        <div class="hospital-results-layout">
            <section class="hospital-results-column" aria-label="Resultados encontrados">
                <main class="hospital-results-panel">
                    <div class="hospital-panel-header">
                        <div>
                            <h2>Resultados da busca</h2>
                            <p id="resultsMeta">Nenhuma busca executada ainda.</p>
                        </div>
                        <div class="hospital-panel-actions">
                            <button id="btnToggleView" type="button" class="btn btn-sm btn-outline-secondary"><app-icon name="list" size="15" decorative="true" /> Exibição</button>
                            <button id="btnExportCsv" type="button" class="btn btn-sm btn-outline-secondary"><app-icon name="download" size="15" decorative="true" /> CSV</button>
                            <button id="btnClearAll" type="button" class="btn btn-sm btn-outline-danger"><app-icon name="close" size="15" decorative="true" /> Limpar</button>
                        </div>
                    </div>

                    <div id="searchSummary" class="hospital-search-summary-inline" aria-live="polite"></div>
                    <div id="resultsList" class="hospital-results-list hospital-results-list-mode" aria-live="polite"></div>
                    <div class="hospital-load-more-wrap"><button id="btnLoadMore" type="button" class="hospital-btn-secondary d-none">Carregar mais resultados</button></div>
                </main>
            </section>

            <aside id="hospitalPreviewPanel" class="hospital-preview-panel" aria-label="Preview lateral do documento">
                <div class="hospital-preview-header">
                    <div class="hospital-preview-heading">
                        <span id="previewTypeBadge" class="hospital-badge">Documento</span>
                        <h3 id="previewTitle">Selecione um documento</h3>
                        <p id="previewSubtitle">Clique em um resultado da busca para abrir o preview ao lado.</p>
                    </div>
                    <button id="btnClosePreviewPanel" class="btn btn-sm btn-outline-secondary" type="button" aria-label="Limpar preview"><app-icon name="close" size="15" decorative="true" /></button>
                </div>

                <div class="hospital-preview-status-row" aria-live="polite">
                    <span id="previewOcrBadge" class="hospital-badge subtle">OCR pendente</span>
                    <span id="previewFileBadge" class="hospital-badge subtle">Arquivo não selecionado</span>
                </div>

                <ul class="nav hospital-preview-tabs" role="tablist" aria-label="Áreas do painel do documento">
                    <li class="nav-item" role="presentation"><button class="nav-link active" type="button" data-panel-tab="summary" role="tab">Resumo</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" type="button" data-panel-tab="preview" role="tab">Preview</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" type="button" data-panel-tab="ocr" role="tab">OCR</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" type="button" data-panel-tab="meta" role="tab">Metadados</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" type="button" data-panel-tab="parts" role="tab">Partes</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" type="button" data-panel-tab="history" role="tab">Histórico</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" type="button" data-panel-tab="actions" role="tab">Ações</button></li>
                </ul>

                <div class="hospital-preview-toolbar" aria-label="Ações do preview">
                    <a id="btnOpenNewTab" class="hospital-preview-action primary disabled" target="_blank" rel="noopener" aria-disabled="true"><app-icon name="external-link" size="15" decorative="true" /> Abrir em nova aba</a>
                    <a id="btnDownloadPreview" class="hospital-preview-action disabled" aria-disabled="true"><app-icon name="download" size="15" decorative="true" /> Baixar</a>
                    <div class="dropdown hospital-more-actions">
                        <button class="hospital-preview-action dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><app-icon name="more" size="15" decorative="true" /> Mais ações</button>
                        <div class="dropdown-menu dropdown-menu-end hospital-actions-menu">
                            <h6 class="dropdown-header">Resultados</h6>
                            <button id="btnActionsRefresh" type="button" class="dropdown-item"><app-icon name="refresh" size="15" decorative="true" /> Atualizar resultados</button>
                            <button id="btnActionsClear" type="button" class="dropdown-item"><app-icon name="close" size="15" decorative="true" /> Limpar filtros</button>
                            <button id="btnActionsAssistant" type="button" class="dropdown-item" data-bs-toggle="offcanvas" data-bs-target="#documentAssistantCanvas"><app-icon name="sparkles" size="15" decorative="true" /> Busca inteligente</button>
                            <div class="dropdown-divider"></div><h6 class="dropdown-header">Documento selecionado</h6>
                            <button id="btnExpandPreview" type="button" class="dropdown-item js-expand-preview"><app-icon name="expand" size="15" decorative="true" /> Expandir</button>
                            <button id="btnFullscreenPreview" type="button" class="dropdown-item"><app-icon name="fullscreen" size="15" decorative="true" /> Tela cheia</button>
                            <button id="btnCopyReference" type="button" class="dropdown-item"><app-icon name="copy" size="15" decorative="true" /> Copiar referência</button>
                            <button type="button" class="dropdown-item disabled" disabled title="Em breve"><app-icon name="share" size="15" decorative="true" /> Compartilhar internamente <small>Em breve</small></button>
                        </div>
                    </div>
                </div>

                <div class="hospital-preview-body">
                    <div id="summaryContent" class="hospital-preview-tab-content active" data-panel-content="summary">
                        <div id="summaryPanelContent" class="hospital-preview-summary hospital-preview-empty"><img src="~/images/illustrations/document-preview-empty.svg" alt="" /><strong>Nenhum documento selecionado</strong><span>Selecione um documento na lista para visualizar detalhes, OCR e metadados.</span></div>
                    </div>
                    <div id="previewContent" class="hospital-preview-tab-content" data-panel-content="preview">
                        <div id="previewEmptyState" class="hospital-preview-empty">
                            <app-icon name="document" size="26" decorative="true" />
                            <strong>Selecione um documento para visualizar.</strong>
                            <span>Clique em um resultado da busca para abrir o preview ao lado.</span>
                        </div>
                        <div id="previewLoading" class="hospital-preview-loading d-none"><span class="spinner-border spinner-border-sm"></span> Carregando preview...</div>
                        <iframe id="hospitalPreviewFrame" class="hospital-preview-frame d-none" title="Preview do documento"></iframe>
                    </div>
                    <div id="ocrContent" class="hospital-preview-tab-content" data-panel-content="ocr">
                        <div id="ocrPanelStatus" class="hospital-ocr-status">Selecione um documento para consultar o OCR.</div>
                        <pre id="ocrPanelText" class="hospital-ocr-text"></pre>
                    </div>
                    <div id="metaContent" class="hospital-preview-tab-content" data-panel-content="meta">
                        <div id="metaPanelContent" class="hospital-meta-list hospital-preview-empty">Nenhum documento selecionado.</div>
                    </div>
                    <div id="partsContent" class="hospital-preview-tab-content" data-panel-content="parts">
                        <div id="partsPanelContent" class="hospital-preview-empty compact">Partes do documento aparecem aqui quando o item selecionado for parcial ou incompleto.</div>
                    </div>
                    <div id="historyContent" class="hospital-preview-tab-content" data-panel-content="history">
                        <div id="historyPanelContent" class="hospital-preview-empty compact">Histórico resumido será carregado a partir dos metadados disponíveis na listagem.</div>
                    </div>
                    <div id="actionsContent" class="hospital-preview-tab-content" data-panel-content="actions">
                        <div id="actionsPanelContent" class="hospital-action-list hospital-preview-empty compact">Selecione um documento para habilitar ações.</div>
                    </div>
                </div>
            </aside>
        </div>
    </section>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="advancedFiltersCanvas" aria-labelledby="advancedFiltersTitle">
        <div class="offcanvas-header">
            <h5 id="advancedFiltersTitle" class="offcanvas-title"><app-icon name="filter" size="17" decorative="true" /> Filtros avançados</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
        </div>
        <div class="offcanvas-body">
            <div class="row g-3">
                <div class="col-12"><label class="form-label" for="advancedType">Tipo documental</label><select id="advancedType" class="form-select"><option value="">Todos</option><option value="pdf">PDF</option><option value="word">Documento Word</option><option value="image">Imagem</option></select></div>
                <div class="col-12"><label class="form-label" for="advancedOcrStatus">Status OCR</label><select id="advancedOcrStatus" class="form-select"><option value="">Todos</option><option value="with">Com OCR</option><option value="without">Sem OCR</option><option value="PROCESSING">Em processamento</option><option value="PENDING">Na fila</option><option value="ERROR">Com erro</option></select></div>
                <div class="col-6"><label class="form-label" for="dateFrom">Período inicial</label><input id="dateFrom" type="date" class="form-control" /></div>
                <div class="col-6"><label class="form-label" for="dateTo">Período final</label><input id="dateTo" type="date" class="form-control" /></div>
                <div class="col-12"><label class="form-label" for="folderFilter">Pasta</label><input id="folderFilter" class="form-control" placeholder="Nome da pasta" /></div>
                <div class="col-12 form-check form-switch ms-2"><input id="ocrRequired" class="form-check-input" type="checkbox" /><label class="form-check-label" for="ocrRequired">Termo OCR obrigatório</label></div>
                <div class="col-12 form-check form-switch ms-2"><input id="recentOnly" class="form-check-input" type="checkbox" /><label class="form-check-label" for="recentOnly">Apenas documentos recentes</label></div>
                <div class="col-12 form-check form-switch ms-2"><input id="previewOnly" class="form-check-input" type="checkbox" /><label class="form-check-label" for="previewOnly">Apenas com preview</label></div>
                <div class="col-12"><label class="form-label" for="sortFilter">Ordenação</label><select id="sortFilter" class="form-select"><option value="relevance">Mais relevantes</option><option value="recent">Mais recentes</option><option value="az">Nome A-Z</option><option value="type">Tipo documental</option></select></div>
            </div>
            <div id="advancedFilterSummary" class="hospital-filter-summary mt-3">Nenhum filtro avançado aplicado.</div>
            <div class="d-grid gap-2 mt-4"><button id="btnApplyAdvanced" type="button" class="hospital-btn-primary" data-bs-dismiss="offcanvas">Aplicar filtros</button><button id="btnResetAdvanced" type="button" class="hospital-btn-secondary">Limpar filtros</button></div>
        </div>
    </div>


    <div class="offcanvas offcanvas-end hospital-assistant-canvas" tabindex="-1" id="documentAssistantCanvas" aria-labelledby="documentAssistantTitle">
      <div class="offcanvas-header"><div><span class="hospital-assistant-kicker">Assistente documental local</span><h2 id="documentAssistantTitle" class="offcanvas-title">Busca Inteligente</h2></div><button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button></div>
      <div class="offcanvas-body"><div class="hospital-assistant-trust"><app-icon name="security" size="17" decorative="true" /><span>Respostas baseadas somente em documentos que você pode consultar. O assistente não inventa conteúdo.</span></div><div id="assistantConversation" class="hospital-assistant-conversation" aria-live="polite"><article class="assistant-message assistant"><strong>Como posso ajudar?</strong><p>Descreva o que procura. Vou interpretar período, OCR, tipo e termos documentais.</p></article></div><div class="hospital-assistant-suggestions" aria-label="Sugestões"><button type="button">Mostre documentos sem OCR</button><button type="button">Quais documentos estão sem classificação?</button><button type="button">Localize arquivos enviados em junho de 2026</button><button type="button">Explique por que estes resultados apareceram</button></div><form id="documentAssistantForm" class="hospital-assistant-compose"><label for="documentAssistantQuestion">Pergunte sobre os documentos</label><textarea id="documentAssistantQuestion" rows="3" placeholder="Ex.: Encontre documentos de internação do paciente…" required></textarea><div><button id="btnClearAssistant" class="btn btn-light" type="button">Limpar conversa</button><button class="btn btn-primary" type="submit"><app-icon name="send" size="15" decorative="true" /> Perguntar</button></div></form></div>
    </div>
    <div id="hospitalAutocompletePortal" aria-live="polite"></div>


</div>

@section Scripts {
    <script src="~/js/hospital-documents.js" asp-append-version="true"></script>
    <script src="~/js/hospital-document-assistant.js" asp-append-version="true"></script>
}
