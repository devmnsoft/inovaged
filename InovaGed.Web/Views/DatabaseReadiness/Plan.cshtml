@model InovaGed.Application.SystemHealth.Migrations.DatabaseMigrationPlan
<div class="atlas-table-shell"><div class="table-responsive"><table class="table atlas-table align-middle mb-0"><thead><tr><th>Área</th><th>Migration</th><th>Descrição</th><th>Status</th><th>Checksum</th><th>Aplicada em</th><th>Erro anterior</th><th>Ações</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Area</td><td><code>@item.Name</code></td><td>@item.Description</td><td><span class="badge @(item.Applied?"bg-success":item.FailedBefore?"bg-danger":"bg-warning text-dark")">@(item.Applied?"Aplicada":item.FailedBefore?"Falha":"Pendente")</span></td><td><code title="@item.ChecksumSha256">@(item.ChecksumSha256?[..Math.Min(12,item.ChecksumSha256.Length)]??"—")</code></td><td>@(item.AppliedAt?.ToLocalTime().ToString("g")??"—")</td><td>@(item.LastError??"—")</td><td>@if(!item.Applied){<form method="post" action="/DatabaseReadiness/ApplyOne">@Html.AntiForgeryToken()<input type="hidden" name="migrationName" value="@item.Name"/><button class="btn btn-sm btn-outline-danger">Aplicar</button></form>}</td></tr>}</tbody></table></div></div>
