@using InovaGed.Application.Contracts.FiscalPortal
@model FiscalPortalPublicationDetails
@{Layout=null;var p=Model.Publication;var f=Model.Fiscalization;}
<!doctype html><html lang="pt-br"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Portal do Fiscal</title><link rel="stylesheet" href="~/css/fiscal-portal.css"/></head><body class="fp-external"><main class="fp-shell"><section class="fp-hero"><div><span>@p.PublicationNumber · COMPETÊNCIA @f.Period.CompetenceMonth.ToString("MM/yyyy")</span><h1>Portal do Fiscal</h1><p>Confira a medição da competência, evidências, glosas e registre o aceite de forma segura.</p></div><span class="fp-badge @p.Status">@p.Status</span></section><nav class="fp-tabs"><a asp-action="Dashboard" asp-route-publicationId="@p.Id">Resumo</a><a asp-action="SyntheticReport" asp-route-publicationId="@p.Id">Relatório sintético</a><a asp-action="AnalyticalReport" asp-route-publicationId="@p.Id">Relatório analítico</a><a asp-action="Evidences" asp-route-publicationId="@p.Id">Evidências</a><a asp-action="Glosas" asp-route-publicationId="@p.Id">Glosas</a><a asp-action="Accept" asp-route-publicationId="@p.Id">Manifestação</a><a asp-action="Receipt" asp-route-publicationId="@p.Id">Comprovante</a></nav><section class="fp-grid"><article class="fp-kpi"><small>Competência</small><strong>@f.Period.CompetenceMonth.ToString("MM/yyyy")</strong></article><article class="fp-kpi"><small>Status</small><strong>@p.Status</strong></article><article class="fp-kpi"><small>Valor medido</small><strong>@f.Period.TotalMeasuredAmount.ToString("C")</strong></article><article class="fp-kpi"><small>Valor aprovado</small><strong>@f.Period.TotalApprovedAmount.ToString("C")</strong></article><article class="fp-kpi"><small>Valor glosado</small><strong>@f.Period.TotalGlossedAmount.ToString("C")</strong></article><article class="fp-kpi"><small>Itens medidos</small><strong>@f.Items.Count</strong></article><article class="fp-kpi"><small>Itens com glosa</small><strong>@f.Glosas.Count</strong></article><article class="fp-kpi"><small>Evidências disponíveis</small><strong>@f.Evidences.Count</strong></article><article class="fp-kpi"><small>Assinatura/aceite</small><strong>@(Model.Signature is null?"Pendente":"Registrado")</strong></article></section><section class="fp-card"><h2>Revisão fiscal</h2><p>Revise os relatórios e evidências antes de registrar o aceite.</p><div class="fp-actions">@if(p.Status is "PUBLISHED" or "VIEWED"){<a class="fp-btn primary" asp-action="Accept" asp-route-publicationId="@p.Id">Registrar manifestação</a><a class="fp-btn danger" asp-action="Reject" asp-route-publicationId="@p.Id">Rejeitar ou pedir correção</a>}@if(p.Status=="ACCEPTED"){<a class="fp-btn primary" asp-action="Receipt" asp-route-publicationId="@p.Id">Abrir comprovante</a>}</div></section></main></body></html>
