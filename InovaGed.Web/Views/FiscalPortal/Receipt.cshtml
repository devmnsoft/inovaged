@model InovaGed.Application.Contracts.FiscalPortal.FiscalPortalPublicationDetails
@{Layout=null;var p=Model.Publication;var f=Model.Fiscalization.Period;var s=Model.Signature;}
<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Comprovante @p.PublicationNumber</title><link rel="stylesheet" href="~/css/fiscal-portal.css"/></head><body class="fp-external"><main class="fp-shell fp-receipt"><div class="fp-print-actions"><a class="fp-btn" asp-action="Dashboard" asp-route-publicationId="@p.Id">Voltar</a><button class="fp-btn primary" onclick="window.print()">Imprimir comprovante</button></div><header><div class="fp-seal">IG</div><div><small>INOVAGED · COMPROVANTE DE ACEITE</small><h1>@p.PublicationNumber</h1></div><span class="fp-badge @p.Status">@p.Status</span></header>@if(s is null){<section class="fp-alert">O comprovante final ficará disponível após a assinatura do aceite.</section>}else{<section class="fp-receipt-grid"><div><small>Competência</small><b>@f.CompetenceMonth.ToString("MM/yyyy")</b></div><div><small>Contrato</small><b>@(f.ContractNumber??"Não informado")</b></div><div><small>Contratante</small><b>@(f.ContractingUnit??"Não informado")</b></div><div><small>Contratada</small><b>@(f.ContractorName??"Não informada")</b></div><div><small>Fiscal</small><b>@s.SignerName · @s.SignerEmail</b></div><div><small>Data/hora do aceite</small><b>@s.SignedAt.ToString("dd/MM/yyyy HH:mm:ss zzz")</b></div><div><small>IP registrado</small><b>@s.IpAddress</b></div><div><small>Identificação</small><b>@s.SignatureType · @s.ValidationStatus</b></div></section><section class="fp-grid"><article class="fp-kpi"><small>Valor medido</small><strong>@f.TotalMeasuredAmount.ToString("C")</strong></article><article class="fp-kpi"><small>Valor aprovado</small><strong>@f.TotalApprovedAmount.ToString("C")</strong></article><article class="fp-kpi"><small>Valor glosado</small><strong>@f.TotalGlossedAmount.ToString("C")</strong></article></section><section class="fp-statement"><h2>Declaração de aceite</h2><p>Declaro que revisei a medição, os relatórios e as evidências desta competência, registrando meu aceite nos termos apresentados.</p><small>HASH SHA-256</small><code>@s.SignedHashSha256</code></section><footer>Verificação interna: @Url.Action("Receipt","FiscalPortal",new{publicationId=p.Id},Context.Request.Scheme)</footer>}</main></body></html>
