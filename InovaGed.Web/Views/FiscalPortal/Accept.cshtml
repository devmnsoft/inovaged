@model InovaGed.Application.Contracts.FiscalPortal.FiscalPortalPublicationDetails
@{Layout=null;}
<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Assinar aceite</title><link rel="stylesheet" href="~/css/fiscal-portal.css"/></head><body class="fp-external"><main class="fp-shell"><a class="fp-back" asp-action="Dashboard" asp-route-publicationId="@Model.Publication.Id">← Voltar ao portal</a><section class="fp-hero"><div><span>ASSINATURA ELETRÔNICA</span><h1>Registrar aceite</h1><p>O aceite eletrônico gera hash, trilha de auditoria e comprovante de assinatura.</p></div></section>@if(Model.Publication.Status is "PUBLISHED" or "VIEWED"){<form method="post" asp-action="SignElectronic" asp-route-publicationId="@Model.Publication.Id" class="fp-card fp-form"><label>Nome do fiscal<input name="signerName" value="@Model.Publication.FiscalName" required/></label><label>E-mail<input name="signerEmail" value="@Model.Publication.FiscalEmail" type="email" required/></label><label>Documento/CPF<input name="signerDocument" autocomplete="off"/></label><label class="wide">Observação<textarea name="notes"></textarea></label><label class="wide fp-declaration"><input type="checkbox" name="declarationAccepted" value="true" required/> Declaro que revisei a medição, os relatórios e as evidências desta competência, registrando meu aceite nos termos apresentados.</label><button class="fp-btn primary">Assinar aceite eletrônico</button><button class="fp-btn" type="button" disabled title="Requer componente criptográfico homologado">Assinar com certificado ICP-Brasil — requer integração</button></form>}else{<section class="fp-alert">Esta publicação não está disponível para nova assinatura.</section>}</main></body></html>
