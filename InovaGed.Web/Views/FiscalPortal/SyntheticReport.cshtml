@model InovaGed.Application.Contracts.FiscalPortal.FiscalPortalPublicationDetails
@{Layout=null;}
<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Relatório sintético</title><link rel="stylesheet" href="~/css/fiscal-portal.css"/></head><body class="fp-external"><main class="fp-shell"><a class="fp-back" asp-action="Dashboard" asp-route-publicationId="@Model.Publication.Id">← Voltar ao portal</a><section class="fp-card"><h1>Relatório sintético</h1><table class="fp-table"><thead><tr><th>Serviço</th><th>Quantidade</th><th>UST</th><th>Medido</th><th>Glosado</th><th>Aprovado</th></tr></thead><tbody>@foreach(var g in Model.Fiscalization.Items.GroupBy(x=>x.ServiceName)){<tr><td>@g.Key</td><td>@g.Sum(x=>x.MeasuredQuantity)</td><td>@g.Sum(x=>x.MeasuredUst)</td><td>@g.Sum(x=>x.MeasuredAmount).ToString("C")</td><td>@g.Sum(x=>x.GlossedAmount).ToString("C")</td><td>@g.Sum(x=>x.ApprovedAmount).ToString("C")</td></tr>}</tbody></table></section></main></body></html>
