@model InovaGed.Application.Contracts.FiscalPortal.FiscalPortalPublicationDetails
@{Layout=null;}
<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Glosas</title><link rel="stylesheet" href="~/css/fiscal-portal.css"/></head><body class="fp-external"><main class="fp-shell"><a class="fp-back" asp-action="Dashboard" asp-route-publicationId="@Model.Publication.Id">← Voltar ao portal</a><section class="fp-card"><h1>Glosas e respostas</h1>@foreach(var x in Model.Fiscalization.Glosas){<article class="fp-evidence"><span class="fp-badge @x.Status">@x.Status</span><h3>@x.GlosaType · @x.GlossedAmount.ToString("C")</h3><p>@x.Reason</p>@if(x.ContractorResponse is not null){<p><b>Resposta:</b> @x.ContractorResponse</p>}@if(x.ResolutionNotes is not null){<p><b>Decisão:</b> @x.ResolutionNotes</p>}</article>}@if(Model.Fiscalization.Glosas.Count==0){<p>Não há glosas registradas.</p>}</section></main></body></html>
