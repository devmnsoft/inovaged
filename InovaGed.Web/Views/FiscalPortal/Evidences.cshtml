@model InovaGed.Application.Contracts.FiscalPortal.FiscalPortalPublicationDetails
@{Layout=null;}
<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Evidências</title><link rel="stylesheet" href="~/css/fiscal-portal.css"/></head><body class="fp-external"><main class="fp-shell"><a class="fp-back" asp-action="Dashboard" asp-route-publicationId="@Model.Publication.Id">← Voltar ao portal</a><section class="fp-card"><h1>Evidências disponíveis</h1>@foreach(var x in Model.Fiscalization.Evidences){<article class="fp-evidence"><span class="fp-badge">@x.EvidenceType</span><h3>@x.Title</h3><p>@x.Description</p>@if(!string.IsNullOrWhiteSpace(x.ExternalUrl)){<a class="fp-btn" href="@x.ExternalUrl" target="_blank" rel="noopener noreferrer">Abrir evidência</a>}<small>Anexada em @x.AttachedAt.ToString("dd/MM/yyyy HH:mm")</small></article>}@if(Model.Fiscalization.Evidences.Count==0){<p>Nenhuma evidência foi disponibilizada nesta competência.</p>}</section></main></body></html>
