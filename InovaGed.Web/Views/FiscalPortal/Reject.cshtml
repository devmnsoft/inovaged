@model InovaGed.Application.Contracts.FiscalPortal.FiscalPortalPublicationDetails
@{Layout=null;}
<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Manifestação fiscal</title><link rel="stylesheet" href="~/css/fiscal-portal.css"/></head><body class="fp-external"><main class="fp-shell"><a class="fp-back" asp-action="Dashboard" asp-route-publicationId="@Model.Publication.Id">← Voltar ao portal</a><section class="fp-hero"><div><span>MANIFESTAÇÃO</span><h1>Rejeitar ou solicitar correção</h1><p>A rejeição reabre a competência para análise e correção pela equipe responsável.</p></div></section><form method="post" class="fp-card fp-form"><label>Motivo<input name="reason" required/></label><label>Item relacionado<select name="relatedItem"><option value="">Competência inteira</option>@foreach(var x in Model.Fiscalization.Items){<option value="@x.Id">@x.ServiceName</option>}</select></label><label>Nome<input name="name" value="@Model.Publication.FiscalName"/></label><label>E-mail<input name="email" value="@Model.Publication.FiscalEmail" type="email"/></label><label class="wide">Observação detalhada<textarea name="details" required></textarea></label><div class="fp-actions"><button class="fp-btn danger" formaction="@Url.Action("Reject",new{publicationId=Model.Publication.Id})">Rejeitar aceite</button><button class="fp-btn" formaction="@Url.Action("RequestCorrection",new{publicationId=Model.Publication.Id})">Solicitar correção</button></div></form></main></body></html>
