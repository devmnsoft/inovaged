@model InovaGed.Application.Contracts.FiscalPortal.FiscalPortalPublicationDetails
@{Layout=null;}
<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Relatório analítico</title><link rel="stylesheet" href="~/css/fiscal-portal.css"/></head><body class="fp-external"><main class="fp-shell"><a class="fp-back" asp-action="Dashboard" asp-route-publicationId="@Model.Publication.Id">← Voltar ao portal</a><section class="fp-card"><h1>Relatório analítico</h1><table class="fp-table"><thead><tr><th>Serviço / origem</th><th>Quantidade</th><th>Medido</th><th>Glosado</th><th>Aprovado</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.Fiscalization.Items){<tr><td><b>@x.ServiceName</b><br/><small>@x.SourceType · @x.SourceId</small></td><td>@x.MeasuredQuantity @x.Unit</td><td>@x.MeasuredAmount.ToString("C")</td><td>@x.GlossedAmount.ToString("C")</td><td>@x.ApprovedAmount.ToString("C")</td><td><span class="fp-badge">@x.Status</span></td></tr>}</tbody></table></section></main></body></html>
