@model IReadOnlyList<InovaGed.Application.PhysicalArchive.WorkOrders.ArchiveWorkOrderListItem>
@{ViewData["Title"]="Ordens de Serviço do Acervo";dynamic s=ViewBag.Sla;}<link rel="stylesheet" href="~/css/archive-work-orders.css"/><header class="wo-hero"><div><h1>Ordens de Serviço do Acervo</h1><p>Controle a execução das atividades físicas do acervo, com responsáveis, prazos, evidências e rastreabilidade.</p></div><div><a class="btn btn-light" asp-action="Sla">Painel SLA</a> <a class="btn btn-primary" asp-action="Create">+ Nova OS</a></div></header><div class="wo-kpis"><div><b>@s.Open</b><span>Abertas</span></div><div><b>@s.InProgress</b><span>Em andamento</span></div><div class="danger"><b>@s.Overdue</b><span>Atrasadas</span></div><div><b>@s.Critical</b><span>Críticas</span></div><div><b>@s.WaitingValidation</b><span>Aguardando validação</span></div><div><b>@s.CompletedThisMonth</b><span>Concluídas no mês</span></div></div><form class="wo-filter"><select name="status"><option value="">Todos os status</option><option>OPEN</option><option>ASSIGNED</option><option>IN_PROGRESS</option><option>CLOSED</option></select><select name="priority"><option value="">Prioridade</option><option>CRITICAL</option><option>HIGH</option><option>MEDIUM</option><option>LOW</option></select><input name="controlNumber" placeholder="Número de controle"/><input name="location" placeholder="Localização"/><button>Filtrar</button><a asp-action="Export">CSV</a></form><div class="wo-table"><table><thead><tr><th>Número</th><th>Tipo / Título</th><th>Prioridade</th><th>Status</th><th>Vencimento</th><th>Origem</th><th></th></tr></thead><tbody>@foreach(var x in Model){var late=x.DueAt<DateTimeOffset.Now&&x.Status is not "CLOSED" and not "CANCELLED";<tr class="@(late?"late":"")"><td><strong>@x.OrderNumber</strong><small>@x.ControlNumber</small></td><td><small>@x.OrderType</small><br/>@x.Title</td><td><span class="badge p-@x.Priority.ToLower()">@x.Priority</span></td><td><span class="badge status">@x.Status</span></td><td>@(x.DueAt?.ToLocalTime().ToString("g")??"Sem prazo")</td><td>@x.SourceType</td><td><a asp-action="Details" asp-route-id="@x.Id">Abrir →</a></td></tr>}</tbody></table></div>
