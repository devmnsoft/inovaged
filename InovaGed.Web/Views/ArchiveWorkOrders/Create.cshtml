@model InovaGed.Web.Controllers.ArchiveWorkOrderCreateInput
@{ViewData["Title"]="Nova ordem de serviço";}<link rel="stylesheet" href="~/css/archive-work-orders.css"/><div class="wo-form"><a asp-action="Index">← Voltar</a><h1>Nova ordem de serviço</h1><p>Transforme alertas e divergências em atividades executáveis pela equipe do acervo.</p><form method="post">@Html.AntiForgeryToken()<label>Título<input asp-for="Title" required/></label><label>Descrição<textarea asp-for="Description"></textarea></label><div class="grid"><label>Tipo<select asp-for="OrderType"><option value="PRINT_LABEL">Imprimir etiqueta</option><option value="REPLACE_LABEL">Substituir etiqueta</option><option value="CHECK_LOCATION">Conferir localização</option><option value="MOVE_BOX">Movimentar caixa</option><option value="BOX_CONFERENCE">Conferir caixa</option><option value="DOCUMENT_CONFERENCE">Conferir documento</option></select></label><label>Prioridade<select asp-for="Priority"><option>LOW</option><option selected>MEDIUM</option><option>HIGH</option><option>CRITICAL</option></select></label><label>Número de controle<input asp-for="ControlNumber"/></label><label>Prazo manual<input asp-for="DueAt" type="datetime-local"/></label><label>Local esperado<input asp-for="LocationExpected"/></label><label>Local encontrado<input asp-for="LocationFound"/></label><label>Local alvo<input asp-for="LocationTarget"/></label><label>Responsável (UUID)<input asp-for="AssignedTo"/></label></div><button class="btn btn-primary btn-lg">Criar OS e tarefas</button></form></div>
