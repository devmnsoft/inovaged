@model IReadOnlyList<InovaGed.Application.PhysicalArchive.WorkOrders.ArchiveWorkOrderSlaItem>
@{ViewData["Title"]="SLA das Ordens do Acervo";dynamic s=ViewBag.Summary;}<link rel="stylesheet" href="~/css/archive-work-orders.css"/><header class="wo-hero"><div><a asp-action="Index">← Ordens</a><h1>SLA e capacidade operacional</h1><p>Priorize vencimentos críticos e acompanhe o tempo de conclusão.</p></div></header><div class="wo-kpis"><div><b>@s.Overdue</b><span>Atrasadas</span></div><div><b>@Math.Round(s.AverageCompletionHours,1)h</b><span>SLA médio</span></div><div><b>@s.ActiveOperators</b><span>Operadores ativos</span></div></div><section class="wo-form"><h2>Ordens fora do prazo</h2>@foreach(var x in Model){<p><a asp-action="Details" asp-route-id="@x.Id"><b>@x.OrderNumber</b> · @x.Title</a> <span class="badge p-@x.Priority.ToLower()">@x.Priority</span> — atrasada @Math.Round(x.OverdueHours,1)h</p>}</section>
