@model InovaGed.Application.PhysicalArchive.WorkOrders.ArchiveWorkOrderDetails
@{ViewData["Title"]=Model.Order.OrderNumber;var late=Model.Order.DueAt<DateTimeOffset.Now&&Model.Order.Status is not "CLOSED" and not "CANCELLED";}<link rel="stylesheet" href="~/css/archive-work-orders.css"/><header class="wo-hero"><div><a asp-action="Index">← Ordens</a><h1>@Model.Order.OrderNumber · @Model.Order.Title</h1><p><span class="badge p-@Model.Order.Priority.ToLower()">@Model.Order.Priority</span> <span class="badge status">@Model.Order.Status</span></p></div><a class="btn btn-light" href="/LabelMobile?workOrderId=@Model.Order.Id">Abrir no mobile</a></header>@if(TempData["Error"] is string e){<div class="alert alert-danger">@e</div>}@if(late){<div class="alert alert-danger">Esta OS está atrasada em relação ao SLA definido.</div>}<div class="wo-details"><main><section><h2>Checklist operacional</h2>@foreach(var t in Model.Tasks){<article class="task done-@(t.Status=="COMPLETED")"><div><b>@t.DisplayOrder. @t.Title</b><small>@(t.RequiresScan?"Exige leitura de etiqueta · ":"")@(t.RequiresEvidence?"Exige evidência":"")</small></div>@if(t.Status!="COMPLETED"){<form action="/ArchiveWorkOrders/Task/@t.Id/Complete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="orderId" value="@Model.Order.Id"/><input name="notes" required placeholder="Resultado da execução"/>@if(t.RequiresScan){<label><input type="checkbox" name="scanConfirmed" value="true"/> QR lido</label>}@if(t.RequiresEvidence){<input name="labelEvidenceId" type="text" required placeholder="ID da evidência fotográfica"/><input name="evidenceDescription" placeholder="Descrição da foto"/>}<button>Concluir tarefa</button></form>}else{<span>✓ @t.CompletedAt?.ToLocalTime()</span>}</article>}</section><section><h2>Evidências</h2>@if(Model.Evidences.Count==0){<p>Anexe uma evidência para comprovar a execução física da tarefa.</p>}@foreach(var x in Model.Evidences){<div class="evidence">📷 @x.Description <small>@x.AttachedAt.ToLocalTime()</small></div>}</section><section><h2>Cadeia de custódia e eventos</h2><div class="timeline">@foreach(var x in Model.Events){<article><b>@x.EventTitle</b><p>@x.EventDescription</p><small>@x.PerformedAt.ToLocalTime() · @x.EventType</small></article>}</div></section></main><aside><section><h2>Dados gerais</h2><dl><dt>Objeto</dt><dd>@Model.SubjectType · @Model.SubjectId</dd><dt>Controle</dt><dd>@Model.Order.ControlNumber</dd><dt>Esperado</dt><dd>@Model.LocationExpected</dd><dt>Encontrado</dt><dd>@Model.LocationFound</dd><dt>Alvo</dt><dd>@Model.Order.LocationTarget</dd><dt>Prazo</dt><dd>@(Model.Order.DueAt?.ToLocalTime().ToString("g")??"Sem prazo")</dd></dl></section><section><h2>Ações</h2><form asp-action="Assign" asp-route-id="@Model.Order.Id" method="post">@Html.AntiForgeryToken()<input name="assignedTo" required placeholder="UUID do responsável"/><input name="dueAt" type="datetime-local"/><button>Atribuir</button></form><form asp-action="Start" asp-route-id="@Model.Order.Id" method="post">@Html.AntiForgeryToken()<button>Iniciar execução</button></form><form asp-action="Complete" asp-route-id="@Model.Order.Id" method="post">@Html.AntiForgeryToken()<input name="notes" required placeholder="Notas finais"/><button>Finalizar execução</button></form><form asp-action="Close" asp-route-id="@Model.Order.Id" method="post">@Html.AntiForgeryToken()<input name="notes" required placeholder="Conferência do supervisor"/><button class="success">Encerrar para auditoria</button></form><p>O encerramento registra a conclusão formal da atividade para auditoria.</p><form asp-action="Cancel" asp-route-id="@Model.Order.Id" method="post">@Html.AntiForgeryToken()<input name="reason" required placeholder="Motivo obrigatório"/><button class="danger">Cancelar</button></form></section></aside></div>
