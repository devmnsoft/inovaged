@model InovaGed.Application.Ged.Dashboard.GedDashboardVm
@{
  ViewData["Title"] = "Visão Geral do InovaGED";
    ViewData["Subtitle"] = "Acompanhe documentos, acervo físico, etiquetas, retenção, incidentes e saúde operacional em um único painel.";
    ViewData["Icon"] = "dashboard";
    ViewData["WorkspaceVariant"] = "full";
  var vm = Model ?? new InovaGed.Application.Ged.Dashboard.GedDashboardVm { PartialFailure = true };
  var recentLoans = vm.RecentLoanRequests ?? new List<InovaGed.Application.Ged.Dashboard.RecentLoanRequestDto>();
  var recentAudit = vm.RecentAuditEvents ?? new List<InovaGed.Application.Ged.Dashboard.RecentAuditEventDto>();
  var dashboardCards = new List<InovaGed.Application.Ged.Dashboard.DashboardLinkVm>
  {
      new("Total de documentos ativos", vm.ActiveDocuments, "bi-files", "text-primary", "/Ged"),
      new("Documentos sem classificação", vm.UnclassifiedDocuments, "bi-tags", "text-warning", "/Ged"),
      new("Documentos confidenciais", vm.ConfidentialDocuments, "bi-shield-lock", "text-danger", "/Ged"),
      new("OCR pendente", vm.OcrPending, "bi-hourglass-split", "text-secondary", "/Ocr"),
      new("OCR processando", vm.OcrProcessing, "bi-cpu", "text-info", "/Ocr"),
      new("OCR com erro", vm.OcrError, "bi-exclamation-triangle", "text-danger", "/Ocr"),
      new("Solicitações pendentes", vm.LoanRequested, "bi-journal-arrow-up", "text-warning", "/Loans"),
      new("Empréstimos vencidos", vm.LoanOverdue, "bi-calendar2-x", "text-danger", "/Loans/Overdue"),
      new("Movimentações hoje", vm.FolderMovesToday, "bi-arrow-left-right", "text-info", "/Ged/Folders"),
      new("Acessos negados 24h", vm.AccessDenied24h, "bi-shield-x", "text-danger", "/Audit/AccessDenied"),
      new("Usuários bloqueados", vm.LockedUsers, "bi-person-lock", "text-danger", "/Users"),
      new("Temporalidade vencida", vm.RetentionExpired, "bi-clock-history", "text-warning", "/Retention")
  };
  var operationalPending = new List<InovaGed.Application.Ged.Dashboard.DashboardLinkVm>
  {
      new("Documentos sem OCR", vm.OcrPending, "bi-file-earmark-text", "", "/Ocr"),
      new("Documentos sem classificação", vm.UnclassifiedDocuments, "bi-tags", "", "/Ged"),
      new("Etiquetas pendentes", null, "bi-printer", "", "/Labels/History"),
      new("Caixas sem localização", null, "bi-box-seam", "", "/Physical/Boxes"),
      new("Empréstimos vencidos", vm.LoanOverdue, "bi-calendar-x", "", "/Loans/Overdue"),
      new("Tarefas atrasadas", null, "bi-list-check", "", "/SmartWorkflow"),
      new("Alertas de governança", null, "bi-shield-exclamation", "", "/Governance/Alerts"),
      new("Medições pendentes", null, "bi-receipt", "", "/ContractMeasurement"),
      new("Publicações aguardando aceite", null, "bi-send", "", "/FiscalPortal")
  };
}
<link rel="stylesheet" href="~/css/operational-dashboard.css" asp-append-version="true" />
<div class="atlas-page mb-4">
    <partial name="Atlas/_AtlasPageHero" />
</div>
<div class="container-fluid py-3">
  <partial name="Atlas/_GlobalQuickActions" />
  <section class="operational-pending" aria-labelledby="operational-pending-title">
    <h2 id="operational-pending-title">Pendências Operacionais</h2>
    <div class="operational-pending__grid">
      @foreach (var item in operationalPending)
      {
        <a href="@item.Url"><i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Title</span>@if (item.Value.HasValue) { <strong>@item.Value.Value</strong> } else { <small>Abrir</small> }</a>
      }
    </div>
  </section>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="mb-1">Painel Operacional do GED</h2>
      <p class="text-muted mb-0">Visão consolidada de documentos, OCR, solicitações e auditoria</p>
    </div>
    <a class="btn btn-outline-primary" asp-controller="GedDashboard" asp-action="Index"><i class="bi bi-arrow-clockwise"></i> Atualizar agora</a>
  </div>

  @if (vm.PartialFailure)
  {
    <div class="alert alert-warning py-2">Alguns indicadores não puderam ser carregados. Verifique os logs técnicos.</div>
  }

  <div class="row g-3 mb-4">
    @foreach (var card in dashboardCards) {
      <div class="col-12 col-sm-6 col-xl-3"><a class="text-decoration-none" href="@card.Url"><div class="card atlas-card h-100 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between"><small class="text-muted">@card.Title</small><i class="bi @card.Icon @card.CssClass"></i></div><div class="display-6 fw-bold">@card.Value</div></div></div></a></div>
    }
  </div>

  <div class="row g-3">
    <div class="col-12 col-xl-6">
      <div class="card atlas-card h-100 shadow-sm">
        <div class="card-header"><strong>Solicitações de empréstimo recentes</strong></div>
        <div class="table-responsive">
          <table class="table atlas-table table-sm mb-0">
            <thead><tr><th>Data</th><th>Solicitante</th><th>Documento</th><th>Status</th></tr></thead>
            <tbody>
            @if (recentLoans.Count == 0)
            {
              <tr><td colspan="4" class="text-muted">Sem registros recentes.</td></tr>
            }
            else
            {
              foreach (var item in recentLoans)
              {
                <tr>
                  <td>@(item.RequestedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                  <td>@(item.Requester ?? "-")</td>
                  <td>@(item.Document ?? "-")</td>
                  <td>@(item.Status ?? "-")</td>
                </tr>
              }
            }
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-12 col-xl-6">
      <div class="card atlas-card h-100 shadow-sm">
        <div class="card-header"><strong>Eventos de auditoria recentes</strong></div>
        <div class="table-responsive">
          <table class="table atlas-table table-sm mb-0">
            <thead><tr><th>Data</th><th>Ação</th><th>Entidade</th><th>Usuário</th></tr></thead>
            <tbody>
            @if (recentAudit.Count == 0)
            {
              <tr><td colspan="4" class="text-muted">Sem registros recentes.</td></tr>
            }
            else
            {
              foreach (var item in recentAudit)
              {
                <tr>
                  <td>@(item.EventTime?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                  <td>@(item.Action ?? "-")</td>
                  <td>@(item.EntityName ?? "-")</td>
                  <td>@(item.UserName ?? "-")</td>
                </tr>
              }
            }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
