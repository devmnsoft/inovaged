@model InovaGed.Application.Ged.Protocols.ProtocoloCentralPage
@{
    ViewData["WorkspaceVariant"] = "wide";
    ViewData["Title"] = "Central de tramitação";
    ViewData["Subtitle"] = "Receber, tramitar, devolver e acompanhar a custódia.";
    string LabelProcesso(string? status) => (status ?? "").ToUpperInvariant() switch
    {
        "RASCUNHO" => "Rascunho",
        "ABERTO" => "Aberto",
        "EM_TRAMITACAO" => "Em tramitação",
        "DEFERIDO" => "Deferido",
        "INDEFERIDO" => "Indeferido",
        "FINALIZADO" => "Finalizado",
        "ARQUIVADO" => "Arquivado",
        "CANCELADO" => "Cancelado",
        _ => status ?? "-"
    };
    string VisaoAtual = Model.Query.Visao ?? "a_receber";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-1">Central de tramitação</h1>
        <p class="text-muted mb-0">A custódia só muda quando o destino recebe. Encaminhar não confirma o recebimento.</p>
    </div>
    <a asp-action="Novo" class="btn btn-primary">Novo protocolo</a>
</div>
@if (TempData["ok"] != null) { <div class="alert alert-success" role="status">@TempData["ok"]</div> }
@if (TempData["erro"] != null) { <div class="alert alert-danger" role="alert">@TempData["erro"]</div> }
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
@if (Model.SemVinculoSetor) { <div class="alert alert-warning" role="status">Seu usuário não tem setor ativo. A visão Geral só aparece para quem já tem acesso administrativo.</div> }

<div class="d-flex flex-wrap gap-2 mb-3" role="tablist" aria-label="Visões da fila">
    @{
        var visoes = new (string Id, string Nome, int Total)[]
        {
            ("a_receber", "A receber", Model.Counts.AReceber),
            ("a_tramitar", "Sob minha responsabilidade", Model.Counts.ATramitar),
            ("enviados", "Enviados", Model.Counts.Enviados),
            ("devolucoes", "Devoluções pendentes", Model.Counts.Devolucoes),
            ("historico", "Histórico", 0),
            ("geral", "Geral", 0)
        };
    }
    @foreach (var v in visoes)
    {
        <a class="btn @(VisaoAtual == v.Id ? "btn-primary" : "btn-outline-secondary")" asp-action="Index" asp-route-visao="@v.Id" asp-route-q="@Model.Query.Q" asp-route-status="@Model.Query.Status">@v.Nome@(v.Total > 0 ? $" ({v.Total})" : "")</a>
    }
</div>

<details class="mb-3">
    <summary>Como usar</summary>
    <p class="small mb-0">Busque o documento ou o prontuário, selecione a linha e use Receber, Tramitar, Devolver, Histórico ou Estornar. F8 recebe, F9 tramita e F10 devolve o registro selecionado, e não disparam enquanto você digita em um campo. O lote mostra impedimentos antes da confirmação. Campos clínicos não são editados nesta tela.</p>
</details>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <input type="hidden" name="visao" value="@VisaoAtual" />
            <div class="col-md-3"><label class="form-label" for="q">Protocolo, interessado ou assunto</label><input id="q" name="q" value="@Model.Query.Q" class="form-control" /></div>
            <div class="col-md-2"><label class="form-label" for="tipo">Tipo</label><input id="tipo" name="tipo" value="@Model.Query.Tipo" class="form-control" /></div>
            <div class="col-md-2"><label class="form-label" for="status">Situação do processo</label>
                <select id="status" name="status" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var s in new[] { "RASCUNHO", "ABERTO", "EM_TRAMITACAO", "DEFERIDO", "INDEFERIDO", "FINALIZADO", "ARQUIVADO", "CANCELADO" })
                    {
                        <option value="@s" selected="@(Model.Query.Status == s)">@LabelProcesso(s)</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><label class="form-label" for="setorId">Setor</label>
                <select id="setorId" name="setorId" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var s in Model.Setores)
                    {
                        <option value="@s.Id" selected="@(Model.Query.SetorId == s.Id)">@s.Rotulo</option>
                    }
                </select>
            </div>
            <div class="col-md-2"><label class="form-label" for="de">De</label><input id="de" type="date" name="de" value="@Model.Query.De?.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="col-md-2"><label class="form-label" for="ate">Até</label><input id="ate" type="date" name="ate" value="@Model.Query.Ate?.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="col-md-3 form-check mt-4"><input class="form-check-input" type="checkbox" name="prazoVencido" value="true" id="prazo" checked="@Model.Query.PrazoVencido" /><label class="form-check-label" for="prazo">Somente prazo vencido</label></div>
            <div class="col-md-2 mt-4"><button class="btn btn-outline-primary w-100">Filtrar</button></div>
            <div class="col-md-2 mt-4"><a class="btn btn-outline-secondary w-100" asp-action="Exportar" asp-route-visao="@VisaoAtual" asp-route-q="@Model.Query.Q" asp-route-status="@Model.Query.Status" asp-route-tipo="@Model.Query.Tipo" asp-route-setorId="@Model.Query.SetorId" asp-route-page="@Model.Page">Exportar página</a></div>
        </form>
    </div>
</div>

<form method="post" asp-action="Lote" id="lote">
    @Html.AntiForgeryToken()
    <input type="hidden" name="acao" id="lote-acao" value="receber" />
    <div class="d-flex flex-wrap gap-2 mb-2">
        <button class="btn btn-outline-success" type="submit" onclick="document.getElementById('lote-acao').value='receber'">Receber selecionados</button>
        <label class="mb-0">Destino <select name="destinoSetorId" class="form-select d-inline-block w-auto"><option value="">Selecione</option>@foreach (var s in Model.Setores){<option value="@s.Id">@s.Rotulo</option>}</select></label>
        <input name="observacao" class="form-control w-auto" placeholder="Observação do lote" />
        <button class="btn btn-outline-primary" type="submit" onclick="document.getElementById('lote-acao').value='tramitar'">Tramitar selecionados</button>
        <button class="btn btn-outline-warning" type="submit" onclick="document.getElementById('lote-acao').value='devolver'">Devolver selecionados</button>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col"><span class="visually-hidden">Seleção</span></th>
                        <th scope="col">Documento / prontuário</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Interessado</th>
                        <th scope="col">Assunto</th>
                        <th scope="col">Observação</th>
                        <th scope="col">Movimentação</th>
                        <th scope="col">Setor</th>
                        <th scope="col">Responsável</th>
                        <th scope="col">Última movimentação</th>
                        <th scope="col">Prazo</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="11" class="text-center text-muted py-4">Nenhum registro nesta visão. Ajuste os filtros ou confira se a migration de custódia foi aplicada no ambiente de homologação.</td></tr>
                }
                else foreach (var i in Model.Rows)
                {
                    <tr class="@(Model.Selecionado?.Id == i.Id ? "table-active" : "")">
                        <td><input type="checkbox" name="ids" value="@i.Id" aria-label="Selecionar @i.Numero" /></td>
                        <td><a asp-action="Index" asp-route-visao="@VisaoAtual" asp-route-q="@Model.Query.Q" asp-route-status="@Model.Query.Status" asp-route-sel="@i.Id" asp-route-page="@Model.Page"><strong>@i.Numero</strong></a><div class="small text-muted">@(i.CodigoDocumental ?? "Sem código documental")</div></td>
                        <td>@i.Tipo</td>
                        <td>@i.Interessado</td>
                        <td>@i.Assunto</td>
                        <td>@i.Observacao</td>
                        <td><span class="badge text-bg-light border">@i.SituacaoLabel</span><div class="small">@LabelProcesso(i.Status)</div></td>
                        <td>@i.Setor</td>
                        <td>@i.Responsavel</td>
                        <td>@(i.UltimaMovimentacao?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td>@(i.Prazo?.ToString("dd/MM/yyyy") ?? "—")@if (i.PrazoVencido){<div>Prazo vencido</div>}</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</form>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Paginação">
        @for (var p = 1; p <= Model.TotalPages; p++)
        {
            <a class="btn btn-sm @(p == Model.Page ? "btn-primary" : "btn-outline-secondary")" asp-action="Index" asp-route-page="@p" asp-route-visao="@VisaoAtual" asp-route-q="@Model.Query.Q" asp-route-status="@Model.Query.Status" asp-route-tipo="@Model.Query.Tipo" asp-route-setorId="@Model.Query.SetorId" asp-route-prazoVencido="@Model.Query.PrazoVencido">@p</a>
        }
    </nav>
}

@if (Model.Selecionado is { } sel)
{
    <section class="card border-0 shadow-sm mt-3" aria-label="Registro selecionado">
        <div class="card-body">
            <h2 class="h5">@sel.Numero — @sel.Assunto</h2>
            <p>Processo @LabelProcesso(sel.Status). Movimentação @sel.SituacaoLabel.</p>
            <dl class="row small">
                <dt class="col-sm-3">Origem</dt><dd class="col-sm-9">@sel.SetorOrigem</dd>
                <dt class="col-sm-3">Destino</dt><dd class="col-sm-9">@sel.SetorDestino</dd>
                <dt class="col-sm-3">Remetente</dt><dd class="col-sm-9">@sel.Remetente</dd>
                <dt class="col-sm-3">Destinatário</dt><dd class="col-sm-9">@sel.Destinatario</dd>
                <dt class="col-sm-3">Enviado</dt><dd class="col-sm-9">@(sel.EnviadoEm?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
                <dt class="col-sm-3">Recebido</dt><dd class="col-sm-9">@(sel.RecebidoEm?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
            </dl>
            @if (sel.ExibirCamposHospitalares) { <p class="small">Interessado/paciente: @sel.Interessado. Este dado é apenas consulta.</p> }
            <div class="d-flex flex-wrap gap-2">
                @if (sel.PodeReceber) { <form asp-action="Receber" method="post" id="acao-receber">@Html.AntiForgeryToken()<input type="hidden" name="protocoloId" value="@sel.Id" /><input type="hidden" name="movimentoId" value="@sel.MovimentoId" /><button class="btn btn-success">Receber</button></form> }
                @if (sel.PodeConfirmarRetorno) { <form asp-action="ConfirmarRetorno" method="post">@Html.AntiForgeryToken()<input type="hidden" name="protocoloId" value="@sel.Id" /><input type="hidden" name="movimentoId" value="@sel.MovimentoId" /><button class="btn btn-success">Confirmar retorno</button></form> }
                @if (sel.PodeDevolver) { <form asp-action="Devolver" method="post" id="acao-devolver" class="d-flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="protocoloId" value="@sel.Id" /><input name="observacao" class="form-control" placeholder="Observação da devolução" /><button class="btn btn-warning">Devolver</button></form> }
                @if (sel.PodeEstornar) { <form asp-action="Estornar" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="protocoloId" value="@sel.Id" /><input name="justificativa" class="form-control" placeholder="Justificativa do estorno" required /><button class="btn btn-outline-danger">Estornar última movimentação</button></form> }
                <a class="btn btn-outline-primary" id="acao-tramitar" asp-action="Details" asp-route-id="@sel.Id">Tramitar / histórico</a>
            </div>
            @if (sel.CustodiaFisica.Count > 0)
            {
                <h3 class="h6 mt-3">Custódia física</h3>
                <ul>@foreach (var f in sel.CustodiaFisica) { <li>@f.Origem — @f.Documento — @f.Localizacao — detentor @f.Detentor — situação @f.Situacao — previsão @(f.Previsao?.ToString("dd/MM/yyyy") ?? "—")</li> }</ul>
            }
        </div>
    </section>
}

<script>
document.addEventListener('keydown', function (e) {
    var alvo = e.target;
    if (alvo && (alvo.closest('input, textarea, select, [contenteditable="true"]'))) return;
    if (e.key === 'F8') { e.preventDefault(); document.querySelector('#acao-receber button')?.click(); }
    if (e.key === 'F9') { e.preventDefault(); document.getElementById('acao-tramitar')?.click(); }
    if (e.key === 'F10') { e.preventDefault(); document.querySelector('#acao-devolver button')?.click(); }
});
</script>
