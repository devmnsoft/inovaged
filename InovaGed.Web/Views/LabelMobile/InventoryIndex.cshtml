@model IEnumerable<dynamic>
@{ViewData["Title"]="Inventário em campo";}<link rel="stylesheet" href="~/css/label-mobile.css" /><div class="lm-shell" data-label-mobile><header class="lm-header"><h1>Inventário em campo</h1><span class="lm-badge" data-online-status></span></header><a class="lm-button primary" asp-action="InventoryNew">Iniciar inventário</a><div class="lm-list">@foreach(var x in Model){<a class="lm-row" asp-action="InventorySession" asp-route-id="@x.id"><strong>@x.title</strong><span>@x.expected_location</span><small>@x.total leituras · @x.status</small></a>}</div></div>@Html.AntiForgeryToken()<script src="~/js/label-mobile-offline.js"></script>
