@model InovaGed.Application.Labels.Tracking.LabelInventoryDetails
@{ViewData["Title"]=Model.Title;var divergent=Model.Items.Count(x=>x.Status=="DIVERGENT_LOCATION");var duplicated=Model.Items.Count(x=>x.Status=="DUPLICATED");}<link rel="stylesheet" href="~/css/label-mobile.css" /><div class="lm-shell" data-label-mobile data-inventory-id="@Model.Id"><header class="lm-header"><div><h1>@Model.Title</h1><small>@Model.ExpectedLocation</small></div><span class="lm-badge" data-online-status></span></header><div class="lm-stats"><span><b>@Model.Items.Count</b>Lidas</span><span><b data-pending-count>0</b>Pendentes</span><span><b>@divergent</b>Divergentes</span><span><b>@duplicated</b>Duplicadas</span></div><div class="lm-actions"><a class="lm-button primary" asp-action="Scanner" asp-route-inventorySessionId="@Model.Id" asp-route-expectedLocation="@Model.ExpectedLocation">Ler próxima etiqueta</a><label class="lm-button">Adicionar foto<input type="file" accept="image/jpeg,image/png,image/webp" capture="environment" data-evidence-file hidden /></label><button type="button" class="lm-button" data-sync-now>Sincronizar agora</button></div><h2>Últimas leituras</h2><div class="lm-list">@foreach(var i in Model.Items.Take(20)){<div class="lm-row"><strong>@(i.ControlNumber??"Não identificada")</strong><span>@i.FoundLocation</span><small class="status-@i.Status.ToLowerInvariant()">@i.Status</small></div>}</div>@if(Model.Status=="OPEN"){<form method="post" asp-action="CloseInventory" asp-route-id="@Model.Id" data-close-inventory>@Html.AntiForgeryToken()<label>Justificativa (obrigatória se houver divergências)<textarea name="justification"></textarea></label><button class="lm-button danger">Finalizar inventário</button></form>}</div>@Html.AntiForgeryToken()<script src="~/js/label-mobile-offline.js"></script>
