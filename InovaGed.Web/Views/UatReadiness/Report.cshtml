@model InovaGed.Application.Release.Uat.UatRunDetails
@{ViewData["Title"]="Relatório de homologação";var pct=Model.TotalCases==0?0:Math.Round(Model.PassedCases*100m/Model.TotalCases,1);}
<style>@@media print{header,nav,aside,.navbar,.sidebar,.no-print{display:none!important}main{margin:0!important}.report{box-shadow:none!important}}.report{max-width:1000px;margin:auto;background:#fff;padding:2rem}.summary{display:flex;gap:2rem;flex-wrap:wrap}</style>
<section class="report"><button class="btn btn-primary no-print" onclick="print()">Imprimir</button><h1>Relatório de Homologação</h1><dl><dt>Release</dt><dd>@Model.ReleaseVersion</dd><dt>Data da execução</dt><dd>@Model.StartedAt.ToString("g")</dd><dt>Responsável</dt><dd>@Model.StartedBy</dd></dl><div class="summary"><strong>Total: @Model.TotalCases</strong><strong>Aprovados: @Model.PassedCases</strong><strong>Reprovados: @Model.FailedCases</strong><strong>Bloqueados: @Model.BlockedCases</strong></div><h2>Casos e evidências</h2><table class="table"><thead><tr><th>Caso</th><th>Status</th><th>Resultado</th><th>Evidência</th><th>Incidente</th></tr></thead><tbody>@foreach(var x in Model.Results){<tr><td>@x.CaseCode — @x.Title</td><td>@x.Result</td><td>@x.ActualResult</td><td>@x.EvidenceNotes</td><td>@x.IncidentId</td></tr>}</tbody></table><h2>Conclusão</h2><p>@(Model.FailedCases+Model.BlockedCases>0?"A homologação possui pendências que devem ser resolvidas antes do Go-Live.":$"Execução concluída com {pct}% de aprovação.")</p></section>
