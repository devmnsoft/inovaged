@model InovaGed.Application.Release.Uat.UatRunDetails
@{ViewData["Title"]="Termo Técnico de Homologação";var pct=Model.TotalCases==0?0:Math.Round(Model.PassedCases*100m/Model.TotalCases,1);var critical=Model.Results.Any(x=>(x.Result=="FAILED"||x.Result=="BLOCKED")&&x.Priority=="CRITICAL");}
<style>@@media print{header,nav,aside,.navbar,.sidebar,.no-print{display:none!important}}.term{max-width:850px;margin:auto;padding:3rem;background:white}</style><section class="term"><button class="btn btn-primary no-print" onclick="print()">Imprimir</button><h1>Termo Técnico de Homologação</h1><p>O termo técnico consolida o resultado da homologação e apoia o aceite da release.</p><dl><dt>Sistema</dt><dd>InovaGED</dd><dt>Release</dt><dd>@Model.ReleaseVersion</dd><dt>Ambiente</dt><dd>@Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT")</dd><dt>Responsável</dt><dd>@Model.StartedBy</dd><dt>Percentual aprovado</dt><dd>@pct%</dd><dt>Pendências</dt><dd>@(Model.FailedCases+Model.BlockedCases)</dd></dl>@if(critical){<div class="alert alert-danger">Aceite não recomendado até resolução das pendências críticas.</div>}<h2>Declaração de aceite técnico</h2><p>Declaro que os resultados e pendências acima foram apresentados para avaliação técnica.</p><div style="margin-top:5rem;border-top:1px solid;width:45%">Assinatura</div><p>Data: ____/____/________</p></section>
