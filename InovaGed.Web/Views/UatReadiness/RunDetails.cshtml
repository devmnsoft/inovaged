@model InovaGed.Application.Release.Uat.UatRunDetails
@{ViewData["Title"]="Execução UAT";}
<h1>Execução de homologação</h1><p>@Model.PlanCode · iniciada em @Model.StartedAt.ToString("g") · <span class="badge bg-primary">@Model.Status</span></p><p>Casos reprovados ou bloqueados devem possuir justificativa e evidência.</p>
<div class="mb-3"><a class="btn btn-outline-primary" href="/UatReadiness/Report/@Model.Id">Relatório</a> <a class="btn btn-outline-secondary" href="/UatReadiness/AcceptanceTerm/@Model.Id">Termo técnico</a></div>
@if(Model.Results.Count==0){<div class="alert alert-info">Nenhum resultado registrado. Selecione um caso no plano para iniciar a validação.</div>}
@foreach(var x in Model.Results){<article class="card mb-3"><div class="card-body"><h2 class="h5">@x.CaseCode — @x.Title</h2><p><strong>Módulo:</strong> @x.ModuleCode · <strong>Status:</strong> @x.Result · <strong>Resultado obtido:</strong> @x.ActualResult</p><p><strong>Evidências:</strong> @x.EvidenceNotes · <strong>Incidente:</strong> @(x.IncidentId?.ToString()??"Não vinculado") @x.IncidentStatus</p><form method="post" action="/UatReadiness/Result" class="row g-2">@Html.AntiForgeryToken()<input type="hidden" name="runId" value="@Model.Id"><input type="hidden" name="testCaseId" value="@x.TestCaseId"><div class="col-md-2"><select name="result" class="form-select"><option>PENDING</option><option>PASSED</option><option>FAILED</option><option>BLOCKED</option><option>SKIPPED</option></select></div><div class="col-md-4"><input name="actualResult" class="form-control" placeholder="Resultado obtido / observação"></div><div class="col-md-3"><input name="evidenceNotes" class="form-control" placeholder="Evidência"></div><div class="col-md-2"><input name="incidentId" type="text" class="form-control" placeholder="ID incidente"></div><div class="col-md-1"><button class="btn btn-primary">Salvar</button></div></form></div></article>}
