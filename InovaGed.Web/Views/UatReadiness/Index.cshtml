@model InovaGed.Application.Release.Uat.UatSummary
@{
    ViewData["Title"] = "Homologação e Go-Live";
    ViewData["Subtitle"] = "Execute testes, registre evidências e acompanhe a prontidão da entrega.";
    ViewData["Icon"] = "clipboard-check";
}
<div class="atlas-page mb-4">
    <partial name="Atlas/_AtlasPageHero" />
</div>
<p class="mt-3">A homologação assistida organiza os testes necessários para validar a entrega antes do uso operacional.</p>
<div class="atlas-operation-grid"><div class="atlas-kpi-card"><span>Casos totais</span><strong>@Model.TotalCases</strong></div><div class="atlas-kpi-card"><span>Aprovados</span><strong>@Model.PassedCases</strong></div><div class="atlas-kpi-card"><span>Reprovados</span><strong>@Model.FailedCases</strong></div><div class="atlas-kpi-card"><span>Bloqueados</span><strong>@Model.BlockedCases</strong></div><div class="atlas-kpi-card"><span>Pendentes</span><strong>@Model.PendingCases</strong></div><div class="atlas-kpi-card"><span>Incidentes vinculados</span><strong>@Model.IncidentCount</strong></div><div class="atlas-kpi-card"><span>Evidências anexadas</span><strong>@Model.EvidenceCount</strong></div><div class="atlas-kpi-card"><span>Status da homologação</span><strong class="badge-uat">@Model.Status</strong></div></div>
<a class="btn btn-primary" href="/UatReadiness/Plans">Plano de testes</a> <a class="btn btn-outline-primary" href="/UatReadiness/GoLiveChecklist">Checklist de Go-Live</a>
