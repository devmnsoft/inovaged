@model InovaGed.Application.Labels.LabelTemplateEditCommand
@{var readOnly=(ViewBag.ReadOnly as bool?)==true;}
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<ul class="nav nav-tabs" role="tablist"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#general" type="button">Dados gerais</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#appearance" type="button">Aparência</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#fields" type="button">Campos</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#print" type="button">Impressão</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#preview" type="button">Prévia</button></li></ul>
<div class="tab-content p-4 border border-top-0 rounded-bottom bg-white"><div class="tab-pane fade show active" id="general"><div class="row g-3"><div class="col-md-7"><label asp-for="Name" class="form-label">Nome do modelo</label><input asp-for="Name" class="form-control" readonly="@readOnly"/></div><div class="col-md-5"><label asp-for="Code" class="form-label">Código interno</label><input asp-for="Code" class="form-control" readonly="@readOnly"/></div><div class="col-12"><label asp-for="Description" class="form-label">Descrição</label><textarea asp-for="Description" class="form-control" readonly="@readOnly"></textarea></div><div class="col-md-4"><label asp-for="SubjectType" class="form-label">Tipo de origem</label><select asp-for="SubjectType" class="form-select" disabled="@readOnly"><option value="BOX">Caixa</option><option value="DOCUMENT">Documento/Pasta</option></select></div><div class="col-md-8 d-flex gap-4 align-items-end"><label><input asp-for="IsActive"/> Ativo</label><label><input asp-for="SupportsBatch"/> Suporta lote</label><label><input asp-for="AllowsManualFields"/> Permite edição manual</label></div></div></div>
<div class="tab-pane fade" id="appearance"><div class="row g-3"><div class="col-12"><label asp-for="Config.HeaderText" class="form-label">Texto do cabeçalho</label><input asp-for="Config.HeaderText" class="form-control"/></div>@foreach(var color in new[]{("PrimaryColor","Cor primária"),("SecondaryColor","Cor secundária"),("BorderColor","Cor da borda"),("AccentColor","Cor de destaque"),("TextColor","Cor do texto")}){<div class="col-md"><label class="form-label">@color.Item2</label><input type="color" name="Config.@color.Item1" value="@(Model.Config.GetType().GetProperty(color.Item1)?.GetValue(Model.Config))" class="form-control form-control-color w-100"/></div>}<div class="col-12"><label asp-for="Config.LogoSvg" class="form-label">SVG da logo</label><textarea asp-for="Config.LogoSvg" rows="5" class="form-control font-monospace" placeholder="SVG sem scripts ou manipuladores de evento"></textarea><div class="form-text">SVG é validado antes de salvar. Conteúdo executável é rejeitado.</div></div></div></div>
<div class="tab-pane fade" id="fields"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Campo</th><th>Visível</th><th>Obrigatório</th><th>Editável</th><th>Nome exibido</th><th>Valor padrão</th><th>Ordem</th></tr></thead><tbody>@for(var i=0;i<Model.Fields.Count;i++){<tr><td><code>@Model.Fields[i].FieldKey</code><input type="hidden" asp-for="Fields[i].FieldKey"/><input type="hidden" asp-for="Fields[i].FieldType"/></td><td><input asp-for="Fields[i].IsVisible"/></td><td><input asp-for="Fields[i].IsRequired"/></td><td><input asp-for="Fields[i].IsEditable"/></td><td><input asp-for="Fields[i].FieldLabel" class="form-control"/></td><td><input asp-for="Fields[i].DefaultValue" class="form-control"/></td><td><input asp-for="Fields[i].DisplayOrder" class="form-control" style="width:6rem"/></td></tr>}</tbody></table></div></div>
<div class="tab-pane fade" id="print"><div class="row g-3"><div class="col-md-3"><label asp-for="Config.PageSize" class="form-label">Página</label><select asp-for="Config.PageSize" class="form-select"><option>A4</option></select></div><div class="col-md-3"><label asp-for="Config.LabelWidthMm" class="form-label">Largura (mm)</label><input asp-for="Config.LabelWidthMm" class="form-control"/></div><div class="col-md-3"><label asp-for="Config.LabelHeightMm" class="form-label">Altura (mm)</label><input asp-for="Config.LabelHeightMm" class="form-control"/></div><div class="col-md-3"><label asp-for="Config.LabelsPerPage" class="form-label">Por página</label><input asp-for="Config.LabelsPerPage" class="form-control"/></div><div class="col-md-3"><label asp-for="Config.Orientation" class="form-label">Orientação</label><select asp-for="Config.Orientation" class="form-select"><option value="PORTRAIT">Retrato</option><option value="LANDSCAPE">Paisagem</option></select></div>@foreach(var margin in new[]{("MarginTopMm","Superior"),("MarginRightMm","Direita"),("MarginBottomMm","Inferior"),("MarginLeftMm","Esquerda")}){<div class="col-md-2"><label class="form-label">Margem @margin.Item2</label><input name="Config.@margin.Item1" value="@(Model.Config.GetType().GetProperty(margin.Item1)?.GetValue(Model.Config))" class="form-control" type="number" step=".1" min="0"/></div>}<div class="col-12"><label asp-for="Config.CustomCss" class="form-label">CSS customizado controlado</label><textarea asp-for="Config.CustomCss" rows="6" class="form-control font-monospace"></textarea></div></div></div>
<div class="tab-pane fade" id="preview"><div class="p-4 rounded border" style="border-color:@Model.Config.BorderColor!important;color:@Model.Config.TextColor;background:linear-gradient(135deg,@Model.Config.SecondaryColor,#fff)"><h3 style="color:@Model.Config.PrimaryColor">@(Model.Config.HeaderText??"Cabeçalho da etiqueta")</h3><strong>N° de Controle:</strong> 2026-000123<br/><strong>Assunto:</strong> Documento de exemplo<br/><strong>LOCALIZAÇÃO:</strong> A01-E02-P03</div><p class="text-muted mt-3">Prévia com dados de exemplo. Nenhuma impressão será registrada.</p></div></div>
@if(!readOnly){<div class="d-flex justify-content-end gap-2 mt-3"><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a><button class="btn btn-primary" type="submit">Salvar configurações</button></div>}else{<div class="alert alert-info mt-3">Modelos de fábrica têm layout estrutural protegido.</div>}
