@model InovaGed.Application.Labels.LabelTemplateDetails
@{Layout=null;var c=Model.Config;var visible=Model.Fields.Where(x=>x.IsVisible).OrderBy(x=>x.DisplayOrder).ToList();}
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Prévia — @Model.Template.Name</title><style>body{margin:0;background:#eef2f5;font-family:Arial,sans-serif;color:@c.TextColor}.toolbar{padding:14px 22px;background:#102a43;color:white;display:flex;gap:12px;align-items:center}.toolbar a,.toolbar button{background:white;color:#102a43;border:0;padding:9px 14px;border-radius:6px;text-decoration:none}.sheet{width:210mm;min-height:297mm;margin:20px auto;background:white;padding:18mm;box-sizing:border-box}.label{width:@(c.LabelWidthMm??174)mm;min-height:@(c.LabelHeightMm??110)mm;border:2px solid @c.BorderColor;padding:8mm;box-sizing:border-box;background:linear-gradient(145deg,@c.SecondaryColor 0,white 30%)}.header{color:@c.PrimaryColor;border-bottom:5px solid @c.PrimaryColor;padding-bottom:8px}.field{padding:6px 0;border-bottom:1px solid @c.BorderColor}.field strong{color:@c.PrimaryColor}@@media print{.toolbar{display:none}.sheet{margin:0}} </style></head><body><div class="toolbar"><a href="@Url.Action("Edit",new{id=Model.Template.Id})">Voltar</a><button onclick="window.print()">Imprimir prévia</button><span>Pré-visualização — não registrada</span></div><main class="sheet"><article class="label"><h1 class="header">@(c.HeaderText??Model.Template.Name)</h1>@foreach(var f in visible){<div class="field"><strong>@f.FieldLabel:</strong> @(f.DefaultValue??(f.FieldKey=="location"?"A01-E02-P03":f.FieldKey=="control_number"?"2026-000123":"Dado de exemplo"))</div>} </article></main></body></html>
