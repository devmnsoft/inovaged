@model IReadOnlyList<InovaGed.Application.Labels.LabelTemplateListItem>
@{ViewData["Title"]="Modelos de Etiqueta";ViewData["Subtitle"]="Gerencie modelos de fábrica e modelos personalizados usados na impressão de caixas, documentos e pastas.";}
<style>.template-hero{background:linear-gradient(120deg,#073b4c,#087f8c);color:#fff;border-radius:1rem}.template-card{border:0;border-top:4px solid #0d6efd;border-radius:.9rem}.template-card.custom{border-color:#008a9a}.template-actions form{display:inline}</style>
<section class="template-hero p-4 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3"><div><div class="text-uppercase small opacity-75">Administração e governança</div><h1 class="h2 mb-2">Modelos de Etiqueta</h1><p class="mb-0">@ViewData["Subtitle"]</p></div><a class="btn btn-light" asp-action="Create"><app-icon name="plus"></app-icon> Novo modelo personalizado</a></section>
@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["Error"] is string err){<div class="alert alert-danger">@err</div>}
<div class="row g-4">@foreach(var item in Model){<div class="col-xl-6"><article class="card template-card @(item.IsCustomTemplate?"custom":"") shadow-sm h-100"><div class="card-body p-4"><div class="d-flex justify-content-between gap-3"><div><span class="badge @(item.IsSystemTemplate?"text-bg-primary":"text-bg-dark")">@(item.IsSystemTemplate?"Padrão de fábrica":"Personalizado")</span><span class="badge @(item.IsActive?"text-bg-success":"text-bg-secondary") ms-1">@(item.IsActive?"Ativo":"Inativo")</span>@if(item.IsDefault){<span class="badge text-bg-warning ms-1">Padrão</span>}<h2 class="h4 mt-3 mb-1">@item.Name</h2><code>@item.Code</code></div><div class="text-end"><strong>v@item.Version</strong><div class="small text-muted">@(item.SubjectType=="BOX"?"Caixa":"Documento/Pasta")</div></div></div><p class="text-muted my-3">@item.Description</p><div class="row small border-top border-bottom py-2 mb-3"><div class="col">Lote: <strong>@(item.SupportsBatch?"Sim":"Não")</strong></div><div class="col">Edição manual: <strong>@(item.AllowsManualFields?"Sim":"Não")</strong></div></div><div class="template-actions d-flex flex-wrap gap-2"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">@(item.IsSystemTemplate?"Consultar":"Editar")</a><a class="btn btn-sm btn-outline-secondary" asp-action="Preview" asp-route-id="@item.Id">Pré-visualizar</a><a class="btn btn-sm btn-outline-secondary" asp-action="Versions" asp-route-id="@item.Id">Ver versões</a>@if(!item.IsDefault&&item.IsActive){<form asp-action="SetDefault" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-warning">Definir padrão</button></form>}<form asp-action="@(item.IsActive?"Deactivate":"Activate")" asp-route-id="@item.Id" method="post"><button class="btn btn-sm @(item.IsActive?"btn-outline-danger":"btn-outline-success")">@(item.IsActive?"Desativar":"Ativar")</button></form><form asp-action="Publish" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-dark">Publicar versão</button></form></div></div></article></div>}</div>
<div class="alert alert-info mt-4"><strong>Governança:</strong> Modelos de fábrica garantem padronização operacional do InovaGED. Modelos personalizados permitem adaptar a etiqueta ao padrão visual e arquivístico do cliente.</div>
