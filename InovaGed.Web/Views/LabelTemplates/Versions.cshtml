@model IReadOnlyList<InovaGed.Application.Labels.LabelTemplateVersionItem>
@{ViewData["Title"]="Versões do modelo";dynamic t=ViewBag.Template;}
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1 class="h3">Histórico de versões</h1><p class="text-muted">@t.Name · <code>@t.Code</code></p></div><a class="btn btn-outline-secondary" asp-action="Index">Voltar</a></div>@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["Error"] is string err){<div class="alert alert-danger">@err</div>}
<div class="card shadow-sm mb-4"><div class="card-body"><h2 class="h5">Publicar nova versão</h2><p class="text-muted">O snapshot preservará configuração, campos e identidade visual usados.</p><form asp-action="Publish" asp-route-id="@t.Id" method="post" class="d-flex gap-2"><input name="notes" class="form-control" maxlength="500" placeholder="Notas da alteração (opcional)"/><button class="btn btn-primary text-nowrap">Publicar versão</button></form></div></div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Versão</th><th>Publicada em</th><th>Responsável</th><th>Notas</th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="4" class="text-center text-muted p-4">Nenhuma versão publicada.</td></tr>}@foreach(var v in Model){<tr><td><span class="badge text-bg-primary">v@v.VersionNumber</span></td><td>@v.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@(v.PublishedBy?.ToString()??"Sistema")</td><td>@(v.ChangeNotes??"Sem notas")</td></tr>}</tbody></table></div></div>
