@model InovaGed.Application.Labels.Tracking.LabelInventoryDetails
@if(Model.Status=="CLOSED"){<form action="/ArchiveReconciliation/RunInventoryDiagnosis" method="post" class="mt-3">@Html.AntiForgeryToken()<input type="hidden" name="inventorySessionId" value="@Model.Id"/><button class="btn btn-primary">Gerar reconciliação deste inventário</button></form>}
@{ViewData["Title"]="Inventário "+Model.SessionNumber;var found=Model.Items.Count(x=>x.Status=="FOUND");var div=Model.Items.Count(x=>x.Status=="DIVERGENT_LOCATION");var dup=Model.Items.Count(x=>x.Status=="DUPLICATED");var unk=Model.Items.Count(x=>x.Status=="UNKNOWN");}<link rel="stylesheet" href="~/css/label-tracking.css"/><h1 class="h3">@Model.Title</h1><p><span class="badge text-bg-primary">@Model.Status</span> <span class="text-muted">@Model.SessionNumber · @Model.ExpectedLocation</span></p><div class="row g-2 mb-3">@foreach(var x in new[]{("Total lido",Model.Items.Count),("Encontrados",found),("Divergentes",div),("Duplicados",dup),("Desconhecidos",unk)}){<div class="col-6 col-lg"><div class="card tracking-card"><div class="card-body"><div class="kpi">@x.Item2</div><small>@x.Item1</small></div></div></div>}</div>@if(Model.Status=="OPEN"){<form asp-action="InventoryScan" asp-route-id="@Model.Id" method="post" class="card tracking-card mb-3"><div class="card-body">@Html.AntiForgeryToken()<div class="row g-2"><div class="col-md-7"><input class="form-control form-control-lg" name="payload" placeholder="Código, payload ou link" required data-qr-input/></div><div class="col-md-3"><input class="form-control form-control-lg" name="foundLocation" value="@Model.ExpectedLocation" placeholder="Local encontrado"/></div><div class="col-md-2 d-grid"><button class="btn btn-primary">Adicionar leitura</button></div></div></div></form>}<div class="card tracking-card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Controle</th><th>Esperado</th><th>Encontrado</th><th>Status</th><th>Data</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.ControlNumber</td><td>@x.ExpectedLocation</td><td>@x.FoundLocation</td><td class="status-@x.Status">@x.Status</td><td>@x.ScannedAt.ToLocalTime()</td></tr>}</tbody></table></div></div>@if(Model.Status=="OPEN"){<div class="row g-2 mt-3"><div class="col-md"><form asp-action="Close" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<input class="form-control mb-2" name="notes" placeholder="Observação obrigatória se houver divergência"/><button class="btn btn-success">Concluir inventário</button></form></div><div class="col-md"><form asp-action="Cancel" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<input class="form-control mb-2" name="reason" required placeholder="Motivo do cancelamento"/><button class="btn btn-outline-danger">Cancelar sessão</button></form></div></div>}
