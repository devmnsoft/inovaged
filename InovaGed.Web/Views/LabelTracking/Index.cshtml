@{ViewData["Title"]="Rastreio de Etiquetas";}<link rel="stylesheet" href="~/css/label-tracking.css" />
<section class="tracking-hero p-4 p-lg-5 mb-4"><small>ETIQUETAS · OPERAÇÃO</small><h1>Rastreio de Etiquetas</h1><p class="mb-0">Valide, localize, inventarie e acompanhe cada etiqueta depois da impressão.</p></section>
<div class="row g-3">@foreach(var x in new[]{("Scanner","Ler QR Code","Valide uma etiqueta e registre a conferência."),("Inventory","Inventário por etiquetas","Conte o acervo e encontre divergências."),("Replacements","Substituições","Gerencie etiquetas danificadas ou ilegíveis."),("Events","Histórico de leituras","Consulte e exporte eventos operacionais.")}){<div class="col-md-6"><div class="card tracking-card h-100"><div class="card-body p-4"><h2 class="h5">@x.Item2</h2><p class="text-muted">@x.Item3</p><a class="btn btn-primary field-action" asp-action="@x.Item1">Abrir</a></div></div></div>}</div>
