@model IEnumerable<dynamic>

@{ViewData["Title"]="Inventário por etiquetas";}<link rel="stylesheet" href="~/css/label-tracking.css"/><div class="d-flex justify-content-between align-items-center"><h1 class="h3">Inventário por etiquetas</h1><a class="btn btn-primary" asp-action="InventoryNew">Nova sessão</a></div><div class="card tracking-card mt-3"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Sessão</th><th>Título</th><th>Local</th><th>Status</th><th>Leituras</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a asp-action="InventoryDetails" asp-route-id="@x.id">@x.session_number</a></td><td>@x.title</td><td>@x.expected_location</td><td><span class="badge text-bg-light">@x.status</span></td><td>@x.total</td></tr>}</tbody></table></div></div>
