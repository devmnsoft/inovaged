@model IReadOnlyList<InovaGed.Application.Labels.Tracking.LabelScanEventItem>@{ViewData["Title"]="Leituras de etiquetas";}<div class="d-flex justify-content-between"><h1 class="h3">Leituras de etiquetas</h1><a class="btn btn-outline-primary" asp-action="EventsCsv">Exportar CSV</a></div><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Data</th><th>Status</th><th>Tipo</th><th>Controle</th><th>Local</th><th>Mensagem</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.ScannedAt.ToLocalTime()</td><td>@x.Status</td><td>@x.SubjectType</td><td>@x.ControlNumber</td><td>@x.LocationScanned</td><td>@x.Message</td></tr>}</tbody></table></div>
