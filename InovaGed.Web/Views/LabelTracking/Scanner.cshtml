@{ViewData["Title"]="Ler QR Code";}<link rel="stylesheet" href="~/css/label-tracking.css" />
<h1 class="h3">Ler QR Code</h1><p class="text-muted">Aponte a câmera para o QR Code da etiqueta ou digite o código manualmente.</p><div class="card tracking-card"><div class="card-body p-4"><div class="scanner-stage mb-3"><video data-qr-video playsinline muted></video></div><form asp-action="Scan" method="post">@Html.AntiForgeryToken()<label class="form-label" for="payload">Código, payload ou link</label><input class="form-control form-control-lg" id="payload" name="payload" required maxlength="2048" data-qr-input /><label class="form-label mt-3" for="location">Localização encontrada</label><input class="form-control" id="location" name="location" maxlength="200"/><div class="d-grid d-sm-flex gap-2 mt-3"><button type="button" class="btn btn-outline-primary btn-lg" data-qr-start>Abrir câmera</button><button class="btn btn-primary btn-lg">Validar etiqueta</button></div></form></div></div><script src="~/js/label-scanner.js" defer></script>
