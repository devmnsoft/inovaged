@model IReadOnlyList<InovaGed.Application.Labels.Tracking.LabelReplacementItem>

@{ViewData["Title"]="Substituições de etiqueta";}<h1 class="h3">Substituições de etiqueta</h1><form asp-action="RequestReplacement" method="post" class="card shadow-sm border-0 mb-3"><div class="card-body">@Html.AntiForgeryToken()<h2 class="h5">Solicitar substituição</h2><div class="row g-2"><div class="col-md-2"><select class="form-select" name="subjectType"><option value="BOX">Caixa</option><option value="DOCUMENT">Documento</option></select></div><div class="col-md-3"><input class="form-control" name="controlNumber" placeholder="Número de controle"/></div><div class="col-md-5"><select class="form-select" name="reason" required><option value="">Selecione o motivo</option><option>Etiqueta danificada</option><option>Etiqueta ilegível</option><option>Erro de impressão</option><option>Alteração de localização</option><option>Troca de modelo</option><option>Outro motivo</option></select></div><div class="col-md-2 d-grid"><button class="btn btn-primary">Solicitar</button></div></div></div></form><div class="table-responsive"><table class="table"><thead><tr><th>Objeto</th><th>Controle</th><th>Motivo</th><th>Status</th><th>Solicitada em</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.SubjectType</td><td>@x.ControlNumber</td><td>@x.Reason</td><td>@x.Status</td><td>@x.RequestedAt.ToLocalTime()</td><td>@if(x.Status=="REQUESTED"){<form asp-action="Approve" asp-route-id="@x.Id" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success">Aprovar</button></form>}</td></tr>}</tbody></table></div>
