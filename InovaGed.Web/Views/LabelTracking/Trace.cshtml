@model InovaGed.Application.Labels.Tracking.LabelTraceDetails
@{ViewData["Title"]="Rastreio da etiqueta";}<link rel="stylesheet" href="~/css/label-tracking.css"/><h1 class="h3">Rastreio da etiqueta</h1><div class="card tracking-card"><div class="card-body p-4"><span class="badge text-bg-light status-@Model.Status">@Model.Status</span><div class="row g-3 mt-1"><div class="col-md-4"><small class="text-muted">Modelo</small><div>@Model.TemplateCode</div></div><div class="col-md-4"><small class="text-muted">Modo</small><div>@Model.PrintMode</div></div><div class="col-md-4"><small class="text-muted">Número de controle</small><div>@Model.ControlNumber</div></div><div class="col-md-4"><small class="text-muted">Tipo</small><div>@Model.SubjectType</div></div><div class="col-md-4"><small class="text-muted">Localização esperada</small><div>@Model.ExpectedLocation</div></div><div class="col-md-4"><small class="text-muted">Localização atual</small><div>@Model.CurrentLocation</div></div><div class="col-md-4"><small class="text-muted">Última impressão</small><div>@Model.PrintedAt?.ToLocalTime()</div></div><div class="col-md-4"><small class="text-muted">Última leitura</small><div>@Model.LastScanAt?.ToLocalTime()</div></div></div><div class="d-flex flex-wrap gap-2 mt-4">@if(Model.SubjectId.HasValue){<a class="btn btn-primary" href="@(Model.SubjectType=="BOX"?$"/Physical/BoxContents?boxId={Model.SubjectId}":$"/Ged/Document/{Model.SubjectId}")">Abrir @(Model.SubjectType=="BOX"?"caixa":"documento")</a>}<a class="btn btn-outline-primary" asp-action="Scanner">Registrar conferência</a><a class="btn btn-outline-secondary" asp-action="Events" asp-route-ControlNumber="@Model.ControlNumber">Ver histórico</a></div></div></div>
