@{ViewData["Title"]="Novo inventário";}<h1 class="h3">Nova sessão de inventário</h1><form method="post" class="card shadow-sm border-0"><div class="card-body p-4">@Html.AntiForgeryToken()<label class="form-label">Título do inventário</label><input class="form-control" name="title" required maxlength="200"/><label class="form-label mt-3">Localização esperada</label><input class="form-control" name="expectedLocation" maxlength="200"/><label class="form-label mt-3">Observações</label><textarea class="form-control" name="notes" rows="3" maxlength="2000"></textarea><button class="btn btn-primary btn-lg mt-4">Iniciar inventário</button></div></form>
