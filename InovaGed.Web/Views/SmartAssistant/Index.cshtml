@{ViewData["Title"]="Assistente Documental Inteligente";ViewData["Subtitle"]="Converse com o acervo, localize documentos, entenda temporalidade, encontre caixas e revise pendências com respostas rastreáveis.";ViewData["Icon"]="message-circle";var cards=new List<(string,string)>{("Perguntar sobre documentos","Quais documentos estão pendentes de classificação?"),("Encontrar caixa ou localização","Onde está a caixa do processo informado?"),("Consultar temporalidade","Quais documentos vencem em 2026?"),("Ver pendências de OCR","Quais documentos estão sem OCR?"),("Ver documentos sensíveis","Quais documentos têm dados sensíveis?"),("Ver etiquetas impressas","Quais etiquetas foram impressas hoje?")};}
<div class="atlas-page"><partial name="Atlas/_AtlasPageHero"/><div class="alert alert-info"><strong>LGPD e segurança:</strong> respostas são baseadas em fontes do seu tenant e dados pessoais são mascarados. Nenhuma ação é executada automaticamente.</div>
<form method="post" asp-action="Start"><div class="mb-3"><label class="form-label" for="title">Título da conversa</label><input class="form-control" id="title" name="title" maxlength="160" placeholder="Ex.: Pendências arquivísticas de 2026"/></div><button class="btn btn-primary" type="submit"><i class="bi bi-chat-dots"></i> Iniciar conversa</button> <a class="btn btn-outline-secondary" asp-action="Sessions">Conversas anteriores</a></form>
<div class="row g-3 mt-3">@foreach(var card in cards){<div class="col-md-6 col-xl-4"><div class="card h-100"><div class="card-body"><h2 class="h6">@card.Item1</h2><p class="text-muted mb-0">@card.Item2</p></div></div></div>}</div></div>
