@model IReadOnlyList<InovaGed.Application.SmartGed.Assistant.SmartAssistantSessionItem>
@{ViewData["Title"]="Conversas do Assistente";ViewData["Subtitle"]="Histórico rastreável de perguntas e respostas documentais.";ViewData["Icon"]="message-circle";}
<div class="atlas-page"><partial name="Atlas/_AtlasPageHero"/>@if(Model.Count==0){<partial name="Atlas/_AtlasEmptyState"/>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Conversa</th><th>Status</th><th>Criada em</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Title</td><td><span class="badge text-bg-success">@item.Status</span></td><td>@item.CreatedAt.ToLocalTime().ToString("g")</td><td><a asp-action="Session" asp-route-id="@item.Id">Abrir</a></td></tr>}</tbody></table></div>}</div>
