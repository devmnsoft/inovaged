@model InovaGed.Application.SmartGed.Assistant.SmartAssistantSessionDetails
@{ViewData["Title"]=Model.Title;ViewData["Subtitle"]="Resposta local, citada e sujeita à revisão humana.";ViewData["Icon"]="message-circle";ViewData["SessionId"]=Model.Id;var suggestions=new List<string>{"Quais documentos estão sem classificação?","Quais documentos vencem em 2026?","Onde está a caixa do processo informado?","Quais documentos têm dados sensíveis?","Quais etiquetas foram reimpressas hoje?","Quais documentos precisam de revisão de OCR?"};}
<div class="atlas-page"><partial name="Atlas/_AtlasPageHero"/><div class="alert alert-warning"><strong>LGPD:</strong> confirme as fontes antes de agir. CPF/CNPJ são mascarados e sugestões não alteram o acervo.</div>
<div class="vstack gap-3">@foreach(var message in Model.Messages){<partial name="_Message" model="message"/>}</div>
<form method="post" asp-action="Ask" class="card mt-4"><div class="card-body"><input type="hidden" name="sessionId" value="@Model.Id"/><label for="question" class="form-label">Pergunte ao acervo</label><textarea id="question" name="question" class="form-control" rows="3" required minlength="3" maxlength="2000"></textarea><button class="btn btn-primary mt-3" type="submit">Enviar pergunta</button></div></form>
<div class="mt-3"><strong>Sugestões:</strong><ul>@foreach(var suggestion in suggestions){<li>@suggestion</li>}</ul></div></div>
