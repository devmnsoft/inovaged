@model InovaGed.Application.SmartGed.Assistant.SmartAssistantSessionDetails
@{ViewData["Title"]=Model.Title;ViewData["Subtitle"]="Resposta local, citada e sujeita à revisão humana.";ViewData["Icon"]="message-circle";ViewData["SessionId"]=Model.Id;var suggestions=new List<string>{"Quais documentos estão sem classificação?","Quais documentos vencem em 2026?","Onde está a caixa do processo informado?","Quais documentos têm dados sensíveis?","Quais etiquetas foram reimpressas hoje?","Quais documentos precisam de revisão de OCR?"};}
@section Styles{<link rel="stylesheet" href="~/css/smart-assistant.css" asp-append-version="true"/>}
<div class="atlas-page smart-assistant" data-smart-assistant><partial name="Atlas/_AtlasPageHero"/><div class="alert alert-warning"><strong>LGPD:</strong> confirme as fontes antes de agir. CPF/CNPJ são mascarados e sugestões não alteram o acervo.</div>
@if(TempData["SmartAssistantError"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
<div class="vstack gap-3 smart-assistant__messages" data-assistant-messages>@foreach(var message in Model.Messages){<partial name="_Message" model="message"/>}</div>
<form method="post" asp-action="Ask" class="card mt-4" data-assistant-form><div class="card-body"><input type="hidden" name="sessionId" value="@Model.Id"/><label for="question" class="form-label">Pergunte ao acervo</label><textarea id="question" name="question" class="form-control" rows="3" required minlength="3" maxlength="2000" placeholder="Use um código, processo, caixa, cliente, contrato ou template para uma resposta mais precisa."></textarea><div class="d-flex align-items-center gap-3 mt-3"><button class="btn btn-primary" type="submit" data-submit>Enviar pergunta</button><span data-loading hidden><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Consultando acervo…</span></div><small class="form-text">Enter envia · Shift+Enter cria uma nova linha.</small></div></form>
<div class="mt-3 smart-assistant__suggestions"><strong>Sugestões:</strong><div>@foreach(var suggestion in suggestions){<button type="button" class="btn btn-sm btn-outline-secondary" data-suggestion="@suggestion">@suggestion</button>}</div></div></div>
@section Scripts{<script src="~/js/smart-assistant.js" asp-append-version="true"></script>}
