@model IReadOnlyList<InovaGed.Application.SmartGed.Assistant.SmartAssistantCitation>
@if(Model.Count>0){<details class="mt-3"><summary>Fontes consultadas (@Model.Count)</summary><ul class="list-group mt-2">@foreach(var citation in Model){<li class="list-group-item"><strong>@citation.SourceType: @citation.Title</strong><div>@citation.Excerpt</div><small>Confiança @citation.Confidence.ToString("0")%</small>@if(!string.IsNullOrWhiteSpace(citation.Url)){<div><a href="@citation.Url">Abrir fonte</a></div>}</li>}</ul></details>}
