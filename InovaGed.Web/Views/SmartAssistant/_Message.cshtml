@model InovaGed.Application.SmartGed.Assistant.SmartAssistantMessage
<article class="card @(Model.Role=="ASSISTANT"?"border-primary":"")"><div class="card-body"><div class="d-flex justify-content-between"><strong>@(Model.Role=="ASSISTANT"?"Assistente":"Você")</strong><small>@Model.CreatedAt.ToLocalTime().ToString("g")</small></div><p class="mt-2">@Model.Content</p>@if(Model.Role=="ASSISTANT"){<div class="small">Confiança: @Model.Confidence.ToString("0")% · @Model.Status</div><partial name="_Citations" model="Model.Citations"/><partial name="_ActionSuggestions" model='new Tuple<Guid,IReadOnlyList<InovaGed.Application.SmartGed.Assistant.SmartAssistantAction>>(ViewBag.SessionId is Guid id?id:Guid.Empty,Model.Actions)'/>}</div></article>
