@model InovaGed.Application.SmartGed.Assistant.SmartAssistantMessage
<article class="card smart-assistant__message @(Model.Role=="ASSISTANT"?"border-primary is-assistant":"is-user")"><div class="card-body"><div class="d-flex justify-content-between"><strong>@(Model.Role=="ASSISTANT"?"Assistente documental":"Você")</strong><small>@Model.CreatedAt.ToLocalTime().ToString("g")</small></div><p class="mt-2 smart-assistant__answer">@Model.Content</p>@if(Model.Role=="ASSISTANT"){var band=Model.Confidence>=85?"Alta":Model.Confidence>=70?"Média":Model.Confidence>=55?"Baixa":"Insuficiente";<div class="small"><span class="badge text-bg-info">Confiança @band · @Model.Confidence.ToString("0")%</span> <span class="badge text-bg-light">@Model.Status</span></div><partial name="_Citations" model="Model.Citations"/><partial name="_ActionSuggestions" model='new Tuple<Guid,IReadOnlyList<InovaGed.Application.SmartGed.Assistant.SmartAssistantAction>>(ViewBag.SessionId is Guid id?id:Guid.Empty,Model.Actions)'/>}</div></article>
