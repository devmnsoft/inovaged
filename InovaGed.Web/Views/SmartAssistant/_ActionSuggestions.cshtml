@model Tuple<Guid,IReadOnlyList<InovaGed.Application.SmartGed.Assistant.SmartAssistantAction>>
@foreach(var action in Model.Item2){<div class="alert alert-secondary mt-3"><strong>Ação recomendada: @action.Title</strong><div>@action.Description</div><span class="badge text-bg-warning">@action.Status</span>@if(action.Status=="PENDING"){<div class="d-flex gap-2 mt-2"><form method="post" asp-action="Accept" asp-route-id="@action.Id"><input type="hidden" name="sessionId" value="@Model.Item1"/><button class="btn btn-sm btn-outline-success" type="submit">Aceitar recomendação</button></form><form method="post" asp-action="Reject" asp-route-id="@action.Id"><input type="hidden" name="sessionId" value="@Model.Item1"/><button class="btn btn-sm btn-outline-danger" type="submit">Rejeitar</button></form></div>}</div>}
