@model IReadOnlyList<InovaGed.Web.Models.Administration.AdministrationRecommendationVM>
@if (Model.Count > 0)
{
    <section class="ig-banner ig-banner-warning" aria-labelledby="recommendations-title">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i><div><h2 id="recommendations-title">Alertas de configuração</h2>
        @foreach (var recommendationItem in Model) { <div class="ig-recommendation"><strong>@recommendationItem.Title</strong><p>@recommendationItem.Reason @recommendationItem.Guidance</p></div> }
        </div>
    </section>
}
