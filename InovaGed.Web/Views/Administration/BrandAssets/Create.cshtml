@model InovaGed.Web.Models.Branding.BrandAssetUploadInput
@{ ViewData["Title"]="Cadastrar logo oficial"; }
@section Styles { <link rel="stylesheet" href="~/css/brand-assets.css" asp-append-version="true" /> }
<main class="atlas-page"><section class="atlas-page-hero brand-assets-hero"><div><h1>Cadastrar logo oficial</h1><p>Envie a arte oficial da marca. O sistema não redesenha logos: a imagem enviada será usada diretamente na impressão.</p></div></section><form method="post" enctype="multipart/form-data" class="atlas-card mt-4">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="atlas-alert"></div><label asp-for="BrandName">Nome da empresa/marca</label><input asp-for="BrandName" class="form-control"/><label asp-for="AssetName">Nome do asset</label><input asp-for="AssetName" class="form-control"/><label asp-for="File">Arquivo da logo</label><input asp-for="File" class="form-control" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" id="logo-file"/><small>PNG, JPG ou WEBP, até 5 MB. SVG permanece bloqueado por segurança.</small><img id="logo-preview" class="brand-upload-preview" alt="Prévia da logo selecionada"/><label><input asp-for="IsDefault"/> Usar como logo padrão deste cliente</label><label asp-for="Notes">Observações</label><textarea asp-for="Notes" class="form-control"></textarea><button type="submit" class="atlas-btn atlas-btn-primary">Cadastrar logo</button></form></main>
@section Scripts { <script>document.querySelector('#logo-file')?.addEventListener('change',e=>{const image=document.querySelector('#logo-preview'),file=e.target.files?.[0];if(!file)return;image.src=URL.createObjectURL(file);image.style.display='block';});</script> }
