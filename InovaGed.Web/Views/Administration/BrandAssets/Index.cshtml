@model IReadOnlyList<InovaGed.Web.Models.Branding.BrandAssetVm>
@{ ViewData["Title"]="Logos e Marcas para Impressão"; }
@section Styles { <link rel="stylesheet" href="~/css/brand-assets.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/print-branding.css" asp-append-version="true" /> }
<main class="atlas-page"><section class="atlas-page-hero brand-assets-hero"><div><h1>Logos e Marcas para Impressão</h1><p>Cadastre a logo oficial da LocDesk, da MNSOFT ou de qualquer cliente para usar em etiquetas, documentos e relatórios impressos.</p></div><a class="atlas-btn atlas-btn-primary" asp-action="Create">Nova logo</a></section>
@if(Model.Count==0){<div class="atlas-empty-state">Nenhuma logo cadastrada. Envie a arte oficial para começar.</div>}else{<div class="brand-assets-grid">@foreach(var asset in Model){<article class="atlas-action-card brand-asset-card"><div class="brand-asset-preview"><img src="@asset.FileUrl" alt="@asset.AssetName" /></div><h2>@asset.AssetName</h2><p>@asset.BrandName</p><div><span class="atlas-status-badge">@asset.Status</span>@if(asset.IsDefault){<span class="atlas-status-badge">Padrão</span>}</div><small>@asset.FileExtension.ToUpperInvariant() · @((asset.FileSizeBytes/1024d).ToString("N0")) KB</small><nav><a asp-action="Details" asp-route-id="@asset.Id">Visualizar</a>@if(asset.Status=="ACTIVE"&&!asset.IsDefault){<form asp-action="SetDefault" asp-route-id="@asset.Id" method="post">@Html.AntiForgeryToken()<button type="submit">Definir como padrão</button></form>}@if(asset.Status=="ACTIVE"){<form asp-action="Archive" asp-route-id="@asset.Id" method="post">@Html.AntiForgeryToken()<button type="submit">Arquivar</button></form>}<a href="/Labels/Branding">Usar em etiquetas</a></nav></article>}</div>}</main>
