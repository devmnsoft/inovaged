@model InovaGed.Web.Models.Administration.AdministrationDashboardVM
@section Styles {
    <link rel="stylesheet" href="~/css/pages/administration.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = "Administração";
    ViewData["Subtitle"] = "Governança, segurança e saúde do ambiente";
}

<header class="ig-page-header">
    <div><span class="ig-eyebrow">Governança institucional</span><h1>Administração</h1><p>Gerencie acessos, parâmetros e continuidade em um único espaço seguro.</p></div>
    <a class="btn btn-outline-secondary" asp-action="Health"><i class="bi bi-heart-pulse" aria-hidden="true"></i> Ver saúde do sistema</a>
</header>

<partial name="_EnvironmentSummary" model="Model.Health" />
<partial name="_ConfigurationRecommendations" model="Model.Recommendations" />
<partial name="_AdministrationSections" model="Model.Sections" />
