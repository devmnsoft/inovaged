@model InovaGed.Web.Models.Administration.AdministrationDashboardVM
@using InovaGed.Web.Models.Atlas
@section Styles {
    <link rel="stylesheet" href="~/css/pages/administration.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = "Administração";
    ViewData["WorkspaceVariant"] = "wide";
    ViewData["Subtitle"] = "Governança, segurança e saúde do ambiente";
}

@{
    var header = new AtlasPageHeaderVm("Central de Administração", "Identidades, segurança, disponibilidade e conformidade em uma visão operacional.", "settings", "Governança institucional",
        new[] { new AtlasPageAction("Prontidão do ambiente", Url.Action("Readiness")!, "check", true), new AtlasPageAction("Saúde do sistema", Url.Action("Health")!, "health") },
        new (string, string?)[] { ("Início", "/"), ("Administração", null) });
    var metrics = Model.Health.Take(4).Select(x => new AtlasMetricVm(x.Title, x.Value ?? "—", x.Message ?? "Estado atual", x.Status, x.Icon)).ToArray();
}
<div class="atlas-prime-page administration-prime">
    <partial name="Atlas/_PageHeader" model="header" />
    <partial name="Atlas/_PageMetrics" model="metrics" />
    <section class="atlas-prime-panel" aria-labelledby="adminRecommendations">
        <div class="atlas-prime-panel__header"><div><h2 id="adminRecommendations">Recomendações prioritárias</h2><small>Ações orientadas por severidade e impacto no ambiente.</small></div></div>
        <partial name="_ConfigurationRecommendations" model="Model.Recommendations" />
    </section>
    <section class="atlas-prime-panel" aria-labelledby="adminAreas">
        <div class="atlas-prime-panel__header"><div><h2 id="adminAreas">Áreas administrativas</h2><small>Acessos organizados por responsabilidade operacional.</small></div></div>
        <partial name="_AdministrationSections" model="Model.Sections" />
    </section>
</div>
