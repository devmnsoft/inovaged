@{ViewData["Title"]="Atlas UI Design System";ViewData["WorkspaceVariant"]="wide";var steps=new List<string>{"Origem","Modelo","Dados","Prévia","Impressão"};}
<div class="atlas-page">
<partial name="Atlas/_AtlasPageHero" view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData){{"HeroTitle","Atlas UI Design System"},{"Subtitle","Padrões visuais, componentes e identidade da interface do InovaGED."},{"Icon","layout"}}'/>
<section class="atlas-card p-4"><h2>Cores e tipografia</h2><p class="text-muted">Tokens semânticos mantêm contraste, hierarquia e consistência em toda a aplicação.</p><div class="atlas-token-grid"><div><div class="atlas-swatch" style="background:var(--atlas-primary)"></div><strong>Primary</strong><code class="d-block">#0b1f3a</code></div><div><div class="atlas-swatch" style="background:var(--atlas-accent)"></div><strong>Accent</strong><code class="d-block">#17c7e8</code></div><div><div class="atlas-swatch" style="background:var(--atlas-success)"></div><strong>Success</strong><code class="d-block">#16a34a</code></div><div><div class="atlas-swatch" style="background:var(--atlas-danger)"></div><strong>Danger</strong><code class="d-block">#dc2626</code></div></div></section>
<section class="atlas-card p-4"><h2>Botões e badges</h2><div class="atlas-btn-group mb-3"><button class="atlas-btn atlas-btn-primary">Ação principal</button><button class="atlas-btn atlas-btn-secondary">Secundária</button><button class="atlas-btn atlas-btn-ghost">Discreta</button><button class="atlas-btn atlas-btn-danger">Crítica</button></div><div class="d-flex flex-wrap gap-2"><span class="atlas-badge atlas-badge-success">ATIVO</span><span class="atlas-badge atlas-badge-warning">PENDENTE</span><span class="atlas-badge atlas-badge-danger">CRÍTICO</span><span class="atlas-badge atlas-badge-info">INFORMAÇÃO</span><span class="atlas-badge atlas-badge-muted">DRAFT</span><span class="atlas-badge atlas-badge-implementation">EM IMPLANTAÇÃO</span></div></section>
<section><h2>Cards e KPIs</h2><div class="atlas-component-grid"><partial name="Atlas/_AtlasKpiCard" view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData){{"Label","Componentes"},{"Value","11"},{"Hint","Primitivos reutilizáveis"}}'/><partial name="Atlas/_AtlasActionCard" view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData){{"CardTitle","Catálogo de ícones"},{"Description","Ícones registrados com fallback seguro."},{"Url",Url.Action("AtlasIcons")!},{"Icon","layout"},{"Badge","Atlas"}}'/></div></section>
<section class="d-grid gap-2"><h2>Alertas</h2><partial name="Atlas/_AtlasAlert" view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData){{"Tone","info"},{"AlertTitle","Informação operacional"},{"Message","Use mensagens diretas e contextualizadas."},{"Recommendation","Confirme os dados antes de continuar."}}'/><partial name="Atlas/_AtlasAlert" view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData){{"Tone","migration"},{"AlertTitle","Migration pendente"},{"Message","O schema precisa ser atualizado."},{"Recommendation","Execute o plano de migration homologado."}}'/></section>
<section class="atlas-card p-4"><h2>Stepper</h2><partial name="Atlas/_AtlasStepper" view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData){{"Steps",steps},{"Current",3}}'/></section>
<section class="atlas-table-shell"><header class="atlas-table-header"><div><strong>Tabela premium</strong><small class="d-block text-muted">Cabeçalho, badges e hover padronizados.</small></div></header><div class="table-responsive"><table class="table atlas-table"><thead><tr><th>Componente</th><th>Estado</th><th>Uso</th></tr></thead><tbody><tr><td>PageHero</td><td><span class="atlas-badge atlas-badge-success">READY</span></td><td>Abertura de páginas</td></tr><tr><td>PreviewShell</td><td><span class="atlas-badge atlas-badge-info">ATLAS</span></td><td>Etiquetas e documentos</td></tr></tbody></table></div></section>
<section class="atlas-form-section"><header class="atlas-form-section__header"><h2>Formulários</h2><p>Campos agrupados por intenção e com rótulos persistentes.</p></header><div class="row g-3"><div class="col-md-6"><label class="form-label" for="atlas-name">Nome</label><input class="form-control" id="atlas-name" placeholder="Informe um nome"/></div><div class="col-md-6"><label class="form-label" for="atlas-status">Status</label><select class="form-select" id="atlas-status"><option>Ativo</option><option>Pendente</option></select></div></div></section>
<div class="atlas-component-grid"><partial name="Atlas/_AtlasEmptyState"/><partial name="Atlas/_AtlasPreviewShell" view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData){{"PreviewTitle","Etiqueta Atlas"}}'/></div>
<section class="atlas-card p-4"><h2>Ícones</h2><p>Use <code>&lt;app-icon&gt;</code> para obter aliases e fallback seguro.</p><div class="d-flex gap-4"><app-icon name="layout" size="28"/><app-icon name="settings" size="28"/><app-icon name="database" size="28"/><app-icon name="printer" size="28"/><app-icon name="warning" size="28"/></div></section>
</div>
