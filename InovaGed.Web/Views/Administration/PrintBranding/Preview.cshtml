@model InovaGed.Web.Models.Branding.PrintBrandingPreviewVm
@{ ViewData["Title"]="Preview da identidade visual"; }
@section Styles { <link rel="stylesheet" href="~/css/print-branding-center.css" asp-append-version="true" /> }
<main class="print-branding-page atlas-page"><header class="print-branding-hero atlas-page-hero"><div><h1>Preview fiel da identidade visual</h1><p>Confira a arte oficial, o cabeçalho e o rodapé antes da impressão.</p></div><a class="atlas-btn atlas-btn-primary" asp-action="TestPrint" asp-route-profileId="@Model.Branding.ProfileId">Imprimir teste</a></header><article class="print-branding-preview-page"><partial name="Branding/_PrintableBrandHeader" model="Model" /><section class="print-branding-example"><h2>Documento de exemplo</h2><p>Este bloco representa o conteúdo de uma etiqueta, relatório ou documento institucional. A imagem permanece sem filtros, cortes, redesenho ou distorção.</p><div class="example-lines"><span></span><span></span><span></span></div></section><partial name="Branding/_PrintableBrandFooter" model="Model" /></article></main>
