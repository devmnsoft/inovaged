@model IReadOnlyList<InovaGed.Web.Models.Branding.PrintBrandingBindingVm>
@{ ViewData["Title"]="Vínculos de identidade visual"; var profiles=ViewBag.Profiles as IReadOnlyList<InovaGed.Web.Models.Branding.PrintBrandingProfileVm>??Array.Empty<InovaGed.Web.Models.Branding.PrintBrandingProfileVm>(); }
@section Styles { <link rel="stylesheet" href="~/css/print-branding-center.css" asp-append-version="true" /> }
<main class="print-branding-page atlas-page"><header class="print-branding-hero atlas-page-hero"><div><h1>Vínculos por template e documento</h1><p>Escolha o perfil aplicado automaticamente, sem informar IDs manualmente.</p></div></header><section class="atlas-table-shell"><div class="table-responsive"><table class="print-branding-binding-table"><thead><tr><th>Contexto</th><th>Chave</th><th>Descrição</th><th>Perfil aplicado</th><th>Logo principal</th><th>Status</th><th>Ações</th></tr></thead><tbody>@foreach(var row in Model){<tr><td>@row.Context</td><td><code>@row.BindingKey</code></td><td>@row.Description</td><td colspan="4"><form method="post" asp-action="SaveBinding" class="binding-form">@Html.AntiForgeryToken()<input type="hidden" name="Context" value="@row.Context" /><input type="hidden" name="BindingKey" value="@row.BindingKey" /><select name="ProfileId"><option value="">Sem vínculo</option>@foreach(var p in profiles.Where(x=>x.Status=="ACTIVE")){<option value="@p.Id" selected="@(p.Id==row.ProfileId)">@p.ProfileName</option>}</select>@if(row.LogoUrl is not null){<img src="@row.LogoUrl" alt="Logo oficial vinculada" />}<span class="atlas-status-badge">@(row.Enabled?"Ativo":"Padrão")</span><button type="submit">Salvar</button><a asp-action="TestPrint" asp-route-profileId="@row.ProfileId">Testar impressão</a></form></td></tr>}</tbody></table></div></section></main>
