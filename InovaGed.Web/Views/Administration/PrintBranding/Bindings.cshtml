@model IReadOnlyList<InovaGed.Web.Models.Branding.PrintBrandingBindingVm>
@{ ViewData["Title"]="Vínculos de identidade visual"; var profiles=ViewBag.Profiles as IReadOnlyList<InovaGed.Web.Models.Branding.PrintBrandingProfileVm>??Array.Empty<InovaGed.Web.Models.Branding.PrintBrandingProfileVm>(); string ContextName(string context)=>context switch{"LABEL_TEMPLATE"=>"Etiqueta","CONTRACT_MEASUREMENT"=>"Medição contratual","FISCAL_PORTAL"=>"Portal do Fiscal","GOVERNANCE_REPORT"=>"Relatório de governança","DOCUMENT_REPORT"=>"Relatório documental","DOCUMENT_COVER"=>"Capa do documento",_=>"Documento"}; }
@section Styles { <link rel="stylesheet" href="~/css/print-branding-center.css" asp-append-version="true" /> }
<main class="print-branding-page atlas-page"><header class="branding-heading"><div><span class="branding-eyebrow">Aplicação automática</span><h1>Vínculos de modelos</h1><p>Escolha onde cada identidade visual será usada, sem informar códigos internos.</p></div><a class="atlas-btn atlas-btn-secondary" asp-action="Index">Voltar à central</a></header>
<section class="binding-filters" aria-label="Filtros"><label>Buscar<input type="search" placeholder="Buscar modelo ou documento..." data-binding-search /></label><label>Tipo<select data-binding-type><option value="">Todos</option><option value="Etiqueta">Etiquetas</option><option value="Documento">Documentos</option><option value="Relatório">Relatórios</option></select></label><label>Status<select data-binding-status><option value="">Todos</option><option value="Vinculado">Vinculado</option><option value="Sem identidade">Sem identidade</option></select></label></section>
<section class="atlas-table-shell"><div class="table-responsive"><table class="print-branding-binding-table"><thead><tr><th>Onde será usado</th><th>Modelo / Documento</th><th>Identidade aplicada</th><th>Situação</th><th></th></tr></thead><tbody>@foreach(var row in Model){var contextName=ContextName(row.Context);var status=row.ProfileId.HasValue?"Vinculado":"Sem identidade";<tr data-binding-row data-search="@($"{contextName} {row.Description}".ToLowerInvariant())" data-type="@contextName" data-status="@status"><td><strong>@contextName</strong></td><td>@row.Description<details><summary>Detalhes técnicos</summary><code>@row.BindingKey</code></details></td><td colspan="3"><form method="post" asp-action="SaveBinding" class="binding-form">@Html.AntiForgeryToken()<input type="hidden" name="Context" value="@row.Context" /><input type="hidden" name="BindingKey" value="@row.BindingKey" /><select name="ProfileId" aria-label="Identidade visual"><option value="">Sem identidade</option>@foreach(var p in profiles.Where(x=>x.Status=="ACTIVE")){<option value="@p.Id" selected="@(p.Id==row.ProfileId)">@p.ProfileName — @(p.ClientName??"Cliente não informado")</option>}</select><span class="binding-status">@status</span><button class="atlas-btn atlas-btn-primary" type="submit">Aplicar</button></form></td></tr>}</tbody></table></div></section></main>
<script src="~/js/print-branding-bindings.js" asp-append-version="true"></script>
