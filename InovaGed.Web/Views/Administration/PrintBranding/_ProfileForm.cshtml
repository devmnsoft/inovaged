@model InovaGed.Web.Models.Branding.PrintBrandingProfileInput
@{ var assets=ViewBag.Assets as IReadOnlyList<InovaGed.Web.Models.Branding.BrandAssetVm>??Array.Empty<InovaGed.Web.Models.Branding.BrandAssetVm>(); }
<form method="post" asp-action="@ViewBag.FormAction" asp-route-id="@Model.Id" class="print-branding-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<fieldset><legend>Identificação</legend><label asp-for="ProfileCode">Código do perfil</label><input asp-for="ProfileCode" /><label asp-for="ProfileName">Nome do perfil</label><input asp-for="ProfileName" /><label asp-for="ClientName">Cliente</label><input asp-for="ClientName" /><label asp-for="ContractName">Contrato</label><input asp-for="ContractName" /><label asp-for="OrganizationName">Órgão/empresa</label><input asp-for="OrganizationName" /></fieldset>
<fieldset><legend>Logos oficiais</legend><label asp-for="PrimaryLogoAssetId">Logo principal</label><select asp-for="PrimaryLogoAssetId"><option value="">Sem logo</option>@foreach(var a in assets){<option value="@a.Id">@a.AssetName — @a.BrandName</option>}</select><label asp-for="SecondaryLogoAssetId">Logo secundária opcional</label><select asp-for="SecondaryLogoAssetId"><option value="">Sem logo secundária</option>@foreach(var a in assets){<option value="@a.Id">@a.AssetName — @a.BrandName</option>}</select><p class="form-hint">As imagens são exibidas com <code>object-fit: contain</code>, sem filtros, cortes ou alteração de proporção.</p></fieldset>
<fieldset><legend>Cabeçalho e rodapé</legend><label asp-for="HeaderTitle">Título</label><input asp-for="HeaderTitle" /><label asp-for="HeaderSubtitle">Subtítulo</label><input asp-for="HeaderSubtitle" /><label asp-for="HeaderExtraLine">Linha extra</label><input asp-for="HeaderExtraLine" /><label asp-for="FooterText">Rodapé</label><textarea asp-for="FooterText"></textarea><label asp-for="FooterExtraLine">Linha extra do rodapé</label><input asp-for="FooterExtraLine" /><label><input asp-for="ShowGeneratedAt" /> Exibir data de geração</label><label><input asp-for="ShowPageNumber" /> Exibir número de página</label><label><input asp-for="ShowProtocolInfo" /> Exibir protocolo</label></fieldset>
<fieldset><legend>Impressão</legend><label asp-for="LogoPosition">Posição principal</label><select asp-for="LogoPosition"><option value="TOP_LEFT">Superior esquerda</option><option value="TOP_CENTER">Superior centro</option><option value="TOP_RIGHT">Superior direita</option></select><label asp-for="SecondaryLogoPosition">Posição secundária</label><select asp-for="SecondaryLogoPosition"><option value="TOP_RIGHT">Superior direita</option><option value="TOP_LEFT">Superior esquerda</option></select><label asp-for="PrimaryLogoWidthMm">Largura principal (mm)</label><input asp-for="PrimaryLogoWidthMm" type="number" step="0.1" /><label asp-for="SecondaryLogoWidthMm">Largura secundária (mm)</label><input asp-for="SecondaryLogoWidthMm" type="number" step="0.1" /><label asp-for="PaperSize">Papel</label><select asp-for="PaperSize"><option>A4</option><option>LETTER</option></select><label asp-for="Orientation">Orientação</label><select asp-for="Orientation"><option value="PORTRAIT">Retrato</option><option value="LANDSCAPE">Paisagem</option></select><div class="margin-grid"><label>Superior (mm)<input asp-for="MarginTopMm" type="number" /></label><label>Direita (mm)<input asp-for="MarginRightMm" type="number" /></label><label>Inferior (mm)<input asp-for="MarginBottomMm" type="number" /></label><label>Esquerda (mm)<input asp-for="MarginLeftMm" type="number" /></label></div><label><input asp-for="IsDefault" /> Definir como padrão</label></fieldset>
<footer><a class="atlas-btn atlas-btn-secondary" asp-action="Index">Cancelar</a><button class="atlas-btn atlas-btn-primary" type="submit">Salvar perfil visual</button></footer></form>
