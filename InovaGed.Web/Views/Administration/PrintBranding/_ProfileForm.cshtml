@model InovaGed.Web.Models.Branding.PrintBrandingProfileInput
@{ var assets=ViewBag.Assets as IReadOnlyList<InovaGed.Web.Models.Branding.BrandAssetVm>??Array.Empty<InovaGed.Web.Models.Branding.BrandAssetVm>(); }
<div class="branding-editor" data-branding-editor>
<form method="post" asp-action="@ViewBag.FormAction" asp-route-id="@Model.Id" class="print-branding-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<section><header><span>1</span><div><h2>Cliente</h2><p>Identifique para quem esta composição será usada.</p></div></header><div class="form-fields"><label asp-for="ProfileName">Nome do perfil<input asp-for="ProfileName" data-preview="profile" placeholder="Prefeitura de Ananindeua — GED" /></label><label asp-for="ProfileCode">Código interno<input asp-for="ProfileCode" placeholder="ANANINDEUA_GED" /></label><label asp-for="ClientName">Nome do cliente<input asp-for="ClientName" data-preview="client" placeholder="Prefeitura Municipal de Ananindeua" /></label><label asp-for="ContractName">Contrato<input asp-for="ContractName" data-preview="contract" placeholder="Contrato 012/2026" /></label><label asp-for="OrganizationName" class="field-wide">Organização / órgão<input asp-for="OrganizationName" data-preview="organization" placeholder="Secretaria Municipal de Administração" /></label></div></section>
<section><header><span>2</span><div><h2>Logos</h2><p>Use somente arquivos oficiais deste cliente.</p></div></header><div class="form-fields"><label asp-for="PrimaryLogoAssetId">Logo principal<select asp-for="PrimaryLogoAssetId" data-logo-select="primary"><option value="">Sem logo</option>@foreach(var a in assets){<option value="@a.Id" data-url="@a.FileUrl" data-name="@a.AssetName" data-brand="@a.BrandName">@a.AssetName — @a.BrandName</option>}</select></label><label asp-for="SecondaryLogoAssetId">Logo secundária<select asp-for="SecondaryLogoAssetId" data-logo-select="secondary"><option value="">Sem logo secundária</option>@foreach(var a in assets){<option value="@a.Id" data-url="@a.FileUrl" data-name="@a.AssetName" data-brand="@a.BrandName">@a.AssetName — @a.BrandName</option>}</select></label></div><a class="branding-context-link" href="/Administration/BrandAssets/Create"><app-icon name="image" size="17" decorative="true" /> Enviar nova logo</a></section>
<section><header><span>3</span><div><h2>Cabeçalho</h2><p>Textos exibidos no topo da composição.</p></div></header><div class="form-fields"><label asp-for="HeaderTitle">Título<input asp-for="HeaderTitle" data-preview="title" placeholder="ARQUIVO CENTRAL" /></label><label asp-for="HeaderSubtitle">Subtítulo<input asp-for="HeaderSubtitle" data-preview="subtitle" placeholder="Gestão Documental" /></label><label asp-for="HeaderExtraLine" class="field-wide">Linha adicional<input asp-for="HeaderExtraLine" data-preview="extra" placeholder="Contrato 012/2026" /></label></div></section>
<section><header><span>4</span><div><h2>Rodapé</h2><p>Informações de apoio usadas pelos renderizadores.</p></div></header><div class="form-fields"><label asp-for="FooterText" class="field-wide">Texto do rodapé<textarea asp-for="FooterText" data-preview="footer"></textarea></label><label asp-for="FooterExtraLine" class="field-wide">Linha adicional<input asp-for="FooterExtraLine" data-preview="footer-extra" /></label></div><div class="check-row"><label><input asp-for="ShowGeneratedAt" /> Mostrar data de geração</label><label><input asp-for="ShowPageNumber" /> Mostrar número da página</label><label><input asp-for="ShowProtocolInfo" /> Mostrar protocolo</label></div></section>
<details class="branding-advanced"><summary><span>5</span><div><strong>Aparência avançada</strong><small>Na maioria dos casos, mantenha os valores automáticos.</small></div></summary><div class="form-fields"><label asp-for="LogoPosition">Posição da logo<select asp-for="LogoPosition"><option value="TOP_LEFT">Superior esquerda</option><option value="TOP_CENTER">Superior centro</option><option value="TOP_RIGHT">Superior direita</option></select></label><label asp-for="SecondaryLogoPosition">Posição da logo secundária<select asp-for="SecondaryLogoPosition"><option value="TOP_RIGHT">Superior direita</option><option value="TOP_LEFT">Superior esquerda</option></select></label><label asp-for="PrimaryLogoWidthMm">Largura principal (mm)<input asp-for="PrimaryLogoWidthMm" type="number" step="0.1" /></label><label asp-for="SecondaryLogoWidthMm">Largura secundária (mm)<input asp-for="SecondaryLogoWidthMm" type="number" step="0.1" /></label><label asp-for="PaperSize">Papel<select asp-for="PaperSize"><option>A4</option><option>LETTER</option></select></label><label asp-for="Orientation">Orientação<select asp-for="Orientation"><option value="PORTRAIT">Retrato</option><option value="LANDSCAPE">Paisagem</option></select></label><label>Margem superior (mm)<input asp-for="MarginTopMm" type="number" /></label><label>Margem direita (mm)<input asp-for="MarginRightMm" type="number" /></label><label>Margem inferior (mm)<input asp-for="MarginBottomMm" type="number" /></label><label>Margem esquerda (mm)<input asp-for="MarginLeftMm" type="number" /></label></div></details>
<label class="default-check"><input asp-for="IsDefault" /> Usar como identidade padrão</label><footer><a class="atlas-btn atlas-btn-secondary" asp-action="Index">Cancelar</a><button class="atlas-btn atlas-btn-primary" type="submit">Salvar perfil visual</button></footer></form>
<button class="atlas-btn atlas-btn-secondary branding-preview-toggle" type="button" data-preview-toggle>Ver prévia</button>
<aside class="branding-live-preview" data-live-preview aria-label="Prévia da identidade visual"><span class="branding-eyebrow">Prévia da identidade</span><div class="preview-logos"><div><img data-preview-logo="primary" alt="Prévia da logo principal" hidden /><span data-logo-empty="primary">Logo principal</span></div><div><img data-preview-logo="secondary" alt="Prévia da logo secundária" hidden /><span data-logo-empty="secondary">Logo secundária</span></div></div><div class="preview-copy"><small data-preview-output="organization">Organização / órgão</small><h2 data-preview-output="title">ARQUIVO CENTRAL</h2><p data-preview-output="subtitle">Gestão Documental</p><p data-preview-output="extra">Contrato</p></div><dl><div><dt>Cliente</dt><dd data-preview-output="client">Nome do cliente</dd></div><div><dt>Contrato</dt><dd data-preview-output="contract">Contrato</dd></div></dl><footer><span data-preview-output="footer">Texto do rodapé</span><small data-preview-output="footer-extra"></small></footer></aside>
</div>
<script src="~/js/print-branding-editor.js" asp-append-version="true"></script>
