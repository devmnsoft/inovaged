@model InovaGed.Web.Models.Branding.PrintBrandingPreviewVm
@{ ViewData["Title"]="Teste de impressão"; var profiles=ViewBag.Profiles as IReadOnlyList<InovaGed.Web.Models.Branding.PrintBrandingProfileVm>??Array.Empty<InovaGed.Web.Models.Branding.PrintBrandingProfileVm>(); }
@section Styles { <link rel="stylesheet" href="~/css/print-branding-center.css" asp-append-version="true" /> }
<main class="print-branding-page atlas-page"><header class="print-branding-hero atlas-page-hero print-controls"><div><h1>Teste de impressão A4</h1><p>Valide margens, logos e textos antes de usar o perfil.</p></div><form method="post">@Html.AntiForgeryToken()<select name="profileId"><option value="">Perfil padrão</option>@foreach(var p in profiles){<option value="@p.Id" selected="@(p.Id==Model.Branding.ProfileId)">@p.ProfileName</option>}</select><button type="submit" class="atlas-btn atlas-btn-secondary">Carregar</button><button type="button" class="atlas-btn atlas-btn-primary" onclick="window.print()">Imprimir</button></form></header><article class="print-branding-test-print"><partial name="Branding/_PrintableBrandHeader" model="Model" /><section class="print-branding-example"><h2>Área útil de impressão</h2><p>Marcas discretas indicam as margens. Confirme que as logos oficiais mantêm sua proporção.</p></section><partial name="Branding/_PrintableBrandFooter" model="Model" /></article></main>
