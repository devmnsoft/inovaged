@{ ViewData["LabelHelpContext"]="BRANDING"; ViewData["Title"]="Identidade Visual"; }
@model InovaGed.Web.Models.Branding.PrintBrandingDashboardVm
@section Styles { <link rel="stylesheet" href="~/css/print-branding-center.css" asp-append-version="true" /> }
<main class="print-branding-page atlas-page">
<header class="branding-heading"><div><span class="branding-eyebrow">Configuração institucional</span><h1>Identidade Visual</h1><p>Defina como o nome, contrato, organização e logotipo do cliente aparecem nas etiquetas e documentos.</p></div><a class="atlas-btn atlas-btn-primary" asp-action="Create"><app-icon name="palette" size="18" decorative="true" /> Novo perfil visual</a></header>
<nav class="branding-secondary" aria-label="Configurações complementares"><a href="/Administration/BrandAssets"><app-icon name="image" size="18" decorative="true" /> Logos</a><a asp-action="Bindings"><app-icon name="link" size="18" decorative="true" /> Vínculos de modelos</a><a asp-action="TestPrint"><app-icon name="printer" size="18" decorative="true" /> Teste de impressão</a><button type="button" data-label-help-open="BRANDING"><app-icon name="file-text" size="18" decorative="true" /> Ajuda</button></nav>
@if(TempData["BrandingError"] is string error){<div class="atlas-alert atlas-alert-warning" role="alert">@error</div>}
@if(!Model.SchemaReady){<div class="atlas-alert atlas-alert-warning"><strong>Não foi possível carregar a configuração visual.</strong> Verifique a atualização do banco de dados.</div>}
else {
<section aria-labelledby="branding-summary-title"><h2 id="branding-summary-title" class="section-title">Resumo</h2><div class="print-branding-kpi-grid"><article><span>Perfis ativos</span><strong>@Model.Profiles.Count(x=>x.Status=="ACTIVE")</strong></article><article><span>Perfil padrão</span><strong>@(Model.DefaultProfile?.ProfileName??"Não definido")</strong></article><article><span>Logos disponíveis</span><strong>@Model.Assets.Count</strong></article><article><span>Modelos vinculados</span><strong>@Model.BindingCount</strong></article></div></section>
<section class="branding-profiles" aria-labelledby="profiles-title"><header><div><h2 id="profiles-title">Perfis visuais</h2><p>Identidades reutilizáveis para cada cliente, contrato ou órgão.</p></div></header>
@if(Model.Profiles.Count==0){<div class="atlas-empty-state branding-empty"><app-icon name="building" size="40" decorative="true" /><h3>Nenhuma identidade visual cadastrada</h3><p>Cadastre o cliente, contrato e logotipo para reutilizar a mesma identidade em etiquetas e documentos.</p><a class="atlas-btn atlas-btn-primary" asp-action="Create">Cadastrar primeira identidade</a></div>}
else{<div class="print-branding-profile-grid">@foreach(var p in Model.Profiles){<article class="print-branding-profile-card"><div class="print-branding-logo-preview">@if(p.PrimaryLogoUrl is not null){<img src="@p.PrimaryLogoUrl" alt="Logo de @p.ClientName" />}else{<span>Logo indisponível</span>}</div><div class="profile-card-title"><h3>@p.ProfileName</h3>@if(p.IsDefault){<span class="atlas-status-badge">Padrão</span>}</div><dl><div><dt>Cliente</dt><dd>@(p.ClientName??"Não informado")</dd></div><div><dt>Contrato</dt><dd>@(p.ContractName??"Não informado")</dd></div><div><dt>Organização</dt><dd>@(p.OrganizationName??"Não informada")</dd></div><div><dt>Situação</dt><dd>@(p.Status=="ACTIVE"?"Ativo":"Arquivado")</dd></div></dl><footer><a class="atlas-btn atlas-btn-secondary" asp-action="Edit" asp-route-id="@p.Id">Editar</a><details class="profile-menu"><summary aria-label="Mais ações">•••</summary><div><a asp-action="Preview" asp-route-id="@p.Id">Pré-visualizar</a>@if(!p.IsDefault&&p.Status=="ACTIVE"){<form method="post" asp-action="SetDefault" asp-route-id="@p.Id">@Html.AntiForgeryToken()<button type="submit">Definir como padrão</button></form>}<form method="post" asp-action="Duplicate" asp-route-id="@p.Id">@Html.AntiForgeryToken()<button type="submit">Duplicar perfil</button></form>@if(!p.IsDefault&&p.Status=="ACTIVE"){<form method="post" asp-action="Archive" asp-route-id="@p.Id">@Html.AntiForgeryToken()<button type="submit">Arquivar</button></form>}</div></details></footer></article>}</div>}</section>
<section class="branding-complementary"><h2>Configurações complementares</h2><p>Gerencie logos oficiais, escolha onde cada identidade será usada e valide a composição antes de imprimir.</p></section>}
</main>
<partial name="~/Views/Labels/Shared/_LabelHelpDrawer.cshtml" />
<script src="~/js/labels-help.js" asp-append-version="true"></script>
