@model InovaGed.Web.Models.Branding.PrintBrandingDashboardVm
@{ ViewData["Title"]="Identidade Visual de Impressão"; }
@section Styles { <link rel="stylesheet" href="~/css/print-branding-center.css" asp-append-version="true" /> }
<main class="print-branding-page atlas-page">
<header class="print-branding-hero atlas-page-hero"><div><span>PRINT BRANDING CENTER 2.0</span><h1>Identidade Visual de Impressão</h1><p>Configure logos, cabeçalhos, rodapés e padrões visuais para etiquetas, documentos e relatórios impressos.</p></div><a class="atlas-btn atlas-btn-primary" asp-action="Create">Cadastrar perfil visual</a></header>
@if(!Model.SchemaReady){<div class="atlas-alert atlas-alert-warning"><strong>Central aguardando banco de dados.</strong> Aplique <code>2026_09_01_print_branding_center_2.sql</code> e a migration de upload de logos. A impressão existente continuará funcionando sem logo.</div>}
else {
<section class="print-branding-kpi-grid"><article class="atlas-kpi-card"><span>Perfis ativos</span><strong>@Model.Profiles.Count(x=>x.Status=="ACTIVE")</strong></article><article class="atlas-kpi-card"><span>Logos cadastradas</span><strong>@Model.Assets.Count</strong></article><article class="atlas-kpi-card"><span>Templates vinculados</span><strong>@Model.BindingCount</strong></article><article class="atlas-kpi-card"><span>Perfil padrão</span><strong>@(Model.DefaultProfile?.ProfileName??"Pendente")</strong></article><article class="atlas-kpi-card"><span>Documentos com branding</span><strong>@Model.BindingCount</strong></article><article class="atlas-kpi-card"><span>Pendências visuais</span><strong>@(Model.DefaultProfile is null?1:0)</strong></article></section>
<section class="print-branding-actions"><a class="atlas-action-card" asp-action="Create"><strong>Cadastrar perfil visual</strong><span>Cliente, contrato e órgão</span></a><a class="atlas-action-card" href="/Administration/BrandAssets"><strong>Gerenciar logos</strong><span>Somente artes oficiais</span></a><a class="atlas-action-card" asp-action="Bindings"><strong>Vincular templates</strong><span>Aplicação automática</span></a><a class="atlas-action-card" asp-action="TestPrint"><strong>Imprimir teste</strong><span>Prévia A4 fiel</span></a><a class="atlas-action-card" asp-action="Preview" asp-route-id="@Model.DefaultProfile?.Id"><strong>Ver preview</strong><span>Conferir antes de imprimir</span></a><a class="atlas-action-card" href="/Labels/PrintWizard"><strong>Abrir etiquetas</strong><span>Usar no assistente</span></a></section>
<section class="atlas-table-shell"><header><h2>Perfis visuais</h2><p>Identidades isoladas por cliente e tenant.</p></header>@if(Model.Profiles.Count==0){<div class="atlas-empty-state">Nenhum perfil cadastrado.</div>}else{<div class="print-branding-profile-grid">@foreach(var p in Model.Profiles){<article class="print-branding-profile-card">@if(p.PrimaryLogoUrl is not null){<div class="print-branding-logo-preview"><img src="@p.PrimaryLogoUrl" alt="Logo oficial de @p.ProfileName" /></div>}<h3>@p.ProfileName</h3><p>@p.ClientName · @p.ContractName</p><span class="atlas-status-badge">@p.Status</span>@if(p.IsDefault){<span class="atlas-status-badge">Padrão</span>}<nav><a asp-action="Preview" asp-route-id="@p.Id">Preview</a><a asp-action="Edit" asp-route-id="@p.Id">Editar</a>@if(!p.IsDefault&&p.Status=="ACTIVE"){<form method="post" asp-action="SetDefault" asp-route-id="@p.Id">@Html.AntiForgeryToken()<button type="submit">Definir padrão</button></form>}<form method="post" asp-action="Archive" asp-route-id="@p.Id">@Html.AntiForgeryToken()<button type="submit">Arquivar</button></form></nav></article>}</div>}</section>}
</main>
