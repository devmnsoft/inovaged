@model InovaGed.Web.Models.Administration.EnvironmentReadinessVM
@{ var atlasHeader = new InovaGed.Web.Models.Atlas.AtlasPageHeaderVm("Prontidão do ambiente", "Saúde, segurança e recomendações acionáveis para operação.", "health", "Administração"); }
<partial name="Atlas/_PageHeader" model="atlasHeader" />
@{ ViewData["Title"] = "Prontidão do ambiente"; ViewData["Subtitle"] = "Banco, migrations, dependências, workers e módulos"; }
<header class="ig-page-header"><div><span class="ig-eyebrow">Operações seguras</span><h1>Central de Prontidão Operacional</h1><p>Valide o ambiente antes de liberá-lo, sem expor segredos ou executar SQL pelo navegador.</p></div><a class="btn btn-outline-secondary" asp-action="Readiness">Revalidar ambiente</a></header>
<div class="ig-kpi-grid"><article class="ig-kpi-card"><strong>@Model.Available</strong><span>Módulos disponíveis</span></article><article class="ig-kpi-card"><strong>@Model.Pending</strong><span>Pendências</span></article></div>
<section class="ig-action-card"><span><strong>Implantação e Release</strong><small>Versão atual: @Model.Release.Version</small><small>Commit: @Model.Release.Commit</small><small>Deployment ID: @Model.Release.DeploymentId</small><small>Implantada em UTC: @(Model.Release.DeployedAtUtc?.ToString("u") ?? "não informado")</small><small>Schema: @Model.Release.Schema</small><small>Release anterior: @Model.Release.PreviousRelease</small><small>Rollback binário: @(Model.Release.RollbackAvailable ? "disponível, sujeito à compatibilidade do schema" : "indisponível")</small></span></section>
<div class="ig-action-grid">@foreach (var readinessItem in Model.Modules) { <article class="ig-action-card @(readinessItem.Available ? string.Empty : "is-disabled")"><span><strong>@readinessItem.ModuleCode</strong><span class="ig-status">@readinessItem.Status</span><small>Versão esperada: 04.1.20</small><small>Versão encontrada: @(readinessItem.SchemaReady ? "compatível" : "pendente")</small><small>Verificado em @readinessItem.CheckedAtUtc.ToString("u")</small>@if (readinessItem.MissingObjects.Count > 0) { <details><summary>Ver objetos ausentes</summary><ul>@foreach (var missingObject in readinessItem.MissingObjects) { <li>@missingObject</li> }</ul></details> }@foreach (var recommendationItem in readinessItem.Recommendations) { <small>@recommendationItem</small> }</span></article> }</div>
<p><a class="btn btn-primary" asp-action="ExportReadiness">Baixar relatório JSON</a></p>
