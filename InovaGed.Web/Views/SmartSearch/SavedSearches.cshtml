@model IReadOnlyList<InovaGed.Application.SmartSearch.SmartSearchSavedSearch>
@{
    ViewData["Title"] = "Buscas salvas";
}
<section class="container-fluid py-4">
    @Html.AntiForgeryToken()
    <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><span class="text-primary fw-semibold">SmartSearch</span><h1 class="h3 mb-1">Buscas salvas</h1><p class="text-muted mb-0">Atalhos privados da sua conta, isolados por organização.</p></div>
        <a class="btn btn-primary" asp-action="Index"><app-icon name="smart-search" size="16" decorative="true" /> Nova busca</a>
    </header>
    @if (TempData["Error"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-5"><app-icon name="bookmark" size="40" decorative="true" /><h2 class="h5 mt-3">Nenhuma busca salva</h2><p class="text-muted">Faça uma consulta no SmartSearch e salve-a para encontrá-la aqui.</p><a class="btn btn-outline-primary" asp-action="Index">Abrir SmartSearch</a></div></div>
    }
    else
    {
        <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-12 col-lg-6" data-saved-card="@item.Id"><article class="card h-100 shadow-sm"><div class="card-body">
                <div class="d-flex justify-content-between gap-3"><div><h2 class="h5" data-saved-name>@(item.IsFavorite ? "★ " : "")@item.Name</h2><p class="text-muted mb-2">@item.Query</p><small class="text-muted">@item.RunCount execução(ões) · criada em @item.CreatedAt.ToString("dd/MM/yyyy")@(item.LastRunAt.HasValue ? $" · última em {item.LastRunAt:dd/MM/yyyy HH:mm}" : "")</small></div></div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button class="btn btn-sm btn-primary" type="button" data-saved-action="run" data-id="@item.Id"><app-icon name="search" size="15" decorative="true" /> Executar</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-saved-action="rename" data-id="@item.Id" data-name="@item.Name">Renomear</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-saved-action="favorite" data-id="@item.Id" data-favorite="@item.IsFavorite.ToString().ToLowerInvariant()">@(item.IsFavorite ? "Desfavoritar" : "Favoritar")</button>
                    <button class="btn btn-sm btn-outline-danger" type="button" data-saved-action="delete" data-id="@item.Id">Excluir</button>
                </div>
            </div></article></div>
        }
        </div>
    }
</section>
<script>
(() => {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const endpoints = { run: '@Url.Action("RunSavedSearch")', rename: '@Url.Action("RenameSavedSearch")', favorite: '@Url.Action("FavoriteSavedSearch")', delete: '@Url.Action("DeleteSavedSearch")' };
    document.addEventListener('click', async event => {
        const button = event.target.closest('[data-saved-action]');
        if (!button) return;
        const action = button.dataset.savedAction;
        const body = new URLSearchParams({ id: button.dataset.id, __RequestVerificationToken: token || '' });
        if (action === 'delete' && !confirm('Excluir esta busca salva? Esta ação não poderá ser desfeita.')) return;
        if (action === 'rename') {
            const name = prompt('Novo nome da busca:', button.dataset.name || '');
            if (!name) return;
            body.set('name', name);
        }
        if (action === 'favorite') body.set('isFavorite', button.dataset.favorite !== 'true' ? 'true' : 'false');
        button.disabled = true;
        try {
            const response = await fetch(endpoints[action], { method: 'POST', headers: { Accept: 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' }, body });
            const data = await response.json();
            if (!response.ok || !data.success) throw new Error(data.message || 'Não foi possível concluir a ação.');
            if (action === 'run') location.href = '@Url.Action("Index")?q=' + encodeURIComponent(data.query);
            else location.reload();
        } catch (error) { alert(error.message || 'O SmartSearch está temporariamente indisponível.'); button.disabled = false; }
    });
})();
</script>
