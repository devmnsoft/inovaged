@{
    ViewData["Title"] = "Assistente Documental Inteligente";
    ViewData["WorkspaceVariant"] = "wide";
    ViewData["Subtitle"] = "Localize documentos por conteúdo, metadados, classificação, etiquetas e rastreabilidade.";
    ViewData["Icon"] = "sparkles";
}
@section Styles { <link rel="stylesheet" href="~/css/pages/document-assistant.css" asp-append-version="true" /> }

<div class="atlas-page mb-4"><partial name="Atlas/_AtlasPageHero" /></div>

<main class="document-assistant" data-document-assistant data-endpoint="@Url.Action("Ask", "SmartSearch")" data-feedback-endpoint="@Url.Action("Feedback", "SmartSearch")" data-history-endpoint="@Url.Action("HistoryData", "SmartSearch")" data-saved-endpoint="@Url.Action("SavedSearches", "SmartSearch")" data-save-endpoint="@Url.Action("SaveSearch", "SmartSearch")" data-run-saved-endpoint="@Url.Action("RunSavedSearch", "SmartSearch")" data-rename-saved-endpoint="@Url.Action("RenameSavedSearch", "SmartSearch")" data-favorite-saved-endpoint="@Url.Action("FavoriteSavedSearch", "SmartSearch")" data-delete-saved-endpoint="@Url.Action("DeleteSavedSearch", "SmartSearch")">
    <header class="assistant-hero">
        <div><span class="assistant-eyebrow"><app-icon name="smart-search" size="16" decorative="true" /> Inteligência documental rastreável</span><h1>Assistente Documental Inteligente</h1><p>Converse com o acervo autorizado. Cada resposta indica critérios e documentos que sustentam o resultado.</p></div>
        <div class="assistant-hero-actions"><button class="btn btn-outline-secondary" type="button" data-toggle-history><app-icon name="history" size="16" decorative="true" /> Histórico</button><button class="btn btn-outline-secondary" type="button" data-save-search disabled><app-icon name="bookmark" size="16" decorative="true" /> Salvar busca</button><a class="btn btn-outline-secondary" asp-action="Statistics"><app-icon name="report" size="16" decorative="true" /> Insights</a><button class="btn btn-outline-secondary" type="button" data-export-conversation disabled><app-icon name="download" size="16" decorative="true" /> Exportar</button><button class="btn btn-ghost" type="button" data-clear-conversation><app-icon name="delete" size="16" decorative="true" /> Limpar conversa</button></div>
    </header>

    <section class="assistant-trust" aria-label="Garantias da busca"><span><app-icon name="permissions" size="16" decorative="true" /> Respeita suas permissões</span><span><app-icon name="document" size="16" decorative="true" /> Respostas com fontes</span><span><app-icon name="search" size="16" decorative="true" /> Sem evidência, sem invenção</span></section>

    <section class="assistant-shell">
        <aside class="assistant-suggestions"><section data-saved-panel><div class="d-flex align-items-center justify-content-between"><h2>Buscas salvas</h2><a class="btn btn-sm btn-ghost" href="@Url.Action("SavedSearches", "SmartSearch")" aria-label="Gerenciar buscas salvas"><app-icon name="edit" size="15" decorative="true" /></a></div><p>Atalhos privados da sua conta.</p><div class="assistant-history-list" data-saved-list></div></section><section data-history-panel @(ViewBag.ShowHistory == true ? null : "hidden")><div class="d-flex align-items-center justify-content-between"><h2>Histórico de conversas</h2><button class="btn btn-sm btn-ghost" type="button" data-clear-history aria-label="Atualizar histórico"><app-icon name="refresh" size="15" decorative="true" /></button></div><p>Suas conversas recentes, isoladas por usuário e organização.</p><div class="assistant-history-list" data-history-list></div></section><section><h2>Perguntas sugeridas</h2><p>Use um ponto de partida ou escreva com suas palavras.</p><div class="assistant-chip-list">
            @foreach (var suggestion in new[] { "Quais documentos estão sem OCR?", "Quais documentos estão sem índice?", "Mostre faturas hospitalares com glosa", "Quais notas vencem este mês?", "Documentos da competência julho de 2026", "Contratos com valor acima de R$ 10.000", "Documentos próximos da temporalidade", "Guias do convênio X pendentes de revisão", "Quais documentos têm baixa confiança na extração?" })
            { <button type="button" class="assistant-chip" data-suggestion="@suggestion">@suggestion</button> }
        </div></section></aside>

        <div class="assistant-conversation">
            <div class="assistant-feed" data-assistant-feed aria-live="polite">
                <div class="assistant-welcome"><app-icon name="smart-search" size="34" decorative="true" /><h2>Como posso ajudar a localizar documentos?</h2><p>Eu consulto títulos, arquivos, pastas, metadados e trechos limitados de OCR dentro do seu escopo de acesso.</p></div>
            </div>
            <form class="assistant-composer" data-assistant-form>
                @Html.AntiForgeryToken()
                <label for="assistantQuestion">Pergunte sobre os documentos</label>
                <div class="assistant-compose-row"><textarea id="assistantQuestion" name="question" rows="2" maxlength="500" required placeholder="Ex.: mostre documentos sem OCR enviados este mês">@ViewBag.InitialQuestion</textarea><button class="btn btn-primary" type="submit" data-submit><app-icon name="search" size="18" decorative="true" /> <span>Consultar</span></button></div>
                <small>As respostas são baseadas somente em evidências encontradas no GED.</small>
            </form>
        </div>
    </section>
</main>

@section Scripts { <script src="~/js/document-assistant.js" asp-append-version="true"></script> }
