@{
    ViewData["Title"] = "Busca inteligente";
    ViewData["WorkspaceVariant"] = "wide";
    ViewData["Subtitle"] = "Pesquise por assunto, nome, protocolo ou conteúdo dos documentos.";
    ViewData["Icon"] = "sparkles";
}
@section Styles { <link rel="stylesheet" href="~/css/pages/document-assistant.css" asp-append-version="true" /> }

<main class="document-assistant" data-document-assistant data-endpoint="@Url.Action("Ask", "SmartSearch")" data-feedback-endpoint="@Url.Action("Feedback", "SmartSearch")" data-history-endpoint="@Url.Action("HistoryData", "SmartSearch")" data-saved-endpoint="@Url.Action("SavedSearches", "SmartSearch")" data-save-endpoint="@Url.Action("SaveSearch", "SmartSearch")" data-run-saved-endpoint="@Url.Action("RunSavedSearch", "SmartSearch")" data-rename-saved-endpoint="@Url.Action("RenameSavedSearch", "SmartSearch")" data-favorite-saved-endpoint="@Url.Action("FavoriteSavedSearch", "SmartSearch")" data-delete-saved-endpoint="@Url.Action("DeleteSavedSearch", "SmartSearch")" data-suggest-endpoint="@Url.Action("Suggest", "SmartSearch")" data-refine-endpoint="@Url.Action("Refine", "SmartSearch")" data-related-endpoint="@Url.Action("Related", "SmartSearch")" data-compare-endpoint="@Url.Action("Compare", "SmartSearch")" data-collections-endpoint="@Url.Action("Collections", "SmartSearch")" data-create-collection-endpoint="@Url.Action("CreateCollection", "SmartSearch")" data-add-collection-endpoint="@Url.Action("AddToCollection", "SmartSearch")" data-evidence-endpoint="@Url.Action("AskDocuments", "SmartSearch")">
    <header class="assistant-hero">
        <div><h1>Busca inteligente</h1><p>Encontre documentos, confira informações e organize sua pesquisa.</p></div>
        <details class="assistant-secondary"><summary class="btn btn-outline-secondary">Mais opções</summary><div><button class="btn btn-ghost" type="button" data-toggle-history><app-icon name="history" size="16" decorative="true" /> Histórico</button><button class="btn btn-ghost" type="button" data-save-search disabled><app-icon name="bookmark" size="16" decorative="true" /> Salvar pesquisa</button><a class="btn btn-ghost" asp-action="Statistics"><app-icon name="report" size="16" decorative="true" /> Insights</a><button class="btn btn-ghost" type="button" data-export-conversation disabled><app-icon name="download" size="16" decorative="true" /> Exportar</button><button class="btn btn-ghost" type="button" data-clear-conversation><app-icon name="delete" size="16" decorative="true" /> Limpar pesquisa</button></div></details>
    </header>

    <section class="assistant-shell">
        <aside class="assistant-suggestions" data-filter-drawer><div class="assistant-aside-heading"><h2>Pesquisa e filtros</h2><button class="btn-close" type="button" data-close-filters aria-label="Fechar filtros"></button></div><section data-saved-panel><div class="d-flex align-items-center justify-content-between"><h3>Pesquisas salvas</h3><a class="btn btn-sm btn-ghost" href="@Url.Action("SavedSearches", "SmartSearch")">Gerenciar</a></div><div class="assistant-history-list" data-saved-list></div></section><section data-history-panel @(ViewBag.ShowHistory == true ? null : "hidden")><div class="d-flex align-items-center justify-content-between"><h3>Histórico</h3><button class="btn btn-sm btn-ghost" type="button" data-clear-history>Atualizar</button></div><div class="assistant-history-list" data-history-list></div></section><section data-initial-guidance><h3>Exemplos de pesquisa</h3><p>Escolha um exemplo para preencher o campo. A pesquisa só começa quando você confirmar.</p><div class="assistant-chip-list">
            @foreach (var suggestion in new[] { "Contratos de manutenção de 2025", "Protocolo 001234/2026", "Faturas hospitalares com glosa", "Documentos sem OCR" })
            { <button type="button" class="assistant-chip" data-suggestion="@suggestion">@suggestion</button> }
        </div></section><section><details class="assistant-how"><summary>Como pesquisar</summary><p>Use palavras comuns, um protocolo ou uma frase entre aspas. Você poderá refinar o escopo depois.</p></details></section></aside>

        <div class="assistant-conversation">
            <nav class="assistant-mode" aria-label="Modo da busca">
                <button type="button" class="is-active" data-search-mode="search" aria-pressed="true">Buscar documentos</button>
                <button type="button" data-search-mode="ask" aria-pressed="false">Perguntar aos documentos</button>
            </nav>
            <div class="assistant-toolbar"><button class="btn btn-sm btn-outline-secondary" type="button" data-open-filters aria-expanded="false"><app-icon name="filter" size="16" decorative="true" /> Filtros <span data-filter-count>0</span></button><fieldset data-density><legend>Visualização</legend><button type="button" class="is-active" data-density-value="comfortable" aria-pressed="true">Confortável</button><button type="button" data-density-value="compact" aria-pressed="false">Compacta</button></fieldset></div>
            <section class="evidence-workspace" data-evidence-workspace hidden>
                <form data-evidence-form>
                    <label for="documentQuestion">Pergunta sobre o acervo</label>
                    <div class="assistant-compose-row"><textarea id="documentQuestion" maxlength="500" rows="2" required placeholder="Ex.: Qual prazo consta nestes contratos?"></textarea><button class="btn btn-primary" type="submit">Perguntar</button></div>
                    <fieldset><legend>Escopo da análise</legend><label><input type="radio" name="evidenceScope" value="searchResults" checked> Todos os resultados da pesquisa atual <small data-current-search-scope>Nenhuma pesquisa executada</small></label><label><input type="radio" name="evidenceScope" value="selectedDocuments"> Documentos selecionados <small data-selected-scope>0 selecionados</small></label><label><input type="radio" name="evidenceScope" value="collection"> Coleção de trabalho <select data-evidence-collection aria-label="Coleção de trabalho"><option value="">Selecione</option></select></label></fieldset>
                    <p class="evidence-help">As respostas consideram somente os documentos indicados no escopo. Confira as fontes antes de usar a informação.</p>
                    <button type="button" class="btn btn-ghost" data-cancel-evidence hidden>Cancelar análise</button>
                </form>
                <div data-evidence-result aria-live="polite"><div class="assistant-welcome"><app-icon name="document" size="34" decorative="true" /><h2>Faça uma pergunta sobre um escopo definido</h2><p>Sem provedor de IA, o InovaGED apresenta passagens relevantes — não uma resposta simulada.</p></div></div>
                <aside class="evidence-panel" data-evidence-panel hidden aria-label="Fonte ativa"></aside>
            </section>
            <div class="assistant-feed" data-assistant-feed aria-live="polite">
                <div class="assistant-welcome"><app-icon name="smart-search" size="34" decorative="true" /><h2>O que você precisa encontrar?</h2><p>Pesquise por assunto, nome, protocolo ou conteúdo autorizado dos documentos.</p></div>
            </div>
            <section class="assistant-scope" data-search-scope hidden aria-label="Escopo da pesquisa"><div><strong>Pesquisa atual</strong><div data-scope-chips></div></div><div class="assistant-scope-actions"><button type="button" class="btn btn-sm btn-outline-primary" data-search-within>Pesquisar dentro destes resultados</button><button type="button" class="btn btn-sm btn-ghost" data-undo-refinement disabled>Desfazer refinamento</button><button type="button" class="btn btn-sm btn-ghost" data-clear-filters>Limpar filtros</button><button type="button" class="btn btn-sm btn-ghost" data-new-search>Nova pesquisa</button></div><p data-refinement-status aria-live="polite"></p></section>
            <div class="assistant-bulk" data-bulk-bar hidden><strong><span data-selection-count>0</span> selecionado(s) nesta pesquisa</strong><span>Seleção explícita, limitada aos itens marcados.</span><button type="button" class="btn btn-sm btn-primary" data-compare>Comparar</button><button type="button" class="btn btn-sm btn-outline-primary" data-add-collection>Adicionar à coleção</button><button type="button" class="btn btn-sm btn-ghost" data-clear-selection>Limpar seleção</button></div>
            <form class="assistant-refine" data-refine-form hidden><label for="assistantRefinement">Refinar a pesquisa atual</label><div><input id="assistantRefinement" maxlength="300" placeholder="Ex.: agora de 2024 ou somente da unidade financeira"><button class="btn btn-outline-primary" type="submit">Aplicar</button></div><small>Os filtros atuais serão mantidos, exceto quando você pedir explicitamente para removê-los ou iniciar nova pesquisa.</small><div data-refinement-options></div></form>
            <form class="assistant-composer" data-assistant-form>
                @Html.AntiForgeryToken()
                <label for="assistantQuestion">O que você deseja encontrar?</label>
                <div class="assistant-compose-row"><div class="assistant-search-field"><textarea id="assistantQuestion" name="question" rows="2" maxlength="500" required placeholder="Ex.: contratos de manutenção de 2025" aria-describedby="assistantSearchHelp" aria-autocomplete="list" aria-controls="assistantAutocomplete" aria-expanded="false">@ViewBag.InitialQuestion</textarea><button type="button" class="assistant-clear-input" data-clear-input aria-label="Limpar pesquisa" hidden>×</button></div><button class="btn btn-primary" type="submit" data-submit><app-icon name="search" size="18" decorative="true" /> <span>Pesquisar</span></button></div>
                <div id="assistantAutocomplete" class="assistant-autocomplete" role="listbox" hidden></div><div class="assistant-interpretation" data-interpretation hidden><strong>Filtros reconhecidos</strong><div data-interpretation-chips></div><button type="button" class="btn btn-sm btn-ghost" data-remove-interpretation>Remover interpretação</button></div><small id="assistantSearchHelp">Pressione Enter para pesquisar. Use aspas para frases exatas.</small>
            </form>
        </div>
    </section>
    <button class="assistant-drawer-backdrop" type="button" data-close-filters aria-label="Fechar filtros" hidden></button>
    <aside class="assistant-preview" data-document-preview hidden aria-label="Visualização rápida" aria-live="polite"><div data-preview-content></div></aside>
    <dialog class="assistant-dialog assistant-save-dialog" data-save-dialog><form data-save-form><button class="btn-close" type="button" data-close-dialog aria-label="Fechar"></button><h2>Salvar pesquisa</h2><p>Guarde a consulta e os filtros aplicados como um atalho privado.</p><label for="savedSearchName">Nome da pesquisa</label><input id="savedSearchName" name="name" maxlength="120" required><div class="assistant-dialog-summary" data-save-summary></div><div class="assistant-dialog-actions"><button class="btn btn-ghost" type="button" data-close-dialog>Cancelar</button><button class="btn btn-primary" type="submit">Salvar pesquisa</button></div></form></dialog>
    <dialog class="assistant-dialog" data-comparison-dialog><form method="dialog"><button class="btn-close" aria-label="Fechar"></button></form><h2>Comparar documentos</h2><p>Campos equivalentes são alinhados. “—” indica campo vazio; “Não disponível” indica que a fonte não forneceu a informação.</p><div data-comparison-content></div><button type="button" class="btn btn-outline-primary" data-compare-text>Comparar texto extraído</button><p class="assistant-legal-note">Diferenças de OCR podem resultar da extração e não comprovam alteração, autenticidade ou conclusão jurídica.</p></dialog>
    <dialog class="assistant-dialog" data-collection-dialog><form method="dialog"><button class="btn-close" aria-label="Fechar"></button></form><h2>Adicionar à coleção</h2><p>Coleções são privadas e guardam referências à versão atual. O acesso será revalidado sempre que a coleção for aberta.</p><div data-collection-list></div><form data-create-collection-form><label for="newCollectionName">Nova coleção</label><div><input id="newCollectionName" maxlength="120" required><button class="btn btn-primary" type="submit">Criar e adicionar</button></div></form></dialog>
</main>

@section Scripts { <script src="~/js/document-assistant.js" asp-append-version="true"></script> }
