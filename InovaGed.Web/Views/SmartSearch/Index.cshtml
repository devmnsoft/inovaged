@{
    ViewData["Title"] = "Busca inteligente";
    ViewData["WorkspaceVariant"] = "wide";
    ViewData["Subtitle"] = "Pesquise por assunto, nome, protocolo ou conteúdo dos documentos.";
    ViewData["Icon"] = "sparkles";
}
@section Styles { <link rel="stylesheet" href="~/css/pages/document-assistant.css" asp-append-version="true" /> }

<div class="atlas-page mb-4"><partial name="Atlas/_AtlasPageHero" /></div>

<main class="document-assistant" data-document-assistant data-endpoint="@Url.Action("Ask", "SmartSearch")" data-feedback-endpoint="@Url.Action("Feedback", "SmartSearch")" data-history-endpoint="@Url.Action("HistoryData", "SmartSearch")" data-saved-endpoint="@Url.Action("SavedSearches", "SmartSearch")" data-save-endpoint="@Url.Action("SaveSearch", "SmartSearch")" data-run-saved-endpoint="@Url.Action("RunSavedSearch", "SmartSearch")" data-rename-saved-endpoint="@Url.Action("RenameSavedSearch", "SmartSearch")" data-favorite-saved-endpoint="@Url.Action("FavoriteSavedSearch", "SmartSearch")" data-delete-saved-endpoint="@Url.Action("DeleteSavedSearch", "SmartSearch")" data-suggest-endpoint="@Url.Action("Suggest", "SmartSearch")" data-refine-endpoint="@Url.Action("Refine", "SmartSearch")" data-related-endpoint="@Url.Action("Related", "SmartSearch")" data-compare-endpoint="@Url.Action("Compare", "SmartSearch")" data-collections-endpoint="@Url.Action("Collections", "SmartSearch")" data-create-collection-endpoint="@Url.Action("CreateCollection", "SmartSearch")" data-add-collection-endpoint="@Url.Action("AddToCollection", "SmartSearch")">
    <header class="assistant-hero">
        <div><span class="assistant-eyebrow"><app-icon name="smart-search" size="16" decorative="true" /> Inteligência documental rastreável</span><h1>Busca inteligente</h1><p>Pesquise por assunto, nome, protocolo ou conteúdo dos documentos. Cada resultado explica onde a correspondência foi encontrada.</p></div>
        <div class="assistant-hero-actions"><button class="btn btn-outline-secondary" type="button" data-toggle-history><app-icon name="history" size="16" decorative="true" /> Histórico</button><button class="btn btn-outline-secondary" type="button" data-save-search disabled><app-icon name="bookmark" size="16" decorative="true" /> Salvar busca</button><a class="btn btn-outline-secondary" asp-action="Statistics"><app-icon name="report" size="16" decorative="true" /> Insights</a><button class="btn btn-outline-secondary" type="button" data-export-conversation disabled><app-icon name="download" size="16" decorative="true" /> Exportar</button><button class="btn btn-ghost" type="button" data-clear-conversation><app-icon name="delete" size="16" decorative="true" /> Limpar conversa</button></div>
    </header>

    <section class="assistant-trust" aria-label="Garantias da busca"><span><app-icon name="permissions" size="16" decorative="true" /> Respeita suas permissões</span><span><app-icon name="document" size="16" decorative="true" /> Respostas com fontes</span><span><app-icon name="search" size="16" decorative="true" /> Sem evidência, sem invenção</span></section>

    <section class="assistant-shell">
        <aside class="assistant-suggestions"><section data-saved-panel><div class="d-flex align-items-center justify-content-between"><h2>Buscas salvas</h2><a class="btn btn-sm btn-ghost" href="@Url.Action("SavedSearches", "SmartSearch")" aria-label="Gerenciar buscas salvas"><app-icon name="edit" size="15" decorative="true" /></a></div><p>Atalhos privados da sua conta.</p><div class="assistant-history-list" data-saved-list></div></section><section data-history-panel @(ViewBag.ShowHistory == true ? null : "hidden")><div class="d-flex align-items-center justify-content-between"><h2>Histórico de conversas</h2><button class="btn btn-sm btn-ghost" type="button" data-clear-history aria-label="Atualizar histórico"><app-icon name="refresh" size="15" decorative="true" /></button></div><p>Suas conversas recentes, isoladas por usuário e organização.</p><div class="assistant-history-list" data-history-list></div></section><section><h2>Perguntas sugeridas</h2><p>Use um ponto de partida ou escreva com suas palavras.</p><div class="assistant-chip-list">
            @foreach (var suggestion in new[] { "Quais documentos estão sem OCR?", "Quais documentos estão sem índice?", "Mostre faturas hospitalares com glosa", "Quais notas vencem este mês?", "Documentos da competência julho de 2026", "Contratos com valor acima de R$ 10.000", "Documentos próximos da temporalidade", "Guias do convênio X pendentes de revisão", "Quais documentos têm baixa confiança na extração?" })
            { <button type="button" class="assistant-chip" data-suggestion="@suggestion">@suggestion</button> }
        </div></section></aside>

        <div class="assistant-conversation">
            <div class="assistant-feed" data-assistant-feed aria-live="polite">
                <div class="assistant-welcome"><app-icon name="smart-search" size="34" decorative="true" /><h2>Como posso ajudar a localizar documentos?</h2><p>Eu consulto títulos, arquivos, pastas, metadados e trechos limitados de OCR dentro do seu escopo de acesso.</p></div>
            </div>
            <section class="assistant-scope" data-search-scope hidden aria-label="Escopo da pesquisa"><div><strong>Pesquisa atual</strong><div data-scope-chips></div></div><div class="assistant-scope-actions"><button type="button" class="btn btn-sm btn-outline-primary" data-search-within>Pesquisar dentro destes resultados</button><button type="button" class="btn btn-sm btn-ghost" data-undo-refinement disabled>Desfazer refinamento</button><button type="button" class="btn btn-sm btn-ghost" data-clear-filters>Limpar filtros</button><button type="button" class="btn btn-sm btn-ghost" data-new-search>Nova pesquisa</button></div><p data-refinement-status aria-live="polite"></p></section>
            <div class="assistant-bulk" data-bulk-bar hidden><strong><span data-selection-count>0</span> selecionado(s) nesta pesquisa</strong><span>Seleção explícita, limitada aos itens marcados.</span><button type="button" class="btn btn-sm btn-primary" data-compare>Comparar</button><button type="button" class="btn btn-sm btn-outline-primary" data-add-collection>Adicionar à coleção</button><button type="button" class="btn btn-sm btn-ghost" data-clear-selection>Limpar seleção</button></div>
            <form class="assistant-refine" data-refine-form hidden><label for="assistantRefinement">Refinar a pesquisa atual</label><div><input id="assistantRefinement" maxlength="300" placeholder="Ex.: agora de 2024 ou somente da unidade financeira"><button class="btn btn-outline-primary" type="submit">Aplicar</button></div><small>Os filtros atuais serão mantidos, exceto quando você pedir explicitamente para removê-los ou iniciar nova pesquisa.</small><div data-refinement-options></div></form>
            <form class="assistant-composer" data-assistant-form>
                @Html.AntiForgeryToken()
                <label for="assistantQuestion">O que você deseja encontrar?</label>
                <div class="assistant-compose-row"><textarea id="assistantQuestion" name="question" rows="2" maxlength="500" required placeholder="Ex.: contratos de manutenção de 2025" aria-describedby="assistantSearchHelp" aria-autocomplete="list" aria-controls="assistantAutocomplete">@ViewBag.InitialQuestion</textarea><button class="btn btn-primary" type="submit" data-submit><app-icon name="search" size="18" decorative="true" /> <span>Consultar</span></button></div>
                <div id="assistantAutocomplete" class="assistant-autocomplete" role="listbox" hidden></div><div class="assistant-interpretation" data-interpretation hidden><strong>Interpretamos sua busca como…</strong><div data-interpretation-chips></div><button type="button" class="btn btn-sm btn-ghost" data-remove-interpretation>Pesquisar somente pelo texto</button></div><small id="assistantSearchHelp">Use aspas para frases exatas e informe protocolos preservando barras, hífens e zeros.</small><details class="assistant-how"><summary>Como usar</summary><p><strong>Pesquisar:</strong> “contratos de manutenção de 2025”. <strong>Refinar:</strong> “somente da unidade financeira” ou “agora de 2024”. Marque de dois a três resultados para <strong>comparar</strong> ou reunir documentos em uma <strong>coleção privada</strong>.</p></details>
            </form>
        </div>
    </section>
    <dialog class="assistant-dialog" data-comparison-dialog><form method="dialog"><button class="btn-close" aria-label="Fechar"></button></form><h2>Comparar documentos</h2><p>Campos equivalentes são alinhados. “—” indica campo vazio; “Não disponível” indica que a fonte não forneceu a informação.</p><div data-comparison-content></div><button type="button" class="btn btn-outline-primary" data-compare-text>Comparar texto extraído</button><p class="assistant-legal-note">Diferenças de OCR podem resultar da extração e não comprovam alteração, autenticidade ou conclusão jurídica.</p></dialog>
    <dialog class="assistant-dialog" data-collection-dialog><form method="dialog"><button class="btn-close" aria-label="Fechar"></button></form><h2>Adicionar à coleção</h2><p>Coleções são privadas e guardam referências à versão atual. O acesso será revalidado sempre que a coleção for aberta.</p><div data-collection-list></div><form data-create-collection-form><label for="newCollectionName">Nova coleção</label><div><input id="newCollectionName" maxlength="120" required><button class="btn btn-primary" type="submit">Criar e adicionar</button></div></form></dialog>
</main>

@section Scripts { <script src="~/js/document-assistant.js" asp-append-version="true"></script> }
