@model InovaGed.Application.SmartGed.SmartGedSearchResult
@{ViewData["Title"]="Busca inteligente";ViewData["Subtitle"]="Consulta unificada e isolada por tenant em texto extraído, resumo e classificação.";ViewData["Icon"]="search";}
<partial name="Atlas/_AtlasPageHero"/><form method="post" class="input-group mb-4">@Html.AntiForgeryToken()<input class="form-control" name="query" value="@Model.Query" minlength="2" required placeholder="Título, CPF mascarado, processo, assunto ou classificação"/><button class="btn btn-primary">Buscar</button></form>
@if(!string.IsNullOrWhiteSpace(Model.Query)){<p class="text-muted">@Model.Items.Count resultado(s) em @Model.ExecutionMs ms.</p><div class="card atlas-card"><div class="table-responsive"><table class="table atlas-table"><thead><tr><th>Documento</th><th>Resumo/trecho</th><th>Classificação</th><th>Qualidade</th><th>Ação</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Document</td><td>@x.Excerpt</td><td>@x.Classification</td><td>@x.QualityStatus</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Document" asp-route-documentId="@x.DocumentId">Inteligência</a></td></tr>}@if(Model.Items.Count==0){<tr><td colspan="5" class="text-muted">Nenhum documento autorizado encontrado.</td></tr>}</tbody></table></div></div>}
