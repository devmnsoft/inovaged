@{ ViewData["Title"]="GED Inteligente"; ViewData["Subtitle"]="Analise documentos, extraia metadados, sugira classificação, temporalidade e priorize revisões com rastreabilidade."; ViewData["Icon"]="sparkles"; }
<div class="atlas-page"><partial name="Atlas/_AtlasPageHero" />
<div class="alert alert-info"><strong>Controle humano obrigatório:</strong> sugestões só se tornam decisões após aceite explícito do operador.</div>
<div class="row g-3">
@foreach(var card in new List<(string Title,string Text,string Url,string Icon)>{("Analisar documentos","Abra um documento para executar regras locais.","/Ged","bi-stars"),("Fila de revisão","Aceite ou rejeite sugestões rastreáveis.","/SmartGed/ReviewQueue","bi-inboxes"),("Busca inteligente","Pesquise OCR, metadados e classificação.","/SmartGed/Search","bi-search"),("Qualidade documental","Priorize inconsistências e baixa confiança.","/SmartGed/Quality","bi-shield-check"),("Sugestões de classificação","Revise enquadramentos propostos.","/SmartGed/ReviewQueue","bi-tags"),("Sugestões de temporalidade","Confirme prazos; nunca há eliminação automática.","/SmartGed/ReviewQueue","bi-calendar-check")}){<div class="col-md-6 col-xl-4"><a href="@card.Url" class="card atlas-card h-100 text-decoration-none"><div class="card-body"><i class="bi @card.Icon fs-3"></i><h2 class="h5 mt-3">@card.Title</h2><p class="text-muted">@card.Text</p></div></a></div>}
</div></div>
