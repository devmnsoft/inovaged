@model InovaGed.Application.SmartGed.SmartGedReviewQueue
@{
    ViewData["Title"] = "Fila de revisão inteligente";
    ViewData["Subtitle"] = "Governança humana obrigatória: revise, ajuste ou rejeite cada recomendação antes da aplicação oficial.";
    ViewData["Icon"] = "sparkles";
    var currentStatus = Model.CurrentStatus ?? "PENDING";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var previousPage = Math.Max(1, Model.Page - 1);
    var nextPage = Math.Min(Model.TotalPages, Model.Page + 1);
    var currentKind = Model.ShowingClassifications ? "classification" : "retention";
    var canRecoverExpired = InovaGed.Web.Security.RolePolicyHelper.IsFullAdmin(User);
}

@functions {
    private static string AuditStatusLabel(string? status) => status switch
    {
        "RECORDED" => "Registrada",
        "PENDING" => "Pendente",
        "FAILED" => "Falha na reconciliação",
        "RECORDING" => "Registro em confirmação",
        "NOT_REQUIRED" => "Não requerida",
        _ => "Pendente"
    };
}

<partial name="Atlas/_AtlasPageHero" />

<!-- Guia de Uso e Governança Arquivística -->
<div class="alert alert-light border d-flex align-items-start gap-3 mb-4 shadow-sm" role="region" aria-label="Instruções de governança da fila de revisão">
    <div class="fs-4 text-primary"><i class="bi bi-shield-check"></i></div>
    <div class="small">
        <strong class="d-block mb-1 text-dark">Como usar a Revisão Assistida:</strong>
        <span class="text-secondary">
            • <strong>Decisão individual:</strong> Cada ação afeta estritamente a sugestão selecionada. Nenhuma outra sugestão é aprovada ou aplicada automaticamente.<br />
            • <strong>Classificação e Temporalidade:</strong> A aprovação da classificação enfileira o cálculo canônico de temporalidade no plano vigente. A aprovação de temporalidade aciona o recálculo canônico sobre o documento sem inventar regras.<br />
            • <strong>Sugestões Obsoletas:</strong> Marcadas com aviso amarelo se o documento recebeu novas versões após a análise. Recomenda-se reanalisar a versão atual antes da decisão.<br />
            • <strong>Justificativa do Revisor:</strong> Todas as decisões exigem ou permitem justificativa personalizada, gravada na trilha de auditoria.
        </span>
    </div>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="btn-group" role="group" aria-label="Filtro por situação da sugestão">
        <a asp-action="ReviewQueue" asp-route-status="PENDING" asp-route-kind="@currentKind" class="btn @(currentStatus == "PENDING" ? "btn-primary" : "btn-outline-secondary")">
            Pendentes
        </a>
        <a asp-action="ReviewQueue" asp-route-status="PROCESSING" asp-route-kind="@currentKind" class="btn @(currentStatus == "PROCESSING" ? "btn-primary" : "btn-outline-secondary")">
            Em aplicação
        </a>
        <a asp-action="ReviewQueue" asp-route-status="FAILED" asp-route-kind="@currentKind" class="btn @(currentStatus == "FAILED" ? "btn-primary" : "btn-outline-secondary")">
            Falhas
        </a>
        <a asp-action="ReviewQueue" asp-route-status="FAILED_APPLIED" asp-route-kind="@currentKind" class="btn @(currentStatus == "FAILED_APPLIED" ? "btn-primary" : "btn-outline-secondary")">
            Aplicadas com pendência
        </a>
        <a asp-action="ReviewQueue" asp-route-status="RECOVERY_INDETERMINATE" asp-route-kind="@currentKind" class="btn @(currentStatus == "RECOVERY_INDETERMINATE" ? "btn-primary" : "btn-outline-secondary")">
            Indeterminadas
        </a>
        <a asp-action="ReviewQueue" asp-route-status="ADMIN_RESOLVED" asp-route-kind="@currentKind" class="btn @(currentStatus == "ADMIN_RESOLVED" ? "btn-primary" : "btn-outline-secondary")">
            Resolvidas
        </a>
        <a asp-action="ReviewQueue" asp-route-status="ACCEPTED" asp-route-kind="@currentKind" class="btn @(currentStatus == "ACCEPTED" ? "btn-primary" : "btn-outline-secondary")">
            Aceitas
        </a>
        <a asp-action="ReviewQueue" asp-route-status="REJECTED" asp-route-kind="@currentKind" class="btn @(currentStatus == "REJECTED" ? "btn-primary" : "btn-outline-secondary")">
            Rejeitadas
        </a>
        <a asp-action="ReviewQueue" asp-route-status="ALL" asp-route-kind="@currentKind" class="btn @(currentStatus == "ALL" ? "btn-primary" : "btn-outline-secondary")">
            Todas
        </a>
    </div>

    <div class="small text-muted">
        <i class="bi bi-clock-history me-1"></i>
        Exibindo situação: <span class="badge bg-secondary">@currentStatus</span>
        <span class="ms-2">Itens @Model.FirstItem-@Model.LastItem de @Model.ActiveTotal nesta aba</span>
    </div>

    @if (canRecoverExpired)
    {
        <form method="post" asp-action="RecoverExpiredReviews" class="d-inline-flex">
            @Html.AntiForgeryToken()
            <input type="hidden" name="status" value="@currentStatus" />
            <input type="hidden" name="kind" value="@currentKind" />
            <input type="hidden" name="page" value="@Model.Page" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-life-preserver me-1"></i> Recuperar expiradas
            </button>
        </form>
        <form method="post" asp-action="ReconcileAdministrativeAudit" class="d-inline-flex">
            @Html.AntiForgeryToken()
            <input type="hidden" name="status" value="@currentStatus" />
            <input type="hidden" name="kind" value="@currentKind" />
            <input type="hidden" name="page" value="@Model.Page" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-journal-check me-1"></i> Reconciliar auditorias
            </button>
        </form>
    }
</div>

<ul class="nav nav-tabs mb-3" role="tablist" aria-label="Tipo de recomendação">
    <li class="nav-item" role="presentation">
        <a asp-action="ReviewQueue"
           asp-route-status="@currentStatus"
           asp-route-kind="classification"
           asp-route-pageSize="@Model.PageSize"
           class="nav-link @(Model.ShowingClassifications ? "active" : "")">
            Classificação <span class="badge text-bg-light ms-1">@Model.ClassificationTotal</span>
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a asp-action="ReviewQueue"
           asp-route-status="@currentStatus"
           asp-route-kind="retention"
           asp-route-pageSize="@Model.PageSize"
           class="nav-link @(!Model.ShowingClassifications ? "active" : "")">
            Temporalidade <span class="badge text-bg-light ms-1">@Model.RetentionTotal</span>
        </a>
    </li>
</ul>

<nav class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3" aria-label="Paginação da fila de revisão">
    <div class="small text-muted">
        Página @Model.Page de @Model.TotalPages · @Model.ActiveTotal item(ns) nesta aba
    </div>
    <div class="btn-group" role="group">
        <a asp-action="ReviewQueue"
           asp-route-status="@currentStatus"
           asp-route-kind="@currentKind"
           asp-route-page="@previousPage"
           asp-route-pageSize="@Model.PageSize"
           class="btn btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")"
           aria-disabled="@(Model.Page <= 1 ? "true" : "false")">Anterior</a>
        <a asp-action="ReviewQueue"
           asp-route-status="@currentStatus"
           asp-route-kind="@currentKind"
           asp-route-page="@nextPage"
           asp-route-pageSize="@Model.PageSize"
           class="btn btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")"
           aria-disabled="@(Model.Page >= Model.TotalPages ? "true" : "false")">Próxima</a>
    </div>
</nav>

@if (Model.ShowingClassifications)
{
<!-- BLOCO 1: SUGESTÕES DE CLASSIFICAÇÃO ARQUIVÍSTICA -->
<div class="card atlas-card mb-4 shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
        <div>
            <strong class="fs-6">Sugestões de Classificação (@Model.Classifications.Count)</strong>
            <div class="small text-muted">Classes sugeridas com base no plano de classificação vigente</div>
        </div>
        <span class="badge bg-light text-dark border">Plano Vigente</span>
    </div>
    <div class="table-responsive">
        <table class="table atlas-table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="min-width: 220px;">Documento</th>
                    <th style="min-width: 240px;">Comparação Antes / Sugerido</th>
                    <th style="min-width: 200px;">Evidência / Fundamento</th>
                    <th style="width: 100px;">Confiança</th>
                    <th style="width: 110px;">Situação</th>
                    <th style="min-width: 240px;">Ações do Revisor</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.Classifications)
                {
                    <tr class="@(x.IsObsolete ? "table-warning bg-opacity-10" : "")">
                        <td>
                            <div class="fw-semibold">
                                <a asp-action="Document" asp-route-documentId="@x.DocumentId" class="text-decoration-none" title="Ver detalhes do documento">
                                    @(string.IsNullOrWhiteSpace(x.DocumentTitle) ? "Documento " + x.DocumentId.ToString()[..8] : x.DocumentTitle)
                                </a>
                            </div>
                            <div class="small text-muted d-flex align-items-center gap-2 mt-1">
                                <span>Versão: v@(x.VersionNumber ?? 1)</span>
                                @if (x.CreatedAt.HasValue)
                                {
                                    <span>· @x.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                }
                            </div>
                            @if (x.IsObsolete)
                            {
                                <div class="mt-2">
                                    <span class="badge bg-warning text-dark d-inline-flex align-items-center gap-1" title="O documento foi alterado após a análise.">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Versão Obsoleta
                                    </span>
                                    <a asp-action="Document" asp-route-documentId="@x.DocumentId" class="btn btn-link btn-sm p-0 d-block small text-primary mt-1">
                                        Reanalisar Versão Vigente
                                    </a>
                                </div>
                            }
                        </td>
                        <td>
                            <div class="small text-muted">Atual:</div>
                            <div class="small fw-semibold text-secondary mb-1">
                                @(string.IsNullOrWhiteSpace(x.CurrentClassification) ? "Não classificado" : x.CurrentClassification)
                            </div>
                            <div class="small text-muted">Sugerida:</div>
                            <div class="fw-bold text-primary">
                                @x.Code — @x.Title
                            </div>
                        </td>
                        <td>
                            <div class="small text-break">@x.Reason</div>
                            @if (!string.IsNullOrWhiteSpace(x.ReviewNotes))
                            {
                                <div class="small text-muted mt-1 fst-italic">
                                    <i class="bi bi-chat-left-text me-1"></i> Decisão anterior: @x.ReviewNotes
                                </div>
                            }
                        </td>
                        <td>
                            <div class="fw-bold @(x.Confidence >= 75 ? "text-success" : (x.Confidence >= 50 ? "text-warning" : "text-danger"))">
                                @x.Confidence%
                            </div>
                        </td>
                        <td>
                            @if (x.Status == "ACCEPTED")
                            {
                                <span class="badge bg-success">Aceita</span>
                            }
                            else if (x.Status == "REJECTED")
                            {
                                <span class="badge bg-danger">Rejeitada</span>
                            }
                            else if (x.Status == "PROCESSING")
                            {
                                <span class="badge bg-warning text-dark">Em aplicação</span>
                            }
                            else if (x.Status == "FAILED_APPLIED")
                            {
                                <span class="badge bg-warning text-dark">Aplicada com pendência</span>
                            }
                            else if (x.Status == "FAILED")
                            {
                                <span class="badge bg-danger">Falha</span>
                            }
                            else if (x.Status == "RECOVERY_INDETERMINATE")
                            {
                                <span class="badge bg-secondary">Efeito indeterminado</span>
                            }
                            else if (x.Status == "ADMIN_RESOLVED")
                            {
                                <span class="badge bg-info text-dark">Resolvida administrativamente</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Pendente</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(x.PublicFailureMessage))
                            {
                                <div class="small text-muted mt-1">@x.PublicFailureMessage</div>
                            }
                            @if (x.RecoveredAt.HasValue)
                            {
                                <div class="small text-muted mt-1">Recuperada em @x.RecoveredAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(x.RecoveryNotes))
                            {
                                <div class="small text-muted mt-1">@x.RecoveryNotes</div>
                            }
                            @if (x.AdminResolutionAt.HasValue)
                            {
                                <div class="small text-muted mt-2">
                                    <strong>Resolução administrativa:</strong><br />
                                    Responsável: @x.AdminResolutionBy<br />
                                    Data: @x.AdminResolutionAt.Value.ToString("dd/MM/yyyy HH:mm")<br />
                                    Justificativa: @x.AdminResolutionReason<br />
                                    Evidência: @x.AdminResolutionEvidence<br />
                                    Auditoria: @AuditStatusLabel(x.AdminResolutionAuditStatus)
                                </div>
                            }
                        </td>
                        <td>
                            @if (x.Status == "PENDING")
                            {
                                <div class="d-flex flex-column gap-2">
                                    <!-- Ação de Aceite com Justificativa Editável -->
                                    <details class="border rounded p-2 bg-light">
                                        <summary class="btn btn-sm btn-success w-100 text-start d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-check-lg me-1"></i> Aceitar e Aplicar</span>
                                            <i class="bi bi-chevron-down small"></i>
                                        </summary>
                                        <form method="post" asp-action="AcceptClassification" asp-route-id="@x.Id" class="mt-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="@currentStatus" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <label class="form-label small fw-semibold text-dark mb-1" for="notes-cls-@x.Id">Justificativa do Revisor:</label>
                                            <textarea id="notes-cls-@x.Id" name="notes" class="form-control form-control-sm mb-2" rows="2" placeholder="Justifique a aprovação da classe sugerida"></textarea>
                                            <button class="btn btn-sm btn-success w-100" type="submit">
                                                Confirmar Aplicação
                                            </button>
                                        </form>
                                    </details>

                                    <!-- Ação de Rejeição com Motivo Obrigatório -->
                                    <details class="border rounded p-2 bg-light">
                                        <summary class="btn btn-sm btn-outline-danger w-100 text-start d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-x-lg me-1"></i> Rejeitar Sugestão</span>
                                            <i class="bi bi-chevron-down small"></i>
                                        </summary>
                                        <form method="post" asp-action="RejectClassification" asp-route-id="@x.Id" class="mt-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="@currentStatus" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <label class="form-label small fw-semibold text-dark mb-1" for="reason-cls-@x.Id">Motivo da Rejeição (obrigatório):</label>
                                            <textarea id="reason-cls-@x.Id" name="reason" class="form-control form-control-sm mb-2" rows="2" required placeholder="Informe o motivo da rejeição"></textarea>
                                            <button class="btn btn-sm btn-danger w-100" type="submit">
                                                Confirmar Rejeição
                                            </button>
                                        </form>
                                    </details>

                                    <a asp-action="Document" asp-route-documentId="@x.DocumentId" class="btn btn-sm btn-outline-secondary w-100">
                                        <i class="bi bi-pencil-square me-1"></i> Ajustar Manualmente
                                    </a>
                                </div>
                            }
                            else if (x.Status == "PROCESSING")
                            {
                                <div class="small text-muted mb-2">Operação em andamento desde @(x.ProcessingStartedAt?.ToString("dd/MM/yyyy HH:mm") ?? "instante não registrado"). Aguarde a conclusão ou use a recuperação administrativa após expirar.</div>
                                <a asp-action="Document" asp-route-documentId="@x.DocumentId" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye me-1"></i> Acompanhar
                                </a>
                            }
                            else if (canRecoverExpired && (x.Status == "FAILED_APPLIED" || x.Status == "RECOVERY_INDETERMINATE"))
                            {
                                <details class="border rounded p-2 bg-light">
                                    <summary class="btn btn-sm btn-outline-primary w-100 text-start d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-shield-check me-1"></i> Resolver pendência</span>
                                        <i class="bi bi-chevron-down small"></i>
                                    </summary>
                                    <form method="post" asp-action="ResolveAdministrativeReview" class="mt-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="suggestionId" value="@x.Id" />
                                        <input type="hidden" name="suggestionKind" value="classification" />
                                        <input type="hidden" name="status" value="@currentStatus" />
                                        <input type="hidden" name="kind" value="@currentKind" />
                                        <input type="hidden" name="page" value="@Model.Page" />
                                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                        <div class="small text-muted mb-2">Informe a evidência conferida. Esta ação finaliza a pendência sem reaplicar a sugestão.</div>
                                        <label class="form-label small fw-semibold" for="admin-reason-cls-@x.Id">Justificativa</label>
                                        <textarea id="admin-reason-cls-@x.Id" name="reason" class="form-control form-control-sm mb-2" rows="2" required></textarea>
                                        <label class="form-label small fw-semibold" for="admin-evidence-cls-@x.Id">Evidência verificada</label>
                                        <textarea id="admin-evidence-cls-@x.Id" name="evidence" class="form-control form-control-sm mb-2" rows="2" required></textarea>
                                        <button class="btn btn-sm btn-primary w-100" type="submit">Finalizar pendência</button>
                                    </form>
                                </details>
                                <a asp-action="Document" asp-route-documentId="@x.DocumentId" class="btn btn-sm btn-outline-secondary mt-2">
                                    <i class="bi bi-eye me-1"></i> Ver Detalhes
                                </a>
                            }
                            else
                            {
                                <a asp-action="Document" asp-route-documentId="@x.DocumentId" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye me-1"></i> Ver Detalhes
                                </a>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Classifications.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-muted text-center py-4">
                            Nenhuma sugestão de classificação encontrada para a situação selecionada.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
}

@if (!Model.ShowingClassifications)
{
<!-- BLOCO 2: SUGESTÕES DE TEMPORALIDADE ARQUIVÍSTICA -->
<div class="card atlas-card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
        <div>
            <strong class="fs-6">Sugestões de Temporalidade (@Model.Retentions.Count)</strong>
            <div class="small text-muted">Recomendações assistidas com base na Tabela de Temporalidade Documental (TTD)</div>
        </div>
        <span class="badge bg-light text-dark border">Base Canônica (TTD)</span>
    </div>
    <div class="table-responsive">
        <table class="table atlas-table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="min-width: 220px;">Documento</th>
                    <th style="min-width: 240px;">Comparação Antes / Recomendado</th>
                    <th style="min-width: 200px;">Fundamento / Regra</th>
                    <th style="width: 100px;">Confiança</th>
                    <th style="width: 110px;">Situação</th>
                    <th style="min-width: 260px;">Ações do Revisor</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.Retentions)
                {
                    <tr class="@(x.IsObsolete ? "table-warning bg-opacity-10" : "")">
                        <td>
                            <div class="fw-semibold">
                                <a asp-action="Document" asp-route-documentId="@x.DocumentId" class="text-decoration-none" title="Ver detalhes do documento">
                                    @(string.IsNullOrWhiteSpace(x.DocumentTitle) ? "Documento " + x.DocumentId.ToString()[..8] : x.DocumentTitle)
                                </a>
                            </div>
                            <div class="small text-muted d-flex align-items-center gap-2 mt-1">
                                <span>Versão: v@(x.VersionNumber ?? 1)</span>
                                @if (x.CreatedAt.HasValue)
                                {
                                    <span>· @x.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                }
                            </div>
                            @if (x.IsObsolete)
                            {
                                <div class="mt-2">
                                    <span class="badge bg-warning text-dark d-inline-flex align-items-center gap-1" title="O documento foi alterado após a geração desta sugestão.">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Versão Obsoleta
                                    </span>
                                    <a asp-action="Document" asp-route-documentId="@x.DocumentId" class="btn btn-link btn-sm p-0 d-block small text-primary mt-1">
                                        Reanalisar Versão Vigente
                                    </a>
                                </div>
                            }
                        </td>
                        <td>
                            <div class="small text-muted">Atual:</div>
                            <div class="small fw-semibold text-secondary mb-1">
                                @(string.IsNullOrWhiteSpace(x.CurrentRetention) ? "Não calculada" : x.CurrentRetention)
                            </div>
                            <div class="small text-muted">Recomendada:</div>
                            <div class="fw-bold text-primary">
                                Fase: @(string.IsNullOrWhiteSpace(x.Phase) ? "Requer revisão" : x.Phase) · Destino: @(string.IsNullOrWhiteSpace(x.FinalDestination) ? "Não definida" : x.FinalDestination)
                            </div>
                            @if (!string.IsNullOrWhiteSpace(x.TriggerEvent))
                            {
                                <div class="small text-muted">Evento Disparador: @x.TriggerEvent</div>
                            }
                            @if (x.RetentionUntil.HasValue)
                            {
                                <div class="small text-success fw-semibold">Prazo estimado: @x.RetentionUntil.Value.ToString("dd/MM/yyyy")</div>
                            }
                        </td>
                        <td>
                            <div class="small text-break">@x.Reason</div>
                            @if (!string.IsNullOrWhiteSpace(x.ReviewNotes))
                            {
                                <div class="small text-muted mt-1 fst-italic">
                                    <i class="bi bi-chat-left-text me-1"></i> Decisão anterior: @x.ReviewNotes
                                </div>
                            }
                        </td>
                        <td>
                            <div class="fw-bold @(x.Confidence >= 75 ? "text-success" : (x.Confidence >= 50 ? "text-warning" : "text-danger"))">
                                @x.Confidence%
                            </div>
                        </td>
                        <td>
                            @if (x.Status == "ACCEPTED")
                            {
                                <span class="badge bg-success">Aceita</span>
                            }
                            else if (x.Status == "REJECTED")
                            {
                                <span class="badge bg-danger">Rejeitada</span>
                            }
                            else if (x.Status == "PROCESSING")
                            {
                                <span class="badge bg-warning text-dark">Em recálculo</span>
                            }
                            else if (x.Status == "FAILED_APPLIED")
                            {
                                <span class="badge bg-warning text-dark">Recalculada com pendência</span>
                            }
                            else if (x.Status == "FAILED")
                            {
                                <span class="badge bg-danger">Falha</span>
                            }
                            else if (x.Status == "RECOVERY_INDETERMINATE")
                            {
                                <span class="badge bg-secondary">Efeito indeterminado</span>
                            }
                            else if (x.Status == "ADMIN_RESOLVED")
                            {
                                <span class="badge bg-info text-dark">Resolvida administrativamente</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Pendente</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(x.PublicFailureMessage))
                            {
                                <div class="small text-muted mt-1">@x.PublicFailureMessage</div>
                            }
                            @if (x.RecoveredAt.HasValue)
                            {
                                <div class="small text-muted mt-1">Recuperada em @x.RecoveredAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(x.RecoveryNotes))
                            {
                                <div class="small text-muted mt-1">@x.RecoveryNotes</div>
                            }
                            @if (x.AdminResolutionAt.HasValue)
                            {
                                <div class="small text-muted mt-2">
                                    <strong>Resolução administrativa:</strong><br />
                                    Responsável: @x.AdminResolutionBy<br />
                                    Data: @x.AdminResolutionAt.Value.ToString("dd/MM/yyyy HH:mm")<br />
                                    Justificativa: @x.AdminResolutionReason<br />
                                    Evidência: @x.AdminResolutionEvidence<br />
                                    Auditoria: @AuditStatusLabel(x.AdminResolutionAuditStatus)
                                </div>
                            }
                        </td>
                        <td>
                            @if (x.Status == "PENDING")
                            {
                                <div class="d-flex flex-column gap-2">
                                    <!-- Ação de Aceite com Justificativa Editável -->
                                    <details class="border rounded p-2 bg-light">
                                        <summary class="btn btn-sm btn-success w-100 text-start d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-calculator me-1"></i> Aprovar e Recalcular</span>
                                            <i class="bi bi-chevron-down small"></i>
                                        </summary>
                                        <form method="post" asp-action="AcceptRetention" asp-route-id="@x.Id" class="mt-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="@currentStatus" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <div class="small text-muted mb-2">
                                                Aprova a recomendação e executa o recálculo canônico de temporalidade institucional.
                                            </div>
                                            <label class="form-label small fw-semibold text-dark mb-1" for="notes-ret-@x.Id">Justificativa do Revisor:</label>
                                            <textarea id="notes-ret-@x.Id" name="notes" class="form-control form-control-sm mb-2" rows="2" placeholder="Justifique a aprovação da temporalidade"></textarea>
                                            <button class="btn btn-sm btn-success w-100" type="submit">
                                                Aprovar Recomendação e Recalcular
                                            </button>
                                        </form>
                                    </details>

                                    <!-- Ação de Rejeição com Motivo Obrigatório -->
                                    <details class="border rounded p-2 bg-light">
                                        <summary class="btn btn-sm btn-outline-danger w-100 text-start d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-x-lg me-1"></i> Rejeitar Recomendação</span>
                                            <i class="bi bi-chevron-down small"></i>
                                        </summary>
                                        <form method="post" asp-action="RejectRetention" asp-route-id="@x.Id" class="mt-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="@currentStatus" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <label class="form-label small fw-semibold text-dark mb-1" for="reason-ret-@x.Id">Motivo da Rejeição (obrigatório):</label>
                                            <textarea id="reason-ret-@x.Id" name="reason" class="form-control form-control-sm mb-2" rows="2" required placeholder="Informe o motivo da rejeição"></textarea>
                                            <button class="btn btn-sm btn-danger w-100" type="submit">
                                                Confirmar Rejeição
                                            </button>
                                        </form>
                                    </details>

                                    <a asp-action="Document" asp-route-documentId="@x.DocumentId" class="btn btn-sm btn-outline-secondary w-100">
                                        <i class="bi bi-eye me-1"></i> Ver no Documento
                                    </a>
                                </div>
                            }
                            else if (x.Status == "PROCESSING")
                            {
                                <div class="small text-muted mb-2">Recálculo em andamento desde @(x.ProcessingStartedAt?.ToString("dd/MM/yyyy HH:mm") ?? "instante não registrado"). Aguarde a conclusão ou use a recuperação administrativa após expirar.</div>
                                <a asp-action="Document" asp-route-documentId="@x.DocumentId" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye me-1"></i> Acompanhar
                                </a>
                            }
                            else if (canRecoverExpired && (x.Status == "FAILED_APPLIED" || x.Status == "RECOVERY_INDETERMINATE"))
                            {
                                <details class="border rounded p-2 bg-light">
                                    <summary class="btn btn-sm btn-outline-primary w-100 text-start d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-shield-check me-1"></i> Resolver pendência</span>
                                        <i class="bi bi-chevron-down small"></i>
                                    </summary>
                                    <form method="post" asp-action="ResolveAdministrativeReview" class="mt-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="suggestionId" value="@x.Id" />
                                        <input type="hidden" name="suggestionKind" value="retention" />
                                        <input type="hidden" name="status" value="@currentStatus" />
                                        <input type="hidden" name="kind" value="@currentKind" />
                                        <input type="hidden" name="page" value="@Model.Page" />
                                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                        <div class="small text-muted mb-2">Informe a memória/evidência conferida. Esta ação finaliza a pendência sem executar novo recálculo.</div>
                                        <label class="form-label small fw-semibold" for="admin-reason-ret-@x.Id">Justificativa</label>
                                        <textarea id="admin-reason-ret-@x.Id" name="reason" class="form-control form-control-sm mb-2" rows="2" required></textarea>
                                        <label class="form-label small fw-semibold" for="admin-evidence-ret-@x.Id">Evidência verificada</label>
                                        <textarea id="admin-evidence-ret-@x.Id" name="evidence" class="form-control form-control-sm mb-2" rows="2" required></textarea>
                                        <button class="btn btn-sm btn-primary w-100" type="submit">Finalizar pendência</button>
                                    </form>
                                </details>
                                <a asp-action="Document" asp-route-documentId="@x.DocumentId" class="btn btn-sm btn-outline-secondary mt-2">
                                    <i class="bi bi-eye me-1"></i> Ver Detalhes
                                </a>
                            }
                            else
                            {
                                <a asp-action="Document" asp-route-documentId="@x.DocumentId" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye me-1"></i> Ver Detalhes
                                </a>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Retentions.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-muted text-center py-4">
                            Nenhuma sugestão de temporalidade encontrada para a situação selecionada.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
}
