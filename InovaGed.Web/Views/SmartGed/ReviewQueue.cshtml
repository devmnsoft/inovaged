@model InovaGed.Application.SmartGed.SmartGedReviewQueue
@{ViewData["Title"]="Fila de revisão inteligente";ViewData["Subtitle"]="Confirme ou rejeite cada sugestão antes de qualquer decisão oficial.";ViewData["Icon"]="sparkles";}
<partial name="Atlas/_AtlasPageHero"/><div class="card atlas-card mb-4"><div class="card-header"><strong>Classificação sugerida (@Model.Classifications.Count)</strong></div><div class="table-responsive"><table class="table atlas-table"><thead><tr><th>Documento</th><th>Sugestão</th><th>Motivo</th><th>Confiança</th><th>Ações</th></tr></thead><tbody>@foreach(var x in Model.Classifications){<tr><td><a asp-action="Document" asp-route-documentId="@x.DocumentId">@x.DocumentId</a></td><td>@x.Code — @x.Title</td><td>@x.Reason</td><td>@x.Confidence%</td><td><form class="d-inline" method="post" asp-action="AcceptClassification" asp-route-id="@x.Id">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success">Aceitar</button></form> <form class="d-inline" method="post" asp-action="RejectClassification" asp-route-id="@x.Id">@Html.AntiForgeryToken()<input type="hidden" name="reason" value="Rejeitada na fila"/><button class="btn btn-sm btn-outline-danger">Rejeitar</button></form></td></tr>}@if(Model.Classifications.Count==0){<tr><td colspan="5" class="text-muted">Nenhuma classificação pendente.</td></tr>}</tbody></table></div></div>
<div class="card atlas-card"><div class="card-header"><strong>Temporalidade sugerida (@Model.Retentions.Count)</strong></div><div class="table-responsive"><table class="table atlas-table"><thead><tr><th>Documento</th><th>Fase</th><th>Destino</th><th>Motivo</th><th>Ações</th></tr></thead><tbody>@foreach(var x in Model.Retentions){<tr><td><a asp-action="Document" asp-route-documentId="@x.DocumentId">@x.DocumentId</a></td><td>@x.Phase</td><td>@x.FinalDestination</td><td>@x.Reason</td><td><form class="d-inline" method="post" asp-action="AcceptRetention" asp-route-id="@x.Id">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success">Aceitar</button></form> <form class="d-inline" method="post" asp-action="RejectRetention" asp-route-id="@x.Id">@Html.AntiForgeryToken()<input type="hidden" name="reason" value="Rejeitada na fila"/><button class="btn btn-sm btn-outline-danger">Rejeitar</button></form></td></tr>}@if(Model.Retentions.Count==0){<tr><td colspan="5" class="text-muted">Nenhuma temporalidade pendente.</td></tr>}</tbody></table></div></div>
