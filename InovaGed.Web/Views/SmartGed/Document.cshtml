@model InovaGed.Web.Models.SmartGed.SmartGedDocumentVM
@{
    ViewData["Title"] = "Painel Documental Inteligente";
    ViewData["Subtitle"] = "IA integrada, extração de evidências, conformidade e governança arquivística.";
    ViewData["Icon"] = "sparkles";
}

<partial name="Atlas/_AtlasPageHero" />

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <span class="badge bg-primary">v@(Model.VersionNumber)</span>
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentClassification))
                    {
                        <span class="badge bg-info text-dark">@Model.CurrentClassification</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Sem Classificação</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentRetentionStatus))
                    {
                        <span class="badge bg-light text-dark border">Temporalidade: @Model.CurrentRetentionStatus</span>
                    }
                </div>
                <h1 class="h4 fw-bold text-dark mb-1">@Model.Title</h1>
                <p class="text-muted small mb-0">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Sem descrição cadastrada." : Model.Description)
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary btn-sm" asp-controller="Ged" asp-action="Details" asp-route-id="@Model.DocumentId" title="Abrir no repositório GED">
                    <i class="bi bi-folder2-open me-1"></i> Abrir no GED
                </a>
                <a class="btn btn-outline-primary btn-sm" asp-controller="Protocolo" asp-action="Novo" asp-route-gedDocumentId="@Model.DocumentId" title="Criar protocolo vinculado a este documento">
                    <i class="bi bi-file-earmark-plus me-1"></i> Autuar Protocolo
                </a>
                <a class="btn btn-outline-secondary btn-sm" asp-action="Search">
                    <i class="bi bi-arrow-left me-1"></i> Voltar à Busca
                </a>
            </div>
        </div>
    </div>
</div>

@if (Model.OcrPending)
{
    <div class="alert alert-warning d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-4 text-warning"></i>
            <div>
                <strong>OCR Pendente ou não processado</strong>
                <div class="small">
                    O reconhecimento óptico de caracteres é obrigatório para que os serviços de IA possam analisar, resumir e validar evidências literais. Respostas genéricas sem base no documento são bloqueadas por governança.
                </div>
            </div>
        </div>
        <form method="post" asp-action="Analyze" asp-route-documentId="@Model.DocumentId">
            @Html.AntiForgeryToken()
            <button class="btn btn-warning btn-sm fw-semibold" type="submit">
                <i class="bi bi-arrow-repeat me-1"></i> Enfileirar OCR e Reanalisar
            </button>
        </form>
    </div>
}
else
{
    <div class="alert alert-success d-flex align-items-center justify-content-between flex-wrap gap-3 py-2 mb-4">
        <div class="small">
            <i class="bi bi-check-circle-fill text-success me-1"></i>
            <strong>Texto OCR disponível:</strong> @(Model.OcrText?.Length ?? 0) caracteres reconhecidos para a versão vigente v@(Model.VersionNumber).
        </div>
        <button class="btn btn-outline-success btn-sm py-0" type="button" data-bs-toggle="collapse" data-bs-target="#ocrPreviewCollapse">
            Ver trecho do OCR
        </button>
    </div>
    <div class="collapse mb-4" id="ocrPreviewCollapse">
        <div class="card card-body bg-light small" style="max-height: 250px; overflow-y: auto; white-space: pre-wrap;">
            @Model.OcrText
        </div>
    </div>
}

<ul class="nav nav-tabs mb-4" id="documentIntelligenceTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-semibold" id="ai-assist-tab" data-bs-toggle="tab" data-bs-target="#ai-assist-panel" type="button" role="tab" aria-selected="true">
            <i class="bi bi-cpu me-1 text-primary"></i> Assistência de IA & Revisão
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="local-rules-tab" data-bs-toggle="tab" data-bs-target="#local-rules-panel" type="button" role="tab" aria-selected="false">
            <i class="bi bi-shield-check me-1 text-success"></i> Análise de Qualidade & Regras
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="protocol-support-tab" data-bs-toggle="tab" data-bs-target="#protocol-support-panel" type="button" role="tab" aria-selected="false">
            <i class="bi bi-journal-text me-1 text-info"></i> Apoio ao Protocolo
        </button>
    </li>
</ul>

<div class="tab-content" id="documentIntelligenceTabsContent">
    <div class="tab-pane fade show active" id="ai-assist-panel" role="tabpanel" aria-labelledby="ai-assist-tab">
        <div class="row g-4">
            <div class="col-lg-8">
                @if (Model.CurrentVersionId.HasValue)
                {
                    <partial name="_DocumentAiAssist" model="new InovaGed.Web.Models.DocumentAiAssistVm(Model.DocumentId, Model.CurrentVersionId.Value)" />
                }
                else
                {
                    <div class="alert alert-info">
                        Documento sem versão física registrada. Envie uma versão para habilitar a assistência de IA.
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white fw-semibold">
                        <i class="bi bi-shield-lock me-1"></i> Governança Documental
                    </div>
                    <div class="card-body small">
                        <p class="mb-2"><strong>Princípios da IA no InovaGed:</strong></p>
                        <ul class="ps-3 mb-3 text-muted">
                            <li>Respostas baseadas exclusivamente no texto literal da versão consultada.</li>
                            <li>Sem comandos automáticos: toda sugestão exige revisão e confirmação humana.</li>
                            <li>Isolamento rígido por tenant e autorização documental validada no servidor.</li>
                            <li>Classificação aplicada aciona recálculo na mesma transação.</li>
                        </ul>
                        <div class="border-top pt-2">
                            <span class="text-muted">Versão consultada:</span> <strong>v@(Model.VersionNumber)</strong><br />
                            <span class="text-muted">Identificador:</span> <code>@Model.DocumentId</code>
                        </div>
                    </div>
                </div>

                @if (Model.Intelligence?.Classification is { } classSug)
                {
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                            <span>Sugestão de Classe</span>
                            <span class="badge bg-primary">@classSug.Confidence%</span>
                        </div>
                        <div class="card-body small">
                            <div class="text-muted mb-1">Classe sugerida:</div>
                            <div class="fw-bold mb-2">@classSug.Code — @classSug.Title</div>
                            <div class="text-muted mb-1">Motivo:</div>
                            <p class="mb-3 text-secondary">@classSug.Reason</p>

                            @if (classSug.Status == "PENDING")
                            {
                                <div class="d-flex gap-2">
                                    <form method="post" asp-action="AcceptClassification" asp-route-id="@classSug.Id" class="flex-grow-1">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-success btn-sm w-100" type="submit">Aceitar</button>
                                    </form>
                                    <form method="post" asp-action="RejectClassification" asp-route-id="@classSug.Id" class="flex-grow-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="reason" value="Rejeitada no painel documental" />
                                        <button class="btn btn-outline-danger btn-sm w-100" type="submit">Rejeitar</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div class="badge @(classSug.Status == "ACCEPTED" ? "bg-success" : "bg-danger")">
                                    Situação: @classSug.Status
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="local-rules-panel" role="tabpanel" aria-labelledby="local-rules-tab">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white fw-semibold">
                        Diagnóstico de Qualidade e Pendências
                    </div>
                    <div class="card-body">
                        @if (Model.Intelligence?.Issues is { Count: > 0 } issues)
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var issue in issues)
                                {
                                    <div class="list-group-item px-0 py-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-semibold text-dark">@issue.Title</span>
                                            <span class="badge @(issue.Severity == "CRITICAL" ? "bg-danger" : (issue.Severity == "HIGH" ? "bg-warning text-dark" : "bg-secondary"))">
                                                @issue.Severity
                                            </span>
                                        </div>
                                        <p class="text-muted small mb-1">Tipo: <code>@issue.Type</code> · Status: <strong>@issue.Status</strong></p>
                                        @if (!string.IsNullOrWhiteSpace(issue.RecommendedAction))
                                        {
                                            <div class="small text-primary">
                                                <i class="bi bi-arrow-right-short"></i> Ação recomendada: @issue.RecommendedAction
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-success small py-3">
                                <i class="bi bi-check-circle-fill me-1"></i> Nenhuma inconformidade grave ou pendência aberta identificada nas regras locais.
                            </div>
                        }
                    </div>
                </div>

                @if (Model.Intelligence is { } intel)
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white fw-semibold">
                            Metadados e Indicadores Extraídos
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0 small">
                                <dt class="col-sm-3 text-muted">Tipo Documental:</dt>
                                <dd class="col-sm-9">@(intel.DocumentType ?? "Não identificado")</dd>
                                <dt class="col-sm-3 text-muted">Assunto Detectado:</dt>
                                <dd class="col-sm-9">@(intel.Subject ?? "Não identificado")</dd>
                                <dt class="col-sm-3 text-muted">Data Identificada:</dt>
                                <dd class="col-sm-9">@(intel.DetectedDate?.ToString("dd/MM/yyyy") ?? "Não identificada")</dd>
                                <dt class="col-sm-3 text-muted">Resumo Automático:</dt>
                                <dd class="col-sm-9 text-secondary">@(intel.Summary ?? "Sem resumo automático")</dd>
                                <dt class="col-sm-3 text-muted">Dados Sensíveis:</dt>
                                <dd class="col-sm-9">
                                    @if (intel.SensitiveIndicators.Count > 0)
                                    {
                                        @foreach (var s in intel.SensitiveIndicators)
                                        {
                                            <span class="badge bg-danger me-1">@s</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Nenhum dado sensível detectado</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm text-center p-4">
                    <div class="display-4 fw-bold text-primary mb-1">
                        @(Model.Intelligence?.Confidence ?? 0)%
                    </div>
                    <div class="text-muted small mb-3">Confiabilidade da Análise Local</div>
                    <form method="post" asp-action="Analyze" asp-route-documentId="@Model.DocumentId">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-primary btn-sm w-100" type="submit">
                            <i class="bi bi-arrow-repeat me-1"></i> Reanalisar Regras Locais
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="protocol-support-panel" role="tabpanel" aria-labelledby="protocol-support-tab">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold mb-3">Autuação Assistida de Protocolo</h2>
                <p class="text-muted small">
                    Use o conteúdo e os fatos validados deste documento para iniciar a autuação de um protocolo com os dados pré-preenchidos. A IA sugere o assunto e o resumo instrutório, mas não inventa interessados, números ou despachos decisórios.
                </p>

                <div class="bg-light rounded p-3 mb-4">
                    <div class="row g-3 small">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Assunto sugerido a partir do documento:</label>
                            <input class="form-control form-control-sm" readonly value="@(Model.Intelligence?.Subject ?? Model.Title)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Documento de origem anexado:</label>
                            <input class="form-control form-control-sm" readonly value="@Model.Title (v@(Model.VersionNumber))" />
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted">Resumo das peças documentais (minuta inicial):</label>
                            <textarea class="form-control form-control-sm" rows="3" readonly>@(Model.Intelligence?.Summary ?? "Documento institucional juntado para instrução processual.")</textarea>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <a class="btn btn-primary" asp-controller="Protocolo" asp-action="Novo" asp-route-gedDocumentId="@Model.DocumentId">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Continuar Autuação no Protocolo
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
