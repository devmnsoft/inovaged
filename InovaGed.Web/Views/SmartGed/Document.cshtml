@model InovaGed.Application.SmartGed.DocumentIntelligenceDetails
@{ViewData["Title"]="Inteligência Documental";ViewData["Subtitle"]="Extração local, sugestões e qualidade com rastreabilidade.";ViewData["Icon"]="sparkles";}
<partial name="Atlas/_AtlasPageHero"/>@if(Model is null){<div class="alert alert-warning">O documento ainda não possui análise. Execute a análise a partir da listagem de documentos.</div>}else{<div class="row g-3"><div class="col-lg-8"><div class="card atlas-card"><div class="card-body"><h2 class="h5">Análise local</h2><dl class="row"><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd><dt class="col-sm-4">Tipo provável</dt><dd class="col-sm-8">@(Model.DocumentType??"Não identificado")</dd><dt class="col-sm-4">Assunto</dt><dd class="col-sm-8">@(Model.Subject??"Não identificado")</dd><dt class="col-sm-4">Resumo</dt><dd class="col-sm-8">@Model.Summary</dd><dt class="col-sm-4">Identificadores mascarados</dt><dd class="col-sm-8">@string.Join(" · ",Model.MaskedIdentifiers.SelectMany(x=>x.Value))</dd></dl></div></div></div><div class="col-lg-4"><div class="card atlas-card"><div class="card-body"><div class="display-6">@Model.Confidence%</div><p>Confiança das regras locais</p><form method="post" asp-action="Analyze" asp-route-documentId="@Model.DocumentId">@Html.AntiForgeryToken()<button class="btn btn-primary">Reanalisar</button></form></div></div></div></div>}
