@model InovaGed.Web.Controllers.FiscalPortalAdminController.CreateInput
@{ViewData["Title"]="Nova publicação";}
<link rel="stylesheet" href="~/css/fiscal-portal.css"/><main class="fp-shell"><section class="fp-hero"><div><span>NOVA COMUNICAÇÃO</span><h1>Publicar competência</h1><p>Defina o destinatário e a validade do link seguro.</p></div></section><form method="post" class="fp-card fp-form"><label>Modo de acesso<select asp-for="AccessMode"><option value="TOKEN">Link seguro por token</option><option value="AUTHENTICATED">Usuário autenticado</option></select></label><label>Nome do fiscal<input asp-for="FiscalName" required/></label><label>E-mail<input asp-for="FiscalEmail" type="email" required/></label><label>Expira em<input asp-for="ExpiresAt" type="datetime-local" required/></label><label class="wide">Observações<textarea asp-for="Notes"></textarea></label><button class="fp-btn primary">Criar publicação</button></form></main>
