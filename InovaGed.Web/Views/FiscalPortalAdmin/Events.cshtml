@model InovaGed.Application.Contracts.FiscalPortal.FiscalPortalPublicationDetails
@{ViewData["Title"]="Eventos do portal";}
<link rel="stylesheet" href="~/css/fiscal-portal.css"/><main class="fp-shell"><section class="fp-hero"><div><span>@Model.Publication.PublicationNumber</span><h1>Trilha de eventos</h1></div></section><section class="fp-card">@foreach(var e in Model.Events){<div class="fp-event"><b>@e.EventType — @e.EventTitle</b><time>@e.PerformedAt.ToString("dd/MM/yyyy HH:mm:ss")</time><p>@e.EventDescription</p><small>@e.IpAddress · @e.PerformedName</small></div>}</section></main>
