@using InovaGed.Application.Contracts.FiscalPortal
@model FiscalPortalPublicationDetails
@{ViewData["Title"]="Detalhes da publicação";var p=Model.Publication;var token=TempData["PortalToken"] as string;}
<link rel="stylesheet" href="~/css/fiscal-portal.css"/><main class="fp-shell"><section class="fp-hero"><div><span>@p.PublicationNumber</span><h1>@Model.Fiscalization.Period.CompetenceMonth.ToString("MM/yyyy")</h1><p>@p.FiscalName · @p.FiscalEmail</p></div><span class="fp-badge @p.Status">@p.Status</span></section>@if(token is not null){<section class="fp-alert"><strong>Copie agora o link seguro — o token não poderá ser recuperado.</strong><div class="fp-copy"><input id="portal-link" readonly value="@Url.Action("Access","FiscalPortal",new{token},Context.Request.Scheme)"/><button type="button" class="fp-btn" onclick="navigator.clipboard.writeText(document.getElementById('portal-link').value)">Copiar link seguro</button></div></section>}<section class="fp-card fp-actions">@if(p.Status=="DRAFT"){<form method="post" asp-action="Publish" asp-route-publicationId="@p.Id"><button class="fp-btn primary">Publicar</button></form>}@if(p.Status is not "ACCEPTED" and not "REVOKED"){<form method="post" asp-action="Revoke" asp-route-publicationId="@p.Id"><input name="reason" required placeholder="Motivo da revogação"/><button class="fp-btn danger">Revogar</button></form>}<a class="fp-btn" asp-controller="FiscalPortal" asp-action="Dashboard" asp-route-publicationId="@p.Id">Ver portal</a>@if(p.Status=="ACCEPTED"){<a class="fp-btn primary" asp-controller="FiscalPortal" asp-action="Receipt" asp-route-publicationId="@p.Id">Comprovante</a>}</section><section class="fp-grid"><article class="fp-kpi"><small>Valor medido</small><strong>@Model.Fiscalization.Period.TotalMeasuredAmount.ToString("C")</strong></article><article class="fp-kpi"><small>Valor aprovado</small><strong>@Model.Fiscalization.Period.TotalApprovedAmount.ToString("C")</strong></article><article class="fp-kpi"><small>Eventos</small><strong>@Model.Events.Count</strong></article></section><section class="fp-card"><h2>Trilha de auditoria</h2>@foreach(var e in Model.Events){<div class="fp-event"><b>@e.EventTitle</b><time>@e.PerformedAt.ToString("dd/MM/yyyy HH:mm:ss")</time><p>@e.EventDescription</p></div>}</section></main>
