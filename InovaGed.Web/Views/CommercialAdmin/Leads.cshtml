@model IReadOnlyList<InovaGed.Web.Models.Commercial.CommercialLead>
@{ViewData["Title"]="Leads comerciais";}<h1>Leads comerciais</h1><form method="get"><select name="status"><option value="">Todos</option><option value="new">Novos</option><option value="contacted">Em contato</option><option value="converted">Convertidos</option><option value="lost">Perdidos</option></select><button>Filtrar</button></form><table class="table"><thead><tr><th>Contato</th><th>Empresa</th><th>Origem</th><th>Status</th><th>Ação</th></tr></thead><tbody>@foreach(var lead in Model){<tr><td>@lead.Name<br>@lead.Email</td><td>@lead.Company</td><td>@lead.Origin</td><td>@lead.Status</td><td><form method="post" action="/admin/comercial/leads/@lead.Id"><select name="status"><option value="new">Novo</option><option value="contacted">Em contato</option><option value="converted">Convertido</option><option value="lost">Perdido</option></select><input name="note" placeholder="Observação"><button>Salvar</button>@Html.AntiForgeryToken()</form></td></tr>}</tbody></table>
