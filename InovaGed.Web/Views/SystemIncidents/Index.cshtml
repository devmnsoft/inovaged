@model IReadOnlyList<InovaGed.Application.SystemHealth.Incidents.SystemIncidentListItem>

@{
    ViewData["Title"] = "Central de Incidentes";

    var incidents = Model ?? Array.Empty<InovaGed.Application.SystemHealth.Incidents.SystemIncidentListItem>();
    var monthLimit = DateTimeOffset.UtcNow.AddMonths(-1);
    var open = incidents.Count(x => x.Status == "OPEN");

    var kpis = new List<(string Label, int Value)>
    {
        ("Incidentes abertos", open),
        ("Críticos", incidents.Count(x => x.Severity == "CRITICAL")),
        ("Schema pendente", incidents.Count(x => x.IncidentType.StartsWith("DATABASE_SCHEMA"))),
        ("Dapper", incidents.Count(x => x.IncidentType == "DAPPER_MATERIALIZATION")),
        ("DI", incidents.Count(x => x.IncidentType == "DEPENDENCY_INJECTION")),
        ("Razor", incidents.Count(x => x.IncidentType == "RAZOR_COMPILATION")),
        ("Rotas com 500", incidents.Count(x => x.IncidentType == "ROUTE_FAILURE")),
        ("Resolvidos no mês", incidents.Count(x => x.Status == "RESOLVED" && x.LastSeenAt >= monthLimit))
    };
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1>Central de Incidentes</h1>
            <p class="text-muted">
                Acompanhe erros técnicos, rotas instáveis, pendências de schema e recomendações de correção.
            </p>
        </div>
        <div>
            <a class="btn btn-outline-primary" asp-action="RouteHealth">Saúde das rotas</a>
            <a class="btn btn-primary" asp-action="Export">Exportar CSV</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var kpi in kpis)
        {
            <div class="col-6 col-lg-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <small class="text-muted">@kpi.Label</small>
                        <div class="fs-2 fw-bold">@kpi.Value</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <form method="get" class="card card-body mb-4">
        <div class="row g-2">
            <div class="col-md"><input name="Type" class="form-control" placeholder="Tipo" /></div>
            <div class="col-md"><input name="Severity" class="form-control" placeholder="Severidade" /></div>
            <div class="col-md"><input name="Status" class="form-control" placeholder="Status" /></div>
            <div class="col-md"><input name="Path" class="form-control" placeholder="Rota" /></div>
            <div class="col-md"><input name="CorrelationId" class="form-control" placeholder="CorrelationId" /></div>
            <div class="col-auto"><button class="btn btn-dark">Filtrar</button></div>
        </div>
    </form>

    @if (!incidents.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h2 class="h5">Nenhum incidente encontrado</h2>
                <p class="text-muted mb-0">
                    Quando houver falhas técnicas registradas, elas aparecerão nesta área.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Severidade</th>
                        <th>Tipo</th>
                        <th>Título</th>
                        <th>Rota</th>
                        <th>Ocorrências</th>
                        <th>Última ocorrência</th>
                        <th>Status</th>
                        <th>Ação recomendada</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var incident in incidents)
                    {
                        var badgeClass = incident.Severity switch
                        {
                            "CRITICAL" => "danger",
                            "HIGH" => "warning",
                            "MEDIUM" => "info",
                            "LOW" => "secondary",
                            _ => "secondary"
                        };

                        <tr>
                            <td>
                                <span class="badge bg-@badgeClass">@incident.Severity</span>
                            </td>
                            <td><code>@incident.IncidentType</code></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@incident.Id">@incident.Title</a>
                            </td>
                            <td>
                                @incident.Controller/@incident.Action
                                <br />
                                <small>@incident.Path</small>
                            </td>
                            <td>@incident.OccurrenceCount</td>
                            <td>@incident.LastSeenAt.ToLocalTime().ToString("g")</td>
                            <td>@incident.Status</td>
                            <td>@incident.RecommendedAction</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <p class="text-muted mt-3">
        Incidentes resolvidos permanecem disponíveis para auditoria técnica.
    </p>
</div>
