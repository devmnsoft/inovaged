@model IReadOnlyList<InovaGed.Application.SystemHealth.Incidents.SystemIncidentListItem>
@{ViewData["Title"]="Central de Incidentes";var open=Model.Count(x=>x.Status=="OPEN");}
<div class="container-fluid py-4">
 <div class="d-flex justify-content-between align-items-start mb-4"><div><h1>Central de Incidentes</h1><p class="text-muted">Acompanhe erros técnicos, rotas instáveis, pendências de schema e recomendações de correção.</p></div><div><a class="btn btn-outline-primary" asp-action="RouteHealth">Saúde das rotas</a> <a class="btn btn-primary" asp-action="Export">Exportar CSV</a></div></div>
 <div class="row g-3 mb-4">@foreach(var k in new[]{("Incidentes abertos",open),("Críticos",Model.Count(x=>x.Severity=="CRITICAL")),("Schema pendente",Model.Count(x=>x.IncidentType.StartsWith("DATABASE_SCHEMA"))),("Dapper",Model.Count(x=>x.IncidentType=="DAPPER_MATERIALIZATION")),("DI",Model.Count(x=>x.IncidentType=="DEPENDENCY_INJECTION")),("Razor",Model.Count(x=>x.IncidentType=="RAZOR_COMPILATION")),("Rotas com 500",Model.Count(x=>x.IncidentType=="ROUTE_FAILURE")),("Resolvidos no mês",Model.Count(x=>x.Status=="RESOLVED"&&x.LastSeenAt>=DateTimeOffset.UtcNow.AddMonths(-1))))){<div class="col-6 col-lg-3"><div class="card shadow-sm h-100"><div class="card-body"><small class="text-muted">@k.Item1</small><div class="fs-2 fw-bold">@k.Item2</div></div></div></div>}</div>
 <form method="get" class="card card-body mb-4"><div class="row g-2"><div class="col-md"><input name="Type" class="form-control" placeholder="Tipo" /></div><div class="col-md"><input name="Severity" class="form-control" placeholder="Severidade" /></div><div class="col-md"><input name="Status" class="form-control" placeholder="Status" /></div><div class="col-md"><input name="Path" class="form-control" placeholder="Rota" /></div><div class="col-md"><input name="CorrelationId" class="form-control" placeholder="CorrelationId" /></div><div class="col-auto"><button class="btn btn-dark">Filtrar</button></div></div></form>
 <div class="card shadow-sm table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Severidade</th><th>Tipo</th><th>Título</th><th>Rota</th><th>Ocorrências</th><th>Última ocorrência</th><th>Status</th><th>Ação recomendada</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><span class="badge bg-@(x.Severity=="CRITICAL"?"danger":x.Severity=="HIGH"?"warning":"secondary")">@x.Severity</span></td><td><code>@x.IncidentType</code></td><td><a asp-action="Details" asp-route-id="@x.Id">@x.Title</a></td><td>@x.Controller/@x.Action<br/><small>@x.Path</small></td><td>@x.OccurrenceCount</td><td>@x.LastSeenAt.ToLocalTime().ToString("g")</td><td>@x.Status</td><td>@x.RecommendedAction</td></tr>}</tbody></table></div>
 <p class="text-muted mt-3">Incidentes resolvidos permanecem disponíveis para auditoria técnica.</p>
</div>
