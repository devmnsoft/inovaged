@model IReadOnlyList<InovaGed.Application.SystemHealth.Incidents.RouteHealthListItem>
@{ViewData["Title"]="Saúde das rotas";}
    ViewData["Subtitle"] = "Monitore disponibilidade, falhas e ações recomendadas para as rotas críticas.";
    ViewData["Icon"] = "activity";
<div class="container py-4"><a asp-action="Index">← Central de Incidentes</a><h1 class="mt-3">Saúde das rotas</h1><p class="text-muted">Snapshots recentes das rotas críticas e seus tempos de resposta.</p><div class="card atlas-card table-responsive"><table class="table atlas-table mb-0"><thead><tr><th>Rota</th><th>Método</th><th>Status</th><th>Duração</th><th>Verificado em</th><th>CorrelationId</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.RoutePath</td><td>@x.HttpMethod</td><td><span class="badge bg-@(x.Success?"success":"danger")">@x.ActualStatus</span></td><td>@x.DurationMs ms</td><td>@x.CheckedAt.ToLocalTime()</td><td><code>@x.CorrelationId</code></td></tr>}</tbody></table></div></div>
