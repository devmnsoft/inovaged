@model InovaGed.Application.SystemHealth.Incidents.SystemIncidentDetails
@{ViewData["Title"]="Detalhes do incidente";var technical=User.IsInRole("Administrator")||User.HasClaim("permission","system.incidents.manage");}
<div class="container py-4"><a asp-action="Index">← Voltar</a><div class="d-flex justify-content-between mt-3"><div><span class="badge bg-danger">@Model.Severity</span> <code>@Model.IncidentType</code><h1>@Model.Title</h1></div><span class="badge bg-secondary align-self-start">@Model.Status</span></div>
<div class="alert alert-info">Este incidente foi agrupado automaticamente por assinatura técnica. <strong>@Model.OccurrenceCount ocorrência(s).</strong></div>
<div class="row g-4"><div class="col-lg-8"><div class="card mb-3"><div class="card-body"><h2 class="h5">Resumo</h2><p>@Model.Message</p><dl class="row"><dt class="col-sm-3">CorrelationId</dt><dd class="col-sm-9"><code>@Model.CorrelationId</code></dd><dt class="col-sm-3">Rota</dt><dd class="col-sm-9">@Model.HttpMethod @Model.Path (@Model.Controller/@Model.Action)</dd><dt class="col-sm-3">SQL State</dt><dd class="col-sm-9">@Model.SqlState</dd><dt class="col-sm-3">Objeto</dt><dd class="col-sm-9">@Model.DatabaseObject</dd></dl></div></div>
@if(technical){<details class="card mb-3"><summary class="card-header">Diagnóstico técnico e stack trace</summary><pre class="card-body overflow-auto">@Model.TechnicalMessage
@Model.StackTrace</pre></details>}<h2 class="h5">Histórico de ocorrências</h2><div class="list-group">@foreach(var e in Model.Events){<div class="list-group-item"><strong>@e.EventType</strong> — @e.EventMessage <small class="text-muted float-end">@e.OccurredAt.ToLocalTime()</small></div>}</div></div>
<div class="col-lg-4"><div class="card border-primary mb-3"><div class="card-body"><h2 class="h5">Ação recomendada</h2><p>@Model.RecommendedAction</p><small>A correção recomendada aponta para o ponto mais provável, mas revise o código antes de aplicar.</small><hr/><a class="btn btn-outline-primary w-100 mb-2" href="/SchemaHealth">Abrir SchemaHealth</a><a class="btn btn-outline-primary w-100" href="/DatabaseReadiness">Abrir DatabaseReadiness</a></div></div><form asp-action="Resolve" asp-route-id="@Model.Id" method="post" class="card card-body mb-3"><label>Notas de resolução</label><textarea name="notes" required class="form-control mb-2"></textarea><button class="btn btn-success">Marcar resolvido</button></form><form asp-action="Ignore" asp-route-id="@Model.Id" method="post" class="card card-body"><label>Justificativa</label><textarea name="reason" required class="form-control mb-2"></textarea><button class="btn btn-outline-secondary">Ignorar</button></form></div></div></div>
