@model InovaGed.Web.Controllers.ContractFiscalizationController.GlosaInput
@{ViewData["Title"]="Registrar glosa";}<link rel="stylesheet" href="~/css/contract-fiscalization.css" /><div class="cf-shell"><section class="cf-hero"><div><span class="cf-eyebrow">DIVERGÊNCIA</span><h1>Registrar glosa</h1><p>Toda glosa exige justificativa e ficará registrada para auditoria.</p></div></section><div class="cf-card"><form method="post" class="cf-form"><input asp-for="PeriodId" type="hidden"/><input asp-for="ItemId" type="hidden"/><div asp-validation-summary="All"></div><label>Tipo<select asp-for="GlosaType"><option value="QUANTITATIVE">Quantitativa</option><option value="FINANCIAL">Financeira</option><option value="TECHNICAL">Técnica / falta de evidência</option><option value="DUPLICATE">Duplicidade</option><option value="OUT_OF_SCOPE">Fora de escopo</option><option value="UNPROVEN">Execução não comprovada</option><option value="OTHER">Outro</option></select></label><label>Justificativa<textarea asp-for="Reason" required></textarea></label><label>Quantidade glosada<input asp-for="GlossedQuantity" min="0" step="0.0001"/></label><label>Valor glosado<input asp-for="GlossedAmount" min="0" step="0.0001"/></label><button class="cf-btn danger">Confirmar glosa</button></form></div></div>
