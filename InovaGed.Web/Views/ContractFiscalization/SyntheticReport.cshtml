@using InovaGed.Application.Contracts.Fiscalization
@model ContractFiscalizationReport
@{Layout=null;var p=Model.Details.Period;}
<!doctype html><html><head><meta charset="utf-8"/><title>Relatório de fiscalização</title><link rel="stylesheet" href="/css/contract-fiscalization.css"/></head><body><main class="cf-print"><div class="cf-no-print cf-actions"><button class="cf-btn primary" onclick="window.print()">Imprimir</button></div><p class="cf-eyebrow" style="color:#075e54">RELATÓRIO OFICIAL DE FISCALIZAÇÃO</p><h1>Relatório sintético</h1><p>Competência <strong>@p.CompetenceMonth.ToString("MM/yyyy")</strong> · Contrato <strong>@(p.ContractNumber??"não informado")</strong></p><table class="cf-table"><thead><tr><th>Nº</th><th>Descrição</th><th>Natureza</th><th>Unitário</th><th>Quantidade</th><th>Medido</th><th>Glosado</th><th>Aprovado</th></tr></thead><tbody>@foreach(var x in Model.Lines){<tr><td>@x.Number</td><td>@x.Description</td><td>@x.Nature</td><td>@x.UnitPrice.ToString("C")</td><td>@x.Quantity</td><td>@x.TotalAmount.ToString("C")</td><td>@x.GlossedAmount.ToString("C")</td><td>@x.ApprovedAmount.ToString("C")</td></tr>}</tbody></table></main></body></html>
