@using InovaGed.Application.Contracts.Fiscalization
@model ContractFiscalizationPeriodDetails
@{ViewData["Title"]="Conferência fiscal";var p=Model.Period;var locked=p.Status is "APPROVED" or "CLOSED";}
<link rel="stylesheet" href="~/css/contract-fiscalization.css" /><div class="cf-shell"><section class="cf-hero"><div><span class="cf-eyebrow">COMPETÊNCIA @p.CompetenceMonth.ToString("MM/yyyy")</span><h1>@(p.ContractNumber??"Fiscalização contratual")</h1><p>@(p.ContractorName??"Contratada não informada") · <span class="cf-badge @p.Status">@p.Status</span></p></div><div class="cf-actions"><a class="cf-btn" asp-action="SyntheticReport" asp-route-id="@p.Id">Relatório sintético</a><a class="cf-btn" asp-action="AnalyticalReport" asp-route-id="@p.Id">Analítico</a><a class="cf-btn" asp-action="AcceptanceTerm" asp-route-id="@p.Id">Termo de aceite</a><a class="cf-btn" asp-action="DispatchSheet" asp-route-id="@p.Id">Despacho</a><a class="cf-btn" asp-action="Export" asp-route-id="@p.Id">CSV</a></div></section>
<div class="cf-grid"><div class="cf-kpi"><small>Valor medido</small><strong>@p.TotalMeasuredAmount.ToString("C")</strong></div><div class="cf-kpi"><small>Valor aprovado</small><strong>@p.TotalApprovedAmount.ToString("C")</strong></div><div class="cf-kpi"><small>Valor glosado</small><strong>@p.TotalGlossedAmount.ToString("C")</strong></div><div class="cf-kpi"><small>UST</small><strong>@p.TotalUst.ToString("N2")</strong></div><div class="cf-kpi"><small>Pendentes</small><strong>@Model.Items.Count(x=>x.Status=="PENDING_REVIEW")</strong></div><div class="cf-kpi"><small>Com glosa</small><strong>@Model.Glosas.Count(x=>x.Status is "OPEN" or "ANSWERED")</strong></div><div class="cf-kpi"><small>Evidências</small><strong>@Model.Evidences.Count</strong></div></div>
@if(!locked){<div class="cf-card cf-actions">@if(p.Status=="DRAFT"){<form method="post" asp-action="ImportProductivity" asp-route-id="@p.Id"><button class="cf-btn primary">Importar medição</button></form>}@if(p.Status is "IMPORTED" or "WITH_GLOSA" or "AWAITING_CONTRACTOR_RESPONSE"){<form method="post" asp-action="Submit" asp-route-id="@p.Id"><button class="cf-btn primary">Submeter para aceite</button></form>}@if(p.Status=="IN_REVIEW"){<form method="post" asp-action="Approve" asp-route-id="@p.Id"><input name="notes" placeholder="Observações do aceite"/><button class="cf-btn primary">Aprovar aceite</button></form>}@if(p.Status!="REJECTED"){<form method="post" asp-action="Reject" asp-route-id="@p.Id"><input name="reason" required placeholder="Motivo da rejeição"/><button class="cf-btn danger">Rejeitar</button></form>}</div>}else{<p class="cf-note">O aceite mensal bloqueia alterações na medição aprovada.</p>}
<div class="cf-card"><h2>Conferência item a item</h2><table class="cf-table"><thead><tr><th>Serviço / origem</th><th>Quantidade</th><th>UST</th><th>Medido</th><th>Glosado</th><th>Aprovado</th><th>Evidências</th><th>Status</th><th>Ações</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><strong>@x.ServiceName</strong><br/><small>@x.ServiceCode · @(x.SourceType??"MANUAL")</small></td><td>@x.MeasuredQuantity</td><td>@x.MeasuredUst</td><td>@x.MeasuredAmount.ToString("C")</td><td>@x.GlossedAmount.ToString("C")</td><td>@x.ApprovedAmount.ToString("C")</td><td>@x.EvidenceCount</td><td><span class="cf-badge @x.Status">@x.Status</span></td><td>@if(!locked&&x.Status=="PENDING_REVIEW"){<form method="post" asp-action="ApproveItem" asp-route-itemId="@x.Id"><input type="hidden" name="periodId" value="@p.Id"/><button class="cf-btn primary">Aprovar</button></form>}@if(!locked){<a class="cf-btn warn" asp-action="GlosaForm" asp-route-itemId="@x.Id" asp-route-periodId="@p.Id">Glosar</a>}</td></tr>}</tbody></table>@if(Model.Items.Count==0){<p>Importe a medição da competência para iniciar a conferência fiscal.</p>}</div>
<div class="cf-card"><h2>Glosas e manifestação</h2>@foreach(var g in Model.Glosas){<article class="cf-note"><strong>@g.GlosaType · @g.GlossedAmount.ToString("C")</strong> <span class="cf-badge">@g.Status</span><p>@g.Reason</p>@if(!string.IsNullOrEmpty(g.ContractorResponse)){<p><b>Manifestação:</b> @g.ContractorResponse</p>}@if(!locked&&g.Status=="OPEN"){<form method="post" asp-action="Respond" asp-route-glosaId="@g.Id"><input type="hidden" name="periodId" value="@p.Id"/><textarea name="response" required placeholder="Manifestação da contratada"></textarea><button class="cf-btn">Responder</button></form>}@if(!locked&&g.Status is "OPEN" or "ANSWERED"){<form method="post" asp-action="Maintain" asp-route-glosaId="@g.Id"><input type="hidden" name="periodId" value="@p.Id"/><input name="notes" required placeholder="Fundamentação fiscal"/><button class="cf-btn danger">Manter</button></form><form method="post" asp-action="Revert" asp-route-glosaId="@g.Id"><input type="hidden" name="periodId" value="@p.Id"/><input name="notes" required placeholder="Motivo da reversão"/><button class="cf-btn primary">Reverter</button></form>}</article>}</div>
@if(!locked){<div class="cf-card"><h2>Anexar evidência</h2><p>Anexe evidências suficientes antes de submeter o aceite.</p><form method="post" asp-action="Evidence" asp-route-id="@p.Id" class="cf-form"><label>Item (opcional)<select name="ItemId"><option value="">Evidência do período</option>@foreach(var x in Model.Items){<option value="@x.Id">@x.ServiceName</option>}</select></label><label>Tipo<select name="EvidenceType"><option>LINK</option><option>WORK_ORDER</option><option>INVENTORY</option><option>LABEL_PRINT</option><option>MOBILE_PHOTO</option><option>NOTE</option></select></label><label>Título<input name="Title" required/></label><label>URL segura<input name="ExternalUrl" type="url"/></label><label>Descrição<textarea name="Description"></textarea></label><button class="cf-btn primary">Anexar evidência</button></form></div>}
<div class="cf-card"><h2>Trilha de auditoria</h2>@foreach(var e in Model.Events){<p><strong>@e.PerformedAt.ToString("dd/MM/yyyy HH:mm") · @e.EventTitle</strong><br/><small>@e.FromStatus → @e.ToStatus · @e.EventDescription</small></p>}</div></div>
