@model IReadOnlyList<InovaGed.Application.Contracts.Fiscalization.ContractFiscalizationItemDto>
@{ViewData["Title"]="Itens fiscalizados";}<link rel="stylesheet" href="~/css/contract-fiscalization.css"/><div class="cf-shell"><div class="cf-card"><h1>Itens fiscalizados</h1><table class="cf-table"><thead><tr><th>Serviço</th><th>Origem</th><th>Quantidade</th><th>UST</th><th>Valor</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.ServiceName</td><td>@x.SourceType</td><td>@x.MeasuredQuantity</td><td>@x.MeasuredUst</td><td>@x.MeasuredAmount.ToString("C")</td><td>@x.Status</td></tr>}</tbody></table></div></div>
