@using InovaGed.Application.Contracts.Fiscalization
@model ContractFiscalizationReport
@{Layout=null;var p=Model.Details.Period;}
<!doctype html><html><head><meta charset="utf-8"/><title>Relatório de fiscalização</title><link rel="stylesheet" href="/css/contract-fiscalization.css"/></head><body><main class="cf-print"><div class="cf-no-print cf-actions"><button class="cf-btn primary" onclick="window.print()">Imprimir</button></div><p class="cf-eyebrow" style="color:#075e54">RELATÓRIO OFICIAL DE FISCALIZAÇÃO</p><h1>Folha de despacho</h1><p>Competência <strong>@p.CompetenceMonth.ToString("MM/yyyy")</strong> · Contrato <strong>@(p.ContractNumber??"não informado")</strong></p><div class="cf-card"><h2>Encaminhamento para pagamento</h2><p>Encaminha-se a medição da competência <strong>@p.CompetenceMonth.ToString("MM/yyyy")</strong> para pagamento do valor aprovado de <strong>@p.TotalApprovedAmount.ToString("C")</strong>.</p><p>Observações: @p.ContractorName — fiscalização @p.Status.</p><p>Data: @DateTime.Today.ToString("dd/MM/yyyy")</p></div><div class="cf-signatures"><div>Fiscal do contrato</div><div>Gestor do contrato</div></div></main></body></html>
