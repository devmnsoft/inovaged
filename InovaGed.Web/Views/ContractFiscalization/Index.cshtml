@model IReadOnlyList<InovaGed.Application.Contracts.Fiscalization.ContractFiscalizationPeriodItem>
@{ViewData["Title"]="Fiscalização Contratual";var current=Model.FirstOrDefault();}
<link rel="stylesheet" href="~/css/contract-fiscalization.css" />
<div class="cf-shell"><section class="cf-hero"><div><span class="cf-eyebrow">GOVERNANÇA CONTRATUAL</span><h1>Fiscalização Contratual</h1><p>Conferência mensal da medição, glosas, evidências e aceite dos serviços executados.</p></div><div class="cf-actions"><a class="cf-btn" asp-action="Create">Nova competência</a></div></section>
<div class="cf-grid"><div class="cf-kpi"><small>Competência atual</small><strong>@(current?.CompetenceMonth.ToString("MM/yyyy")??"—")</strong></div><div class="cf-kpi"><small>Valor medido</small><strong>@(current?.TotalMeasuredAmount.ToString("C")??"—")</strong></div><div class="cf-kpi"><small>Valor aprovado</small><strong>@(current?.TotalApprovedAmount.ToString("C")??"—")</strong></div><div class="cf-kpi"><small>Valor glosado</small><strong>@(current?.TotalGlossedAmount.ToString("C")??"—")</strong></div><div class="cf-kpi"><small>Status do aceite</small><strong>@(current?.Status??"Não criado")</strong></div></div>
<div class="cf-card"><form method="get" class="cf-actions"><input type="month" name="competence"/><select name="status"><option value="">Todos os status</option><option>DRAFT</option><option>IN_REVIEW</option><option>WITH_GLOSA</option><option>APPROVED</option><option>CLOSED</option></select><button class="cf-btn primary">Filtrar</button></form></div>
<div class="cf-card"><table class="cf-table"><thead><tr><th>Competência</th><th>Contrato</th><th>Status</th><th>Medido</th><th>Aprovado</th><th>Glosado</th><th>Fiscal</th><th>Abertura</th><th>Ações</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CompetenceMonth.ToString("MM/yyyy")</td><td>@(x.ContractNumber??"—")</td><td><span class="cf-badge @x.Status">@x.Status</span></td><td>@x.TotalMeasuredAmount.ToString("C")</td><td>@x.TotalApprovedAmount.ToString("C")</td><td>@x.TotalGlossedAmount.ToString("C")</td><td>@(x.FiscalUserId?.ToString()??"A definir")</td><td>@x.OpenedAt.ToString("dd/MM/yyyy")</td><td><a asp-action="Details" asp-route-id="@x.Id">Conferir</a></td></tr>}</tbody></table>@if(Model.Count==0){<p class="cf-note">Importe a medição da competência para iniciar a conferência fiscal.</p>}</div></div>
