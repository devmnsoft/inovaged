@using InovaGed.Application.Contracts.Fiscalization
@model ContractFiscalizationReport
@{Layout=null;var p=Model.Details.Period;}
<!doctype html><html><head><meta charset="utf-8"/><title>Relatório de fiscalização</title><link rel="stylesheet" href="/css/contract-fiscalization.css"/></head><body><main class="cf-print"><div class="cf-no-print cf-actions"><button class="cf-btn primary" onclick="window.print()">Imprimir</button></div><p class="cf-eyebrow" style="color:#075e54">RELATÓRIO OFICIAL DE FISCALIZAÇÃO</p><h1>Relatório analítico</h1><p>Competência <strong>@p.CompetenceMonth.ToString("MM/yyyy")</strong> · Contrato <strong>@(p.ContractNumber??"não informado")</strong></p><table class="cf-table"><thead><tr><th>Data</th><th>Serviço</th><th>Origem</th><th>Operador</th><th>Qtd.</th><th>UST</th><th>Valor</th><th>Evidência</th><th>Status</th><th>Observação fiscal</th></tr></thead><tbody>@foreach(var x in Model.Lines){<tr><td>@x.PerformedAt?.ToString("dd/MM/yyyy")</td><td>@x.Description</td><td>@x.Origin</td><td>@x.OperatorId</td><td>@x.Quantity</td><td>@x.Ust</td><td>@x.TotalAmount.ToString("C")</td><td>@x.EvidenceCount</td><td>@x.Status</td><td>@x.FiscalNotes</td></tr>}</tbody></table></main></body></html>
