@model InovaGed.Web.Controllers.ContractFiscalizationController.CreateInput
@{ViewData["Title"]="Nova fiscalização";}<link rel="stylesheet" href="~/css/contract-fiscalization.css" />
<div class="cf-shell"><section class="cf-hero"><div><span class="cf-eyebrow">NOVA COMPETÊNCIA</span><h1>Abrir fiscalização mensal</h1><p>Identifique o contrato e os responsáveis pelo aceite.</p></div></section><div class="cf-card"><form method="post" class="cf-form"><div asp-validation-summary="All"></div><label>Competência<input asp-for="CompetenceMonth" type="month" required/></label><label>Número do contrato<input asp-for="ContractNumber"/></label><label>Contratada<input asp-for="ContractorName"/></label><label>Unidade contratante<input asp-for="ContractingUnit"/></label><label>Fiscal (UUID)<input asp-for="FiscalUserId"/></label><label>Gestor (UUID)<input asp-for="ManagerUserId"/></label><label>Observações<textarea asp-for="Notes"></textarea></label><div class="cf-actions"><button class="cf-btn primary">Criar competência</button><a class="cf-btn" asp-action="Index">Cancelar</a></div></form></div></div>
