@model InovaGed.Web.Models.Poc.PocChecklistVm
@using InovaGed.Web.Models.Atlas
@using InovaGed.Web.Models.Poc
@{ ViewData["Title"] = "Checklist PoC 1–27"; var header = new AtlasPageHeaderVm("Checklist PoC item a item", "Requisito, prova funcional, referência técnica, evidência e passo de apresentação em uma única visão.", "list", "Central de demonstração", new[] { new AtlasPageAction("Abrir roteiro", "/Poc/Demo", "timeline", true) }, new (string, string?)[] { ("Central PoC", "/Poc"), ("Checklist", null) }); string Status(PocReadinessStatus s) => s == PocReadinessStatus.Ready ? "Pronto" : "Parcial"; }
<div class="atlas-prime-page poc-prime"><partial name="Atlas/_PageHeader" model="header" /><partial name="Atlas/_PageMetrics" model="Model.Metrics" />
<nav class="poc-prime__tabs" aria-label="Seções da Central PoC"><a href="/Poc">Visão geral</a><a class="active" href="/Poc/Checklist" aria-current="page">Checklist 1–27</a><a href="/Poc/Demo">Roteiro de demo</a><a href="/Poc/Evidences">Evidências</a></nav>
<section class="poc-checklist" aria-label="27 requisitos da prova de conceito">@foreach (var item in Model.Items) { <article class="poc-check-item"><div class="poc-check-item__number">@item.Number.ToString("00")</div><div class="poc-check-item__body"><div class="poc-check-item__title"><h2>@item.Requirement</h2><span class="poc-status poc-status--@item.Status.ToString().ToLowerInvariant()">@Status(item.Status)</span></div><div class="poc-check-item__proof"><span><strong>Tela de prova</strong><a href="@item.ProofScreen">@item.ProofScreen</a></span><span><strong>Tabela / endpoint</strong><code>@item.TechnicalReference</code></span></div><details><summary><app-icon name="timeline" size="15" decorative="true" /> Como demonstrar e coletar evidência</summary><p>@item.DemoStep</p><small>@item.Evidence</small></details></div></article> }</section></div>
@section Styles { <link rel="stylesheet" href="~/css/pages/poc-prime.css" asp-append-version="true" /> }
