@model InovaGed.Web.Models.Poc.PocDemoVm
@using InovaGed.Web.Models.Atlas
@{ ViewData["Title"] = "Roteiro de demonstração"; var header = new AtlasPageHeaderVm("Roteiro guiado de 30–45 minutos", "Uma narrativa ponta a ponta, do upload à portabilidade, com resultado esperado em cada parada.", "timeline", "Central de demonstração", new[] { new AtlasPageAction("Ver evidências", "/Poc/Evidences", "audit", true) }, new (string, string?)[] { ("Central PoC", "/Poc"), ("Roteiro", null) }); }
<div class="atlas-prime-page poc-prime"><partial name="Atlas/_PageHeader" model="header" />
<nav class="poc-prime__tabs" aria-label="Seções da Central PoC"><a href="/Poc">Visão geral</a><a href="/Poc/Checklist">Checklist 1–27</a><a class="active" href="/Poc/Demo" aria-current="page">Roteiro de demo</a><a href="/Poc/Evidences">Evidências</a></nav>
<section class="poc-demo-summary"><app-icon name="timeline" size="25" decorative="true" /><div><strong>@Model.TotalMinutes minutos</strong><span>@Model.Steps.Count etapas funcionais</span></div><p>Use os links em sequência e mantenha um mesmo documento como fio condutor da apresentação.</p></section>
<ol class="poc-demo-timeline">@foreach (var step in Model.Steps) { <li><span class="poc-demo-timeline__marker">@step.Order</span><article><div class="poc-demo-timeline__heading"><span><app-icon name="@step.Icon" size="20" decorative="true" /></span><div><small>@step.Minutes min</small><h2>@step.Title</h2></div></div><p>@step.Description</p><div class="poc-demo-timeline__evidence"><strong>Comprovação esperada</strong><span>@step.ExpectedEvidence</span></div><a class="btn btn-primary" href="@step.Url">@step.ActionLabel <app-icon name="arrow-right" size="15" decorative="true" /></a></article></li> }</ol></div>
@section Styles { <link rel="stylesheet" href="~/css/pages/poc-prime.css" asp-append-version="true" /> }
