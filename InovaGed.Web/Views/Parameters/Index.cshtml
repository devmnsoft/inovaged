@model InovaGed.Application.Parameters.ParameterIndexVM
@{ ViewData["Title"] = "Parâmetros do Sistema"; }
@section Styles { <link rel="stylesheet" href="~/css/parameters.css" asp-append-version="true" /> }
<div class="parameters-page" data-parameters-page>
  <header class="parameters-hero">
    <div><span class="parameters-eyebrow"><app-icon name="settings" size="15" decorative="true" /> Administração segura</span><h1>Parâmetros do Sistema</h1><p>Configurações operacionais que padronizam os cadastros e o funcionamento do InovaGED.</p></div>
    <a class="btn btn-primary parameters-primary" asp-action="Create" asp-route-categoryCode="@Model.CategoryCode"><app-icon name="plus" size="17" decorative="true" /> Novo parâmetro</a>
  </header>
  @if (TempData["Success"] is not null) { <div class="parameters-feedback success" role="status"><app-icon name="check" size="18" decorative="true" /><span>@TempData["Success"]</span></div> }
  @if (TempData["Error"] is not null) { <div class="parameters-feedback danger" role="alert"><app-icon name="warning" size="18" decorative="true" /><span>@TempData["Error"]</span></div> }
  <section class="parameters-metrics" aria-label="Indicadores">
    <article><span>Total visível</span><strong>@Model.Total</strong><small>na seleção atual</small></article>
    <article><span>Ativos</span><strong>@Model.Active</strong><small>disponíveis para uso</small></article>
    <article><span>Inativos</span><strong>@Model.Inactive</strong><small>preservados no histórico</small></article>
    <article><span>Alterados recentemente</span><strong>@Model.RecentlyChanged</strong><small>nos últimos 30 dias</small></article>
  </section>
  <section class="parameters-workspace">
    <form method="get" class="parameters-filters" aria-label="Filtros de parâmetros">
      <div class="parameters-search"><app-icon name="search" size="17" decorative="true" /><label class="visually-hidden" for="parameterSearch">Buscar</label><input id="parameterSearch" name="search" value="@Model.Search" placeholder="Buscar por chave, nome ou descrição" /></div>
      <label><span>Grupo</span><select name="categoryCode"><option value="">Todos os grupos</option>@foreach(var c in Model.Categories){<option value="@c.Code" selected="@(c.Code == Model.CategoryCode)">@c.Name (@c.TotalItems)</option>}</select></label>
      <label><span>Status</span><select name="status"><option value="all" selected="@(Model.Status == "all")">Todos</option><option value="active" selected="@(Model.Status == "active")">Ativos</option><option value="inactive" selected="@(Model.Status == "inactive")">Inativos</option></select></label>
      <button class="btn btn-primary" type="submit">Aplicar filtros</button><a class="btn btn-light" asp-action="Index">Limpar</a>
    </form>
    <div class="parameters-table-wrap">
      <table class="parameters-table"><thead><tr><th>Parâmetro</th><th>Grupo</th><th>Valor / referência</th><th>Status</th><th>Última alteração</th><th><span class="visually-hidden">Ações</span></th></tr></thead>
      <tbody>@if(!Model.Items.Any()){<tr><td colspan="6"><div class="parameters-empty"><app-icon name="search" size="30" decorative="true" /><strong>Nenhum parâmetro encontrado</strong><span>Ajuste os filtros ou crie um novo parâmetro.</span></div></td></tr>} else {@foreach(var item in Model.Items){
        <tr data-parameter-id="@item.Id"><td data-label="Parâmetro"><button type="button" class="parameter-key js-parameter-details" data-id="@item.Id">@item.Code</button><strong>@item.Name</strong><small>@(item.Description ?? "Sem descrição informada")</small></td><td data-label="Grupo"><span class="parameter-group">@item.CategoryName</span>@if(item.IsSystem){<small>Sistêmico e protegido</small>}</td><td data-label="Valor / referência"><span>@(item.Abbreviation ?? item.ExternalCode ?? item.ParentName ?? "—")</span></td><td data-label="Status"><span class="parameter-status @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? "Ativo" : "Inativo")</span></td><td data-label="Última alteração"><time datetime="@((item.UpdatedAt ?? item.CreatedAt).ToString("O"))">@((item.UpdatedAt ?? item.CreatedAt).ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</time><small>Auditoria preservada</small></td><td class="parameter-actions"><div class="dropdown"><button class="btn btn-sm btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><app-icon name="more" size="16" decorative="true" /> Ações</button><div class="dropdown-menu dropdown-menu-end"><button class="dropdown-item js-parameter-details" type="button" data-id="@item.Id"><app-icon name="eye" size="15" decorative="true" /> Visualizar</button><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><app-icon name="edit" size="15" decorative="true" /> Editar</a><a class="dropdown-item" asp-action="Duplicate" asp-route-id="@item.Id"><app-icon name="copy" size="15" decorative="true" /> Duplicar</a><div class="dropdown-divider"></div><form asp-action="SetActive" asp-route-id="@item.Id" method="post">@Html.AntiForgeryToken()<input type="hidden" name="categoryCode" value="@Model.CategoryCode"/><input type="hidden" name="active" value="@(!item.IsActive)"/><button class="dropdown-item" type="submit">@(item.IsActive ? "Inativar" : "Ativar")</button></form>@if(!item.IsSystem){<button class="dropdown-item text-danger js-parameter-delete" type="button" data-id="@item.Id" data-name="@item.Name">Inativar e remover da lista</button>}</div></div></td></tr>
      }}</tbody></table>
    </div>
  </section>
</div>
<dialog id="parameterDetailsDialog" class="parameter-dialog"><div class="parameter-dialog-head"><div><span>Detalhes do parâmetro</span><h2 id="detailName">Carregando…</h2></div><button type="button" class="btn btn-light js-dialog-close" aria-label="Fechar"><app-icon name="close" size="16" decorative="true" /></button></div><div id="parameterDetailsBody" class="parameter-dialog-body"></div><div class="parameter-dialog-actions"><button id="copyParameterKey" type="button" class="btn btn-light"><app-icon name="copy" size="15" decorative="true" /> Copiar chave</button><a id="editParameterLink" class="btn btn-primary">Editar parâmetro</a></div></dialog>
<dialog id="parameterDeleteDialog" class="parameter-dialog compact"><form id="parameterDeleteForm" method="post">@Html.AntiForgeryToken()<input type="hidden" name="categoryCode" value="@Model.CategoryCode"/><input type="hidden" name="reason" value="Inativação confirmada pela gestão de parâmetros"/><div class="parameter-dialog-head"><div><span>Ação controlada</span><h2>Inativar parâmetro?</h2></div></div><div class="parameter-dialog-body"><p><strong id="deleteParameterName"></strong> deixará de aparecer nos cadastros, mas o histórico será preservado.</p><p>Essa ação não apaga referências já utilizadas.</p></div><div class="parameter-dialog-actions"><button type="button" class="btn btn-light js-dialog-close">Cancelar</button><button type="submit" class="btn btn-danger">Confirmar inativação</button></div></form></dialog>
@section Scripts { <script src="~/js/parameters.js" asp-append-version="true"></script> }
