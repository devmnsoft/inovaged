@{
    ViewData["Title"] = "Cadastrar documentos";
    var types = (System.Collections.Generic.IReadOnlyList<InovaGed.Web.Controllers.SectorCatalogChoice>)(ViewBag.Types ?? Array.Empty<InovaGed.Web.Controllers.SectorCatalogChoice>());
}
<link rel="stylesheet" href="~/css/demais-setores.css" asp-append-version="true" />
<main class="ds-page" data-ds-register data-find-url="@Url.Action("BuscarPaciente")" data-start-url="@Url.Action("IniciarEnvio")" data-part-url="@Url.Action("ParteEnvio")" data-status-url="@Url.Action("SituacaoEnvio")" data-cancel-url="@Url.Action("CancelarEnvio")" data-complete-url="@Url.Action("ConcluirEnvio")" data-link-url="@Url.Action("VincularExistente")" data-retry-url="@Url.Action("Reenfileirar")" data-open-url="@Url.Action("Consultar")">
    @Html.AntiForgeryToken()
    <h1>Cadastrar documentos</h1>
    <p class="ds-help">Confirme o paciente e o atendimento, escolha o nome do catálogo e grave os arquivos. O envio grande segue em partes, até @ViewBag.MaxMb MB quando esse limite estiver configurado. Leitura e extração acontecem depois da gravação.</p>
    <ol class="ds-steps"><li>1. Paciente e atendimento</li><li>2. Documentos</li><li>3. Confirmação</li></ol>
    <section class="ds-card">
        <h2>Paciente e atendimento</h2>
        <form data-ds-patient-form class="ds-grid">
            @Html.AntiForgeryToken()
            <label>Tipo do identificador<select name="identifierKind"><option value="ID">ID do paciente</option><option value="CPF">CPF</option></select></label>
            <label>Identificador do paciente<input name="externalCode" autocomplete="off" required /></label>
            <label>Sistema de origem<input name="sourceSystem" value="MV" /></label>
            <label>Unidade de origem<input name="sourceUnit" /></label>
            <div class="ds-actions"><button type="button" data-ds-find>Consultar</button></div>
        </form>
        <p data-ds-context class="ds-note">Nenhum paciente confirmado.</p>
        <label>Atendimento<select data-ds-encounters><option value="">Selecione depois da consulta</option></select></label>
        <p class="ds-note">I, A e U só aparecem como internação, ambulatorial ou urgência depois que o contrato da origem for parametrizado.</p>
    </section>
    <section class="ds-card">
        <h2>Documentos</h2>
        <label>Nome padronizado
            <select data-ds-catalog>
                <option value="">Escolha no catálogo</option>
                @foreach (var item in types)
                {
                    <option value="@item.Code">@item.Order.ToString("00") — @item.Name</option>
                }
            </select>
        </label>
        <label>Setor comum<input name="sectorCode" placeholder="FATURAMENTO, FARMACIA, CME ou DDI" /></label>
        <label>Data comum do documento<input name="documentDate" type="date" /></label>
        <label>Emissor clínico<input name="issuerName" /></label>
        <label>Responsável pela informação<input name="informationOwner" /></label>
        <label>Observação<textarea name="notes"></textarea></label>
        <label><input type="checkbox" name="confirmAnotherOccurrence" /> Confirmo outra ocorrência do mesmo tipo, não uma nova versão.</label>
        <div class="ds-drop" data-ds-drop tabindex="0">Arraste os arquivos para esta área ou escolha abaixo. A prévia aparece quando o navegador consegue mostrá-la.</div>
        <label>Arquivos<input type="file" data-ds-files multiple accept=".pdf,.jpg,.jpeg,.png,.tif,.tiff,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt" /></label>
        <div class="ds-actions"><button type="button" data-ds-apply>Aplicar valores comuns aos arquivos</button></div>
        <ul data-ds-file-list></ul>
        <p class="ds-note">Cada arquivo mostra a transferência, a gravação e, em separado, a pré-visualização e a leitura. Se a gravação falhar depois do arquivo já estar no GED, repita só o vínculo.</p>
    </section>
    <section class="ds-card">
        <h2>Confirmação</h2>
        <div class="ds-actions"><button type="button" data-ds-send disabled="disabled">Gravar no GED</button>
            <a data-ds-open href="@Url.Action("Consultar")">Abrir documentos deste atendimento</a></div>
        <p data-ds-status class="ds-status" hidden></p>
        <ul data-ds-results></ul>
    </section>
</main>
<script src="~/js/demais-setores.js" asp-append-version="true"></script>
