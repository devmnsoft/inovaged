@using InovaGed.Web.Controllers
@{
    ViewData["Title"] = "Consultar e analisar";
    var documents = (IReadOnlyList<SectorDocumentRow>)(ViewBag.Documents ?? Array.Empty<SectorDocumentRow>());
    var fields = (IReadOnlyList<SectorFieldRow>)(ViewBag.Fields ?? Array.Empty<SectorFieldRow>());
    var findings = (IReadOnlyList<SectorFindingRow>)(ViewBag.Findings ?? Array.Empty<SectorFindingRow>());
    var checklist = (IReadOnlyList<SectorChecklistRow>)(ViewBag.Checklist ?? Array.Empty<SectorChecklistRow>());
    var siblings = (IReadOnlyList<SectorEncounterOption>)(ViewBag.Siblings ?? Array.Empty<SectorEncounterOption>());
    var context = (object?)ViewBag.Context as SectorContextRow;
    var files = documents.Count;
    var types = documents.Select(item => item.CatalogCode).Distinct().Count();
    var encounterRaw = (object?)ViewBag.EncounterId;
    var encounterId = encounterRaw is Guid parsedEncounter ? parsedEncounter : (Guid?)null;
    var embedded = ViewBag.Embedded == true;
    var fileAction = (string?)ViewBag.FileAction ?? "Arquivo";
    var publicId = ViewBag.PublicId is Guid parsedPublic ? parsedPublic : (Guid?)null;
    string FileUrl(Guid versionId) => publicId is Guid id
        ? Url.Action(fileAction, new { publicId = id, versionId }) ?? "#"
        : Url.Action(fileAction, new { versionId }) ?? "#";
    var searchUrl = publicId is Guid searchId ? Url.Action("PesquisarIntegrado", new { publicId = searchId }) : Url.Action("Pesquisar");
    var textUrl = publicId is Guid textId ? Url.Action("TextoIntegrado", new { publicId = textId }) : Url.Action("Texto");
    var switchUrl = publicId is Guid switchId ? Url.Action("TrocarAtendimento", new { publicId = switchId }) : Url.Action("TrocarAtendimento");
    string ProcessingLabel(string? status) => status switch
    {
        "CONCLUIDO" => "Concluído",
        "AGUARDANDO_TEXTO" => "Aguardando texto",
        "BLOQUEADO_OCR" => "Aguardando correção do OCR",
        "SEM_TEXTO" => "Concluído sem texto utilizável",
        "AGUARDANDO" => "Aguardando",
        "ENFILEIRADO" => "Na fila",
        "PROCESSANDO" => "Em processamento",
        "FALHOU" => "Falhou",
        "FALHOU_AO_ENFILEIRAR" => "Solicitação não enfileirada",
        "NAO_APLICAVEL" => "Não se aplica",
        "CANCELADO" => "Cancelado",
        "JA_EXISTENTE" => "Já existente",
        "CONCLUIDO_COM_PENDENCIAS" => "Concluído com pendências",
        _ => status ?? "Aguardando"
    };
    if (embedded)
        Layout = "~/Views/Shared/_DemaisSetoresFrame.cshtml";
}
<link rel="stylesheet" href="~/css/demais-setores.css" asp-append-version="true" />
<main class="ds-page" data-ds-consult data-embedded="@(embedded ? "1" : "0")" data-public-id="@publicId" data-partner-origin="@ViewBag.PartnerOrigin" data-allow-switch="@(ViewBag.AllowSwitch == true ? "1" : "0")" data-patient-id="@context?.PatientId" data-encounter-id="@encounterId" data-encounter-code="@context?.EncounterCode" data-find-url="@Url.Action("BuscarPaciente")" data-switch-url="@switchUrl" data-search-url="@searchUrl" data-text-url="@textUrl" data-file-url="@(publicId is Guid fileId ? Url.Action(fileAction, new { publicId = fileId }) : Url.Action(fileAction))">
    @Html.AntiForgeryToken()
    <h1>Consultar e analisar</h1>
    @if(publicId is Guid sessionId)
    {
        <section class="ds-card" data-ds-session data-expires="@(((DateTimeOffset?)ViewBag.SessionExpiresAt)?.ToString("O"))" data-status-url="@Url.Action("EstadoIntegrado",new { publicId=sessionId })" data-recovery-url="@Url.Action("Recuperar",new { reference=sessionId })" data-partner-origin="@ViewBag.PartnerOrigin" aria-live="polite">
            <p data-ds-session-state>Sessão ativa. O acesso é revalidado a cada consulta.</p>
            <a class="ds-primary-action" data-ds-session-recover hidden target="_blank" rel="noopener noreferrer">Abrir em nova janela</a>
        </section>
        <script src="~/js/demais-setores-session.js" asp-append-version="true"></script>
    }
    <p class="ds-help">Como usar: confirme o atendimento, escolha o documento e leia o PDF, o texto e os dados sugeridos. Campo sugerido não é informação validada. A conta não está integrada: ausência no prontuário não significa item não faturado.</p>
    <section class="ds-context" data-ds-consult-lookup>
        @if (!embedded)
        {
        <form data-ds-patient-form class="ds-grid">
            @Html.AntiForgeryToken()
            <label>Tipo do identificador<select name="identifierKind"><option value="ID">ID do paciente</option><option value="CPF">CPF</option></select></label>
            <label>Identificador do paciente<input name="externalCode" autocomplete="off" /></label>
            <label>Sistema de origem<input name="sourceSystem" value="MV" /></label>
            <label>Unidade de origem<input name="sourceUnit" /></label>
            <div class="ds-actions"><button type="button" data-ds-find>Consultar paciente</button></div>
        </form>
        <p data-ds-context class="ds-note">Busque pelo ID externo ou CPF e confirme o paciente antes de escolher o atendimento.</p>
        <label>Atendimento<select data-ds-encounters><option value="">Selecione um atendimento</option></select></label>
        <div class="ds-actions"><a data-ds-context-open aria-disabled="true">Abrir o atendimento confirmado</a></div>
        }
        @if (context is null)
        {
            <p class="ds-note">Nenhum atendimento aberto. A origem clínica, quando indisponível, não cria paciente fictício.</p>
        }
        else
        {
            <p><strong>@context.DisplayName</strong> · código @context.PatientCode</p>
            <p>Atendimento @context.EncounterCode · código externo @(context.RawKind ?? "não informado") · tipo @(context.Kind ?? "ainda não mapeado") · @(context.Status ?? "situação não informada")</p>
            <p class="ds-note">Entrada @(context.AdmittedAt?.ToString("dd/MM/yyyy HH:mm") ?? "não informada") · alta @(context.DischargedAt?.ToString("dd/MM/yyyy HH:mm") ?? "não informada")</p>
            @if (context.ConfirmedAt is DateTimeOffset confirmed)
            {
                <p class="ds-note">Identidade confirmada na origem em @confirmed.ToLocalTime().ToString("dd/MM/yyyy HH:mm"). Esta data não amplia a autorização da sessão.</p>
            }
            <details>
                <summary>Detalhes administrativos</summary>
                <p class="ds-note">Paciente interno @context.PatientId · atendimento interno @(encounterId?.ToString() ?? "") · escopo @(ViewBag.ScopeKind ?? "consulta interna")</p>
            </details>
        }
        <p>Arquivos visíveis: @files. Tipos presentes: @types. Essas quantidades são diferentes. Pré-visualização, OCR e extração são etapas separadas. OCR concluído não confirma os dados.</p>
        @if (embedded && ViewBag.AllowSwitch == true)
        {
            <form method="post" action="@switchUrl" class="ds-grid" data-ds-switch>
                <input type="hidden" name="protecao" data-ds-protection value="" />
                <label>Outro atendimento deste paciente
                    <select name="encounterCode">
                        @foreach (var sibling in siblings)
                        {
                            <option value="@sibling.Code">@sibling.Code · @(sibling.Kind ?? "tipo não mapeado") · @(sibling.AdmittedAt?.ToString("dd/MM/yyyy") ?? "entrada não informada") · @(sibling.DischargedAt?.ToString("dd/MM/yyyy") ?? "sem alta")</option>
                        }
                    </select>
                </label>
                <button type="submit">Trocar atendimento</button>
            </form>
            <p class="ds-note">A troca só vale se a integração e esta abertura permitirem navegação entre episódios. O mesmo paciente não autoriza a troca sozinho.</p>
        }
    </section>
    <div class="ds-tabs" role="tablist">
        <button type="button" data-ds-tab="lista" aria-controls="ds-lista">Documentos</button>
        <button type="button" data-ds-tab="pdf" aria-controls="ds-pdf">PDF</button>
        <button type="button" data-ds-tab="analise" aria-controls="ds-analise">Análise</button>
    </div>
    <div class="ds-actions"><button type="button" data-ds-collapse aria-controls="ds-analise" aria-expanded="true">Recolher análise</button></div>
    <div class="ds-workspace" data-ds-workspace data-auto-version="@ViewBag.AutoVersion">
        <section class="ds-list is-active" id="ds-lista" data-region="lista">
            <h2>Lista</h2>
            <div class="ds-grid">
                <label>Nome<input data-ds-filter="name" type="search" /></label>
                <label>Origem<select data-ds-filter="origin"><option value="">Todas</option><option>GED_UPLOAD</option><option>MV</option><option>EXTERNO</option></select></label>
                <label>Setor<input data-ds-filter="sector" /></label>
                <label>Situação<select data-ds-filter="review"><option value="">Todas</option><option>RECEBIDO</option><option>PENDENTE</option><option>EM_CONFERENCIA</option><option>CONFERIDO</option><option>INCONSISTENTE</option><option>NAO_APLICAVEL</option><option>SUBSTITUIDO</option></select></label>
            </div>
            @foreach (var group in documents.GroupBy(item => item.CatalogCode))
            {
                <h3>@group.First().Name <span class="ds-badge">@group.Count() arquivo(s)</span></h3>
                foreach (var document in group.OrderBy(item => item.DocumentDate))
                {
                    <button type="button" class="ds-doc" data-ds-open data-url="@FileUrl(document.VersionId)" data-version="@document.VersionId" data-name="@document.Name" data-origin="@document.Origin" data-sector="@document.SectorCode" data-review="@document.ReviewStatus" data-date="@document.DocumentDate?.ToString("yyyy-MM-dd")" aria-current="false">
                        <strong>@document.Name</strong>
                        <span class="ds-badge">@document.ReviewStatus</span>
                        <span class="ds-badge">Prévia: @ProcessingLabel(document.PreviewStatus)</span>
                        <span class="ds-badge">OCR: @ProcessingLabel(document.OcrStatus)</span>
                        <span class="ds-badge">Extração: @ProcessingLabel(document.ExtractionStatus)</span>
                        <span class="ds-note">Arquivo gravado · vínculo confirmado. A revisão humana permanece separada.</span>
                        <span class="ds-note">@document.OriginalFileName · @document.Origin · @(document.SectorCode ?? "setor não informado") · @(document.DocumentDate?.ToString("dd/MM/yyyy") ?? "sem data")</span>
                    </button>
                    @if (ViewBag.CanExtract == true && InovaGed.Application.Sectors.SectorClinicalEvidence.SupportedCatalog.Contains(document.CatalogCode))
                    {
                        <details class="ds-card">
                        <summary>Sugestões clínicas com IA</summary>
                        <form method="post" action="@Url.Action("ExtrairItensClinicos")" data-ds-clinical-extraction>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="linkId" value="@document.LinkId" />
                            <input type="hidden" name="idempotencyKey" value="@Guid.NewGuid().ToString("N")" />
                            <input type="hidden" name="resumeRunId" value="" />
                            <p class="ds-note">IA clínica usa o texto desta versão, se houver política e provedor autorizados. As sugestões exigem revisão e não geram cobrança.</p>
                            <button type="submit">Sugerir itens clínicos com IA</button>
                            <p role="status" aria-live="polite" data-ds-clinical-result></p>
                            <button type="button" data-ds-clinical-refresh hidden>Atualizar sugestões na tela</button>
                        </form>
                        </details>
                    }
                    @if (ViewBag.CanReview == true)
                    {
                        <form method="post" action="@Url.Action("Conferir")" class="ds-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="linkId" value="@document.LinkId" />
                            <label>Conferência<select name="toStatus"><option>EM_CONFERENCIA</option><option>CONFERIDO</option><option>INCONSISTENTE</option><option>PENDENTE</option><option>NAO_APLICAVEL</option><option>RECEBIDO</option></select></label>
                            <label>Justificativa<input name="justification" /></label>
                            <button type="submit">Registrar conferência</button>
                        </form>
                    }
                    @if (document.RequiresPhysical && ViewBag.CanReview == true)
                    {
                        <form method="post" action="@Url.Action("EvidenciaFisica")" class="ds-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="linkId" value="@document.LinkId" />
                            <label>Evidência do original físico<input name="evidence" value="@document.PhysicalEvidence" required /></label>
                            <button type="submit">Registrar original</button>
                        </form>
                    }
                }
            }
            @if (documents.Count == 0)
            {
                <p>Não há documento deste tipo no atendimento. Outro atendimento não foi aberto.</p>
            }
            else if (!string.IsNullOrWhiteSpace((string?)ViewBag.CatalogCode) && documents.Count(item => item.CatalogCode == (string)ViewBag.CatalogCode) > 1)
            {
                <p>Há mais de um documento deste tipo.</p>
            }
            <h3>Pesquisar neste atendimento</h3>
            <form data-ds-search class="ds-grid">
                <label>Palavra ou expressão<input name="term" minlength="2" required /></label>
                @if (!embedded || ViewBag.AllowSwitch == true)
                {
                    <label><input type="checkbox" name="includeOtherEncounters" /> Incluir outros atendimentos deste paciente. Cada resultado mostra o episódio. Sem permissão de navegação, a busca permanece neste atendimento.</label>
                }
                <input type="hidden" name="page" value="0" data-ds-page />
                <button type="submit">Buscar texto</button>
            </form>
            <p class="ds-note">A busca é literal. Sinônimos cadastrados no tipo ampliam o termo. Análise semântica não é executada e página sem marcação no texto não é estimada. Cada página tem 20 resultados. A navegação alcança 51 páginas, até 1.020 resultados. O total continua visível quando houver mais, e a interface pede para refinar a pesquisa.</p>
            <ul data-ds-hits></ul>
            <nav class="ds-pager" data-ds-pager hidden aria-label="Páginas da pesquisa">
                <button type="button" data-ds-prev>Anterior</button>
                <p data-ds-range class="ds-note"></p>
                <button type="button" data-ds-next>Próxima</button>
            </nav>
        </section>
        <section id="ds-pdf" data-region="pdf">
            <div class="ds-viewer-header">
                <h2>Visualizador</h2>
                <div class="ds-viewer-controls">
                    <button type="button" class="ds-btn-tool" data-ds-zoom-out title="Diminuir zoom (−)">−</button>
                    <span class="ds-zoom-label" data-ds-zoom-level>100%</span>
                    <button type="button" class="ds-btn-tool" data-ds-zoom-in title="Aumentar zoom (+)">+</button>
                    <button type="button" class="ds-btn-tool" data-ds-zoom-reset title="Redefinir zoom (100%)">100%</button>
                    <a data-ds-viewer-direct href="#" target="_blank" rel="noopener noreferrer" class="ds-viewer-direct" hidden>Abrir em nova aba</a>
                </div>
            </div>
            <p class="ds-note" data-ds-viewer-status>Nenhum documento selecionado.</p>
            <iframe class="ds-viewer" data-ds-frame title="Documento do atendimento" name="ds-viewer"></iframe>
        </section>
        <aside class="ds-analysis" id="ds-analise" data-region="analise">
            <h2>Análise</h2>
            <div class="ds-tabs ds-tabs-always" role="tablist">
                <button type="button" data-ds-panel="texto">Texto</button>
                <button type="button" data-ds-panel="dados">Dados extraídos</button>
                <button type="button" data-ds-panel="achados">Achados</button>
                <button type="button" data-ds-panel="checklist">Checklist e histórico</button>
            </div>
            <div data-ds-panel-body="texto" class="is-active">
                <p data-ds-text class="ds-note">Selecione um documento para ver o texto já lido. Correção de campo não altera o PDF.</p>
            </div>
            <div data-ds-panel-body="dados" hidden>
                @if (fields.Count == 0)
                {
                    <p>Nenhum campo extraído para os documentos visíveis.</p>
                }
                @foreach (var field in fields)
                {
                    <article class="ds-card">
                        <p><span class="ds-badge">@field.Status</span> @field.ContextCode</p>
                        <p>Proposta: @field.SuggestedValue</p>
                        @if (!string.IsNullOrWhiteSpace(field.ConfirmedValue))
                        {
                            <p>Valor revisado: @field.ConfirmedValue</p>
                        }
                        <p>Evidência: @field.Evidence @(field.PageNumber is null ? "(página não informada pelo mecanismo; sem coordenadas não há destaque visual)" : "página " + field.PageNumber)</p>
                        <p class="ds-note">Origem @(field.SourceKind == "TEXTO_NATIVO" ? "texto nativo" : field.SourceKind ?? "texto da versão") · mecanismo @(field.Mechanism == "IA_CLINICA_V1" ? "IA clínica" : field.Mechanism?.StartsWith("REGRAS_LOCAIS") == true ? "regras locais" : field.Mechanism) · situação @field.Status. Valor sugerido não é dado confirmado.</p>
                        @if (field.ReviewerId.HasValue)
                        {
                            <p class="ds-note">Revisão registrada por @field.ReviewerName, em @field.ReviewedAt.</p>
                        }
                        <button type="button" data-ds-open data-url="@FileUrl(field.VersionId)" data-page="@field.PageNumber" data-version="@field.VersionId">Abrir evidência</button>
                        @if (ViewBag.CanExtract == true && field.Status!="SUPERADO")
                        {
                            <form method="post" action="@Url.Action("RevisarCampo")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="fieldId" value="@field.FieldId" />
                                <select name="status"><option>CONFIRMADO</option><option>CORRIGIDO</option><option>REJEITADO</option><option>INCONCLUSIVO</option></select>
                                <input name="value" placeholder="Valor corrigido, se houver" />
                                <button type="submit">Registrar revisão</button>
                            </form>
                        }
                    </article>
                }
            </div>
            <div data-ds-panel-body="achados" hidden>
                <p class="ds-note">@InovaGed.Application.Sectors.SectorFindings.AccountUnavailable</p>
                @foreach (var finding in findings)
                {
                    <article class="ds-card">
                        <p>@finding.Description</p>
                        <p><span class="ds-badge">@finding.Status</span> <span class="ds-badge">@finding.Category</span> Informação localizada, não elegibilidade de faturamento.</p>
                        <p>@finding.Evidence @(finding.PageNumber is null ? "" : "· página " + finding.PageNumber)</p>
                        @if (finding.VersionId is Guid versionId)
                        {
                            <button type="button" data-ds-open data-url="@FileUrl(versionId)" data-page="@finding.PageNumber" data-version="@versionId">Abrir evidência</button>
                        }
                        @if (ViewBag.CanReview == true)
                        {
                            <form method="post" action="@Url.Action("DecidirAchado")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="findingId" value="@finding.FindingId" />
                                <select name="status"><option>CONFIRMADO</option><option>REJEITADO</option><option>COMPLEMENTACAO</option><option>ENCAMINHADO</option></select>
                                <input name="justification" required />
                                <button type="submit">Registrar decisão</button>
                            </form>
                        }
                    </article>
                }
            </div>
            <div data-ds-panel-body="checklist" hidden>
                <h3>Checklist do Anexo I</h3>
                <ul>
                    @foreach (var item in checklist)
                    {
                        <li>@item.Order.ToString("00") @item.Name — @item.State @(item.Required ? "(exigido neste contexto)" : "")</li>
                    }
                </ul>
                @if (ViewBag.CanCorrect == true && encounterId.HasValue)
                {
                    <h3>Corrigir vínculo</h3>
                    <form method="post" action="@Url.Action("CorrigirVinculo")" class="ds-grid">
                        @Html.AntiForgeryToken()
                        <label>Documento
                            <select name="linkId">
                                @foreach (var document in documents)
                                {
                                    <option value="@document.LinkId">@document.Name</option>
                                }
                            </select>
                        </label>
                        <label>Atendimento do mesmo paciente
                            <select name="toEncounterId">
                                @foreach (var sibling in siblings)
                                {
                                    <option value="@sibling.Id">@sibling.Code · @(sibling.Kind ?? "tipo não mapeado") · @(sibling.Status ?? "situação não informada")</option>
                                }
                            </select>
                        </label>
                        <label>Justificativa<input name="reason" required /></label>
                        <button type="submit">Corrigir vínculo</button>
                    </form>
                    @if (siblings.Count == 0)
                    {
                        <p class="ds-note">Não há outro atendimento deste paciente para receber o vínculo.</p>
                    }
                }
                @if (ViewBag.CanExtract == true && encounterId.HasValue)
                {
                    <h3>Solicitar leitura</h3>
                    <p class="ds-note">O vínculo e as mudanças de texto acionam o processamento em segundo plano. Esta ação solicita nova verificação na fila. Abrir a consulta não executa extração. Correções humanas são preservadas.</p>
                    <form method="post" action="@Url.Action("AtualizarLeitura")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="encounterId" value="@encounterId" />
                        <button type="submit">Solicitar verificação na fila</button>
                    </form>
                }
                @if (ViewBag.CanPrint == true && encounterId.HasValue)
                {
                    <h3>Preparar entrega</h3>
                    <p class="ds-note">A impressão não avalia assinatura digital e não substitui original físico. A preparação não é entrega confirmada e não encerra o atendimento. O Anexo II só entra se o perfil institucional estiver habilitado.</p>
                    <p><a href="@Url.Action("PreviaEntrega", new { encounterId })">Abrir prévia de capa e checklist</a></p>
                    <form method="post" action="@Url.Action("PrepararEntrega")" class="ds-grid">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="encounterId" value="@encounterId" />
                        <label>Perfil<select name="profileCode"><option>ANEXO_I</option><option>ANEXO_II</option></select></label>
                        <label>Destinatário<input name="recipient" /></label>
                        @foreach (var document in documents)
                        {
                            <label><input type="checkbox" name="linkIds" value="@document.LinkId" /> @document.Name @(document.RequiresPhysical ? "(original físico)" : "")</label>
                        }
                        <button type="submit">Preparar entrega</button>
                    </form>
                }
                @if (ViewBag.CanShare == true)
                {
                    <h3>Link para incorporação</h3>
                    <form method="post" action="@Url.Action("CriarIncorporacao")" class="ds-grid">
                        @Html.AntiForgeryToken()
                        <label>Versão
                            <select name="versionId">
                                @foreach (var document in documents)
                                {
                                    <option value="@document.VersionId">@document.Name</option>
                                }
                            </select>
                        </label>
                        <label>Origem cadastrada<input name="origin" placeholder="https://aplicacao.exemplo" /></label>
                        <button type="submit">Gerar concessão de 15 minutos</button>
                    </form>
                }
            </div>
        </aside>
    </div>
</main>
<script src="~/js/demais-setores.js" asp-append-version="true"></script>
<script src="~/js/demais-setores-clinical.js" asp-append-version="true"></script>
