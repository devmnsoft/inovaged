@{
    ViewData["Title"] = "Parametrizações";
}
<link rel="stylesheet" href="~/css/demais-setores.css" asp-append-version="true" />
<main class="ds-page">
    <h1>Parametrizações</h1>
    <p class="ds-help">DDI permanece sem significado institucional atribuído. A visão desse setor só existe para os tipos que forem associados de propósito. O Anexo II não substitui o Anexo I.</p>
    <section class="ds-card">
        <h2>Setores já cadastrados</h2>
        <ul>
            @foreach (var department in ViewBag.Departments)
            {
                <li>@department.code — @department.name</li>
            }
        </ul>
        <p class="ds-note">Se DDI não aparecer, não há departamento com esse código. O módulo não cria esse significado.</p>
    </section>
    <section class="ds-card">
        <h2>Contrato do tipo de atendimento</h2>
        <form method="post" action="@Url.Action("SalvarContrato")">
            @Html.AntiForgeryToken()
            <label>Sistema<input name="sourceSystem" required /></label>
            <label>Código externo<input name="rawCode" required /></label>
            <label>Tipo confirmado<select name="kind"><option>INTERNACAO</option><option>AMBULATORIAL</option><option>URGENCIA</option></select></label>
            <button type="submit">Registrar contrato</button>
        </form>
    </section>
    <section class="ds-card">
        <h2>Acesso ao módulo</h2>
        <form method="post" action="@Url.Action("Conceder")">
            @Html.AntiForgeryToken()
            <label>Usuário
                <select name="userId" required>
                    @foreach (var user in ViewBag.Users)
                    {
                        <option value="@user.id">@user.name</option>
                    }
                </select>
            </label>
            <label>Setor<select name="sectorCode"><option>FATURAMENTO</option><option>FARMACIA</option><option>DDI</option><option>CME</option><option>SELECIONADO</option></select></label>
            <label>Permissão<select name="permissionCode">
                <option>CONSULTAR</option><option>CADASTRAR</option><option>CORRIGIR_VINCULO</option><option>REVISAR_EXTRACAO</option>
                <option>CONFERIR</option><option>IMPRIMIR</option><option>COMPARTILHAR</option><option>PARAMETRIZAR</option><option>ADMINISTRAR</option>
            </select></label>
            <button type="submit">Conceder</button>
        </form>
        <form method="post" action="@Url.Action("RevogarAcesso")">
            @Html.AntiForgeryToken()
            <label>Usuário
                <select name="userId" required>
                    @foreach (var user in ViewBag.Users)
                    {
                        <option value="@user.id">@user.name</option>
                    }
                </select>
            </label>
            <label>Setor<select name="sectorCode"><option>FATURAMENTO</option><option>FARMACIA</option><option>DDI</option><option>CME</option><option>SELECIONADO</option></select></label>
            <button type="submit">Revogar setor</button>
        </form>
        <p class="ds-note">A revogação retira o acesso do setor e as autorizações antigas dos tipos que a pessoa deixa de consultar.</p>
    </section>
    <section class="ds-card">
        <h2>Integração por link</h2>
        <form method="post" action="@Url.Action("CadastrarIntegracao")">
            @Html.AntiForgeryToken()
            <label>Identificador da integração<input name="clientId" required /></label>
            <label>Chave<input name="secret" type="password" required minlength="16" autocomplete="new-password" /></label>
            <label>Sistema<input name="sourceSystem" required /></label>
            <label>Unidade<input name="sourceUnit" /></label>
            <label>Origens permitidas<input name="origins" placeholder="https://sistema.exemplo" required /></label>
            <label>Tipos permitidos<input name="catalogCodes" placeholder="DS23, DS08" /></label>
            <label><input type="checkbox" name="allowEncounterList" value="true" /> Permitir consulta do atendimento sem tipo</label>
            <label><input type="checkbox" name="allowEncounterSwitch" value="true" /> Permitir navegação entre atendimentos do mesmo paciente</label>
            <label>Prazo máximo em minutos<input name="maxMinutes" type="number" min="1" max="60" value="15" /></label>
            <button type="submit">Gravar integração</button>
        </form>
        <form method="post" action="@Url.Action("DesativarIntegracao")" class="ds-grid">
            @Html.AntiForgeryToken()
            <label>Integração
                <select name="clientId" required>
                    @foreach (var integration in ViewBag.Integrations)
                    {
                        <option value="@integration.client_id">@integration.client_id — @(integration.active ? "ativa" : "inativa") — @(integration.allow_encounter_switch ? "pode trocar episódio" : "sem troca de episódio")</option>
                    }
                </select>
            </label>
            <button type="submit">Desativar integração</button>
        </form>
        <p class="ds-note">Desativar inutiliza códigos pendentes e revoga sessões. Gravar de novo reativa a integração, sem recuperar essas aberturas. <a href="@Url.Action("Parceiro")">Abrir a página de teste do parceiro</a>. A chave não volta a ser exibida.</p>
    </section>
    <section class="ds-card" id="assistente-integracao">
        <h2>Assistente de URL</h2>
        <p class="ds-help">O modelo abaixo ainda exige autorização. Ele não é uma concessão temporária e não contém a chave.</p>
        <div class="ds-grid">
            <label>Identificador da integração<input id="ds-url-integracao" value="parceiro-exemplo" /></label>
            <label>Tipo do identificador
                <select id="ds-url-tipo"><option value="ID">ID do paciente</option><option value="CPF">CPF</option></select>
            </label>
            <label>Paciente<input id="ds-url-paciente" value="000120" /></label>
            <label>Código do atendimento<input id="ds-url-atendimento" value="000088" /></label>
            <label>Nome do documento<input id="ds-url-documento" value="Prescrição Médica" /></label>
            <label>Modo
                <select id="ds-url-modo"><option value="consulta">consulta</option><option value="documento">documento</option></select>
            </label>
        </div>
        <p><button type="button" id="ds-url-montar">Montar modelo</button></p>
        <p class="ds-note">Modelo de URL parametrizada. Ainda exige login ou uma abertura de servidor. CPF nesta URL pode permanecer no histórico do navegador e em logs de infraestrutura. O redirecionamento não apaga registros já feitos por proxy ou servidor. Prefira a chamada de servidor quando o parceiro puder usá-la.</p>
        <textarea id="ds-url-modelo" readonly rows="3"></textarea>
        <h3>URL temporária concedida</h3>
        <p class="ds-note">A resposta do backend traz urlAbertura e urlIncorporacao com prazo em validade. Esses endereços servem uma vez. Não copie um código vencido como se fosse um link permanente.</p>
        <h3>Código de iframe</h3>
        <textarea id="ds-url-iframe" readonly rows="3"></textarea>
        <h3>Chamada de servidor</h3>
        <pre>POST /api/integracoes/demais-setores/aberturas
X-InovaGed-Integracao: parceiro-exemplo
X-InovaGed-Chave: (chave cadastrada, fora da URL)
X-InovaGed-Idempotencia: exemplo-0001

{"paciente":{"tipoIdentificador":"ID","identificador":"000120"},"codigoAtendimento":"000088","nomeDocumento":"Prescrição Médica","modo":"consulta","origemIncorporacao":"https://parceiro.exemplo"}</pre>
        <p class="ds-note">Diagnóstico: a chave não volta a ser exibida. integracao_nao_autorizada não informa se o prontuário existe. Uma repetição com a mesma idempotência não reenvia os códigos.</p>
    </section>
    <script>
        document.getElementById("ds-url-montar").addEventListener("click", function () {
            var params = new URLSearchParams();
            params.set("integracao", document.getElementById("ds-url-integracao").value.trim());
            params.set("tipoIdentificador", document.getElementById("ds-url-tipo").value);
            params.set("paciente", document.getElementById("ds-url-paciente").value.trim());
            params.set("codigoAtendimento", document.getElementById("ds-url-atendimento").value.trim());
            params.set("nomeDocumento", document.getElementById("ds-url-documento").value.trim());
            params.set("modo", document.getElementById("ds-url-modo").value);
            var path = "/DemaisSetores/Integrar?" + params.toString();
            document.getElementById("ds-url-modelo").value = location.origin + path;
            document.getElementById("ds-url-iframe").value = "<iframe src=\"" + location.origin + "/DemaisSetores/Abrir/<codigo-opaco>\" title=\"Documento do atendimento\"></iframe>";
        });
    </script>
    <section class="ds-card">
        <h2>Anexo II</h2>
        <form method="post" action="@Url.Action("HabilitarAnexoIi")">
            @Html.AntiForgeryToken()
            <label><input type="checkbox" name="enabled" value="true" /> Habilitar a composição física como perfil separado</label>
            <button type="submit">Salvar perfil</button>
        </form>
    </section>
    <section class="ds-card">
        <h2>Origem de incorporação</h2>
        <form method="post" action="@Url.Action("Origem")">
            @Html.AntiForgeryToken()
            <label>Origem<input name="origin" placeholder="https://sistema.exemplo" /></label>
            <button type="submit">Cadastrar origem</button>
        </form>
    </section>
    <section class="ds-card">
        <h2>Mapeamento MV</h2>
        <ul>
            @foreach (var mapping in ViewBag.Mappings)
            {
                <li>@mapping.catalog_code — @mapping.mapping_status. @mapping.note</li>
            }
        </ul>
    </section>
</main>
