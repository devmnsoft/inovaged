@model IReadOnlyList<InovaGed.Application.PhysicalArchive.Reconciliation.ArchiveReconciliationRunItem>
@{ViewData["Title"]="Diagnósticos do acervo";}<link rel="stylesheet" href="~/css/archive-reconciliation.css"/><header class="ar-page"><div><a asp-action="Index">← Saneamento</a><h1>Execuções de diagnóstico</h1></div></header><section class="ar-panel"><div class="table-responsive"><table class="table"><thead><tr><th>Número</th><th>Origem</th><th>Início</th><th>Verificados</th><th>Issues</th><th>Críticas</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a asp-action="Run" asp-route-id="@x.Id">@x.RunNumber</a></td><td>@x.Source</td><td>@x.StartedAt.ToLocalTime()</td><td>@x.TotalChecked</td><td>@x.TotalIssues</td><td>@x.TotalCritical</td><td><span class="ar-status">@x.Status</span></td></tr>}</tbody></table></div></section>
