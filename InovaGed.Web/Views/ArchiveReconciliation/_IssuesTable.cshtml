@model IReadOnlyList<InovaGed.Application.PhysicalArchive.Reconciliation.ArchiveReconciliationIssueItem>
<section class="ar-panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Gravidade</th><th>Inconsistência</th><th>Objeto</th><th>Sugestão</th><th>Status</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="6" class="text-center text-muted py-5">Nenhuma inconsistência encontrada.</td></tr>}@foreach(var x in Model){<tr><td><span class="ar-severity ar-@x.Severity.ToLowerInvariant()">@x.Severity</span></td><td><strong>@x.Title</strong><small>@x.IssueType</small></td><td>@x.SubjectType<br/><small>@x.ControlNumber</small></td><td>@x.Suggestion</td><td><span class="ar-status">@x.Status</span></td><td><a class="btn btn-sm btn-outline-primary" asp-action="Issue" asp-route-id="@x.Id">Revisar</a></td></tr>}</tbody></table></div></section>
