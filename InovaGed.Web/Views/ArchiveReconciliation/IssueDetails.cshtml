@model InovaGed.Application.PhysicalArchive.Reconciliation.ArchiveReconciliationIssueDetails
@{ViewData["Title"]=Model.Issue.Title;}<link rel="stylesheet" href="~/css/archive-reconciliation.css"/><header class="ar-page"><div><a asp-action="Issues">← Fila de saneamento</a><h1>@Model.Issue.Title</h1><p><span class="ar-severity ar-@Model.Issue.Severity.ToLowerInvariant()">@Model.Issue.Severity</span> <span class="ar-status">@Model.Issue.Status</span> · @Model.Issue.ControlNumber</p></div></header><div class="ar-detail"><main><section class="ar-panel"><h2>Diagnóstico</h2><p>@Model.Issue.Description</p><div class="ar-compare"><div><small>Esperado</small><strong>@(Model.ExpectedValue??"Não informado")</strong></div><span>→</span><div><small>Encontrado</small><strong>@(Model.FoundValue??"Não informado")</strong></div></div></section><section class="ar-panel ar-suggestion"><small>SUGESTÃO ASSISTIDA</small><h2>@Model.Issue.Suggestion</h2><p>Esta correção altera dados do acervo. Revise antes de aplicar.</p></section></main><aside class="ar-panel"><h2>Ações</h2>@if(Model.Issue.Status is "OPEN" or "IN_REVIEW"){<form asp-action="ApplyFix" asp-route-id="@Model.Issue.Id" method="post">@Html.AntiForgeryToken()<textarea class="form-control" name="notes" placeholder="Observações da correção"></textarea><button class="btn btn-success w-100 mt-2" data-confirm-fix>Aplicar correção segura</button></form><hr/><form asp-action="Ignore" asp-route-id="@Model.Issue.Id" method="post">@Html.AntiForgeryToken()<textarea class="form-control" name="reason" required placeholder="Justificativa obrigatória"></textarea><button class="btn btn-outline-secondary w-100 mt-2">Ignorar inconsistência</button></form><form asp-action="Reject" asp-route-id="@Model.Issue.Id" method="post" class="mt-2">@Html.AntiForgeryToken()<input class="form-control" name="reason" required placeholder="Motivo da rejeição"/><button class="btn btn-outline-danger w-100 mt-2">Rejeitar sugestão</button></form>}else{<p>Resolvida em @Model.ResolvedAt?.ToLocalTime()</p><p>@Model.ResolutionNotes</p>}</aside></div><script src="~/js/archive-reconciliation.js"></script>
