@model InovaGed.Application.PhysicalArchive.Reconciliation.ArchiveReconciliationDashboard
@{ViewData["Title"]="Saneamento Inteligente do Acervo";}
<link rel="stylesheet" href="~/css/archive-reconciliation.css" />
<section class="ar-hero"><div><span>SANEAMENTO · FÍSICO × DIGITAL</span><h1>Saneamento Inteligente do Acervo</h1><p>Identifique divergências entre cadastro digital, etiquetas, leituras, inventário e localização física.</p></div><div class="ar-quality"><strong>@Model.Quality%</strong><small>Índice de qualidade</small></div></section>
<div class="ar-actions"><form asp-action="RunFullDiagnosis" method="post">@Html.AntiForgeryToken()<button class="btn btn-light btn-lg">Executar diagnóstico geral</button></form><a class="btn btn-outline-light btn-lg" asp-action="Runs">Histórico de diagnósticos</a><a class="btn btn-outline-light btn-lg" asp-action="Issues">Fila de saneamento</a><a class="btn btn-warning btn-lg" asp-action="Export">Exportar relatório</a></div>
<p class="ar-help">O saneamento inteligente cruza dados digitais, etiquetas, leituras e inventários para encontrar divergências operacionais.</p>
<div class="ar-kpis">@foreach(var k in new[]{("Caixas verificadas",Model.Boxes),("Documentos verificados",Model.Documents),("Etiquetas verificadas",Model.Labels),("Inconsistências abertas",Model.OpenIssues),("Itens críticos",Model.CriticalIssues),("Divergências de localização",Model.LocationMismatches),("Objetos sem etiqueta",Model.WithoutLabel),("Etiquetas sem objeto",Model.OrphanLabels),("Correções aplicadas",Model.FixedIssues),("Itens ignorados",Model.IgnoredIssues)}){<article><small>@k.Item1</small><strong>@k.Item2</strong></article>}</div>
<section class="ar-panel"><div class="ar-panel-title"><div><h2>Reconciliar por inventário</h2><p>Compare o esperado com os itens e localizações encontrados em uma sessão.</p></div></div><form asp-action="RunInventoryDiagnosis" method="post" class="ar-inline">@Html.AntiForgeryToken()<input class="form-control" type="text" name="inventorySessionId" required placeholder="ID da sessão de inventário"/><button class="btn btn-primary">Gerar reconciliação</button></form></section>
<section class="ar-panel"><div class="ar-panel-title"><h2>Diagnósticos recentes</h2><a asp-action="Runs">Ver todos</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Execução</th><th>Origem</th><th>Verificados</th><th>Issues</th><th>Críticos</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.RecentRuns.Take(8)){<tr><td><a asp-action="Run" asp-route-id="@x.Id">@x.RunNumber</a></td><td>@x.Source</td><td>@x.TotalChecked</td><td>@x.TotalIssues</td><td>@x.TotalCritical</td><td><span class="ar-status">@x.Status</span></td></tr>}</tbody></table></div></section>
