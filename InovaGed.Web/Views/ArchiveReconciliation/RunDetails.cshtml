@model InovaGed.Application.PhysicalArchive.Reconciliation.ArchiveReconciliationRunDetails
@{ViewData["Title"]=Model.Run.RunNumber;}<link rel="stylesheet" href="~/css/archive-reconciliation.css"/><header class="ar-page"><div><a asp-action="Runs">← Diagnósticos</a><h1>@Model.Run.RunNumber</h1><p>@Model.Run.Source · @Model.Run.StartedAt.ToLocalTime()</p></div><a class="btn btn-outline-primary" asp-action="Export" asp-route-report="all">Exportar CSV</a></header><div class="ar-kpis"><article><small>Verificados</small><strong>@Model.Run.TotalChecked</strong></article><article><small>Inconsistências</small><strong>@Model.Run.TotalIssues</strong></article><article><small>Críticas</small><strong>@Model.Run.TotalCritical</strong></article><article><small>Altas</small><strong>@Model.Run.TotalHigh</strong></article></div><partial name="_IssuesTable" model="Model.Issues" />
