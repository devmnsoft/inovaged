@model IReadOnlyList<InovaGed.Web.Models.Labels.LabelStudioTemplate>
@{ ViewData["Title"] = "Estúdio de Modelos de Etiquetas"; }
@section Styles { <link rel="stylesheet" href="~/css/labels-studio.css" asp-append-version="true" /> }
<main class="labels-studio-page">
 <header class="labels-studio-hero"><div><span class="labels-studio-kicker"><app-icon name="layout-template" size="16" decorative="true" /> Catálogo homologado</span><h1>Estúdio de Modelos de Etiquetas</h1><p>Visualize, compare e valide modelos de etiquetas para caixas, documentos, pastas, LocDesk e padrões personalizados.</p></div><a class="ig-button ig-button--primary" asp-action="PrintWizard"><app-icon name="printer" size="18" decorative="true" /> Nova impressão</a></header>
 @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
 <section class="label-template-gallery" aria-label="Modelos disponíveis">
 @foreach (var item in Model)
 {
  var isHol = item.Code == "LOCDESK_PASTA_HOL_V1"; var isLocDesk = item.Code.StartsWith("LOCDESK", StringComparison.Ordinal);
  <article class="label-template-card">
   <div class="label-template-thumb @item.ThumbClass" aria-hidden="true"><div class="thumb-head">@if(isLocDesk){<img src="~/images/logos/locdesk-logo.svg" alt="" />}else{<span>InovaGED</span>}<small>@(isLocDesk ? "ARQUIVO LOCDESCK ANANINDEUA" : "ETIQUETA DE IDENTIFICAÇÃO")</small></div>@if(isHol){<b>Contrato: Hosp. Ophir Loyola</b>}<div class="thumb-control">Nº Controle: <strong>@(isHol ? "199" : "0001")</strong> · Vol.: <strong>1/3</strong></div><i></i><i></i><i></i><footer>LOCALIZAÇÃO: LOC.AN.101.E1.P1</footer></div>
   <div class="label-template-meta"><div class="label-template-badges"><span>@item.SubjectType</span><span>@(isLocDesk ? "LocDesk" : "Sistema")</span>@if(isHol){<span class="is-hol">HOL</span>}@if(item.IsDefault){<span class="is-default">Padrão</span>}</div><h2>@item.Name</h2><code>@item.Code</code><p>@item.Description</p><dl><div><dt>Tipo</dt><dd>@item.SubjectType</dd></div><div><dt>Modo</dt><dd>@item.Mode</dd></div></dl></div>
   <footer class="label-template-actions"><a asp-action="TemplateDetails" asp-route-code="@item.Code">Ver detalhes</a><a asp-action="TemplatePreview" asp-route-code="@item.Code"><app-icon name="eye" size="15" decorative="true" /> Pré-visualizar</a><a class="primary" asp-action="PrintWizard" asp-route-templateCode="@item.Code">Usar no assistente</a></footer>
  </article>
 }
 </section>
</main>
