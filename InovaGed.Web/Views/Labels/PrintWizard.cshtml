@model InovaGed.Web.Models.Labels.LabelPrintWizardInputModel
@{ViewData["Title"]="Nova impressão de etiqueta";ViewData["LabelHelpContext"]="PRINT";var stepper=new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData);stepper["Steps"]=new List<string>{"Origem","Modelo","Identidade","Impressão","Conferência"};stepper["Current"]=1;}
@section Styles {<link rel="stylesheet" href="~/css/pages/labels-print-wizard.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/labels-studio.css" asp-append-version="true"/>}
<main class="label-wizard-page"><header class="label-wizard-hero atlas-page-hero"><div><small>Impressão guiada</small><h1>Nova etiqueta</h1><p>Avance na ordem: origem, modelo, identidade visual, impressão e conferência.</p></div><div class="label-wizard-hero__actions"><partial name="Shared/_LabelHelpDrawer"/><a asp-action="Index" class="atlas-btn atlas-btn-secondary">Voltar à central</a></div></header><partial name="Atlas/_AtlasStepper" view-data="stepper"/><form method="post" id="label-print-form" class="label-wizard-layout" data-label-form>@Html.AntiForgeryToken()<input type="hidden" name="ClientActionId" value="@Guid.NewGuid()"/><main class="label-wizard-main"><partial name="Atlas/_AtlasValidationSummary"/><partial name="_PrintWizardOrigin"/><partial name="_PrintWizardTemplate"/><partial name="_PrintWizardBranding"/><partial name="_PrintWizardPrintSettings"/><partial name="_PrintWizardReview"/></main><partial name="_PrintWizardPreview"/></form></main>
@section Scripts {<script src="~/js/labels-help.js" asp-append-version="true"></script><script src="~/js/labels-printwizard.js" asp-append-version="true"></script><script src="~/js/labels-form-submit.js" asp-append-version="true"></script>}
