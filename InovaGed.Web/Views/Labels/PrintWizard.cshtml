@model InovaGed.Web.Models.Labels.LabelPrintWizardInputModel
@using InovaGed.Application.PhysicalArchive

@{
    ViewData["Title"] = "Nova impressão de etiqueta";
    IReadOnlyList<LabelTemplateOption> templates =
        ViewBag.Templates as IReadOnlyList<LabelTemplateOption>
        ?? new List<LabelTemplateOption>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/labels-print-wizard.css" asp-append-version="true" />
}

<div class="label-wizard-page">
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a asp-action="Index">Etiquetas</a></li><li class="breadcrumb-item active" aria-current="page">Nova impressão</li></ol></nav>
    <header class="label-wizard-hero">
        <div><span class="label-wizard-eyebrow"><i class="bi bi-printer"></i> Central de Etiquetas</span><h1>Nova impressão de etiqueta</h1><p>Escolha a origem, o modo de impressão e o modelo ideal para caixa, documento, pasta ou lote.</p></div>
        <div class="label-wizard-hero__actions"><a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Voltar à central</a><a asp-action="History" class="btn btn-outline-primary"><i class="bi bi-clock-history"></i> Histórico</a></div>
    </header>
    @if (ViewBag.CatalogMigrationWarning is string migrationWarning) { <div class="alert alert-warning" role="alert"><strong>Atenção:</strong> @migrationWarning</div> }
    <div class="label-wizard-steps" aria-label="Etapas da impressão"><div class="label-wizard-step is-active"><strong>1</strong><span>Origem</span></div><div class="label-wizard-step is-active"><strong>2</strong><span>Modo</span></div><div class="label-wizard-step is-active"><strong>3</strong><span>Modelo</span></div><div class="label-wizard-step is-active"><strong>4</strong><span>Prévia</span></div></div>

    <form method="post" class="label-wizard-layout">
        @Html.AntiForgeryToken()
        <main class="label-wizard-main">
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            <section class="label-wizard-card"><header class="label-wizard-card__header"><h2><span>1</span> Origem</h2><p>Informe qual item receberá a etiqueta.</p></header><div class="label-wizard-card__body label-origin-grid"><div><label asp-for="SubjectType" class="form-label">Tipo de origem</label><select asp-for="SubjectType" class="form-select" id="subject"><option value="BOX">Caixa</option><option value="DOCUMENT">Documento/Pasta</option><option value="BATCH">Lote</option><option value="MANUAL_LABEL">Manual</option></select></div><div><label asp-for="SubjectId" class="form-label">Identificador do objeto</label><input asp-for="SubjectId" class="form-control" placeholder="Selecione nas listagens ou informe o identificador" /></div></div></section>
            <section class="label-wizard-card"><header class="label-wizard-card__header"><h2><span>2</span> Modo de impressão</h2><p>Use o padrão homologado ou um modelo adaptado à operação.</p></header><div class="label-wizard-card__body label-mode-grid"><label class="label-mode-card"><input asp-for="PrintMode" type="radio" value="FACTORY" /><span class="label-mode-card__icon"><i class="bi bi-shield-check"></i></span><strong>Padrão de fábrica</strong><small>Modelo seguro e padronizado pelo InovaGED.</small></label><label class="label-mode-card"><input asp-for="PrintMode" type="radio" value="CUSTOM" /><span class="label-mode-card__icon"><i class="bi bi-sliders"></i></span><strong>Personalizado</strong><small>Modelos do cliente, como LocDesk, com campos adaptados à operação.</small></label></div></section>
            <section class="label-wizard-card"><header class="label-wizard-card__header"><h2><span>3</span> Modelo</h2><p>Compare os modelos disponíveis para a origem e o modo escolhidos.</p></header><div class="label-wizard-card__body"><label asp-for="TemplateCode" class="form-label">Modelo selecionado</label><select asp-for="TemplateCode" class="form-select label-template-select">@foreach (var template in templates) { <option value="@template.Code">@template.Name — @template.Description</option> }</select><div class="label-template-grid mt-3">@foreach (var template in templates) { var isLocDesk = template.Code.StartsWith("LOCDESK", StringComparison.OrdinalIgnoreCase); var typeLabel = template.SubjectType == "BOX" ? "Caixa" : template.SubjectType == "BATCH" ? "Lote" : "Documento/Pasta"; <label class="label-template-card"><input asp-for="TemplateCode" type="radio" value="@template.Code" /><span class="label-template-card__badges"><span class="badge text-bg-light">@typeLabel</span><span class="badge text-bg-primary">@(template.Mode == "FACTORY" ? "Fábrica" : "Personalizado")</span>@if (isLocDesk) { <span class="badge text-bg-dark">LocDesk</span> }</span><strong>@template.Name</strong><small>@template.Description</small></label> }</div></div></section>
            <section class="label-wizard-card"><header class="label-wizard-card__header"><h2><span>4</span> Configuração</h2><p>Defina quantidade e, quando necessário, justifique a reimpressão.</p></header><div class="label-wizard-card__body label-config-grid"><div><label asp-for="Copies" class="form-label">Cópias</label><input asp-for="Copies" class="form-control" min="1" /></div><div><label asp-for="ReprintReason" class="form-label">Motivo da reimpressão</label><input asp-for="ReprintReason" class="form-control" placeholder="Obrigatório quando esta etiqueta já foi impressa" /></div></div><footer class="label-wizard-actions"><a asp-action="Index" class="btn btn-lg btn-outline-secondary">Cancelar</a><button asp-action="Preview" class="btn btn-lg btn-outline-primary"><i class="bi bi-eye"></i> Pré-visualizar</button><button asp-action="Print" class="btn btn-lg btn-primary"><i class="bi bi-printer"></i> Registrar e imprimir</button><button asp-action="PrintBatch" class="btn btn-lg btn-outline-dark">Imprimir em lote</button></footer></section>
        </main>
        <aside class="label-wizard-preview"><section class="label-wizard-card label-wizard-preview__sticky"><header class="label-wizard-card__header"><h2>Prévia da etiqueta</h2><p>Resumo visual antes de gerar a impressão.</p></header><div class="label-wizard-card__body"><div class="label-preview-sheet"><div class="label-preview-mini"><div class="label-preview-brand"><i class="bi bi-box-seam"></i><strong>InovaGED</strong></div><span class="label-preview-kicker">Etiqueta de identificação</span><strong id="preview-template">@(templates.FirstOrDefault(t => t.Code == Model.TemplateCode)?.Name ?? "Selecione um modelo")</strong><div class="label-preview-lines"><span></span><span></span><span></span></div><div class="label-preview-footer"><i class="bi bi-qr-code"></i><small>Prévia ilustrativa</small></div></div></div><dl class="label-wizard-summary"><div><dt>Origem</dt><dd id="summary-subject">@Model.SubjectType</dd></div><div><dt>Modo</dt><dd id="summary-mode">@Model.PrintMode</dd></div><div><dt>Cópias</dt><dd id="summary-copies">@Model.Copies</dd></div></dl></div></section></aside>
    </form>
</div>

@section Scripts {
<script>
(() => {
    const subject = document.querySelector('#subject');
    const modes = document.querySelectorAll('input[name="PrintMode"]');
    const templateSelect = document.querySelector('.label-template-select');
    const templateRadios = document.querySelectorAll('.label-template-card input');
    const reloadCatalog = () => { const checked = document.querySelector('input[name="PrintMode"]:checked'); if (!checked) return; const url = new URL(location.href); url.searchParams.set('subjectType', subject.value); url.searchParams.set('mode', checked.value); location.href = url; };
    subject?.addEventListener('change', reloadCatalog); modes.forEach(input => input.addEventListener('change', reloadCatalog));
    templateRadios.forEach(input => input.addEventListener('change', () => { templateSelect.value = input.value; document.querySelector('#preview-template').textContent = input.closest('label').querySelector('strong').textContent; }));
    templateSelect?.addEventListener('change', () => { const radio = [...templateRadios].find(x => x.value === templateSelect.value); if (radio) radio.checked = true; document.querySelector('#preview-template').textContent = templateSelect.options[templateSelect.selectedIndex]?.text.split(' — ')[0] ?? ''; });
    document.querySelector('[name="Copies"]')?.addEventListener('input', event => document.querySelector('#summary-copies').textContent = event.target.value);
})();
</script>
}
