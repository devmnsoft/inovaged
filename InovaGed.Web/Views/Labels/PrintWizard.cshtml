@model InovaGed.Web.Models.Labels.LabelPrintWizardInputModel
@using InovaGed.Application.PhysicalArchive

@{
    ViewData["Title"] = "Nova impressão de etiqueta";
    IReadOnlyList<LabelTemplateOption> templates =
        ViewBag.Templates as IReadOnlyList<LabelTemplateOption>
        ?? new List<LabelTemplateOption>();
    IReadOnlyList<InovaGed.Web.Models.SelectOptionViewModel> subjectOptions =
        ViewBag.SubjectOptions as IReadOnlyList<InovaGed.Web.Models.SelectOptionViewModel>
        ?? Array.Empty<InovaGed.Web.Models.SelectOptionViewModel>();
    IReadOnlyList<InovaGed.Web.Models.Labels.LabelPrintProfileInput> printProfiles = ViewBag.PrintProfiles as IReadOnlyList<InovaGed.Web.Models.Labels.LabelPrintProfileInput> ?? Array.Empty<InovaGed.Web.Models.Labels.LabelPrintProfileInput>();
    var selectedProfile = ViewBag.SelectedPrintProfile as InovaGed.Web.Models.Labels.LabelPrintProfileInput;

    var stepperViewData = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData);
    stepperViewData["Steps"] = new List<string> { "Origem", "Modo", "Modelo", "Prévia", "Impressão" };
    stepperViewData["Current"] = 2;

    var beforeContinueAlert = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData);
    beforeContinueAlert["AlertTitle"] = "Antes de continuar";
    beforeContinueAlert["Message"] = "Selecione o tipo e o modelo da etiqueta antes de gerar a impressão. A reimpressão exige justificativa para manter a rastreabilidade.";
    beforeContinueAlert["Tone"] = "info";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/labels-print-wizard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true" />
}

<div class="label-wizard-page">
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a asp-action="Index">Etiquetas</a></li><li class="breadcrumb-item active" aria-current="page">Nova impressão</li></ol></nav>
    <header class="label-wizard-hero atlas-page-hero">
        <div><span class="label-wizard-eyebrow"><i class="bi bi-printer"></i> Central de Etiquetas</span><h1>Nova impressão de etiqueta</h1><p>Escolha a origem, o modo de impressão e o modelo ideal para caixa, documento, pasta ou lote.</p></div>
        <div class="label-wizard-hero__actions"><a asp-action="Templates" class="atlas-btn atlas-btn-secondary"><i class="bi bi-grid"></i> Ver modelos disponíveis</a><a asp-action="Index" class="atlas-btn atlas-btn-secondary"><i class="bi bi-arrow-left"></i> Voltar à central</a><a asp-action="History" class="atlas-btn atlas-btn-secondary"><i class="bi bi-clock-history"></i> Histórico</a></div>
    </header>
    @if (ViewBag.CatalogMigrationWarning is string migrationWarning) { <div class="atlas-alert atlas-alert-warning" role="alert"><strong>Atenção:</strong> @migrationWarning</div> }
    <partial name="Atlas/_AtlasStepper" view-data="stepperViewData" />
    <partial name="Atlas/_AtlasAlert" view-data="beforeContinueAlert" />

    <form method="post" class="label-wizard-layout">
        @Html.AntiForgeryToken()
        <main class="label-wizard-main">
            <partial name="Atlas/_AtlasValidationSummary" />
            <section class="label-wizard-card"><header class="label-wizard-card__header"><h2><span>1</span> Origem</h2><p>Informe qual item receberá a etiqueta.</p></header><div class="label-wizard-card__body label-origin-grid"><div><label asp-for="SubjectType" class="form-label">Tipo de origem</label><select asp-for="SubjectType" class="form-select" id="subject"><option value="BOX">Caixa</option><option value="DOCUMENT">Documento/Pasta</option><option value="BATCH">Lote</option><option value="MANUAL_LABEL">Manual</option></select></div><div><label asp-for="SubjectId" class="form-label">Item de origem</label><select asp-for="SubjectId" class="form-select" required="@(Model.SubjectType != "MANUAL_LABEL")" aria-describedby="subject-help"><option value="">Selecione pelo nome ou código</option>@foreach(var option in subjectOptions){<option value="@option.Value">@option.Label</option>}</select><small id="subject-help" class="form-text">A lista contém somente registros disponíveis para o tenant atual.</small><span asp-validation-for="SubjectId" class="text-danger"></span>@if(subjectOptions.Count == 0 && Model.SubjectType != "MANUAL_LABEL"){<div class="atlas-form-empty" role="status">Nenhum item disponível para este tipo de origem.</div>}</div></div></section>
            <section class="label-wizard-card"><header class="label-wizard-card__header"><h2><span>2</span> Modo de impressão</h2><p>Use o padrão homologado ou um modelo adaptado à operação.</p></header><div class="label-wizard-card__body label-mode-grid"><label class="label-mode-card"><input asp-for="PrintMode" type="radio" value="FACTORY" /><span class="label-mode-card__icon"><i class="bi bi-shield-check"></i></span><strong>Padrão de fábrica</strong><small>Modelo seguro e padronizado pelo InovaGED.</small></label><label class="label-mode-card"><input asp-for="PrintMode" type="radio" value="CUSTOM" /><span class="label-mode-card__icon"><i class="bi bi-sliders"></i></span><strong>Personalizado</strong><small>Modelos do cliente, como LocDesk, com campos adaptados à operação.</small></label></div></section>
            <section class="label-wizard-card"><header class="label-wizard-card__header"><h2><span>3</span> Modelo</h2><p>Compare os modelos disponíveis para a origem e o modo escolhidos.</p></header><div class="label-wizard-card__body"><label asp-for="TemplateCode" class="form-label">Modelo selecionado</label><select asp-for="TemplateCode" class="form-select label-template-select" required><option value="">Selecione um modelo de etiqueta</option>@foreach (var template in templates) { <option value="@template.Code">@template.Name — @template.Description</option> }</select><span asp-validation-for="TemplateCode" class="text-danger"></span>@if (templates.Count == 0) { <div class="atlas-alert atlas-alert-warning mt-3" role="alert"><strong>Nenhum modelo de etiqueta disponível.</strong><br />Aplique as migrations obrigatórias em Prontidão do Banco ou use o catálogo mínimo do sistema.<div class="mt-2"><a class="atlas-btn atlas-btn-secondary" href="/DatabaseReadiness">Abrir Prontidão do Banco</a></div></div> }<div class="label-template-grid mt-3">@foreach (var template in templates) { var isLocDesk = template.Code.StartsWith("LOCDESK", StringComparison.OrdinalIgnoreCase); var typeLabel = template.SubjectType == "BOX" ? "Caixa" : template.SubjectType == "BATCH" ? "Lote" : "Documento/Pasta"; <button class="label-template-card" type="button" data-template-code="@template.Code"><span class="label-template-card__badges"><span class="atlas-badge atlas-badge-muted">@typeLabel</span><span class="atlas-badge atlas-badge-info">@(template.Mode == "FACTORY" ? "Fábrica" : "Personalizado")</span>@if (isLocDesk) { <span class="atlas-badge atlas-badge-implementation">LocDesk</span> }</span><strong>@template.Name</strong><small>@template.Description</small></button> }</div></div></section>
            <section class="label-wizard-card"><header class="label-wizard-card__header"><h2><span>4</span> Configuração e calibração</h2><p>Defina quantidade, perfil da impressora e, quando necessário, justifique a reimpressão.</p></header><div class="label-wizard-card__body label-config-grid"><div><label asp-for="Copies" class="form-label">Cópias</label><input asp-for="Copies" class="form-control" type="number" min="1" max="500" required /><span asp-validation-for="Copies" class="text-danger"></span></div><div><label asp-for="PrintProfileId" class="form-label">Perfil de calibração</label><select asp-for="PrintProfileId" class="form-select"><option value="">Perfil padrão automático</option>@foreach(var profile in printProfiles){<option value="@profile.Id">@profile.ProfileName @(profile.IsDefault?"(padrão)":"")</option>}</select>@if(!printProfiles.Any()){<small class="form-text">Nenhum perfil de calibração cadastrado. A impressão usará o padrão do navegador.</small>}</div><div><label asp-for="ReprintReason" class="form-label">Motivo da reimpressão</label><textarea asp-for="ReprintReason" class="form-control" rows="2" placeholder="Informe o motivo quando esta etiqueta já tiver sido impressa" aria-describedby="reprint-help"></textarea><small id="reprint-help" class="form-text">A justificativa preserva a rastreabilidade de reimpressões.</small><span asp-validation-for="ReprintReason" class="text-danger"></span></div></div>@if(selectedProfile is not null){<dl class="label-wizard-summary"><div><dt>Perfil padrão aplicado</dt><dd>@selectedProfile.ProfileName</dd></div><div><dt>Margem superior / esquerda</dt><dd>@selectedProfile.MarginTopMm mm / @selectedProfile.MarginLeftMm mm</dd></div><div><dt>Deslocamento X/Y</dt><dd>@selectedProfile.OffsetXMm mm / @selectedProfile.OffsetYMm mm</dd></div><div><dt>Escala</dt><dd>@selectedProfile.ScalePercent%</dd></div></dl>}<footer class="label-wizard-actions"><a asp-action="Index" class="atlas-btn atlas-btn-secondary">Voltar</a><button type="submit" formaction="@Url.Action("Preview", "Labels")" formmethod="post" class="atlas-btn atlas-btn-secondary" @(templates.Count == 0 ? "disabled" : null)>Pré-visualizar</button><button type="submit" formaction="@Url.Action("Print", "Labels")" formmethod="post" class="atlas-btn atlas-btn-primary" @(templates.Count == 0 ? "disabled" : null)>Gerar impressão</button></footer></section>
        </main>
        <aside class="label-wizard-preview label-preview-panel"><section class="label-wizard-card label-wizard-preview__sticky atlas-preview-shell label-preview-shell"><header class="label-wizard-card__header"><h2>Pré-visualização da etiqueta</h2><p>Resumo visual antes de gerar a impressão.</p></header><div class="label-wizard-card__body"><div class="label-preview-sheet label-preview-paper"><div class="label-preview-mini"><div class="label-preview-brand"><i class="bi bi-box-seam"></i><strong>InovaGED</strong></div><span class="label-preview-kicker">Etiqueta de identificação</span><strong id="preview-template">@(templates.FirstOrDefault(t => t.Code == Model.TemplateCode)?.Name ?? "Selecione um modelo")</strong><div class="label-preview-lines"><span></span><span></span><span></span></div><div class="label-preview-footer"><i class="bi bi-qr-code"></i><small>Prévia ilustrativa</small></div></div></div><dl class="label-wizard-summary"><div><dt>Origem</dt><dd id="summary-subject">@Model.SubjectType</dd></div><div><dt>Modo</dt><dd id="summary-mode">@Model.PrintMode</dd></div><div><dt>Cópias</dt><dd id="summary-copies">@Model.Copies</dd></div></dl></div></section></aside>
    </form>
</div>

@section Scripts {
<script>
(() => {
    const subject = document.querySelector('#subject');
    const modes = document.querySelectorAll('input[name="PrintMode"]');
    const templateSelect = document.querySelector('.label-template-select');
    const templateCards = document.querySelectorAll('.label-template-card[data-template-code]');
    const reloadCatalog = () => { const checked = document.querySelector('input[name="PrintMode"]:checked'); if (!checked) return; const url = new URL(location.href); url.searchParams.set('subjectType', subject.value); url.searchParams.set('mode', checked.value); location.href = url; };
    subject?.addEventListener('change', reloadCatalog); modes.forEach(input => input.addEventListener('change', reloadCatalog));
    templateCards.forEach(card => card.addEventListener('click', () => { templateSelect.value = card.dataset.templateCode; document.querySelector('#preview-template').textContent = card.querySelector('strong').textContent; }));
    templateSelect?.addEventListener('change', () => { document.querySelector('#preview-template').textContent = templateSelect.options[templateSelect.selectedIndex]?.text.split(' — ')[0] ?? ''; });
    document.querySelector('[name="Copies"]')?.addEventListener('input', event => document.querySelector('#summary-copies').textContent = event.target.value);
})();
</script>
}
