@model InovaGed.Web.Models.Labels.LabelPrintWizardInputModel
@using InovaGed.Application.PhysicalArchive

@{
    ViewData["Title"] = "Nova impressão de etiqueta";
    IReadOnlyList<LabelTemplateOption> templates =
        ViewBag.Templates as IReadOnlyList<LabelTemplateOption>
        ?? new List<LabelTemplateOption>();
    IReadOnlyList<InovaGed.Web.Models.SelectOptionViewModel> subjectOptions =
        ViewBag.SubjectOptions as IReadOnlyList<InovaGed.Web.Models.SelectOptionViewModel>
        ?? Array.Empty<InovaGed.Web.Models.SelectOptionViewModel>();
    IReadOnlyList<InovaGed.Web.Models.Labels.LabelPrintProfileInput> printProfiles = ViewBag.PrintProfiles as IReadOnlyList<InovaGed.Web.Models.Labels.LabelPrintProfileInput> ?? Array.Empty<InovaGed.Web.Models.Labels.LabelPrintProfileInput>();
    var selectedProfile = ViewBag.SelectedPrintProfile as InovaGed.Web.Models.Labels.LabelPrintProfileInput;
    var brandAssets = ViewBag.BrandAssets as IReadOnlyList<InovaGed.Web.Models.Branding.BrandAssetVm> ?? Array.Empty<InovaGed.Web.Models.Branding.BrandAssetVm>();
    var brandingProfiles = ViewBag.PrintBrandingProfiles as IReadOnlyList<InovaGed.Web.Models.Branding.PrintBrandingProfileVm> ?? Array.Empty<InovaGed.Web.Models.Branding.PrintBrandingProfileVm>();

    var stepperViewData = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData);
    stepperViewData["Steps"] = new List<string> { "Origem", "Modo", "Modelo", "Prévia", "Impressão" };
    stepperViewData["Current"] = 2;

    var beforeContinueAlert = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData);
    beforeContinueAlert["AlertTitle"] = "Antes de continuar";
    beforeContinueAlert["Message"] = "Selecione o tipo e o modelo da etiqueta antes de gerar a impressão. A reimpressão exige justificativa para manter a rastreabilidade.";
    beforeContinueAlert["Tone"] = "info";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/labels-print-wizard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/labels-printwizard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/labels-demo.css" asp-append-version="true" />
}

<div class="label-wizard-page">
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a asp-action="Index">Etiquetas</a></li><li class="breadcrumb-item active" aria-current="page">Nova impressão</li></ol></nav>
    <header class="label-wizard-hero atlas-page-hero">
        <div><span class="label-wizard-eyebrow"><i class="bi bi-printer"></i> Central de Etiquetas</span><h1>Etiquetas LocDesk</h1><p>Configure, confira e imprima a etiqueta com a identidade visual correta em um único fluxo.</p></div>
        <div class="label-wizard-hero__actions"><a asp-action="Designer" class="atlas-btn atlas-btn-secondary"><i class="bi bi-grid"></i> Estúdio de Modelos</a><a asp-action="Index" class="atlas-btn atlas-btn-secondary"><i class="bi bi-arrow-left"></i> Voltar à central</a><a asp-action="History" class="atlas-btn atlas-btn-secondary"><i class="bi bi-clock-history"></i> Histórico</a></div>
    </header>
    <aside class="label-demo-callout" aria-labelledby="demo-mode-title"><div><h2 id="demo-mode-title">Modo de demonstração</h2><p>Use somente amostras fictícias, sem misturar dados de demonstração à impressão real.</p></div><nav><a asp-action="Demo" class="atlas-btn atlas-btn-secondary">Abrir vitrine</a><a asp-action="DemoSamples" class="atlas-btn atlas-btn-secondary" target="_blank">Imprimir amostras</a></nav></aside>
    @if (ViewBag.CatalogMigrationWarning is string migrationWarning) { <div class="atlas-alert atlas-alert-warning" role="alert"><strong>Atenção:</strong> @migrationWarning</div> }
    <partial name="Atlas/_AtlasStepper" view-data="stepperViewData" />
    <partial name="Atlas/_AtlasAlert" view-data="beforeContinueAlert" />

    <form method="post" id="label-print-form" class="label-wizard-layout" data-label-form>
        @Html.AntiForgeryToken()
        <input type="hidden" name="ClientActionId" value="@Guid.NewGuid()" />
        <main class="label-wizard-main">
            <partial name="Atlas/_AtlasValidationSummary" />
            <section class="label-wizard-card"><header class="label-wizard-card__header"><h2><span>1</span> O que imprimir</h2><p>Informe qual item receberá a etiqueta.</p></header><div class="label-wizard-card__body label-origin-grid"><div><label asp-for="SubjectType" class="form-label">Tipo de origem</label><select asp-for="SubjectType" class="form-select" id="subject"><option value="BOX">Caixa</option><option value="DOCUMENT">Documento/Pasta</option><option value="BATCH">Lote</option><option value="MANUAL_LABEL">Manual</option></select></div><div><label asp-for="SubjectId" class="form-label">Item de origem</label><select asp-for="SubjectId" class="form-select" required="@(Model.SubjectType != "MANUAL_LABEL")" aria-describedby="subject-help"><option value="">Selecione pelo nome ou código</option>@foreach(var option in subjectOptions){<option value="@option.Value">@option.Label</option>}</select><small id="subject-help" class="form-text">A lista contém somente registros disponíveis para o tenant atual.</small><span asp-validation-for="SubjectId" class="text-danger"></span>@if(subjectOptions.Count == 0 && Model.SubjectType != "MANUAL_LABEL"){<div class="atlas-form-empty" role="status">Nenhum item disponível para este tipo de origem.</div>}</div></div></section>
            <section class="label-wizard-card"><header class="label-wizard-card__header"><h2>Modo de impressão</h2><p>Use o padrão homologado ou um modelo adaptado à operação.</p></header><div class="label-wizard-card__body label-mode-grid"><label class="label-mode-card"><input asp-for="PrintMode" type="radio" value="FACTORY" /><span class="label-mode-card__icon"><i class="bi bi-shield-check"></i></span><strong>Padrão de fábrica</strong><small>Modelo seguro e padronizado pelo InovaGED.</small></label><label class="label-mode-card"><input asp-for="PrintMode" type="radio" value="CUSTOM" /><span class="label-mode-card__icon"><i class="bi bi-sliders"></i></span><strong>Personalizado</strong><small>Modelos do cliente, como LocDesk, com campos adaptados à operação.</small></label></div></section>
            <section class="label-wizard-card"><header class="label-wizard-card__header"><h2><span>2</span> Modelo da etiqueta</h2><p>Compare os modelos disponíveis para a origem e o modo escolhidos.</p></header><div class="label-wizard-card__body"><label asp-for="TemplateCode" class="form-label">Modelo selecionado</label><select asp-for="TemplateCode" class="form-select label-template-select" required><option value="">Selecione um modelo de etiqueta</option>@foreach (var template in templates) { <option value="@template.Code">@template.Name — @template.Description</option> }</select><span asp-validation-for="TemplateCode" class="text-danger"></span>@if (templates.Count == 0) { <div class="atlas-alert atlas-alert-warning mt-3" role="alert"><strong>Nenhum modelo de etiqueta disponível.</strong><br />Aplique as migrations obrigatórias em Prontidão do Banco ou use o catálogo mínimo do sistema.<div class="mt-2"><a class="atlas-btn atlas-btn-secondary" href="/DatabaseReadiness">Abrir Prontidão do Banco</a></div></div> }<div class="label-template-grid mt-3">@foreach (var template in templates) { var isLocDesk = template.Code.StartsWith("LOCDESK", StringComparison.OrdinalIgnoreCase); var typeLabel = template.SubjectType == "BOX" ? "Caixa" : template.SubjectType == "BATCH" ? "Lote" : "Documento/Pasta"; <button class="label-template-card" type="button" data-template-code="@template.Code"><span class="label-template-card__badges"><span class="atlas-badge atlas-badge-muted">@typeLabel</span><span class="atlas-badge atlas-badge-info">@(template.Mode == "FACTORY" ? "Fábrica" : "Personalizado")</span>@if (isLocDesk) { <span class="atlas-badge atlas-badge-implementation">LocDesk</span> }</span><strong>@template.Name</strong><small>@template.Description</small></button> }</div></div></section>
            <section class="label-wizard-card"><header class="label-wizard-card__header"><h2><span>3</span> Logo e identidade visual</h2><p>Selecione a arte real e ajuste seu tamanho físico antes de imprimir.</p></header><div class="label-wizard-card__body"><input asp-for="LogoSelection" type="hidden" />
<label asp-for="SelectedLogoAssetId" class="form-label">Logo da impressão</label><select asp-for="SelectedLogoAssetId" asp-items="Model.LogoOptions" class="form-select" id="selected-logo"><option value="">Usar logo padrão do modelo</option></select><div class="label-logo-status" role="status"><strong>Status da imagem</strong><span id="selected-logo-status">Logo não selecionada</span></div><div class="brand-asset-preview mt-2"><img id="selected-logo-preview" alt="Preview da logo oficial selecionada" hidden /></div><a class="atlas-btn atlas-btn-secondary" href="/Administration/BrandAssets/Create?returnUrl=/Labels/PrintWizard">Enviar nova logo</a><a class="atlas-btn atlas-btn-secondary" href="/Labels/LogoLayout/@(string.IsNullOrWhiteSpace(Model.TemplateCode) ? "LOCDESK_PASTA_V1" : Model.TemplateCode)">Ajustar posição e tamanho da logo</a><div class="label-config-grid mt-3"><div><label asp-for="LogoWidthMm">Largura (mm)</label><input asp-for="LogoWidthMm" class="form-control" type="number" min="10" max="90" step=".1" placeholder="38" /></div><div><label asp-for="LogoHeightMm">Altura (mm)</label><input asp-for="LogoHeightMm" class="form-control" type="number" min="5" max="60" step=".1" placeholder="Automática" /></div><label><input asp-for="PreserveAspectRatio" /> Manter proporção</label><div><label asp-for="LogoFitMode">Modo de encaixe</label><select asp-for="LogoFitMode" class="form-select"><option value="CONTAIN">CONTAIN — sem cortar</option><option value="COVER">COVER — pode cortar</option><option value="FILL">FILL — pode deformar</option></select></div><div><label asp-for="LogoPosition">Posição</label><select asp-for="LogoPosition" class="form-select"><option value="TOP_LEFT">Superior esquerda</option><option value="TOP_CENTER">Superior centro</option><option value="TOP_RIGHT">Superior direita</option><option value="CENTER">Centro</option><option value="BOTTOM_LEFT">Inferior esquerda</option><option value="BOTTOM_CENTER">Inferior centro</option><option value="BOTTOM_RIGHT">Inferior direita</option></select></div><div><label asp-for="LogoOffsetXmm">Deslocamento X (mm)</label><input asp-for="LogoOffsetXmm" class="form-control" type="number" min="-100" max="100" step=".1" /></div><div><label asp-for="LogoOffsetYmm">Deslocamento Y (mm)</label><input asp-for="LogoOffsetYmm" class="form-control" type="number" min="-100" max="100" step=".1" /></div></div></div></section>
            <partial name="_PrintWizardFinalReview" />
        </main>
        <aside class="label-wizard-preview label-preview-panel"><section class="label-wizard-card label-wizard-preview__sticky atlas-preview-shell label-preview-shell"><header class="label-wizard-card__header"><h2>Pré-visualização da etiqueta</h2><p>Resumo visual antes de gerar a impressão.</p></header><div class="label-wizard-card__body"><div class="label-preview-sheet label-preview-paper"><div class="label-preview-mini"><div class="label-preview-brand" id="preview-brand"><span class="label-preview-locdesk-logo" hidden><img id="label-preview-selected-logo" alt="Logo aplicada" hidden /></span><span class="label-preview-factory-brand"><i class="bi bi-box-seam"></i><strong>InovaGED</strong></span></div><span class="label-preview-kicker">Etiqueta de identificação</span><strong id="preview-template">@(templates.FirstOrDefault(t => t.Code == Model.TemplateCode)?.Name ?? "Selecione um modelo")</strong><div class="label-preview-lines"><span></span><span></span><span></span></div><div class="label-preview-footer"><i class="bi bi-qr-code"></i><small>QR com token seguro</small></div></div></div><section class="label-final-check" aria-labelledby="final-check-title"><h3 id="final-check-title">Conferência final</h3><dl class="label-wizard-summary"><div><dt>Modelo</dt><dd id="summary-template">@(templates.FirstOrDefault(t => t.Code == Model.TemplateCode)?.Name ?? "Selecione")</dd></div><div><dt>Origem</dt><dd id="summary-subject">@Model.SubjectType</dd></div><div><dt>Cópias</dt><dd id="summary-copies">@Model.Copies</dd></div><div><dt>Perfil</dt><dd>@(selectedProfile?.ProfileName ?? "Padrão automático")</dd></div><div><dt>Logo aplicada</dt><dd id="summary-logo">Padrão do modelo</dd></div><div><dt>Tamanho</dt><dd id="summary-logo-size">38 mm · altura automática</dd></div><div><dt>Posição</dt><dd>Superior esquerda</dd></div><div><dt>Calibração</dt><dd>@(selectedProfile?.ProfileName ?? "Padrão automático")</dd></div><div><dt>QR Code</dt><dd>Token seguro</dd></div><div><dt>Registro em histórico</dt><dd>Ativo</dd></div><div><dt>Rastreabilidade</dt><dd>Ativa</dd></div></dl></section><footer class="label-preview-actions"><button type="submit" form="label-print-form" formaction="@Url.Action("Preview", "Labels")" formmethod="post" class="btn btn-outline-primary" data-loading-text="Gerando prévia...">Pré-visualizar etiqueta</button><button type="submit" form="label-print-form" formaction="@Url.Action("PrintPreview", "Labels")" formmethod="post" class="btn btn-primary" data-loading-text="Preparando impressão...">Visualizar impressão</button><button type="submit" form="label-print-form" formaction="@Url.Action("Print", "Labels")" formmethod="post" class="btn btn-success" data-loading-text="Registrando impressão...">Imprimir</button></footer></div></section></aside>
    </form>
</div>

@section Scripts {
<script src="~/js/labels-form-submit.js" asp-append-version="true"></script>
<script>
(() => {
    const subject = document.querySelector('#subject');
    const modes = document.querySelectorAll('input[name="PrintMode"]');
    const templateSelect = document.querySelector('.label-template-select');
    const templateCards = document.querySelectorAll('.label-template-card[data-template-code]');
    const reloadCatalog = () => { const checked = document.querySelector('input[name="PrintMode"]:checked'); if (!checked) return; const url = new URL(location.href); url.searchParams.set('subjectType', subject.value); url.searchParams.set('mode', checked.value); location.href = url; };
    subject?.addEventListener('change', reloadCatalog); modes.forEach(input => input.addEventListener('change', reloadCatalog));
    const updateTemplate = (text, code = templateSelect?.value ?? '') => { document.querySelector('#preview-template')?.replaceChildren(text); document.querySelector('#summary-template')?.replaceChildren(text); const locDesk = code.startsWith('LOCDESK'); const logo = document.querySelector('.label-preview-locdesk-logo'); const factory = document.querySelector('.label-preview-factory-brand'); if (logo) logo.hidden = !locDesk; if (factory) factory.hidden = locDesk; };
    templateCards.forEach(card => card.addEventListener('click', () => { if (!templateSelect) return; templateSelect.value = card.dataset.templateCode ?? ''; updateTemplate(card.querySelector('strong')?.textContent ?? '', card.dataset.templateCode ?? ''); }));
    templateSelect?.addEventListener('change', () => updateTemplate(templateSelect.options[templateSelect.selectedIndex]?.text.split(' — ')[0] ?? '', templateSelect.value));
    updateTemplate(templateSelect?.options[templateSelect.selectedIndex]?.text.split(' — ')[0] ?? 'Selecione um modelo', templateSelect?.value ?? '');
    const logoSelect=document.querySelector('#selected-logo'),logoPreview=document.querySelector('#selected-logo-preview'),logoOrigin=document.querySelector('[name=\"LogoSelection\"]'); const updateLogo=()=>{const option=logoSelect?.options[logoSelect.selectedIndex],assetId=logoSelect?.value??'',src=assetId?`/Administration/BrandAssets/${assetId}/File`:'';if(logoPreview){if(src)logoPreview.src=src;else logoPreview.removeAttribute('src');logoPreview.hidden=!src;logoPreview.onerror=()=>{logoPreview.hidden=true;logoPreview.removeAttribute('src');document.querySelector('#selected-logo-status')?.replaceChildren('Logo selecionada, mas arquivo não encontrado');};logoPreview.onload=()=>document.querySelector('#selected-logo-status')?.replaceChildren('Logo carregada');}document.querySelector('#selected-logo-status')?.replaceChildren(src?'Carregando logo…':'Logo não selecionada');const applied=document.querySelector('#label-preview-selected-logo');if(applied){if(src)applied.src=src;else applied.removeAttribute('src');applied.hidden=!src;}if(src&&logoOrigin)logoOrigin.value='SELECTED';document.querySelector('#summary-logo')?.replaceChildren(src?(option?.textContent??'Logo selecionada'):'Padrão do modelo');};logoSelect?.addEventListener('change',updateLogo);updateLogo();
    document.querySelector('[name="Copies"]')?.addEventListener('input', event => document.querySelector('#summary-copies')?.replaceChildren(event.target.value));
})();
</script>
}
