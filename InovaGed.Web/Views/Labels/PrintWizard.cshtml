@model InovaGed.Web.Models.Labels.LabelPrintWizardInputModel
@using InovaGed.Application.PhysicalArchive

@{
    ViewData["Title"] = "Nova impressão de etiqueta";
    IReadOnlyList<LabelTemplateOption> templates =
        ViewBag.Templates as IReadOnlyList<LabelTemplateOption>
        ?? new List<LabelTemplateOption>();
}

<style>
    .steps {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: .5rem;
    }

    .step {
        border-top: 4px solid #dbe4ee;
        padding: .7rem;
    }

    .step.active {
        border-color: #176b87;
    }

    .mode-card {
        border: 2px solid #dbe4ee;
        border-radius: 1rem;
        cursor: pointer;
    }

    .mode-card:has(input:checked) {
        border-color: #176b87;
        background: #f0f9ff;
    }

    @@media (max-width: 700px) {
        .steps {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>
<div class="d-flex justify-content-between mb-3"><div><h1 class="h3 mb-1">Nova impressão</h1><p class="text-muted">Escolha como deseja imprimir esta etiqueta.</p></div><a asp-action="Index" class="btn btn-outline-secondary align-self-start">Voltar à central</a></div>
@if (ViewBag.CatalogMigrationWarning is string migrationWarning) { <div class="alert alert-warning" role="alert"><strong>Atenção:</strong> @migrationWarning</div> }
<div class="steps mb-4">@foreach(var s in new[]{("1","Origem"),("2","Modo"),("3","Modelo"),("4","Prévia e impressão")}){<div class="step active"><strong>@s.Item1</strong><div>@s.Item2</div></div>}</div>
<form method="post" class="card border-0 shadow-sm"><div class="card-body p-4"><div asp-validation-summary="All" class="text-danger"></div>
<h2 class="h5">1. Origem</h2><div class="row g-3 mb-4"><div class="col-md-4"><label asp-for="SubjectType" class="form-label">Tipo de origem</label><select asp-for="SubjectType" class="form-select" id="subject"><option value="BOX">Caixa</option><option value="DOCUMENT">Documento/Pasta</option><option value="BATCH">Lote</option><option value="MANUAL_LABEL">Manual</option></select></div><div class="col-md-8"><label asp-for="SubjectId" class="form-label">Identificador do objeto</label><input asp-for="SubjectId" class="form-control" placeholder="Selecione nas listagens ou informe o identificador" /></div></div>
<h2 class="h5">2. Modo de impressão</h2><div class="row g-3 mb-4"><div class="col-md-6"><label class="mode-card p-3 d-block h-100"><input asp-for="PrintMode" type="radio" value="FACTORY" class="form-check-input me-2"/><strong>Padrão de fábrica</strong><p class="text-muted small mt-2 mb-0">Layout fixo, seguro e padronizado pelo InovaGED. Campos essenciais vêm do sistema.</p></label></div><div class="col-md-6"><label class="mode-card p-3 d-block h-100"><input asp-for="PrintMode" type="radio" value="CUSTOM" class="form-check-input me-2"/><strong>Personalizado</strong><p class="text-muted small mt-2 mb-0">Modelos adaptados à operação do cliente, como LocDesk, com campos editáveis.</p></label></div></div>
<h2 class="h5">3. Modelo</h2><select asp-for="TemplateCode" class="form-select mb-4">@foreach(var t in templates){<option value="@t.Code">@t.Name — @t.Description</option>}</select>
<h2 class="h5">4. Prévia e impressão</h2><div class="row g-3"><div class="col-md-3"><label asp-for="Copies" class="form-label">Cópias</label><input asp-for="Copies" class="form-control"/></div><div class="col-md-9"><label asp-for="ReprintReason" class="form-label">Motivo da reimpressão</label><input asp-for="ReprintReason" class="form-control" placeholder="Obrigatório quando esta etiqueta já foi impressa"/></div></div></div><div class="card-footer bg-white p-3 d-flex flex-wrap justify-content-end gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Voltar</a><button asp-action="Preview" class="btn btn-outline-primary">Pré-visualizar</button><button asp-action="Print" class="btn btn-primary"><app-icon name="print"></app-icon> Registrar e imprimir</button><button asp-action="PrintBatch" class="btn btn-outline-dark">Imprimir em lote</button></div></form>
<script>document.querySelectorAll('input[name="PrintMode"],#subject').forEach(x=>x.addEventListener('change',()=>{const u=new URL(location.href);u.searchParams.set('subjectType',document.querySelector('#subject').value);u.searchParams.set('mode',document.querySelector('input[name="PrintMode"]:checked').value);location.href=u;}));</script>
