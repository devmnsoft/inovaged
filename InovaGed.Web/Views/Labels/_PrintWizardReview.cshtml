@model InovaGed.Web.Models.Labels.LabelPrintWizardInputModel
<section class="label-wizard-card label-final-review" data-wizard-step="5"><header class="label-wizard-card__header"><h2><span>5</span> Conferir e imprimir</h2><p>Confira o resumo e a prévia. A emissão cria histórico e rastreabilidade.</p></header><div class="label-wizard-card__body"><dl class="label-wizard-summary"><div><dt>Origem</dt><dd data-review-origin>—</dd></div><div><dt>Modelo e versão</dt><dd data-review-template>—</dd></div><div><dt>Cliente</dt><dd data-review-branding>Configuração padrão</dd></div><div><dt>Cópias</dt><dd data-review-copies>1</dd></div></dl><ul class="label-print-checklist"><li data-check="origin">Origem selecionada</li><li data-check="template">Modelo compatível selecionado</li><li data-check="copies">Número de cópias válido</li><li data-check="preview">Prévia gerada pelo renderizador</li></ul></div><footer class="label-final-actionbar"><button type="submit" class="btn btn-success" data-print-submit formaction="@Url.Action("Print","Labels")" formmethod="post">Imprimir etiqueta</button></footer></section>
