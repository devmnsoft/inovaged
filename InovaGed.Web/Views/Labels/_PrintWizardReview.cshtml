@model InovaGed.Web.Models.Labels.LabelPrintWizardInputModel
<section class="label-wizard-card label-final-review" data-wizard-step="5"><header class="label-wizard-card__header"><h2><span>5</span> Conferir e imprimir</h2><p>Confira os itens essenciais. A impressão só deve prosseguir com origem e modelo válidos.</p></header><div class="label-wizard-card__body"><ul class="label-print-checklist"><li data-check="origin">Origem selecionada</li><li data-check="template">Modelo selecionado</li><li>Cliente e identidade visual conferidos</li><li data-check="copies">Número de cópias válido</li><li>Perfil de impressão e tamanho conferidos</li><li>Quantidade por folha conferida</li><li>QR e rastreabilidade habilitados</li></ul></div><footer class="label-final-actionbar"><button type="submit" class="btn btn-outline-primary" formaction="@Url.Action("Preview","Labels")" formmethod="post">Atualizar prévia</button><button type="submit" class="btn btn-success" data-print-submit formaction="@Url.Action("Print","Labels")" formmethod="post">Imprimir etiqueta</button></footer></section>
