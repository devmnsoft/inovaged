@using InovaGed.Web.Models.Branding
@{ ViewData["Title"]="Marca das etiquetas"; var assets=ViewBag.Assets as IReadOnlyList<BrandAssetVm>??Array.Empty<BrandAssetVm>(); var bindings=ViewBag.Bindings as IReadOnlyDictionary<string,Guid?>??new Dictionary<string,Guid?>(); var templates=new Dictionary<string,string>{{"LOCDESK_PASTA_V1","LocDesk Pasta"},{"LOCDESK_CAIXA_V1","LocDesk Caixa"},{"LOCDESK_PASTA_HOL_V1","LocDesk Pasta HOL"},{"FACTORY_BOX_V1","Factory Caixa"},{"FACTORY_DOCUMENT_V1","Factory Documento"}}; }
@section Styles { <link rel="stylesheet" href="~/css/brand-assets.css"/><link rel="stylesheet" href="~/css/print-branding.css"/> }
<main class="atlas-page"><section class="atlas-page-hero brand-assets-hero"><div><h1>Marca das etiquetas</h1><p>Configure a logo oficial padrão e uma logo específica para cada modelo, sempre com proporção preservada.</p></div><a class="atlas-btn atlas-btn-secondary" href="/Administration/BrandAssets/Create">Cadastrar logo</a></section>@if(!assets.Any()){<div class="atlas-empty-state">Cadastre uma logo oficial antes de configurar os modelos.</div>}else{<section class="atlas-table-shell mt-4"><h2>Logo padrão do cliente</h2><div class="brand-assets-grid">@foreach(var asset in assets){<article class="brand-asset-card"><div class="brand-asset-preview"><img src="@asset.FileUrl" alt="@asset.AssetName"/></div><strong>@asset.AssetName</strong>@if(!asset.IsDefault){<form method="post" action="/Labels/Branding/SetDefaultLogo">@Html.AntiForgeryToken()<input type="hidden" name="logoAssetId" value="@asset.Id"/><button type="submit">Definir como padrão</button></form>}else{<span class="atlas-status-badge">Padrão</span>}</article>}</div></section><section class="atlas-table-shell mt-4"><h2>Logo específica por modelo</h2>@foreach(var template in templates){bindings.TryGetValue(template.Key,out var selected);<form method="post" action="/Labels/Branding/SaveTemplateLogo" class="atlas-action-card">@Html.AntiForgeryToken()<input type="hidden" name="templateCode" value="@template.Key"/><label>@template.Value <code>@template.Key</code></label><select name="logoAssetId"><option value="">Usar padrão do cliente</option>@foreach(var asset in assets){<option value="@asset.Id" selected="@(selected==asset.Id)">@asset.AssetName — @asset.BrandName</option>}</select><label>Largura (mm)<input name="widthMm" type="number" min="10" max="90" step=".1" value="38" /></label><label>Altura (mm)<input name="heightMm" type="number" min="5" max="60" step=".1" /></label><label><input name="preserveAspectRatio" type="checkbox" value="true" checked /> Manter proporção</label><label>Encaixe <select name="fitMode"><option>CONTAIN</option><option>COVER</option><option>FILL</option></select></label><label>Posição <select name="position"><option value="TOP_LEFT">Superior esquerda</option><option value="TOP_CENTER">Superior centro</option><option value="TOP_RIGHT">Superior direita</option><option value="CENTER">Centro</option></select></label><button type="submit">Salvar</button><button type="submit" formaction="/Labels/Branding/TestPrint" formmethod="get">Testar impressão</button></form>}</section>}</main>
