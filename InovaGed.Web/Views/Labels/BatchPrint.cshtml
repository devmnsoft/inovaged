@model InovaGed.Web.Models.Labels.CreateBatchPrintJobInput
@{ ViewData["LabelHelpContext"]="BATCH_SELECTION";ViewData["Title"]="Impressão em lote";var rows=(IEnumerable<dynamic>)ViewBag.Rows; }
@section Styles {<link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/labels-studio.css" asp-append-version="true"/>}
<main class="labels-page"><header class="labels-hero"><div><span class="labels-eyebrow"><app-icon name="batch" size="16" decorative="true"/> Operação guiada</span><h1>Impressão em lote</h1><p>Selecione registros visíveis, configure e confira o lote antes de criar o job rastreável.</p></div><partial name="~/Views/Labels/Shared/_LabelHelpDrawer.cshtml"/></header>
<nav class="label-stepper" aria-label="Etapas"><button type="button" aria-current="step">1 Selecionar registros</button><button type="button" disabled>2 Configurar impressão</button><button type="button" disabled>3 Conferir lote</button></nav>
<form asp-action="CreateBatchPrintJob" method="post" data-batch-form>@Html.AntiForgeryToken()<input asp-for="SubjectType" type="hidden"/><input asp-for="PrintMode" type="hidden" data-batch-mode/>
<section data-batch-step="1"><div class="d-flex gap-2 mb-3"><a class="btn @(Model.SubjectType=="BOX"?"btn-primary":"btn-outline-primary")" asp-action="BatchPrint" asp-route-subjectType="BOX">Caixas</a><a class="btn @(Model.SubjectType=="DOCUMENT"?"btn-primary":"btn-outline-primary")" asp-action="BatchPrint" asp-route-subjectType="DOCUMENT">Documentos/Pastas</a></div><div class="label-batch-filters"><label>Buscar<input type="search" class="form-control" data-batch-search placeholder="Código, título, localização ou classificação"/></label><label>Situação<select class="form-select" data-batch-filter><option value="all">Todos</option><option value="new">Nunca impressos</option><option value="printed">Já impressos</option></select></label><button type="button" class="btn btn-outline-secondary" data-select-visible>Selecionar visíveis</button><button type="button" class="btn btn-outline-secondary" data-clear-selection>Limpar seleção</button></div><div class="table-responsive" style="max-height:520px"><table class="table table-hover align-middle"><thead class="sticky-top bg-light"><tr><th><span class="visually-hidden">Selecionar</span></th><th>Código</th><th>Descrição</th><th>Localização</th><th>Classificação</th><th>Situação</th></tr></thead><tbody>@foreach(var r in rows){<tr data-batch-row data-printed="@(((bool)r.already_printed).ToString().ToLowerInvariant())" data-search="@r.control_number @r.subject @r.location @r.classification"><td><input class="form-check-input pick" type="checkbox" name="SubjectIds" value="@r.id"/></td><td>@r.control_number</td><td>@r.subject</td><td>@r.location</td><td>@r.classification</td><td>@if(r.already_printed){<span class="badge text-bg-warning">Já impressa</span>}else{<span>Nova</span>}</td></tr>}</tbody></table></div></section>
<section data-batch-step="2" hidden><div class="label-origin-grid"><label>Modelo<select asp-for="TemplateCode" class="form-select" required><option value="">Selecione</option>@foreach(var t in ViewBag.Templates){<option value="@t.Code" data-mode="@t.Mode">@t.Name</option>}</select></label><label>Identidade<select asp-for="PrintBrandingProfileId" class="form-select"><option value="">Padrão do vínculo</option>@foreach(var p in ViewBag.PrintBrandingProfiles){<option value="@p.Id">@p.ProfileName</option>}</select></label><label>Perfil da impressora<select asp-for="PrintProfileId" class="form-select"><option value="">Perfil padrão</option>@foreach(var p in ViewBag.PrintProfiles){<option value="@p.Id">@p.ProfileName</option>}</select></label><label>Cópias<input asp-for="Copies" class="form-control" min="1" max="500"/></label></div><div data-reprint-warning hidden><p><strong data-reprint-count>0</strong> etiquetas já foram impressas anteriormente.</p><label>Justificativa da reimpressão<textarea asp-for="ReprintReason" class="form-control" rows="2"></textarea></label></div></section>
<section data-batch-step="3" hidden><h2>Conferir lote</h2><dl class="label-wizard-summary"><div><dt>Origens</dt><dd data-batch-selected>0</dd></div><div><dt>Etiquetas físicas</dt><dd data-batch-physical>0</dd></div><div><dt>Páginas estimadas</dt><dd data-batch-pages>0</dd></div><div><dt>Amostras de prévia</dt><dd>Até 3 etiquetas; as demais usam o mesmo modelo.</dd></div></dl><button type="submit" class="ig-button ig-button--primary">Criar lote e visualizar</button></section>
<footer class="label-batch-summary"><strong><span data-selected-count>0</span> selecionados</strong><span><span data-printed-count>0</span> já impressos</span><span><span data-new-count>0</span> novos</span><button type="button" class="btn btn-outline-secondary" data-batch-back>Voltar</button><button type="button" class="btn btn-primary" data-batch-next>Continuar</button></footer></form></main>
@section Scripts {<script src="~/js/labels-help.js" asp-append-version="true"></script><script src="~/js/labels-batch.js" asp-append-version="true"></script>}
