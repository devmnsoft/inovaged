@model InovaGed.Web.Models.Labels.CreateBatchPrintJobInput
@{ViewData["Title"]="Impressão em lote";var rows=(IEnumerable<dynamic>)ViewBag.Rows;}
<section class="p-4 rounded-4 bg-primary text-white mb-4"><div class="small text-uppercase opacity-75">Etiquetas · lote</div><h1 class="h2">Impressão em lote</h1><p class="mb-0">Selecione várias caixas ou documentos, revise o modelo e crie um único job rastreável.</p></section>
<div class="d-flex gap-2 mb-3"><a class="btn @(Model.SubjectType=="BOX"?"btn-primary":"btn-outline-primary")" asp-action="BatchPrint" asp-route-subjectType="BOX">Caixas</a><a class="btn @(Model.SubjectType=="DOCUMENT"?"btn-primary":"btn-outline-primary")" asp-action="BatchPrint" asp-route-subjectType="DOCUMENT">Documentos/Pastas</a></div>
<form asp-action="CreateBatchPrintJob" method="post"><input asp-for="SubjectType" type="hidden"><div class="card border-0 shadow-sm mb-4"><div class="card-body"><div class="row g-3"><div class="col-md-3"><label class="form-label">Modo</label><select asp-for="PrintMode" class="form-select"><option value="FACTORY">Padrão de fábrica</option><option value="CUSTOM">Personalizado</option></select></div><div class="col-md-4"><label class="form-label">Modelo compatível</label><select asp-for="TemplateCode" class="form-select" required><option value="">Selecione</option>@foreach(var t in ViewBag.Templates){<option value="@t.Code">@t.Name</option>}</select></div><div class="col-md-2"><label class="form-label">Cópias</label><input asp-for="Copies" class="form-control"></div><div class="col-md-3"><label class="form-label">Motivo de reimpressão</label><input asp-for="ReprintReason" class="form-control" placeholder="Obrigatório se já impressa"></div></div></div></div>
<div class="card border-0 shadow-sm"><div class="card-header bg-white d-flex justify-content-between"><strong>Registros disponíveis</strong><button type="button" class="btn btn-sm btn-outline-secondary" onclick="document.querySelectorAll('.pick').forEach(x=>x.checked=true)">Selecionar todos</button></div><div class="table-responsive" style="max-height:520px"><table class="table table-hover align-middle mb-0"><thead class="sticky-top bg-light"><tr><th></th><th>Código/controle</th><th>Assunto/título</th><th>Caixa</th><th>Localização</th><th>Classificação</th><th>Status</th><th>Histórico</th></tr></thead><tbody>@foreach(var r in rows){<tr><td><input class="form-check-input pick" type="checkbox" name="SubjectIds" value="@r.id"></td><td>@r.control_number</td><td>@r.subject</td><td>@r.box_no</td><td>@r.location</td><td>@r.classification</td><td>@r.status</td><td>@if(r.already_printed){<span class="badge text-bg-warning">Já impressa</span>}else{<span class="badge text-bg-light">Nova</span>}</td></tr>}</tbody></table></div><div class="card-footer bg-white text-end"><button class="btn btn-primary btn-lg">Criar lote e visualizar</button></div></div></form>
