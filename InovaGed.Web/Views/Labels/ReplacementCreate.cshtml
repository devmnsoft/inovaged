@{ViewData["Title"]="Substituir etiqueta";}
<link rel="stylesheet" href="~/css/labels-traceability.css"/><main class="label-replacement-page"><section class="atlas-page-hero"><div><h1>Substituir etiqueta</h1><p>A nova identidade revoga operacionalmente o uso da anterior.</p></div></section><form method="post" class="atlas-card">@Html.AntiForgeryToken()<label>Etiqueta antiga (TraceCode, QR ou URL)</label><input name="labelCode" required/><label>Motivo da substituição</label><textarea name="reason" required minlength="10"></textarea><label>Modelo novo</label><select name="newTemplateCode" required><option value="FACTORY_DOCUMENT_V1">Padrão Documento</option><option value="FACTORY_BOX_V1">Padrão Caixa</option><option value="LOCDESK_PASTA_V1">LocDesk Pasta</option><option value="LOCDESK_PASTA_HOL_V1">LocDesk HOL</option><option value="LOCDESK_CAIXA_V1">LocDesk Caixa</option></select><button type="submit" class="atlas-btn atlas-btn-primary">Criar nova identidade</button></form></main>
