@{ ViewData["Title"] = "Aceite Visual de Etiquetas"; ViewData["WorkspaceVariant"] = "wide";
 var models = new List<string> { "LocDesk Pasta Padrão", "LocDesk Caixa Padrão", "LocDesk Pasta HOL", "Factory Box", "Factory Document" };
 var checks = new List<string> { "Cabeçalho correto", "Logo correto", "Borda correta", "Controle em vermelho", "Volume em vermelho", "Campos obrigatórios presentes", "LOCALIZAÇÃO presente", "QR Code legível", "Preview correto", "Impressão limpa", "Fonte legível", "Espaçamento adequado" }; }
@section Styles { <link rel="stylesheet" href="~/css/labels-demo.css" asp-append-version="true" /> }
<main class="labels-demo-page labels-demo-acceptance"><header class="labels-demo-hero"><div><span>Homologação visual · RC4</span><h1>Checklist de aceite visual</h1><p>Conferência preparada para apresentação, validação em impressora real e futura assinatura do cliente.</p></div><nav><a class="ig-button ig-button--primary" asp-action="DemoSamples">Abrir amostras</a><a class="ig-button ig-button--secondary" asp-action="Demo">Voltar à vitrine</a></nav></header>
<div id="checklist" class="labels-demo-checklist">@foreach (var name in models) { <section><header><div><small>Modelo homologado</small><h2>@name</h2></div><span class="labels-demo-status labels-demo-status--ok">OK</span></header><ul>@foreach (var check in checks) { var attention = check == "QR Code legível" && name == "LocDesk Caixa Padrão"; <li><span>@check</span><strong class="labels-demo-status @(attention ? "labels-demo-status--attention" : "labels-demo-status--ok")">@(attention ? "Atenção" : "OK")</strong></li> }</ul></section> }</div>
<footer class="labels-demo-signoff"><div><strong>Responsável pelo aceite</strong><span>________________________________</span></div><div><strong>Data</strong><span>____ / ____ / ________</span></div><p>Área reservada para futura assinatura e homologação formal.</p></footer></main>
