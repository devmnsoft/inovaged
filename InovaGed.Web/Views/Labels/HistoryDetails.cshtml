@model dynamic
@{ViewData["Title"]="Detalhes da impressão";string snapshot=Convert.ToString(Model.snapshot_json)??"{}";}
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1 class="h3">Detalhes da impressão</h1><p class="text-muted">Registro auditável e snapshot imutável da etiqueta.</p></div><a class="btn btn-outline-secondary" asp-action="History">Voltar ao histórico</a></div>
<div class="row g-4"><div class="col-lg-7"><div class="card shadow-sm"><div class="card-header"><strong>Dados da impressão</strong></div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-4">Data/hora</dt><dd class="col-sm-8">@Convert.ToDateTime(Model.printed_at).ToString("dd/MM/yyyy HH:mm:ss")</dd><dt class="col-sm-4">Usuário</dt><dd class="col-sm-8">@(Model.printed_by_name??"—")</dd><dt class="col-sm-4">IP</dt><dd class="col-sm-8">@(Model.ip_address??"—")</dd><dt class="col-sm-4">Origem</dt><dd class="col-sm-8">@Model.label_subject_type · @Model.label_subject_id</dd><dt class="col-sm-4">Modelo usado</dt><dd class="col-sm-8"><strong>@Model.template_name</strong> · v@Model.template_version <span class="badge @(Convert.ToString(Model.print_mode)=="CUSTOM"?"text-bg-dark":"text-bg-primary")">@(Convert.ToString(Model.print_mode)=="CUSTOM"?"Personalizado":"Padrão de fábrica")</span> @if(Model.was_default){<span class="badge text-bg-warning">Era padrão</span>}</dd><dt class="col-sm-4">Motivo de reimpressão</dt><dd class="col-sm-8">@(Model.reprint_reason??"Primeira impressão")</dd><dt class="col-sm-4">Hash SHA-256</dt><dd class="col-sm-8"><code class="text-break">@Model.snapshot_sha256</code></dd></dl></div></div></div><div class="col-lg-5"><div class="card shadow-sm"><div class="card-header"><strong>Campos e configuração usados</strong></div><div class="card-body"><p class="small text-muted">Snapshot preservado no momento da impressão.</p><pre class="bg-light border rounded p-3 small text-wrap" style="max-height:32rem;overflow:auto">@snapshot</pre></div></div></div></div>
<div class="card shadow-sm mt-4"><div class="card-body"><h2 class="h5">Reimpressão controlada</h2><p>Informe o motivo da reimpressão para manter a rastreabilidade.</p><form method="post" asp-action="Reprint" asp-route-id="@Model.id"><label for="justification" class="form-label">Justificativa obrigatória</label><textarea id="justification" name="justification" required maxlength="500" class="form-control mb-3"></textarea><button class="btn btn-primary" type="submit">Solicitar reimpressão</button></form></div></div>
