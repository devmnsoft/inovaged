@model InovaGed.Web.Models.Labels.LocDeskLabelInputModel
@{ ViewData["Title"]="Etiquetas LocDesk"; ViewData["Subtitle"]="Geração, preenchimento e impressão de etiquetas de pasta e caixa"; }
@{ var locDeskFields = new List<(string Name, string Label)> { ("Details","Detalhamento"),("Activity","Atividade"),("Classification","Classificação"),("Support","Suporte"),("DocumentPeriod","Período do Documento"),("CurrentPhase","Fase Atual"),("EliminationForecast","Previsão Eliminação"),("EliminationStatus","Situação Eliminação"),("LedNumber","Nº LED"),("Location","LOCALIZAÇÃO") }; }
<link rel="stylesheet" href="~/css/locdesk-labels.css">
<link rel="stylesheet" href="~/css/labels-premium.css">
<section class="locdesk-admin-hero mb-4"><div class="d-flex justify-content-between flex-wrap gap-3"><div><div class="text-uppercase small opacity-75">Identificação e rastreabilidade</div><h2 class="mt-1">Etiquetas LocDesk</h2><p class="mb-0">Geração, preenchimento e impressão de etiquetas de pasta e caixa</p></div><partial name="_LocDeskLogoSvg" /></div></section>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}
<div class="row g-4"><div class="col-xl-9"><form method="post" target="_blank" class="card ig-card locdesk-form-card"><div class="card-header bg-white pt-3"><ul class="nav nav-pills gap-2"><li><button type="button" class="nav-link active kind-tab" data-kind="FOLDER">🏷️ Etiqueta de Pasta</button></li><li><button type="button" class="nav-link kind-tab" data-kind="BOX">📦 Etiqueta de Caixa</button></li><li><a class="nav-link" asp-action="History">🕘 Histórico</a></li></ul></div><div class="card-body p-4">
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><input asp-for="LabelKind" type="hidden" id="labelKind"><input asp-for="BoxId" type="hidden"><input asp-for="DocumentId" type="hidden">
<div class="row g-3"><div class="col-md-8"><label asp-for="ArchiveTitle" class="form-label">Cabeçalho do arquivo</label><input asp-for="ArchiveTitle" class="form-control"><span asp-validation-for="ArchiveTitle" class="text-danger"></span></div><div class="col-md-4"><label asp-for="ProcessNumber" class="form-label">Processo nº</label><input asp-for="ProcessNumber" class="form-control"></div>
<div class="col-md-4"><label asp-for="ControlNumber" class="form-label">N° de Controle</label><input asp-for="ControlNumber" class="form-control"><span asp-validation-for="ControlNumber" class="text-danger"></span></div><div class="col-md-2"><label asp-for="VolumeNumber" class="form-label">Volume</label><input asp-for="VolumeNumber" class="form-control"></div><div class="col-md-2"><label asp-for="VolumeTotal" class="form-label">Total</label><input asp-for="VolumeTotal" class="form-control"></div><div class="col-md-4"><label asp-for="Copies" class="form-label">Cópias (lote)</label><input asp-for="Copies" class="form-control"></div>
<div class="col-12"><label asp-for="Subject" class="form-label">Assunto</label><textarea asp-for="Subject" class="form-control" rows="2"></textarea><span asp-validation-for="Subject" class="text-danger"></span></div>
@foreach (var field in locDeskFields){<div class="col-md-6"><label class="form-label" for="@field.Item1">@field.Item2</label><input class="form-control" id="@field.Item1" name="@field.Item1" value="@Model.GetType().GetProperty(field.Item1)?.GetValue(Model)"></div>}
<div class="col-12"><label asp-for="ReprintReason" class="form-label">Motivo da reimpressão <span class="text-muted">(obrigatório após a primeira impressão)</span></label><textarea asp-for="ReprintReason" class="form-control"></textarea></div></div></div>
<div class="card-footer bg-white d-flex flex-wrap gap-2 p-3"><button class="btn ig-button ig-button--secondary" asp-action="PreviewLocDesk">▣ Pré-visualizar</button><button class="btn ig-btn-primary" asp-action="PrintLocDesk">🖨️ Gerar impressão da etiqueta</button><a class="btn ig-button ig-button--primary" asp-action="PrintWizard" asp-route-subjectType="BATCH" asp-route-mode="CUSTOM">🏷️ Montar lote</a><button class="btn ig-button ig-button--secondary" type="reset">Limpar</button></div></form></div>
<div class="col-xl-3"><section class="ig-label-preview-shell locdesk-live-preview mb-3" aria-labelledby="locdesk-preview-title"><header><div><small>Pré-visualização</small><h2 id="locdesk-preview-title">Etiqueta LocDesk</h2></div><span class="ig-status-badge ig-status-badge--ok">Escala adaptada</span></header><div class="ig-label-preview-shell__canvas"><article class="locdesk-preview-label"><header><partial name="_LocDeskLogoSvg" /><strong>ARQUIVO LOCDESCK<br />ANANINDEUA</strong><app-icon name="qr-code" size="38" decorative="true" /></header><div class="locdesk-preview-control"><span>Nº de Controle</span><strong id="previewControl">@Model.ControlNumber</strong><span>Volume</span><strong id="previewVolume">@Model.VolumeNumber / @Model.VolumeTotal</strong></div><dl><div><dt>Assunto</dt><dd id="previewSubject">@(string.IsNullOrWhiteSpace(Model.Subject) ? "Será preenchido com os dados informados" : Model.Subject)</dd></div><div><dt>Localização</dt><dd id="previewLocation">@Model.Location</dd></div></dl></article></div><footer><app-icon name="printer" size="16" decorative="true" /> Confirme a escala em 100% antes de imprimir.</footer></section><div class="card ig-card locdesk-form-card mb-3"><div class="card-body"><h5>Carregar dados</h5><p class="text-muted small">Informe o identificador na listagem de caixas ou documentos.</p><a asp-action="Boxes" class="btn btn-outline-primary w-100 mb-2">📦 Carregar dados da caixa</a><a asp-action="Documents" class="btn btn-outline-primary w-100">📄 Carregar dados do documento</a></div></div><div class="alert alert-info"><strong>QR Code gerado</strong><br><small>O código direciona ao objeto vinculado e respeita autenticação e tenant.</small></div></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>document.querySelectorAll('.kind-tab').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.kind-tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById('labelKind').value=b.dataset.kind;}));[['ControlNumber','previewControl'],['Subject','previewSubject'],['Location','previewLocation']].forEach(([name,target])=>document.querySelector(`[name="${name}"]`)?.addEventListener('input',e=>document.getElementById(target).textContent=e.target.value));const updateVolume=()=>document.getElementById('previewVolume').textContent=`${document.querySelector('[name="VolumeNumber"]')?.value||''} / ${document.querySelector('[name="VolumeTotal"]')?.value||''}`;document.querySelectorAll('[name^="Volume"]').forEach(x=>x.addEventListener('input',updateVolume));</script>}
