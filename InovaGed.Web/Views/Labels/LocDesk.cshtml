@model InovaGed.Web.Models.Labels.LocDeskLabelInputModel
@using InovaGed.Web.Models.Labels
@{ ViewData["Title"]="Etiquetas LocDesk"; ViewData["Subtitle"]="Geração, preenchimento e impressão de etiquetas";
var previewFields = new List<KeyValuePair<string, string>> { new("Assunto:", "Subject"), new("Detalhamento:", "Details"), new("Atividade:", "Activity"), new("Classificação:", "Classification"), new("Suporte:", "Support"), new("Fase Atual:", "CurrentPhase"), new("Previsão Eliminação:", "EliminationForecast"), new("Situação Eliminação:", "EliminationStatus"), new("Nº LED:", "LedNumber"), new("LOCALIZAÇÃO:", "Location") }; }
@section Styles { <link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/locdesk-label.css" asp-append-version="true" /> }
<section class="locdesk-admin-hero atlas-page-hero mb-4"><div><span class="text-uppercase small opacity-75">Identificação e rastreabilidade</span><h1>Etiquetas LocDesk</h1><p>Escolha o modelo, preencha os campos arquivísticos e confira a etiqueta antes da impressão.</p></div><img src="~/img/locdesk-logo.svg" alt="LocDesk" /></section>
<div class="locdesk-editor-layout">
<form method="post" target="_blank" class="locdesk-form-card">
 @Html.AntiForgeryToken()
 <div class="locdesk-form-section"><h2>Modelo da etiqueta</h2><div class="locdesk-model-grid">
  <label><input asp-for="TemplateCode" type="radio" value="@LabelTemplateCode.LocDeskFolder" data-kind="FOLDER" /><strong>LocDesk Padrão</strong><small>Pasta com QR e campos Ananindeua.</small></label>
  <label><input asp-for="TemplateCode" type="radio" value="@LabelTemplateCode.LocDeskFolderHol" data-kind="FOLDER" /><strong>LocDesk Pasta HOL</strong><small>Modelo oficial do Hospital Ophir Loyola.</small></label>
  <label><input asp-for="TemplateCode" type="radio" value="@LabelTemplateCode.LocDeskBox" data-kind="BOX" /><strong>LocDesk Caixa</strong><small>Identificação de caixa física.</small></label>
 </div></div>
 <div asp-validation-summary="ModelOnly" class="atlas-alert atlas-alert-danger"></div><input asp-for="LabelKind" type="hidden" id="labelKind" /><input asp-for="BoxId" type="hidden" /><input asp-for="DocumentId" type="hidden" />
 <section class="locdesk-form-section"><h2>Identificação</h2><div class="row g-3">
  <div class="col-md-6 hol-field"><label asp-for="Contract" class="form-label">Contrato</label><input asp-for="Contract" class="form-control" /><span asp-validation-for="Contract" class="text-danger"></span></div>
  <div class="col-md-6 hol-field"><label asp-for="MedicalRecordNumber" class="form-label">Número do prontuário</label><input asp-for="MedicalRecordNumber" class="form-control" /></div>
  <div class="col-md-8 standard-field"><label asp-for="ArchiveTitle" class="form-label">Cabeçalho do arquivo</label><input asp-for="ArchiveTitle" class="form-control" /></div><div class="col-md-4 standard-field"><label asp-for="ProcessNumber" class="form-label">Processo nº</label><input asp-for="ProcessNumber" class="form-control" /></div>
  <div class="col-md-4"><label asp-for="ControlNumber" class="form-label">Número de controle</label><input asp-for="ControlNumber" class="form-control" /><span asp-validation-for="ControlNumber" class="text-danger"></span></div><div class="col-md-2"><label asp-for="VolumeNumber" class="form-label">Volume atual</label><input asp-for="VolumeNumber" class="form-control" type="number" /></div><div class="col-md-2"><label asp-for="VolumeTotal" class="form-label">Volume total</label><input asp-for="VolumeTotal" class="form-control" type="number" /></div><div class="col-md-4"><label asp-for="Copies" class="form-label">Cópias</label><input asp-for="Copies" class="form-control" type="number" /></div>
 </div></section>
 <section class="locdesk-form-section"><h2>Descrição arquivística</h2><div class="row g-3">
  <div class="col-12"><label asp-for="Subject" class="form-label">Assunto</label><textarea asp-for="Subject" class="form-control" rows="2"></textarea><span asp-validation-for="Subject" class="text-danger"></span></div>
  <div class="col-md-6"><label asp-for="Details" class="form-label">Detalhamento</label><input asp-for="Details" class="form-control" /></div>
  <div class="col-md-3"><label asp-for="Activity" class="form-label">Atividade</label><select asp-for="Activity" class="form-select"><option>MEIO</option><option>FIM</option></select></div>
  <div class="col-md-3"><label asp-for="Support" class="form-label">Suporte</label><select asp-for="Support" class="form-select"><option value="1. PAPEL">PAPEL</option><option value="2. DIGITAL">DIGITAL</option><option value="3. HÍBRIDO">HÍBRIDO</option></select></div>
  <div class="col-12"><label asp-for="Classification" class="form-label">Classificação</label><input asp-for="Classification" class="form-control" /></div>
  <div class="col-md-3 hol-field"><label asp-for="PeriodStart" class="form-label">Período inicial</label><input asp-for="PeriodStart" class="form-control" type="date" /></div><div class="col-md-3 hol-field"><label asp-for="PeriodEnd" class="form-label">Período final</label><input asp-for="PeriodEnd" class="form-control" type="date" /></div>
  <div class="col-md-6 standard-field"><label asp-for="DocumentPeriod" class="form-label">Período</label><input asp-for="DocumentPeriod" class="form-control" /></div>
  <div class="col-md-6"><label asp-for="CurrentPhase" class="form-label">Fase atual</label><select asp-for="CurrentPhase" class="form-select"><option>1. GUARDA CORRENTE</option><option>2. GUARDA INTERMEDIÁRIA</option><option>0. GUARDA PERMANENTE</option></select></div>
  <div class="col-md-6"><label asp-for="EliminationForecast" class="form-label">Previsão de eliminação</label><input asp-for="EliminationForecast" class="form-control" /></div>
  <div class="col-md-6"><label asp-for="EliminationStatus" class="form-label">Situação de eliminação</label><select asp-for="EliminationStatus" class="form-select"><option>0. GUARDA PERMANENTE</option><option>1. ELIMINAÇÃO AUTORIZADA</option><option>2. LED PENDENTE DE ELABORAÇÃO</option></select></div>
  <div class="col-md-6"><label asp-for="LedNumber" class="form-label">Nº LED</label><input asp-for="LedNumber" class="form-control" /></div><div class="col-md-6"><label asp-for="Location" class="form-label">Localização</label><input asp-for="Location" class="form-control" /></div>
  <div class="col-12"><label asp-for="ReprintReason" class="form-label">Motivo da reimpressão</label><textarea asp-for="ReprintReason" class="form-control"></textarea></div>
 </div></section>
 <footer class="label-actions"><button class="atlas-btn atlas-btn-secondary" asp-action="PreviewLocDesk">Pré-visualizar</button><button class="atlas-btn atlas-btn-primary" asp-action="PrintLocDesk">Gerar impressão</button><a class="atlas-btn atlas-btn-secondary" asp-action="History">Histórico</a></footer>
</form>
<aside class="locdesk-screen-preview"><h2>Pré-visualização da etiqueta</h2><p>Os valores iniciais são somente fallback visual e não são salvos automaticamente.</p><div class="locdesk-preview-canvas"><article class="locdesk-label locdesk-hol-label"><header class="locdesk-hol-header"><div class="locdesk-hol-brand"><img class="locdesk-hol-logo" src="~/img/locdesk-logo.svg" alt="LocDesk" /><small>ARQUIVO LOCDESCK ANANINDEUA</small></div><div class="locdesk-hol-contract"><span>Contrato:</span><strong data-preview="Contract">@Model.Contract</strong></div><div class="locdesk-hol-control"><span>N° Controle: <strong class="locdesk-hol-red" data-preview="ControlNumber">@Model.ControlNumber</strong></span><span>Vol.: <strong id="previewVolume">@Model.VolumeNumber/@Model.VolumeTotal</strong></span></div></header><div class="locdesk-hol-body">@foreach (var field in previewFields) {<div class="locdesk-hol-row @(field.Value == "Location" ? "locdesk-hol-location" : "")"><strong class="locdesk-hol-label-title">@field.Key</strong><span class="locdesk-hol-label-value" data-preview="@field.Value">@Model.GetType().GetProperty(field.Value)?.GetValue(Model)</span></div>}</div></article></div></aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script>(()=>{const radios=document.querySelectorAll('[name="TemplateCode"]'),kind=document.querySelector('#labelKind');function toggle(){const selected=document.querySelector('[name="TemplateCode"]:checked');if(!selected)return;kind.value=selected.dataset.kind;document.body.classList.toggle('locdesk-is-hol',selected.value==='@LabelTemplateCode.LocDeskFolderHol');}radios.forEach(x=>x.addEventListener('change',toggle));toggle();document.querySelectorAll('[data-preview]').forEach(output=>document.querySelector(`[name="${output.dataset.preview}"]`)?.addEventListener('input',e=>output.textContent=e.target.value));const volume=()=>document.querySelector('#previewVolume').textContent=`${document.querySelector('[name="VolumeNumber"]').value}/${document.querySelector('[name="VolumeTotal"]').value}`;document.querySelectorAll('[name^="Volume"]').forEach(x=>x.addEventListener('input',volume));})();</script> }
