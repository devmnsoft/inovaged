@{ ViewData["Title"]="Central de Etiquetas"; ViewData["WorkspaceVariant"]="wide";
var cards = new List<(string Icon,string Title,string Description,string Url,string Action,string Status)> {
("print","Assistente de Impressão","Fluxo guiado para escolher tipo, modelo, dados e saída.",Url.Action("PrintWizard")!,"Iniciar impressão","Operacional"),
("location","Etiqueta LocDesk","Prepare etiquetas personalizadas de caixas, pastas e documentos.",Url.Action("LocDesk")!,"Criar LocDesk","Homologado"),
("history","Histórico de Impressões","Audite emissões, usuários, modelos e reimpressões.",Url.Action("History")!,"Consultar histórico","Auditável"),
("box","Etiquetas de Caixas","Selecione caixas físicas e gere identificações rastreáveis.",Url.Action("Boxes")!,"Selecionar caixa","Disponível"),
("document","Etiquetas de Documentos","Identifique documentos e pastas com QR Code.",Url.Action("Documents")!,"Selecionar documento","Disponível"),
("qr-code","Rastreio QR","Localize a origem e acompanhe a cadeia de custódia.","/LabelTracking","Abrir rastreio","Online"),
("tag","Modelos de Etiqueta","Ajuste modelos, dimensões e calibração de impressão.",Url.Action("Calibration")!,"Gerenciar modelos","Configurável"),
("activity","Fila de Impressão","Acompanhe trabalhos, prévias e arquivos gerados.",Url.Action("PrintQueue")!,"Abrir fila","Monitorada") }; }
@section Styles { <link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true" /> }
<div class="ig-label-page ig-fade-in"><section class="ig-page-hero" aria-labelledby="labels-title"><div><span class="ig-eyebrow"><app-icon name="tag" size="16" decorative="true" /> Operação e rastreabilidade</span><h1 id="labels-title">Central de Etiquetas</h1><p>Imprima, rastreie e audite etiquetas de caixas, documentos e padrões personalizados.</p></div><a class="ig-button ig-button--primary" asp-action="PrintWizard"><app-icon name="print" size="18" decorative="true" /> Iniciar impressão</a></section>
<partial name="Atlas/_PremiumAlert" view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { { "AlertTitle", "Validação antes da impressão" }, { "Message", "Confirme os dados e a escala da pré-visualização. Toda reimpressão exige justificativa para preservar a auditoria." }, { "Tone", "info" } }' />
<section class="ig-label-operation-grid" aria-label="Operações de etiquetas">@foreach(var card in cards){<partial name="Atlas/_LabelOperationCard" view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { { "Icon", card.Icon }, { "AlertTitle", card.Title }, { "Description", card.Description }, { "Url", card.Url }, { "Action", card.Action }, { "Status", card.Status } }' />}</section></div>
