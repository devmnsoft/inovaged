@{ ViewData["Title"]="Central de Etiquetas"; ViewData["WorkspaceVariant"]="wide"; ViewData["LabelHelpContext"]="CENTRAL";
var actions=new[]{
("printer","Imprimir etiqueta","Crie uma etiqueta para uma caixa, documento, pasta, prontuário ou processo.",Url.Action("PrintWizard")!,"Nova impressão"),
("layers","Imprimir em lote","Imprima várias etiquetas em uma única operação.",Url.Action("BatchPrint")!,"Preparar lote"),
("layout-template","Modelos de etiqueta","Crie e personalize os modelos usados pela sua organização.",Url.Action("Index","LabelDesigner")!,"Gerenciar modelos"),
("history","Histórico e rastreabilidade","Consulte etiquetas emitidas, reimpressões e rastreabilidade.",Url.Action("History")!,"Consultar histórico")}; }
@section Styles { <link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/labels-studio.css" asp-append-version="true" /> }
<main class="labels-page"><header class="labels-hero"><div><span class="labels-eyebrow"><app-icon name="tag" size="16" decorative="true" /> Operação de etiquetas</span><h1>Central de Etiquetas</h1><p>Escolha o que deseja fazer. Configurações e ferramentas especiais ficam disponíveis quando necessário.</p></div><partial name="Shared/_LabelHelpDrawer" /></header>
<section aria-labelledby="main-actions"><div class="labels-section-heading"><div><span>Comece aqui</span><h2 id="main-actions">O que você deseja fazer?</h2></div></div><div class="labels-action-grid labels-action-grid--primary">@foreach(var card in actions){<article class="labels-action-card"><span class="labels-action-card__icon"><app-icon name="@card.Item1" size="25" decorative="true" /></span><h3>@card.Item2</h3><p>@card.Item3</p><a href="@card.Item4" class="ig-button ig-button--secondary">@card.Item5 <app-icon name="arrow-right" size="15" decorative="true" /></a></article>}</div></section>
<details class="labels-settings"><summary><app-icon name="settings" size="18" decorative="true" /> Configurações</summary><nav aria-label="Configurações de etiquetas"><a href="/Administration/PrintBranding">Identidade visual</a><a asp-action="Calibration">Calibração da impressora</a><a asp-action="Scanner">Scanner QR</a><a asp-action="Quality">Qualidade de impressão</a><a asp-action="LocDesk">Modelos antigos (LocDesk/HOL)</a><a asp-action="Demo">Ferramentas de homologação</a></nav></details></main>
@section Scripts { <script src="~/js/labels-help.js" asp-append-version="true"></script> }
