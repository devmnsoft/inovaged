@using InovaGed.Application.Labels.Printing
@{ ViewData["Title"]="Etiquetas"; ViewData["WorkspaceVariant"]="wide"; ViewData["LabelHelpContext"]="CENTRAL"; var metrics=(LabelPrintQueueMetrics)ViewBag.Metrics; }
@section Styles { <link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/labels-operations-rc40.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" /> }
<main class="labels-page labels-operations">
 <header class="labels-hero labels-hero--tasks"><div><span class="labels-eyebrow"><app-icon name="tag" size="16" decorative="true" /> Modelos e impressão</span><h1>Etiquetas</h1><p>Crie modelos visuais e imprima etiquetas para documentos, caixas e lotes.</p></div><div class="labels-hero-actions"><a class="ig-button ig-button--primary" asp-action="PrintWizard"><app-icon name="printer" size="18" decorative="true" /> Imprimir etiquetas</a><a class="ig-button ig-button--secondary" asp-controller="LabelDesigner" asp-action="New"><app-icon name="edit" size="18" decorative="true" /> Criar modelo no editor visual</a></div></header>
 <nav class="labels-primary-nav" aria-label="Navegação de etiquetas"><a asp-controller="LabelDesigner" asp-action="Index"><app-icon name="layout-template" size="18" decorative="true" /><span><strong>Meus modelos</strong><small>Crie e abra modelos no Canvas</small></span></a><a asp-action="PrintQueue"><app-icon name="printer" size="18" decorative="true" /><span><strong>Fila de impressão</strong><small>Acompanhe impressões e falhas</small></span></a><partial name="Shared/_LabelHelpDrawer" /></nav>
 @if (ViewBag.MetricsAvailable is false) { <div class="alert alert-warning" role="status">Indicadores temporariamente indisponíveis.</div> }
 <details class="labels-operational-summary"><summary>Ver resumo operacional</summary><section class="label-operation-kpis" aria-label="Status operacional"><a asp-action="PrintQueue"><small>Aguardando impressão</small><strong>@metrics.Awaiting</strong></a><a asp-action="PrintQueue" asp-route-status="ERROR"><small>Com erro</small><strong>@metrics.Errors</strong></a><a asp-action="PrintQueue" asp-route-status="PRINTED"><small>Impressas hoje</small><strong>@metrics.PrintedToday</strong></a><a asp-controller="LabelDesigner" asp-action="Index"><small>Modelos publicados</small><strong>@ViewBag.PublishedTemplates</strong></a></section></details>
 <section class="label-operation-group" aria-labelledby="create-print"><div class="labels-section-heading"><div><span>Impressões</span><h2 id="create-print">Escolha como imprimir</h2></div></div><div class="labels-action-grid"><partial name="_OperationsCard" model='new[]{"printer","Imprimir etiquetas","Escolha os registros, o modelo e confira antes de gerar.",Url.Action("PrintWizard")!}'/><partial name="_OperationsCard" model='new[]{"layers","Imprimir um lote","Selecione e confira várias etiquetas com segurança.",Url.Action("BatchPrint")!}'/></div></section>
 <section class="label-operation-group" aria-labelledby="design-config"><div class="labels-section-heading"><div><span>Modelos</span><h2 id="design-config">Crie ou edite o desenho</h2></div></div><div class="labels-action-grid"><partial name="_OperationsCard" model='new[]{"layout-template","Meus modelos","Veja prévias e abra um modelo no editor visual (Canvas).",Url.Action("Index","LabelDesigner")!}'/></div></section>
 <section class="label-operation-group" aria-labelledby="follow"><div class="labels-section-heading"><div><span>Governança</span><h2 id="follow">Acompanhar</h2></div><a asp-action="Quality" class="ig-button ig-button--secondary">Ver qualidade</a></div><div class="labels-action-grid"><partial name="_OperationsCard" model='new[]{"printer","Central de impressão","Acompanhe filas, falhas e reimpressões.",Url.Action("PrintQueue")!}'/><partial name="_OperationsCard" model='new[]{"history","Histórico","Veja quem imprimiu e quando.",Url.Action("History")!}'/><partial name="_OperationsCard" model='new[]{"search","Rastreabilidade","Descubra qual etiqueta está válida agora.",Url.Action("TraceIndex")!}'/><partial name="_OperationsCard" model='new[]{"scanner","Scanner","Opere leitores USB em modo contínuo.",Url.Action("Scanner")!}'/></div></section>
 <details class="labels-settings"><summary><app-icon name="settings" size="18" decorative="true" /> Configurações de impressão</summary><nav aria-label="Configurações de impressão"><a href="/Administration/PrintBranding">Identidade visual</a><a asp-action="Calibration">Calibração</a><a asp-action="LocDesk">Modelos antigos (LocDesk/HOL)</a></nav></details>
</main>
@section Scripts { <script src="~/js/labels-help.js" asp-append-version="true"></script> }
