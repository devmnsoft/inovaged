@using InovaGed.Application.Labels.Printing
@{ ViewData["Title"]="Central de Etiquetas"; ViewData["WorkspaceVariant"]="wide"; ViewData["LabelHelpContext"]="CENTRAL"; var metrics=(LabelPrintQueueMetrics)ViewBag.Metrics; }
@section Styles { <link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/labels-operations-rc40.css" asp-append-version="true" /> }
<main class="labels-page labels-operations">
 <header class="labels-hero"><div><span class="labels-eyebrow"><app-icon name="tag" size="16" decorative="true" /> Workspace operacional</span><h1>Central de Etiquetas</h1><p>Crie, valide, imprima e acompanhe cada etiqueta em um fluxo integrado.</p></div><partial name="Shared/_LabelHelpDrawer" /></header>
 <section class="label-operation-kpis" aria-label="Status operacional"><a asp-action="PrintQueue"><small>Aguardando impressão</small><strong>@metrics.Awaiting</strong></a><a asp-action="PrintQueue" asp-route-status="ERROR"><small>Com erro</small><strong>@metrics.Errors</strong></a><a asp-action="PrintQueue" asp-route-status="PRINTED"><small>Impressas hoje</small><strong>@metrics.PrintedToday</strong></a><a asp-controller="LabelDesigner" asp-action="Index"><small>Modelos publicados</small><strong>@ViewBag.PublishedTemplates</strong></a></section>
 <section class="label-operation-group" aria-labelledby="create-print"><div class="labels-section-heading"><div><span>Operação</span><h2 id="create-print">Criar e imprimir</h2></div></div><div class="labels-action-grid"><partial name="_OperationsCard" model='new[]{"printer","Nova impressão","Prepare uma etiqueta com prévia e validações.",Url.Action("PrintWizard")!}'/><partial name="_OperationsCard" model='new[]{"layers","Impressão em lote","Selecione e confira várias etiquetas com segurança.",Url.Action("BatchPrint")!}'/></div></section>
 <section class="label-operation-group" aria-labelledby="design-config"><div class="labels-section-heading"><div><span>Preparação</span><h2 id="design-config">Design e configuração</h2></div></div><div class="labels-action-grid"><partial name="_OperationsCard" model='new[]{"layout-template","Modelos","Gerencie layouts e versões publicadas.",Url.Action("Index","LabelDesigner")!}'/><partial name="_OperationsCard" model='new[]{"workspace","Identidade visual","Configure marcas usadas na impressão.","/Administration/PrintBranding"}'/><partial name="_OperationsCard" model='new[]{"settings","Calibração","Valide papel, margens e escala da impressora.",Url.Action("Calibration")!}'/></div></section>
 <section class="label-operation-group" aria-labelledby="follow"><div class="labels-section-heading"><div><span>Governança</span><h2 id="follow">Acompanhar</h2></div><a asp-action="Quality" class="ig-button ig-button--secondary">Ver qualidade</a></div><div class="labels-action-grid"><partial name="_OperationsCard" model='new[]{"printer","Central de impressão","Acompanhe filas, falhas e reimpressões.",Url.Action("PrintQueue")!}'/><partial name="_OperationsCard" model='new[]{"history","Histórico","Veja quem imprimiu e quando.",Url.Action("History")!}'/><partial name="_OperationsCard" model='new[]{"search","Rastreabilidade","Descubra qual etiqueta está válida agora.",Url.Action("TraceIndex")!}'/><partial name="_OperationsCard" model='new[]{"scanner","Scanner","Opere leitores USB em modo contínuo.",Url.Action("Scanner")!}'/></div></section>
 <details class="labels-settings"><summary><app-icon name="settings" size="18" decorative="true" /> Mais</summary><nav aria-label="Mais opções"><span>Compatibilidade</span><a asp-action="LocDesk">Modelos antigos (LocDesk/HOL)</a></nav></details>
</main>
@section Scripts { <script src="~/js/labels-help.js" asp-append-version="true"></script> }
