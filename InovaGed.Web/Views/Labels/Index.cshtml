@{ ViewData["Title"]="Central de Impressão de Etiquetas"; }
<style>.label-hero{background:linear-gradient(135deg,#102a43,#176b87);color:#fff;border-radius:1.25rem}.label-card{transition:.2s;border:0;border-radius:1rem}.label-card:hover{transform:translateY(-3px);box-shadow:0 1rem 2rem rgba(15,23,42,.12)!important}.label-icon{width:3rem;height:3rem;border-radius:.8rem;background:#e8f2ff;display:grid;place-items:center;color:#176b87}</style>
<section class="label-hero p-4 p-lg-5 mb-4"><div class="text-uppercase small opacity-75 fw-semibold">InovaGED · rastreabilidade</div><h1 class="h2 mt-2">Central de Impressão de Etiquetas</h1><p class="mb-0 opacity-75">Escolha o padrão, personalize os campos, gere QR Code e imprima etiquetas com rastreabilidade.</p></section>
<div class="row g-4">
@foreach(var card in new[]{("archive","Imprimir etiqueta de caixa","Selecione uma caixa física e use o padrão do sistema ou um modelo personalizado.","Boxes","Selecionar caixa"),("document","Imprimir etiqueta de documento/pasta","Identifique documentos e pastas com QR Code e histórico auditável.","Documents","Selecionar documento"),("print","Impressão em lote","Monte um lote, escolha uma vez o modo e registre cada etiqueta.","BatchPrint","Montar lote de impressão"),("tag","Fila de impressão","Revise, gere o arquivo e acompanhe cada job operacional.","PrintQueue","Abrir fila"),("settings","Calibração","Ajuste margens, escala e dimensões para cada impressora.","Calibration","Calibrar impressão"),("history","Histórico de impressões","Consulte usuário, template, reimpressões, hash e snapshot.","History","Ver histórico"),("search","Rastreio de etiquetas","Leia QR Codes, faça inventários e trate divergências.","Tracking","Abrir rastreio"),("chart","Inteligência de Etiquetas","Monitore KPIs, alertas, divergências e cadeia de custódia.","Intelligence","Ver painel")}) {
<div class="col-md-6 col-xl-4"><div class="card label-card shadow-sm h-100"><div class="card-body p-4 d-flex flex-column"><div class="label-icon mb-3"><app-icon name="@card.Item1"></app-icon></div><h2 class="h5">@card.Item2</h2><p class="text-muted flex-grow-1">@card.Item3</p>@if(card.Item4=="Tracking"){<a class="btn btn-primary align-self-start" href="/LabelTracking">@card.Item5</a>}else if(card.Item4=="Intelligence"){<a class="btn btn-primary align-self-start" href="/LabelIntelligence">@card.Item5</a>}else{<a class="btn btn-primary align-self-start" asp-action="@card.Item4">@card.Item5</a>}</div></div></div> }
</div>
