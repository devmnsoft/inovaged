@model IReadOnlyList<InovaGed.Application.Labels.Printing.LabelPrintJobListItem>
@using InovaGed.Application.Labels.Printing
@{
    ViewData["Title"] = "Central de Impressão";
    var filter = (LabelPrintJobFilter)ViewBag.Filter;
    var metrics = (LabelPrintQueueMetrics)ViewBag.Metrics;
    string Badge(string status) => status switch { "PRINTED" => "success", "ERROR" => "danger", "CANCELLED" => "secondary", "PDF_GENERATED" => "info", "READY_TO_PRINT" => "primary", _ => "warning" };
}
<section class="mb-4 border-bottom pb-4">
    <nav aria-label="Breadcrumb"><ol class="breadcrumb small"><li class="breadcrumb-item"><a asp-action="Index">Etiquetas</a></li><li class="breadcrumb-item active">Central de impressão</li></ol></nav>
    <div class="d-flex flex-wrap justify-content-between gap-3 align-items-end">
        <div><h1 class="h2 mb-1">Central de Impressão</h1><p class="text-muted mb-0">Acompanhe, valide e controle as emissões de etiquetas.</p></div>
        <div class="d-flex gap-2"><a class="btn btn-primary" asp-action="PrintWizard">Nova impressão</a><a class="btn btn-outline-primary" asp-action="BatchPrint">Impressão em lote</a></div>
    </div>
</section>
<div class="row g-3 mb-4" aria-label="Indicadores da fila">
@foreach (var item in new[] { ("Aguardando", metrics.Awaiting, "warning"), ("Prontas", metrics.Ready, "primary"), ("Impressas hoje", metrics.PrintedToday, "success"), ("Com erro", metrics.Errors, "danger"), ("Reimpressões", metrics.Reprints, "dark") })
{ <div class="col-6 col-lg"><div class="card h-100"><div class="card-body py-3"><small class="text-muted">@item.Item1</small><div class="h3 text-@item.Item3 mb-0">@item.Item2</div></div></div></div> }
</div>
<form method="get" class="card card-body mb-4" aria-label="Filtros da central">
    <div class="row g-2">
        <div class="col-md-3"><label class="form-label" for="Search">Busca geral</label><input class="form-control" id="Search" name="Search" value="@filter.Search" placeholder="Job, controle ou modelo"></div>
        <div class="col-md"><label class="form-label" for="From">De</label><input class="form-control" id="From" type="date" name="From" value="@filter.From?.ToString("yyyy-MM-dd")"></div>
        <div class="col-md"><label class="form-label" for="To">Até</label><input class="form-control" id="To" type="date" name="To" value="@filter.To?.ToString("yyyy-MM-dd")"></div>
        <div class="col-md"><label class="form-label" for="Status">Status</label><select class="form-select" id="Status" name="Status"><option value="">Todos</option>@foreach(var status in new[]{"PENDING","PREVIEWED","READY_TO_PRINT","PDF_GENERATED","PRINTED","CANCELLED","ERROR"}){<option value="@status" selected="@(filter.Status==status)">@LabelPrintStatusDisplay.Humanize(status)</option>}</select></div>
        <div class="col-md"><label class="form-label" for="SubjectType">Tipo</label><select class="form-select" id="SubjectType" name="SubjectType"><option value="">Todos</option><option value="BOX" selected="@(filter.SubjectType=="BOX")">Caixa física</option><option value="DOCUMENT" selected="@(filter.SubjectType=="DOCUMENT")">Documento</option></select></div>
        <div class="col-md-auto d-flex align-items-end"><button type="submit" class="btn btn-outline-primary">Aplicar filtros</button></div>
    </div>
</form>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Impressão</th><th>Modelo</th><th>Origem</th><th>Solicitante</th><th>Data/hora</th><th>Status</th><th>Itens</th><th class="text-end">Ações</th></tr></thead><tbody>
@foreach(var job in Model){<tr><td><a asp-action="PrintJob" asp-route-id="@job.Id" class="fw-semibold">@job.JobNumber</a>@if(!string.IsNullOrWhiteSpace(job.ReprintReason)){<div><span class="badge text-bg-dark">Reimpressão</span></div>}</td><td>@(job.TemplateName??job.TemplateCode)</td><td>@(job.SubjectType=="BOX"?"Caixa física":job.SubjectType=="DOCUMENT"?"Documento":"Outra")<div class="small text-muted">@job.ControlNumber</div></td><td>@(job.RequestedByName??"Não informado")</td><td>@job.RequestedAt.ToLocalTime().ToString("g")</td><td><span class="badge text-bg-@Badge(job.Status)">@LabelPrintStatusDisplay.Humanize(job.Status)</span></td><td>@job.ItemCount × @job.Copies</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="PrintJob" asp-route-id="@job.Id">Abrir</a> <a class="btn btn-sm btn-outline-secondary" asp-action="PrintPreview" asp-route-id="@job.Id">Prévia</a>@if(job.Status is "READY_TO_PRINT" or "PDF_GENERATED"){<a class="btn btn-sm btn-outline-secondary" asp-action="GeneratePdf" asp-route-id="@job.Id">Artefato</a>}</td></tr>}
@if(Model.Count==0){<tr><td colspan="8" class="text-center text-muted p-5">Nenhuma impressão encontrada para os filtros informados.</td></tr>}
</tbody></table></div></div>
<nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Paginação"><span class="small text-muted">Página @filter.Page · @metrics.Total emissões</span><div class="btn-group"><a class="btn btn-outline-secondary @(filter.Page<=1?"disabled":"")" asp-route-page="@(filter.Page-1)" asp-route-pageSize="@filter.PageSize" asp-route-status="@filter.Status" asp-route-search="@filter.Search">Anterior</a><a class="btn btn-outline-secondary @(Model.Count<filter.PageSize?"disabled":"")" asp-route-page="@(filter.Page+1)" asp-route-pageSize="@filter.PageSize" asp-route-status="@filter.Status" asp-route-search="@filter.Search">Próxima</a></div></nav>
<aside class="alert alert-light border mt-4"><strong>Como funciona</strong><ol class="mb-0 mt-2"><li>Crie uma impressão.</li><li>Confira a prévia.</li><li>Gere o artefato.</li><li>Confirme a impressão física.</li></ol></aside>
