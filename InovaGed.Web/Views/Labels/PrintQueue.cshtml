@model IReadOnlyList<InovaGed.Application.Labels.Printing.LabelPrintJobListItem>
@using InovaGed.Application.Labels.Printing
@{ViewData["Title"]="Central de Impressão";var filter=(LabelPrintJobFilter)ViewBag.Filter;var metrics=(LabelPrintQueueMetrics)ViewBag.Metrics;var actionMap=(IReadOnlyDictionary<Guid,IReadOnlyList<LabelPrintJobActionDto>>)ViewBag.JobActions;string Badge(string status)=>status switch{"PRINTED"=>"success","ERROR"=>"danger","CANCELLED"=>"secondary","PDF_GENERATED"=>"info","READY_TO_PRINT"=>"primary",_=>"warning"};string QueryWithout(string key){var q=Context.Request.Query.Where(x=>!x.Key.Equals(key,StringComparison.OrdinalIgnoreCase)).SelectMany(x=>x.Value.Select(v=>$"{Uri.EscapeDataString(x.Key)}={Uri.EscapeDataString(v!)}"));return "?"+string.Join("&",q);}}
@if (ViewBag.MetricsAvailable is false) { <div class="alert alert-warning" role="status">Indicadores temporariamente indisponíveis.</div> }
@section Styles { <link rel="stylesheet" href="~/css/labels-operations-rc40.css" asp-append-version="true" /> }
<header class="label-job-header"><div><a asp-action="Index">Etiquetas</a><h1>Central de Impressão</h1><p>Acompanhe, valide e controle as emissões.</p></div><div><a class="btn btn-primary" asp-action="PrintWizard">Nova impressão</a> <a class="btn btn-outline-primary" asp-action="BatchPrint">Impressão em lote</a></div></header>
<section class="label-operation-kpis" aria-label="Indicadores da fila">@foreach(var item in new[]{("Aguardando",metrics.Awaiting),("Prontas",metrics.Ready),("Impressas hoje",metrics.PrintedToday),("Com erro",metrics.Errors)}){<a asp-action="PrintQueue"><small>@item.Item1</small><strong>@item.Item2</strong></a>}</section>
<form method="get" class="card card-body mb-3" aria-label="Filtros da central" data-print-queue><details class="print-filter-panel" open><summary class="d-md-none btn btn-outline-secondary">Filtros</summary><div class="row g-2 print-filter-fields"><div class="col-md-3"><label class="form-label" for="Search">Busca</label><input class="form-control" id="Search" name="Search" value="@filter.Search" placeholder="Job, controle ou modelo"></div><div class="col-md"><label class="form-label" for="From">De</label><input class="form-control" id="From" type="date" name="From" value="@filter.From?.ToString("yyyy-MM-dd")"></div><div class="col-md"><label class="form-label" for="To">Até</label><input class="form-control" id="To" type="date" name="To" value="@filter.To?.ToString("yyyy-MM-dd")"></div><div class="col-md"><label class="form-label" for="Status">Status</label><select class="form-select" id="Status" name="Status"><option value="">Todos</option>@foreach(var status in new[]{"PENDING","PREVIEWED","READY_TO_PRINT","PDF_GENERATED","PRINTED","CANCELLED","ERROR"}){<option value="@status" selected="@(filter.Status==status)">@LabelPrintStatusDisplay.Humanize(status)</option>}</select></div><div class="col-md"><label class="form-label" for="Sort">Ordenação</label><select class="form-select" id="Sort" name="Sort"><option value="newest" selected="@(filter.Sort=="newest")">Mais recentes</option><option value="oldest" selected="@(filter.Sort=="oldest")">Mais antigos</option><option value="status" selected="@(filter.Sort=="status")">Status</option><option value="template" selected="@(filter.Sort=="template")">Modelo</option></select></div><div class="col-md-auto"><label class="form-label" for="PageSize">Por página</label><select class="form-select" id="PageSize" name="PageSize">@foreach(var size in new[]{25,50,100}){<option selected="@(filter.PageSize==size)">@size</option>}</select></div><div class="col-md-auto d-flex align-items-end gap-2"><button class="btn btn-primary">Aplicar</button><a class="btn btn-outline-secondary" asp-action="PrintQueue">Limpar filtros</a></div></div></details></form>
@if(!string.IsNullOrWhiteSpace(filter.Status)||filter.From.HasValue||filter.To.HasValue||!string.IsNullOrWhiteSpace(filter.Search)){<nav class="print-filter-chips" aria-label="Filtros aplicados">@if(!string.IsNullOrWhiteSpace(filter.Status)){<a href="@QueryWithout("Status")">Status: @LabelPrintStatusDisplay.Humanize(filter.Status) ×</a>}@if(filter.From.HasValue||filter.To.HasValue){<a asp-action="PrintQueue" asp-route-status="@filter.Status" asp-route-search="@filter.Search">Período: aplicado ×</a>}@if(!string.IsNullOrWhiteSpace(filter.Search)){<a href="@QueryWithout("Search")">Busca: @filter.Search ×</a>}</nav>}
<div class="card"><div class="table-responsive" style="max-height:65vh"><table class="table table-sm align-middle mb-0 print-queue-table"><thead class="bg-light"><tr><th>Impressão</th><th>Modelo</th><th>Origem</th><th>Solicitante</th><th>Data/hora</th><th>Status</th><th>Itens</th><th class="text-end">Ações</th></tr></thead><tbody>@foreach(var job in Model){var actions=actionMap[job.Id];<tr><td><a asp-action="PrintJob" asp-route-id="@job.Id" class="fw-semibold">@job.JobNumber</a></td><td>@(job.TemplateName??job.TemplateCode)</td><td>@(job.SubjectType=="BOX"?"Caixa física":job.SubjectType=="DOCUMENT"?"Documento":"Outra")<small class="d-block text-muted">@job.ControlNumber</small></td><td>@(job.RequestedByName??"Não informado")</td><td>@job.RequestedAt.ToLocalTime().ToString("g")</td><td><span class="badge text-bg-@Badge(job.Status)">@LabelPrintStatusDisplay.Humanize(job.Status)</span></td><td>@job.ItemCount × @job.Copies</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="PrintJob" asp-route-id="@job.Id">Abrir</a>@if(actions.Count>0){<details class="d-inline-block text-start"><summary class="btn btn-sm btn-outline-secondary" aria-label="Mais ações">•••</summary><div class="dropdown-menu show position-absolute">@foreach(var action in actions.Where(x=>x.Key!="cancel")){<a class="dropdown-item" asp-action="PrintJob" asp-route-id="@job.Id">@action.Label</a>}</div></details>}</td></tr>}@if(Model.Count==0){<tr><td colspan="8" class="text-center text-muted p-5">Nenhuma impressão encontrada.</td></tr>}</tbody></table></div></div>
<nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Paginação"><span>Página @filter.Page · @metrics.Total emissões</span><div class="btn-group"><a class="btn btn-outline-secondary @(filter.Page<=1?"disabled":"")" asp-route-page="@(filter.Page-1)" asp-route-pageSize="@filter.PageSize" asp-route-sort="@filter.Sort" asp-route-status="@filter.Status" asp-route-search="@filter.Search">Anterior</a><a class="btn btn-outline-secondary @(Model.Count<filter.PageSize?"disabled":"")" asp-route-page="@(filter.Page+1)" asp-route-pageSize="@filter.PageSize" asp-route-sort="@filter.Sort" asp-route-status="@filter.Status" asp-route-search="@filter.Search">Próxima</a></div></nav>
@section Scripts { <script src="~/js/labels-operations-rc40.js" asp-append-version="true"></script> }
