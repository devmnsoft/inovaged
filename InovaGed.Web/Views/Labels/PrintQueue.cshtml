@model IReadOnlyList<InovaGed.Application.Labels.Printing.LabelPrintJobListItem>
@using InovaGed.Application.Labels.Printing
@{ViewData["Title"]="Fila de impressão";var f=(LabelPrintJobFilter)ViewBag.Filter;string Badge(string s)=>s switch{"PRINTED"=>"success","ERROR"=>"danger","CANCELLED"=>"secondary","PDF_GENERATED"=>"info",_=>"warning"};}
<section class="p-4 rounded-4 text-white mb-4" style="background:linear-gradient(135deg,#102a43,#176b87)"><div class="d-flex flex-wrap justify-content-between gap-3"><div><div class="small text-uppercase opacity-75">Etiquetas · operação</div><h1 class="h2">Fila de impressão</h1><p class="mb-0">Crie uma fila de impressão para revisar antes de enviar para a impressora.</p></div><div class="d-flex gap-2 align-items-center"><a class="btn btn-light" asp-action="PrintWizard">Nova impressão</a><a class="btn btn-outline-light" asp-action="BatchPrint">Impressão em lote</a></div></div></section>
<div class="row g-3 mb-4">@foreach(var x in new[]{("Pendentes",Model.Count(j=>j.Status is "PENDING" or "PREVIEWED"),"warning"),("Geradas",Model.Count(j=>j.Status=="PDF_GENERATED"),"info"),("Concluídas",Model.Count(j=>j.Status=="PRINTED"),"success"),("Erros",Model.Count(j=>j.Status=="ERROR"),"danger"),("Reimpressões",Model.Count(j=>!string.IsNullOrWhiteSpace(j.ReprintReason)),"dark")}){<div class="col-6 col-lg"><div class="card border-0 shadow-sm"><div class="card-body"><span class="text-muted">@x.Item1</span><div class="h3 text-@x.Item3 mb-0">@x.Item2</div></div></div></div>}</div>
<form method="get" class="card card-body border-0 shadow-sm mb-4"><div class="row g-2"><div class="col-md"><input class="form-control" type="date" name="From" value="@f.From?.ToString("yyyy-MM-dd")" aria-label="Data inicial"></div><div class="col-md"><input class="form-control" name="TemplateCode" value="@f.TemplateCode" placeholder="Modelo"></div><div class="col-md"><input class="form-control" name="SubjectType" value="@f.SubjectType" placeholder="Tipo de origem"></div><div class="col-md"><input class="form-control" name="ControlNumber" value="@f.ControlNumber" placeholder="Número de controle"></div><div class="col-md"><select class="form-select" name="Status"><option value="">Todos os status</option>@foreach(var s in new[]{"PENDING","PREVIEWED","PDF_GENERATED","PRINTED","CANCELLED","ERROR"}){<option selected="@(f.Status==s)">@s</option>}</select></div><div class="col-md-auto"><button type="submit" class="btn btn-primary">Filtrar</button></div></div></form>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Job</th><th>Modelo/origem</th><th>Solicitação</th><th>Status</th><th>Itens</th><th class="text-end">Ações</th></tr></thead><tbody>@foreach(var j in Model){<tr><td><a asp-action="PrintJob" asp-route-id="@j.Id" class="fw-semibold">@j.JobNumber</a>@if(!string.IsNullOrWhiteSpace(j.ReprintReason)){<div><span class="badge text-bg-dark">Reimpressão</span></div>}</td><td>@(j.TemplateName??j.TemplateCode)<div class="small text-muted">@j.SubjectType · @j.ControlNumber</div></td><td>@j.RequestedAt.ToLocalTime().ToString("g")<div class="small text-muted">@j.RequestedByName</div></td><td><span class="badge text-bg-@Badge(j.Status)">@j.Status</span></td><td>@j.ItemCount × @j.Copies</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="PrintPreview" asp-route-id="@j.Id">Prévia</a> <a class="btn btn-sm btn-outline-secondary" asp-action="GeneratePdf" asp-route-id="@j.Id">HTML/PDF</a></td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="text-center text-muted p-5">Nenhum job encontrado.</td></tr>}</tbody></table></div></div>
