@model InovaGed.Web.Models.Labels.LabelStudioPreviewViewModel
@{ Layout = Model.PrintOnly ? "_PrintLayout" : "_Layout"; ViewData["Title"] = $"Prévia - {Model.Template.Name}"; var item=Model.Sample; }
@section Styles { <link rel="stylesheet" href="~/css/labels-studio.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/locdesk-label.css" asp-append-version="true" /> }
@if(!Model.PrintOnly){<nav class="label-template-preview-toolbar"><a asp-action="TemplateDetails" asp-route-code="@Model.Template.Code">Voltar ao modelo</a><a asp-action="TemplatePrintSample" asp-route-code="@Model.Template.Code" target="_blank">Imprimir amostra</a><span>Dados demonstrativos — não são salvos</span></nav>}
<main class="label-template-preview-stage @(Model.PrintOnly ? "label-template-sample-page" : "")"><article class="studio-real-label @(Model.Template.Code.Contains("HOL") ? "is-hol" : "")"><header><div><strong>@(Model.Template.Code.StartsWith("LOCDESK") ? "LocDesk" : "InovaGED")</strong><small>@(Model.Template.Code.StartsWith("LOCDESK") ? "ARQUIVO LOCDESCK ANANINDEUA" : "ETIQUETA DE IDENTIFICAÇÃO")</small></div>@if(Model.Template.Code.Contains("HOL")){<p>Contrato: <b>@item.Contract</b></p>}<p>N° Controle: <em>@item.ControlNumber</em> &nbsp; Vol.: <em>@item.VolumeNumber/@item.VolumeTotal</em></p></header><dl><div><dt>Assunto:</dt><dd>@item.Subject</dd></div><div><dt>Detalhamento:</dt><dd>@item.Details</dd></div><div><dt>Atividade:</dt><dd>@item.Activity</dd></div><div><dt>Classificação:</dt><dd>@item.Classification</dd></div><div><dt>Suporte:</dt><dd>@item.Support</dd></div><div><dt>Período do Documento:</dt><dd>@(Model.Template.Code.Contains("HOL") ? item.DocumentPeriod : item.DocumentPeriod)</dd></div><div><dt>Fase Atual:</dt><dd>@item.CurrentPhase</dd></div><div><dt>Previsão Eliminação:</dt><dd>@item.EliminationForecast</dd></div><div><dt>Situação Eliminação:</dt><dd>@item.EliminationStatus</dd></div><div><dt>Nº LED:</dt><dd>@item.LedNumber</dd></div><div class="location"><dt>LOCALIZAÇÃO:</dt><dd>@item.Location</dd></div></dl></article></main>
