@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@model InovaGed.Application.Labels.Printing.LabelPrintJobDetails
@{ Layout=null; var canvasHtml=Convert.ToString(ViewBag.CanvasHtml)??string.Empty; }
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Prévia @Model.JobNumber</title><style>body{margin:0;background:#e7edf2;font-family:Arial,sans-serif;color:#172b4d}.toolbar{position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:12px 20px;background:#102a43;color:#fff}.toolbar a,.toolbar button{border:0;border-radius:6px;padding:9px 14px;text-decoration:none;background:#fff;color:#102a43;cursor:pointer}.toolbar .primary{background:#21a179;color:#fff}.job{margin-left:auto}.canvas-frame{width:100%;min-height:calc(100vh - 64px);border:0;background:#fff}@@media print{.toolbar{display:none}.canvas-frame{min-height:100vh}}</style></head><body><header class="toolbar"><a href="@Url.Action("PrintQueue")">Voltar</a><a href="@Url.Action("PrintJob",new{id=Model.Id})">Job @Model.JobNumber</a><span>Status: @Model.Status</span><button type="button" onclick="document.querySelector('.canvas-frame').contentWindow.print()">Imprimir agora</button><a href="@Url.Action("GeneratePdf",new{id=Model.Id})">Baixar HTML</a><form method="post" action="@Url.Action("MarkPrinted",new{id=Model.Id})"><input name="__RequestVerificationToken" type="hidden" value="@Antiforgery.GetAndStoreTokens(Context).RequestToken"><button type="submit" class="primary">Marcar como impresso</button></form></header><iframe class="canvas-frame" title="Prévia da etiqueta" srcdoc="@canvasHtml"></iframe></body></html>
