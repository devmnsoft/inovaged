@{ViewData["Title"]="Qualidade do QR Code";}
<link rel="stylesheet" href="~/css/labels-traceability.css"/><main class="label-qr-quality-page"><section class="atlas-page-hero"><div><span>Validação visual</span><h1>Qualidade do QR Code</h1><p>Confere legibilidade, quiet zone e ausência de identificadores sensíveis.</p></div></section><form method="post" class="atlas-card">@Html.AntiForgeryToken()<label>Modelo</label><input name="templateCode" required/><label><input type="checkbox" name="hasQr" value="true"/> QR presente</label><label>Tamanho (mm)</label><input type="number" name="sizeMm" min="0" step="0.1" required/><label><input type="checkbox" name="hasQuietZone" value="true"/> Quiet zone preservada</label><label>URL de amostra</label><input name="sampleUrl" required placeholder="/l/token-seguro"/><button class="atlas-btn atlas-btn-primary">Validar QR</button></form></main>
