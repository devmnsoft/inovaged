@model dynamic
@{ ViewData["Title"]="Rastreabilidade da etiqueta"; }
<main class="label-trace-page"><header class="atlas-page-hero"><div><span>Rastreabilidade</span><h1>Etiqueta @Model.control_number</h1><p>Histórico operacional e vínculo com a origem.</p></div></header>
<div class="row g-4"><section class="col-lg-7"><div class="card"><div class="card-body"><h2 class="h5">Resumo</h2><dl class="row mb-0"><dt class="col-sm-4">Tipo</dt><dd class="col-sm-8">@Model.label_kind</dd><dt class="col-sm-4">Volume</dt><dd class="col-sm-8">@Model.volume_number / @Model.volume_total</dd><dt class="col-sm-4">Assunto</dt><dd class="col-sm-8">@Model.subject</dd><dt class="col-sm-4">Classificação</dt><dd class="col-sm-8">@Model.classification</dd><dt class="col-sm-4">Localização</dt><dd class="col-sm-8"><strong>@Model.location</strong></dd></dl></div></div></section>
<section class="col-lg-5"><div class="card"><div class="card-body"><h2 class="h5">Timeline da etiqueta</h2><ol class="label-trace-timeline"><li><strong>Criada</strong><span>@Model.created_at</span></li><li><strong>Emitida</strong><span>Identidade registrada</span></li><li><strong>Lida</strong><span>Leituras aparecem quando realizadas</span></li><li><strong>Reimpressa, substituída ou revogada</strong><span>Eventos exibidos quando aplicáveis</span></li></ol></div></div></section></div></main>
