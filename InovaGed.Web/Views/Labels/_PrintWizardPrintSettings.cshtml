@model InovaGed.Web.Models.Labels.LabelPrintWizardInputModel
@{var profiles=ViewBag.PrintProfiles as IReadOnlyList<InovaGed.Web.Models.Labels.LabelPrintProfileInput> ?? Array.Empty<InovaGed.Web.Models.Labels.LabelPrintProfileInput>();}
<section class="label-wizard-card" data-wizard-step="4"><header class="label-wizard-card__header"><h2><span>4</span> Configurar impressão</h2><p>Informe as cópias e use calibração somente quando necessário.</p></header><div class="label-wizard-card__body label-origin-grid"><label>Cópias<input asp-for="Copies" class="form-control" type="number" min="1" max="500"/></label><label>Perfil de impressão<select asp-for="PrintProfileId" class="form-select"><option value="">Padrão da impressora</option>@foreach(var p in profiles){<option value="@p.Id">@p.ProfileName</option>}</select></label><label class="label-reprint-reason">Justificativa de reimpressão<textarea asp-for="ReprintReason" rows="2" placeholder="Preencha somente ao emitir uma nova via"></textarea></label></div></section>
