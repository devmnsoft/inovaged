@model InovaGed.Web.Models.Labels.LabelStudioTemplate
@{ ViewData["Title"] = Model.Name; }
@section Styles { <link rel="stylesheet" href="~/css/labels-studio.css" asp-append-version="true" /> }
<main class="labels-studio-page"><header class="labels-studio-hero"><div><span class="labels-studio-kicker">Detalhe do modelo</span><h1>@Model.Name</h1><p>@Model.Description</p><code>@Model.Code</code></div><a class="ig-button ig-button--secondary" asp-action="Templates">Todos os modelos</a></header>
<section class="label-template-detail"><article><h2>Especificação</h2><dl><div><dt>Origem</dt><dd>@Model.SubjectType</dd></div><div><dt>Modo</dt><dd>@Model.Mode</dd></div><div><dt>View Razor</dt><dd>@($"{Model.ViewName}.cshtml")</dd></div><div><dt>Versão</dt><dd>@Model.Version</dd></div><div><dt>Dimensões aproximadas</dt><dd>@Model.Dimensions</dd></div><div><dt>Suporta lote?</dt><dd>@(Model.SupportsBatch ? "Sim" : "Não")</dd></div><div><dt>Campos manuais?</dt><dd>@(Model.AllowsManualFields ? "Sim" : "Não")</dd></div><div><dt>Modelo do sistema?</dt><dd>@(Model.IsSystem ? "Sim" : "Não")</dd></div><div><dt>Padrão?</dt><dd>@(Model.IsDefault ? "Sim" : "Não")</dd></div></dl></article><article><h2>Campos esperados</h2><ul class="label-template-field-list">@foreach(var field in Model.Fields){<li><app-icon name="tag" size="14" decorative="true" /> @field</li>}</ul></article></section>
<nav class="label-template-preview-toolbar" aria-label="Ações do modelo"><a asp-action="PrintWizard" asp-route-templateCode="@Model.Code">Usar no PrintWizard</a><a asp-action="TemplatePreview" asp-route-code="@Model.Code">Pré-visualizar</a><a asp-action="TemplatePrintSample" asp-route-code="@Model.Code" target="_blank">Imprimir amostra</a><a asp-action="History" asp-route-template="@Model.Code">Histórico filtrado</a><a asp-action="Calibration">Calibração</a><form method="post" asp-action="SetStudioDefault" asp-route-code="@Model.Code"><button type="submit">Definir como padrão</button></form></nav>
</main>
