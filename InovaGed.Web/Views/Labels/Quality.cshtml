@model IReadOnlyList<InovaGed.Web.Models.Labels.LabelQualityRow>
@{ViewData["Title"]="Qualidade visual das etiquetas";}
@section Styles{<link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true"/>}
<main class="label-fidelity-page"><header class="atlas-page-hero"><div><span class="labels-eyebrow">Checklist homologado</span><h1>Qualidade visual das etiquetas</h1><p>Valide legibilidade, dimensões, QR Code, campos obrigatórios e limpeza do modo de impressão.</p></div><form method="post" action="/Labels/Quality/Validate">@Html.AntiForgeryToken()<button type="submit" class="ig-button ig-button--primary">Validar modelos agora</button></form></header><section class="label-fidelity-card"><div class="label-quality-grid">@foreach(var row in Model){<article><header><div><strong>@row.TemplateName</strong><small>@row.TemplateCode</small></div><span class="quality-ok">Aprovado</span></header><ul>@foreach(var check in row.Checks){<li>✓ @check</li>}</ul>@if(row.TemplateCode=="LOCDESK_PASTA_HOL_V1"){<div class="quality-contract"><strong>Contrato: Hosp. Ophir Loyola</strong><b>N° Controle em vermelho</b><span>LOCALIZAÇÃO em destaque</span><em>ARQUIVO LOCDESCK ANANINDEUA</em></div>}</article>}</div></section></main>
