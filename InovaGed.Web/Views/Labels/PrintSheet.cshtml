@model InovaGed.Web.Models.Labels.LabelSheetInput
@{ViewData["Title"]="Prévia de folha A4";var profiles=ViewBag.Profiles as IReadOnlyList<InovaGed.Web.Models.Labels.LabelPrintProfileInput>??[];}
@section Styles{<link rel="stylesheet" href="~/css/labels-print.css" asp-append-version="true"/>}
<main class="label-fidelity-page"><header class="atlas-page-hero"><div><span class="labels-eyebrow">Impressão fiel</span><h1>Prévia de folha A4</h1><p>Monte a folha, confira margens, espaçamento e perfil antes de consumir papel.</p></div></header><section class="label-fidelity-card"><form method="post" action="/Labels/PrintSheet/Preview">@Html.AntiForgeryToken()<div class="label-profile-form"><label>Modelo<select asp-for="TemplateCode"><option>FACTORY_BOX_V1</option><option>FACTORY_DOCUMENT_V1</option><option>LOCDESK_CAIXA_V1</option><option>LOCDESK_PASTA_V1</option><option>LOCDESK_PASTA_HOL_V1</option></select></label><label>Perfil de calibração<select asp-for="ProfileId"><option value="">Perfil padrão automático</option>@foreach(var p in profiles){<option value="@p.Id">@p.ProfileName @(p.IsDefault?"(padrão)":"")</option>}</select></label><label>Quantidade<input asp-for="Quantity" type="number" min="1" max="100"/></label><label>Largura da etiqueta (mm)<input asp-for="LabelWidthMm" type="number" step=".1"/></label><label>Altura da etiqueta (mm)<input asp-for="LabelHeightMm" type="number" step=".1"/></label></div><button type="submit" class="ig-button ig-button--primary">Gerar prévia</button></form></section></main>
