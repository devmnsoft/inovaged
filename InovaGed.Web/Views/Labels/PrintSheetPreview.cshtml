@model InovaGed.Web.Models.Labels.LabelSheetInput
@{Layout=null;var p=(InovaGed.Web.Models.Labels.LabelPrintProfileInput)ViewBag.Profile;var autoPrint=ViewBag.AutoPrint is true;}
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><title>Folha A4 · @Model.TemplateCode</title><link rel="stylesheet" href="~/css/labels-print.css"/></head><body class="label-sheet-preview-page"><header class="label-sheet-toolbar no-print"><a href="/Labels/PrintSheet">Configurar</a><button type="button" onclick="window.print()">Imprimir folha</button><div class="label-sheet-profile-summary"><strong>@p.ProfileName</strong><span>Margens @p.MarginTopMm / @p.MarginLeftMm mm · Offset @p.OffsetXMm / @p.OffsetYMm mm · Escala @p.ScalePercent%</span></div></header><main class="label-sheet-print-page"><section class="label-sheet-a4" style="--label-offset-x-mm:@p.OffsetXMm;--label-offset-y-mm:@p.OffsetYMm;--label-scale:@(p.ScalePercent/100m);--label-margin-top-mm:@p.MarginTopMm;--label-margin-left-mm:@p.MarginLeftMm;--label-gap-x-mm:@p.LabelGapXMm;--label-gap-y-mm:@p.LabelGapYMm"><div class="label-sheet-margin-guide">Área útil calibrada</div><div class="label-sheet-grid">@for(var i=0;i<Model.Quantity;i++){<article class="label-sheet-slot" style="width:@(Model.LabelWidthMm)mm;height:@(Model.LabelHeightMm)mm"><div class="label-sheet-label"><strong>@Model.TemplateCode</strong><span>Etiqueta @(i+1)</span><b>LOCALIZAÇÃO</b><i>▦</i></div></article>}</div></section></main>@if(autoPrint){<script>window.addEventListener('load',()=>window.print())</script>}</body></html>
