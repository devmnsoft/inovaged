@model InovaGed.Web.Models.Labels.LabelPrintWizardInputModel
@{var profiles=ViewBag.PrintBrandingProfiles as IReadOnlyList<InovaGed.Web.Models.Branding.PrintBrandingProfileVm> ?? Array.Empty<InovaGed.Web.Models.Branding.PrintBrandingProfileVm>();}
<section class="label-wizard-card" data-wizard-step="3"><header class="label-wizard-card__header"><h2><span>3</span> Qual identidade visual?</h2><p>Se não selecionar uma opção, o sistema usará a configuração padrão.</p></header><div class="label-wizard-card__body"><input asp-for="LogoSelection" type="hidden"/><label asp-for="PrintBrandingProfileId">Perfil visual</label><select asp-for="PrintBrandingProfileId" class="form-select" id="print-branding-profile"><option value="">Configuração padrão</option>@foreach(var p in profiles){<option value="@p.Id">@p.ProfileName</option>}</select><dl class="label-wizard-summary"><div><dt>Cliente</dt><dd id="summary-branding-client">Configuração padrão</dd></div><div><dt>Contrato</dt><dd id="summary-branding-contract">—</dd></div><div><dt>Organização</dt><dd id="summary-branding-org">—</dd></div><div><dt>Logo</dt><dd id="summary-branding-logo">Padrão do modelo</dd></div></dl><details class="label-advanced-logo"><summary>Ajustes avançados da logo</summary><label asp-for="SelectedLogoAssetId">Logo manual</label><select asp-for="SelectedLogoAssetId" asp-items="Model.LogoOptions" class="form-select" id="selected-logo"><option value="">Usar logo do perfil</option></select><div class="label-config-grid"><label>Largura (mm)<input asp-for="LogoWidthMm" type="number" min="10" max="90" step=".1"/></label><label>Altura (mm)<input asp-for="LogoHeightMm" type="number" min="5" max="60" step=".1"/></label><label>Encaixe<select asp-for="LogoFitMode"><option value="CONTAIN">Mostrar inteira</option><option value="COVER">Preencher e recortar</option><option value="FILL">Preencher área</option></select></label><label>Posição<select asp-for="LogoPosition"><option value="TOP_LEFT">Superior esquerda</option><option value="TOP_CENTER">Superior centro</option><option value="TOP_RIGHT">Superior direita</option><option value="CENTER">Centro</option><option value="BOTTOM_LEFT">Inferior esquerda</option><option value="BOTTOM_CENTER">Inferior centro</option><option value="BOTTOM_RIGHT">Inferior direita</option></select></label><label>Ajuste horizontal<input asp-for="LogoOffsetXmm" type="number"/></label><label>Ajuste vertical<input asp-for="LogoOffsetYmm" type="number"/></label><label><input asp-for="PreserveAspectRatio"/> Manter proporção</label></div></details></div></section>
