@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@model InovaGed.Application.Labels.Printing.LabelPrintJobDetails
@{Layout=null;var labels=Model.Items.Count==0?new[]{new{Model.ControlNumber,Model.Location,Model.PayloadJson}}:Model.Items.Select(x=>new{x.ControlNumber,x.Location,x.PayloadJson});}
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Prévia @Model.JobNumber</title><style>*{box-sizing:border-box}body{margin:0;background:#e7edf2;font-family:Arial;color:#172b4d}.toolbar{position:sticky;top:0;z-index:2;background:#102a43;color:#fff;padding:12px 20px;display:flex;gap:8px;align-items:center;flex-wrap:wrap}.toolbar a,.toolbar button{border:0;border-radius:6px;padding:9px 14px;text-decoration:none;background:#fff;color:#102a43;cursor:pointer}.toolbar .primary{background:#21a179;color:white}.note{margin-left:auto}.sheet{background:white;width:210mm;min-height:297mm;margin:18px auto;padding:10mm;box-shadow:0 4px 25px #789;display:grid;grid-template-columns:repeat(2,1fr);align-content:start;gap:4mm}.label{border:1px solid #111;min-height:55mm;padding:6mm;display:flex;flex-direction:column;gap:3mm;overflow:hidden}.label strong{font-size:16pt}.label small{font-size:7pt;word-break:break-word}@@page{size:A4;margin:0}</style></head><body><header class="toolbar no-print"><a href="@Url.Action("PrintQueue")">← Voltar</a><button type="submit" onclick="window.print()">Imprimir pelo navegador</button><a href="@Url.Action("GeneratePdf",new{id=Model.Id})">Baixar HTML de impressão</a><form method="post" action="@Url.Action("MarkPrinted",new{id=Model.Id})"><input name="__RequestVerificationToken" type="hidden" value="@Antiforgery.GetAndStoreTokens(Context).RequestToken"><button type="submit" class="primary">Marcar como impresso</button></form><span class="note">A pré-visualização representa o tamanho real da folha A4.</span></header><main class="sheet">@foreach(var item in labels){for(var c=0;c<Model.Copies;c++){<article class="label"><strong>@(item.ControlNumber??Model.TemplateName??Model.TemplateCode)</strong><span>@item.Location</span><small>@item.PayloadJson</small></article>}}</main></body></html>
