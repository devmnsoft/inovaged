@model InovaGed.Web.Models.Labels.LabelPrintWizardInputModel
@{ var options=ViewBag.SubjectOptions as IReadOnlyList<InovaGed.Web.Models.SelectOptionViewModel> ?? Array.Empty<InovaGed.Web.Models.SelectOptionViewModel>(); }
<section class="label-wizard-card" data-wizard-step="1"><header class="label-wizard-card__header"><h2><span>1</span> O que será etiquetado?</h2><p>Escolha a finalidade e o registro que receberá a etiqueta.</p></header><div class="label-wizard-card__body label-origin-grid"><div><label asp-for="SubjectType">Finalidade</label><select asp-for="SubjectType" class="form-select" id="subject"><option value="BOX">Caixa</option><option value="DOCUMENT">Documento ou pasta</option><option value="BATCH">Lote</option><option value="MANUAL_LABEL">Etiqueta avulsa</option></select></div><div><label asp-for="SubjectId">Origem</label><select asp-for="SubjectId" class="form-select"><option value="">Selecione pelo nome ou código</option>@foreach(var option in options){<option value="@option.Value">@option.Label</option>}</select><span asp-validation-for="SubjectId" class="text-danger"></span></div></div></section>
