@model InovaGed.Web.Models.Labels.LabelCanvasDesignerPageViewModel
<dialog class="designer-validation" data-validation-dialog aria-labelledby="validation-title"><form method="dialog"><header><h2 id="validation-title">Verificação do modelo</h2><button value="cancel">Fechar</button></header></form><ul data-validation-list aria-live="polite">@if(Model.Validation.Issues.Count==0){<li class="is-ok">Nenhum problema encontrado.</li>}@foreach(var issue in Model.Validation.Issues){<li class="is-@issue.Severity.ToLowerInvariant()" data-element-id="@issue.ElementId"><button type="button">@(issue.Severity=="ERROR"?"Erro":issue.Severity=="WARNING"?"Atenção":"Informação") · @issue.Message</button></li>}</ul></dialog>
