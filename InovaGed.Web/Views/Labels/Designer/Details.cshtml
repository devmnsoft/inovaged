@model InovaGed.Web.Models.Labels.LabelCanvasDesignerPageViewModel
@{ViewData["Title"]=Model.Design.TemplateName;var d=Model.Design;var state=d.Status=="DRAFT"?$"Em edição · baseada na v{d.CurrentVersion}":$"Publicado · v{d.CurrentVersion}";}
@section Styles { <link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" /> }
<main class="label-designer-page">
 <header class="label-designer-hero"><div><span>@d.TemplateKey · @state</span><h1>@d.TemplateName</h1><p>@(d.Description??"Template visual de etiqueta com posicionamento em milímetros.")</p></div><div class="designer-actions"><a class="ig-button ig-button--secondary" asp-action="Index">Voltar</a><a class="ig-button ig-button--primary" asp-action="Edit" asp-route-templateKey="@d.TemplateKey">@(d.CanEdit?"Editar no canvas":"Inspecionar")</a></div></header>
 <section class="designer-detail-grid"><article><span>Governança</span><h2>Estado do template</h2><dl><dt>Status</dt><dd><span class="designer-status is-@d.Status.ToLowerInvariant()">@state</span></dd><dt>Finalidade</dt><dd>@d.TemplateKind · @d.SubjectType</dd><dt>Formato</dt><dd>@d.WidthMm × @d.HeightMm mm · @d.PaperKind</dd><dt>Versão em produção</dt><dd>v@d.CurrentVersion</dd></dl><div class="designer-actions"><a asp-action="Preview" asp-route-templateKey="@d.TemplateKey">Pré-visualizar</a><a asp-action="TestPrint" asp-route-templateKey="@d.TemplateKey" target="_blank">Impressão teste</a><a asp-action="Versions" asp-route-templateKey="@d.TemplateKey">Ver versões</a></div></article><article><span>Quality gate</span><h2>Validação do layout</h2>@if(!Model.Validation.Issues.Any()){<div class="designer-validation-ok">Layout válido, sem alertas.</div>}else{<ul class="designer-issues">@foreach(var issue in Model.Validation.Issues.Take(12)){<li class="is-@issue.Severity.ToLowerInvariant()"><strong>@issue.Severity</strong><span>@issue.Message</span></li>}</ul>}<p>Erros críticos bloqueiam publicação. Alertas exigem confirmação consciente.</p></article></section>
 <section class="label-designer-table"><header><div><span>Ações controladas</span><h2>Operações</h2></div></header><div class="designer-actions" data-detail-actions data-template-key="@d.TemplateKey">@Html.AntiForgeryToken()<button data-detail-action="duplicate">Duplicar como novo modelo</button>@if(d.Status=="PUBLISHED"&&!d.IsSystemTemplate){<button data-detail-action="revision">Criar nova revisão</button>}@if(d.CanEdit){<button data-detail-action="publish">Publicar versão</button><button data-detail-action="delete" class="is-danger">Excluir rascunho</button>}</div><div class="designer-toast" data-toast></div></section>
</main>
@section Scripts { <script src="~/js/labels-designer.js" asp-append-version="true"></script> }
