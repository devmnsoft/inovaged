@model InovaGed.Web.Models.Labels.LabelDesignViewModel
@{ViewData["Title"]=Model.TemplateName;}
@section Styles { <link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" /> }
<main class="label-designer-page"><header class="label-designer-hero"><div><span>@Model.TemplateCode · v@Model.CurrentVersion</span><h1>@Model.TemplateName</h1><p>@Model.Description</p></div><div class="designer-actions"><a class="ig-button ig-button--secondary" asp-action="Index">Voltar</a><a class="ig-button ig-button--primary" asp-action="Edit" asp-route-templateCode="@Model.TemplateCode">@(Model.CanEdit?"Editar":"Visualizar")</a></div></header>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(Model.IsSystemTemplate){<div class="label-designer-validation"><strong>Modelo oficial protegido.</strong> Este é um modelo oficial do sistema. Para personalizar, duplique o modelo e edite a cópia.</div>}
<section class="designer-detail-grid"><article><h2>Configuração</h2><dl><dt>Status</dt><dd>@Model.Status</dd><dt>Dimensão</dt><dd>@Model.WidthMm × @Model.HeightMm mm</dd><dt>Papel</dt><dd>@Model.PaperSize · @Model.Orientation</dd><dt>Campos</dt><dd>@Model.Fields.Count</dd></dl><div class="designer-actions"><form asp-action="Duplicate" asp-route-templateCode="@Model.TemplateCode" method="post">@Html.AntiForgeryToken()<button class="ig-button ig-button--secondary">Duplicar</button></form><form asp-action="Validate" asp-route-templateCode="@Model.TemplateCode" method="post">@Html.AntiForgeryToken()<button class="ig-button ig-button--secondary">Validar</button></form>@if(Model.CanEdit){<form asp-action="Publish" asp-route-templateCode="@Model.TemplateCode" method="post">@Html.AntiForgeryToken()<button class="ig-button ig-button--primary">Publicar</button></form>}</div></article><partial name="~/Views/Labels/Designer/_Canvas.cshtml" model="Model" /></section>
<section class="label-designer-validation"><h2>Validações</h2>@if(!Model.Validations.Any()){<p>Execute a validação visual antes de publicar.</p>}else{@foreach(var v in Model.Validations){<article class="is-@v.Severity.ToLowerInvariant()"><strong>@v.Title</strong><span>@v.Description</span><em>@v.Status</em></article>}}</section></main>
