@using System.Text.Json
@model InovaGed.Web.Models.Labels.LabelDesignViewModel
@{ViewData["Title"]="Editar "+Model.TemplateName;var palette=new List<string>{"Texto fixo","Campo dinâmico","Número de controle","Volume","Assunto","Classificação","Suporte","Período","Fase atual","Previsão de eliminação","Situação de eliminação","Localização","QR Code","Código de barras","Logo","Linha divisória"};}
@section Styles { <link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" /> }
<main class="label-designer-page"><header class="label-designer-hero"><div><span>@Model.TemplateCode · escala aproximada em mm</span><h1>@(Model.CanEdit?"Editor visual":"Visualização protegida")</h1><p>@if(Model.IsSystemTemplate){<text>Este é um modelo oficial do sistema. Para personalizar, duplique o modelo e edite a cópia.</text>}else{<text>Edite posições numericamente e acompanhe o canvas.</text>}</p></div><a class="ig-button ig-button--secondary" asp-action="Details" asp-route-templateCode="@Model.TemplateCode">Voltar</a></header>
@if(TempData["Info"] is string info){<div class="label-designer-validation">@info</div>}
<form asp-action="Save" asp-route-templateCode="@Model.TemplateCode" method="post" id="designer-form">@Html.AntiForgeryToken()<input type="hidden" name="FieldsJson" id="FieldsJson" value="@JsonSerializer.Serialize(Model.Fields)" />
<div class="label-designer-layout"><aside class="label-designer-sidebar"><h2>Campos disponíveis</h2>@foreach(var item in palette){<button type="button" disabled="@(!Model.CanEdit)">@item</button>}</aside><section><div class="designer-metadata"><label>Nome<input name="TemplateName" value="@Model.TemplateName" readonly="@(!Model.CanEdit)" /></label><label>Largura (mm)<input name="WidthMm" type="number" step=".1" value="@Model.WidthMm" readonly="@(!Model.CanEdit)" /></label><label>Altura (mm)<input name="HeightMm" type="number" step=".1" value="@Model.HeightMm" readonly="@(!Model.CanEdit)" /></label></div><partial name="~/Views/Labels/Designer/_Canvas.cshtml" model="Model" /></section><aside class="label-designer-properties"><h2>Propriedades</h2><p>Selecione um campo no canvas.</p><label>Rótulo<input data-prop="FieldLabel" /></label><label>Chave<input data-prop="FieldKey" readonly /></label><label>Fonte de dados<input data-prop="DataSource" /></label><div class="properties-grid"><label>X mm<input data-prop="XMm" type="number" step=".1" /></label><label>Y mm<input data-prop="YMm" type="number" step=".1" /></label><label>Largura<input data-prop="WidthMm" type="number" step=".1" /></label><label>Altura<input data-prop="HeightMm" type="number" step=".1" /></label><label>Fonte pt<input data-prop="FontSizePt" type="number" step=".5" /></label><label>Cor<input data-prop="Color" type="color" /></label></div><label><input data-prop="IsRequired" type="checkbox" /> Obrigatório</label><label><input data-prop="IsPrintable" type="checkbox" /> Imprimível</label>@if(Model.CanEdit){<button class="ig-button ig-button--primary" type="submit">Salvar rascunho</button>}</aside></div></form><footer class="label-designer-validation"><strong>Validação pré-impressão:</strong> campos fora da área, sobreposições, legibilidade, QR Code e obrigatoriedade são verificados pela ação Validar.</footer></main>
@section Scripts { <script src="~/js/labels-designer.js" asp-append-version="true"></script> }
