@using System.Text.Json
@model InovaGed.Web.Models.Labels.LabelCanvasDesignerPageViewModel
@{
    ViewData["LabelHelpContext"] = "DESIGNER";
    ViewData["Title"] = (Model.IsNew ? "Novo modelo" : "Editar ") + Model.Design.TemplateName;
    var canEdit = Model.IsNew || Model.Design.CanEdit;
    var endpoint = Model.IsNew
        ? Url.Action("New", "LabelDesigner")
        : Url.Action("Save", "LabelDesigner", new { templateKey = Model.Design.TemplateKey });
    var safeJson = Model.Design.DesignJson.Replace("</", "<\\/");
}
@section Styles {
    <link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/labels-studio.css" asp-append-version="true" />
}
<main class="canvas-designer" data-designer data-can-edit="@canEdit.ToString().ToLowerInvariant()"
      data-new="@Model.IsNew.ToString().ToLowerInvariant()" data-save-url="@endpoint"
      data-template-key="@Model.Design.TemplateKey">
    @Html.AntiForgeryToken()
    <script type="application/json" id="designer-json">@Html.Raw(safeJson)</script>
    <script type="application/json" id="field-catalog">@Html.Raw(JsonSerializer.Serialize(Model.Fields, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
    <partial name="_DesignerToolbar" model="Model" />
    <section class="canvas-workspace">
        <partial name="_DesignerLibrary" model="Model" />
        <partial name="_DesignerWorkspace" model="Model" />
        <partial name="_DesignerInspector" model="Model" />
    </section>
    <partial name="_DesignerDialogs" model="Model" />
</main>
@section Scripts {
    <script src="~/js/labels-help.js" asp-append-version="true"></script>
    <script src="~/js/labels-designer.js" asp-append-version="true"></script>
}
