@using System.Text.Json
@model InovaGed.Web.Models.Labels.LabelCanvasDesignerPageViewModel
@{ViewData["Title"]=(Model.IsNew?"Novo modelo":"Editar ")+Model.Design.TemplateName;var canEdit=Model.IsNew||Model.Design.CanEdit;var endpoint=Model.IsNew?Url.Action("New","LabelDesigner"):Url.Action("Save","LabelDesigner",new{templateKey=Model.Design.TemplateKey});var safeJson=Model.Design.DesignJson.Replace("</","<\\/");}
@section Styles { <link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" /> }
<main class="canvas-designer" data-designer data-can-edit="@canEdit.ToString().ToLowerInvariant()" data-new="@Model.IsNew.ToString().ToLowerInvariant()" data-save-url="@endpoint" data-template-key="@Model.Design.TemplateKey">
 @Html.AntiForgeryToken()
 <script type="application/json" id="designer-json">@Html.Raw(safeJson)</script>
 <script type="application/json" id="field-catalog">@Html.Raw(JsonSerializer.Serialize(Model.Fields,new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
 <header class="canvas-toolbar">
  <a class="tool-link" asp-action="Index" aria-label="Voltar">← <span>Voltar</span></a><span class="toolbar-divider"></span>
  <div class="canvas-template-heading"><strong>@(Model.IsNew?"Novo template":Model.Design.TemplateName)</strong><small><span class="designer-status is-@Model.Design.Status.ToLowerInvariant()">@Model.Design.Status</span> · v@Model.Design.CurrentVersion</small></div>
  <div class="toolbar-cluster"><button type="button" data-action="undo" title="Desfazer (Ctrl+Z)">↶</button><button type="button" data-action="redo" title="Refazer (Ctrl+Y)">↷</button><button type="button" data-action="toggle-grid" class="is-active">Grade</button><button type="button" data-action="toggle-ruler" class="is-active">Régua</button><label class="zoom-control">Zoom <input type="range" min="40" max="180" step="10" value="100" data-zoom /><output>100%</output></label></div>
  <div class="toolbar-cluster toolbar-primary"><button type="button" data-action="save" @(canEdit?null:"disabled")>Salvar rascunho</button>@if(!Model.IsNew){<a asp-action="Preview" asp-route-templateKey="@Model.Design.TemplateKey">Pré-visualizar</a><button type="button" data-action="publish" @(Model.Design.CanEdit?null:"disabled")>Publicar</button><button type="button" data-action="duplicate">Duplicar</button><a asp-action="TestPrint" asp-route-templateKey="@Model.Design.TemplateKey" target="_blank">Testar impressão</a><a asp-action="Versions" asp-route-templateKey="@Model.Design.TemplateKey">Versões</a>}</div>
 </header>
 <section class="canvas-workspace">
  <aside class="component-panel"><header><span>Biblioteca</span><h2>Componentes</h2></header><div class="component-search"><input type="search" placeholder="Buscar componente" data-component-search /></div><div class="component-list">
   @foreach(var item in new[]{("text","T","Texto fixo"),("field","{}","Campo dinâmico"),("qr","▦","QR Code"),("barcode","▥","Código de barras"),("logo","◆","Logo principal"),("logo","◇","Logo secundária"),("field","C","Cliente"),("field","#","Contrato"),("field","O","Organização"),("field","H","Título do cabeçalho"),("field","S","Subtítulo"),("field","R","Rodapé"),("image","▧","Imagem vinculada"),("line","—","Linha"),("rect","□","Retângulo"),("separator","⋯","Separador"),("table","▤","Tabela simples"),("group","▣","Bloco de identificação"),("group","⌖","Localização física"),("group","T","Temporalidade"),("group","✓","Auditoria / rastreio")}){<button type="button" data-add="@item.Item1" data-label="@item.Item3" @(canEdit?null:"disabled")><i>@item.Item2</i><span>@item.Item3</span></button>}
   <h3>Componentes legados</h3>
   @foreach(var item in new[]{("group","LD","Bloco LocDesk"),("group","HOL","Bloco HOL")}){<button type="button" data-add="@item.Item1" data-label="@item.Item3" @(canEdit?null:"disabled")><i>@item.Item2</i><span>@item.Item3</span></button>}
  </div><footer><strong>Arraste depois de inserir</strong><small>Posições e dimensões são mantidas em milímetros.</small></footer></aside>
  <section class="canvas-stage-panel">
   <div class="canvas-meta"><label>Nome do modelo<input data-meta="templateName" value="@Model.Design.TemplateName" @(canEdit?null:"readonly") /></label><label>Chave<input data-meta="templateKey" value="@Model.Design.TemplateKey" placeholder="CLIENTE_MODELO_CANVAS_V1" @(Model.IsNew?null:"readonly") /></label><label>Tipo<select data-meta="subjectType" @(canEdit?null:"disabled")>@foreach(var x in new[]{"Box","Document","Folder","MedicalRecord","Process","LocDeskFolder","LocDeskBox","PhysicalLocation","Classification","Loan","Protocol"}){<option selected="@(Model.Design.SubjectType==x)">@x</option>}</select></label><label>Papel<select data-meta="paperKind" @(canEdit?null:"disabled")><option>A4</option><option>A5</option><option>CUSTOM</option></select></label><label>L × A (mm)<span><input type="number" min="20" max="500" step=".1" data-meta="widthMm" value="@Model.Design.WidthMm" @(canEdit?null:"readonly") /><input type="number" min="20" max="500" step=".1" data-meta="heightMm" value="@Model.Design.HeightMm" @(canEdit?null:"readonly") /></span></label></div>
   <details class="canvas-branding" open><summary>Identidade do cliente</summary><div class="canvas-meta">
    <label>Perfil visual<select data-meta="defaultBrandingProfileId" @(canEdit?null:"disabled")><option value="">Padrão do template/tenant</option>@foreach(var profile in Model.BrandingProfiles??[]){<option value="@profile.ProfileId" selected="@(profile.ProfileId==Model.Design.DefaultBrandingProfileId)">@profile.ProfileName — @(profile.ClientName??"sem cliente informado")</option>}</select></label>
    <label>Chave de associação<input data-meta="brandingBindingKey" value="@Model.Design.BrandingBindingKey" placeholder="Padrão: chave do template" @(canEdit?null:"readonly") /></label>
    <label>Cliente (fallback)<input data-meta="clientNameFallback" value="@Model.Design.ClientNameFallback" @(canEdit?null:"readonly") /></label><label>Contrato (fallback)<input data-meta="contractNameFallback" value="@Model.Design.ContractNameFallback" @(canEdit?null:"readonly") /></label><label>Organização (fallback)<input data-meta="organizationNameFallback" value="@Model.Design.OrganizationNameFallback" @(canEdit?null:"readonly") /></label><label>Título (fallback)<input data-meta="headerTitleFallback" value="@Model.Design.HeaderTitleFallback" placeholder="ARQUIVO CENTRAL" @(canEdit?null:"readonly") /></label><label>Subtítulo (fallback)<input data-meta="headerSubtitleFallback" value="@Model.Design.HeaderSubtitleFallback" @(canEdit?null:"readonly") /></label><label>Contexto<select data-meta="labelContext" @(canEdit?null:"disabled")><option value="GENERIC" selected="@(Model.Design.LabelContext=="GENERIC")">Genérico</option><option value="LEGACY" selected="@(Model.Design.LabelContext=="LEGACY")">Legado / cliente específico</option></select></label>
   </div><p>Logo principal, logo secundária e rodapé são resolvidos pelo perfil visual selecionado ou pela associação do template.</p></details>
   <div class="canvas-stage" data-stage><div class="canvas-ruler ruler-x" data-ruler-x></div><div class="canvas-ruler ruler-y" data-ruler-y></div><div class="label-canvas" data-canvas tabindex="0"><div class="safe-margin" data-safe-margin><span>margem segura</span></div></div></div>
   <footer class="canvas-statusbar"><span data-selection-status>Nenhum elemento selecionado</span><span>Grade <b data-grid-value>2 mm</b></span><span data-save-status>Sem alterações</span></footer>
  </section>
  <aside class="properties-panel"><header><span>Inspetor</span><h2>Propriedades</h2></header><div class="empty-properties" data-empty-properties><strong>Selecione um elemento</strong><p>Clique no canvas para editar conteúdo, vínculo, aparência e posição.</p></div><div class="property-form" data-property-form hidden>
   <div class="property-actions"><button type="button" data-action="duplicate-element">Duplicar</button><button type="button" data-action="toggle-lock">Bloquear</button><button type="button" data-action="delete-element" class="is-danger">Excluir</button></div>
   <label>Nome interno<input data-prop="name" /></label><label>Tipo<input data-prop="type" readonly /></label><label>Texto<textarea data-prop="text" rows="2"></textarea></label><label>Campo vinculado<select data-prop="binding.field"><option value="">Sem vínculo</option>@foreach(var f in Model.Fields){<option value="@f.Key">@f.Label</option>}</select></label>
   <fieldset><legend>Geometria em mm</legend><div class="property-grid"><label>X<input type="number" step=".1" data-prop="xMm" /></label><label>Y<input type="number" step=".1" data-prop="yMm" /></label><label>Largura<input type="number" step=".1" min="1" data-prop="widthMm" /></label><label>Altura<input type="number" step=".1" min="1" data-prop="heightMm" /></label><label>Rotação<input type="number" step="1" data-prop="rotationDeg" /></label><label>Camada<input type="number" step="1" data-prop="zIndex" /></label></div></fieldset>
   <fieldset><legend>Tipografia e aparência</legend><label>Fonte<select data-prop="style.fontFamily"><option>Arial</option><option>Helvetica</option><option>Verdana</option><option>Times New Roman</option></select></label><div class="property-grid"><label>Tamanho (pt)<input type="number" min="5" max="72" step=".5" data-prop="style.fontSizePt" /></label><label>Peso<select data-prop="style.fontWeight"><option value="400">Regular</option><option value="600">Semibold</option><option value="700">Negrito</option></select></label><label>Alinhamento<select data-prop="style.align"><option value="left">Esquerda</option><option value="center">Centro</option><option value="right">Direita</option></select></label><label>Padding (mm)<input type="number" min="0" step=".5" data-prop="style.paddingMm" /></label><label>Cor<input type="color" data-prop="style.color" /></label><label>Fundo<input type="color" data-prop="style.backgroundColor" /></label></div><label>Borda<select data-prop="style.border"><option value="none">Sem borda</option><option value="1px solid #111111">Linha fina</option><option value="1px dashed #111111">Tracejada</option><option value="2px solid #111111">Linha forte</option></select></label></fieldset>
   <fieldset><legend>Comportamento</legend><label class="check"><input type="checkbox" data-prop="visible" /> Visível</label><label class="check"><input type="checkbox" data-prop="locked" /> Bloqueado</label><label class="check"><input type="checkbox" data-prop="style.wrap" /> Quebrar linha</label><label class="check"><input type="checkbox" data-prop="validation.required" /> Obrigatório</label><label class="check"><input type="checkbox" data-prop="validation.showOnlyWhenValue" /> Mostrar apenas se houver valor</label><label>Máximo de caracteres<input type="number" min="1" data-prop="validation.maxCharacters" /></label></fieldset>
  </div></aside>
 </section>
 <nav class="canvas-floating-tools" aria-label="Ações de alinhamento"><button data-action="align-left">Alinhar esquerda</button><button data-action="align-center">Centralizar</button><button data-action="align-right">Alinhar direita</button><button data-action="distribute-h">Distribuir H</button><button data-action="distribute-v">Distribuir V</button><button data-action="front">Frente</button><button data-action="back">Trás</button><button data-action="group">Agrupar</button><button data-action="ungroup">Desagrupar</button></nav>
 <div class="designer-toast" data-toast role="status" aria-live="polite"></div><dialog data-confirm><form method="dialog"><h2 data-confirm-title>Confirmar</h2><p data-confirm-message></p><div><button value="cancel">Cancelar</button><button value="confirm" class="ig-button ig-button--primary">Confirmar</button></div></form></dialog>
</main>
@section Scripts { <script src="~/js/labels-designer.js" asp-append-version="true"></script> }
