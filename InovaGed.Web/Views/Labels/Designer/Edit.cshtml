@using System.Text.Json
@using InovaGed.Application.Branding
@model InovaGed.Web.Models.Labels.LabelCanvasDesignerPageViewModel
@{ViewData["LabelHelpContext"]="DESIGNER";ViewData["Title"]=(Model.IsNew?"Novo modelo":"Editar ")+Model.Design.TemplateName;var canEdit=Model.IsNew||Model.Design.CanEdit;var endpoint=Model.IsNew?Url.Action("New","LabelDesigner"):Url.Action("Save","LabelDesigner",new{templateKey=Model.Design.TemplateKey});var safeJson=Model.Design.DesignJson.Replace("</","<\\/");var brandingProfiles=Model.BrandingProfiles??Array.Empty<ResolvedPrintBranding>();var purposes=new[]{("Box","Caixa"),("Document","Documento"),("Folder","Pasta"),("MedicalRecord","Prontuário"),("Process","Processo"),("LocDeskFolder","Pasta antiga"),("LocDeskBox","Caixa antiga"),("PhysicalLocation","Localização física"),("Classification","Classificação"),("Loan","Empréstimo"),("Protocol","Protocolo")};}
@section Styles { <link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/labels-studio.css" asp-append-version="true" /> }
<main class="canvas-designer" data-designer data-can-edit="@canEdit.ToString().ToLowerInvariant()" data-new="@Model.IsNew.ToString().ToLowerInvariant()" data-save-url="@endpoint" data-template-key="@Model.Design.TemplateKey">
 @Html.AntiForgeryToken()
 <script type="application/json" id="designer-json">@Html.Raw(safeJson)</script>
 <script type="application/json" id="field-catalog">@Html.Raw(JsonSerializer.Serialize(Model.Fields,new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
 <header class="canvas-toolbar">
  <a class="tool-link" asp-action="Index" aria-label="Voltar"><app-icon name="arrow-left" size="16" decorative="true" /> <span>Voltar</span></a><span class="toolbar-divider"></span>
  <div class="canvas-template-heading"><strong>@(Model.IsNew?"Novo modelo":Model.Design.TemplateName)</strong><small><span class="designer-status is-@Model.Design.Status.ToLowerInvariant()">@(Model.Design.Status=="DRAFT"?$"Em edição · baseada na v{Model.Design.CurrentVersion}":$"Publicado · v{Model.Design.CurrentVersion}")</span></small></div>
  <div class="toolbar-cluster toolbar-history"><button type="button" data-action="undo" aria-label="Desfazer"><app-icon name="undo" size="17" decorative="true" /></button><button type="button" data-action="redo" aria-label="Refazer"><app-icon name="refresh" size="17" decorative="true" /></button></div>
  <div class="toolbar-cluster toolbar-primary"><button type="button" data-action="save" @(canEdit?null:"disabled")>Salvar</button><button type="button" data-action="live-preview">Pré-visualizar</button>@if(!Model.IsNew){<button type="button" data-action="publish" @(Model.Design.CanEdit?null:"disabled")>Publicar</button><details class="designer-more"><summary aria-label="Mais opções">Mais opções</summary><nav><button type="button" data-focus-mode aria-pressed="false">Modo foco</button>@if(Model.Design.Status=="PUBLISHED"&&!Model.Design.IsSystemTemplate){<button type="button" data-action="revision">Criar nova revisão</button>}<button type="button" data-action="duplicate">Duplicar modelo</button><a asp-action="Versions" asp-route-templateKey="@Model.Design.TemplateKey">Histórico de versões</a><a asp-action="TestPrint" asp-route-templateKey="@Model.Design.TemplateKey" target="_blank">Testar impressão</a><button type="button" data-model-settings-open>Configurações do modelo</button></nav></details>}<partial name="~/Views/Labels/Shared/_LabelHelpDrawer.cshtml" /></div>
 </header>
 <section class="canvas-workspace">
  <aside class="component-panel"><header><span>Adicionar conteúdo</span><h2>Biblioteca</h2></header><nav class="library-tabs" aria-label="Biblioteca"><button type="button" class="is-active" data-library-tab="elements">Elementos</button><button type="button" data-library-tab="fields">Campos <span class="help-dot" title="Preenchidos automaticamente na impressão">?</span></button><button type="button" data-library-tab="blocks">Blocos</button><button type="button" data-library-tab="layers">Camadas <span class="help-dot" title="Controla a ordem visual">?</span></button></nav><div class="component-search" data-library-section="fields"><input type="search" placeholder="Buscar campo..." aria-label="Buscar campo" data-component-search /></div><div class="component-list">
   @foreach(var item in new[]{("text","edit","Texto fixo"),("qr","label","QR Code"),("barcode","metadata","Código de barras Code 128"),("logo","image","Logo principal"),("logo","image","Logo secundária"),("image","preview","Imagem vinculada"),("line","columns","Linha"),("rect","cards","Retângulo")}){<button type="button" draggable="true" data-add="@item.Item1" data-label="@item.Item3" @(canEdit?null:"disabled")><i><app-icon name="@item.Item2" size="18" decorative="true" /></i><span>@item.Item3</span></button>}
   @foreach(var field in Model.Fields){<button type="button" draggable="true" data-add="field" data-label="@field.Label" data-field-search="@field.Label @field.Description @field.Category" @(canEdit?null:"disabled")><i><app-icon name="metadata" size="18" decorative="true" /></i><span>@field.Label<small>@field.Category</small></span></button>}
   <h3>Blocos reutilizáveis</h3>@foreach(var preset in new[]{"Cabeçalho institucional","Identificação","Classificação","Temporalidade","Localização","Rastreabilidade","Cliente/Contrato"}){<button type="button" data-preset="@preset" @(canEdit?null:"disabled")><i>＋</i><span>@preset</span></button>}
  </div><section class="layers-panel"><header><span>Camadas</span><small>ordem visual</small></header><div data-layers></div></section><footer><strong>Arraste para o Canvas</strong><small>Posições e dimensões são mantidas em milímetros.</small></footer></aside>
  <section class="canvas-stage-panel">
   <details class="designer-model-settings"><summary>Configurações do modelo</summary><div class="canvas-meta"><label>Nome<input data-meta="templateName" value="@Model.Design.TemplateName" @(canEdit?null:"readonly") /></label><label>Identificador técnico<input data-meta="templateKey" value="@Model.Design.TemplateKey" placeholder="Gerado automaticamente" @(Model.IsNew?null:"readonly") /></label><label>Finalidade<select data-meta="subjectType" @(canEdit?null:"disabled")>@foreach(var purpose in purposes){<option value="@purpose.Item1" selected="@(Model.Design.SubjectType==purpose.Item1)">@purpose.Item2</option>}</select></label><label>Papel<select data-meta="paperKind" @(canEdit?null:"disabled")><option>A4</option><option>A5</option><option value="CUSTOM">Tamanho personalizado</option></select></label><label>L × A (mm)<span><input type="number" min="20" max="500" step=".1" data-meta="widthMm" value="@Model.Design.WidthMm" @(canEdit?null:"readonly") /><input type="number" min="20" max="500" step=".1" data-meta="heightMm" value="@Model.Design.HeightMm" @(canEdit?null:"readonly") /></span></label></div></details>
   <details class="canvas-branding"><summary>Identidade do cliente</summary><div class="canvas-meta">
    <label>Perfil visual<select data-meta="defaultBrandingProfileId" @(canEdit?null:"disabled")><option value="">Padrão do template/tenant</option>@foreach(var profile in brandingProfiles){<option value="@profile.ProfileId" selected="@(profile.ProfileId==Model.Design.DefaultBrandingProfileId)">@profile.ProfileName — @(profile.ClientName??"sem cliente informado")</option>}</select></label>
    <label>Chave de associação<input data-meta="brandingBindingKey" value="@Model.Design.BrandingBindingKey" placeholder="Padrão: chave do template" @(canEdit?null:"readonly") /></label>
    <label>Cliente (fallback)<input data-meta="clientNameFallback" value="@Model.Design.ClientNameFallback" @(canEdit?null:"readonly") /></label><label>Contrato (fallback)<input data-meta="contractNameFallback" value="@Model.Design.ContractNameFallback" @(canEdit?null:"readonly") /></label><label>Organização (fallback)<input data-meta="organizationNameFallback" value="@Model.Design.OrganizationNameFallback" @(canEdit?null:"readonly") /></label><label>Título (fallback)<input data-meta="headerTitleFallback" value="@Model.Design.HeaderTitleFallback" placeholder="ARQUIVO CENTRAL" @(canEdit?null:"readonly") /></label><label>Subtítulo (fallback)<input data-meta="headerSubtitleFallback" value="@Model.Design.HeaderSubtitleFallback" @(canEdit?null:"readonly") /></label><label>Contexto<select data-meta="labelContext" @(canEdit?null:"disabled")><option value="GENERIC" selected="@(Model.Design.LabelContext=="GENERIC")">Genérico</option><option value="LEGACY" selected="@(Model.Design.LabelContext=="LEGACY")">Legado / cliente específico</option></select></label>
   </div><p>Logo principal, logo secundária e rodapé são resolvidos pelo perfil visual selecionado ou pela associação do template.</p></details>
   <nav class="canvas-view-tools" aria-label="Visualização"><button type="button" data-action="toggle-grid" class="is-active">Grade</button><button type="button" data-action="toggle-ruler" class="is-active">Régua</button><label><input type="checkbox" data-snap checked /> Alinhar automaticamente <span class="help-dot" title="Ajuda a encaixar elementos">?</span></label><label>Zoom <input type="range" min="40" max="180" step="10" value="100" data-zoom /><output>100%</output></label></nav><div class="canvas-stage" data-stage><div class="canvas-ruler ruler-x" data-ruler-x></div><div class="canvas-ruler ruler-y" data-ruler-y></div><div class="label-canvas" data-canvas tabindex="0"><div class="smart-guides" data-guides></div><div class="selection-marquee" data-marquee hidden></div><div class="safe-margin" data-safe-margin><span>margem segura</span></div></div></div>
   <footer class="canvas-statusbar"><span data-selection-status>Nenhum elemento selecionado</span><span>Grade <b data-grid-value>2 mm</b></span><span data-save-status>Sem alterações</span></footer>
  </section>
  <aside class="properties-panel"><header><span>Editar elemento</span><h2>Propriedades</h2></header><div class="empty-properties" data-empty-properties><strong>Selecione um elemento</strong><p>Clique no etiqueta para editar conteúdo, vínculo, aparência e posição.</p></div><div class="property-form" data-property-form hidden>
   <div class="property-actions"><button type="button" data-action="duplicate-element">Duplicar</button><button type="button" data-action="toggle-lock">Bloquear</button><button type="button" data-action="delete-element" class="is-danger">Excluir</button></div>
   <label>Nome da camada<input data-prop="name" /></label><label>Tipo<input data-prop="type" readonly /></label><label>Texto<textarea data-prop="text" rows="2"></textarea></label><label>Campo vinculado<select data-prop="binding.field"><option value="">Sem vínculo</option>@foreach(var f in Model.Fields){<option value="@f.Key">@f.Label</option>}</select></label><div class="property-grid"><label>Prefixo<input data-prop="binding.prefix" /></label><label>Sufixo<input data-prop="binding.suffix" /></label><label>Formato<select data-prop="binding.format"><option value="NONE">Sem formatação</option><option value="UPPERCASE">MAIÚSCULAS</option><option value="LOWERCASE">minúsculas</option><option value="DATE_DDMMYYYY">Data completa — 31/12/2026</option><option value="DATE_MMYYYY">Mês/Ano — 12/2026</option><option>NUMBER</option><option value="PAD_LEFT">Completar com zeros</option></select></label><label>Vazio<select data-prop="binding.emptyBehavior"><option value="FALLBACK">Usar texto alternativo</option><option value="EMPTY">Deixar vazio</option><option value="HIDE">Ocultar elemento</option></select></label></div>
   <details class="inspector-group"><summary>Posição e tamanho</summary><p class="inspector-help">Use estes valores somente quando precisar de posicionamento preciso. Normalmente você pode mover e redimensionar diretamente na etiqueta.</p><fieldset><legend class="visually-hidden">Posição e tamanho</legend><div class="property-grid"><label>X<input type="number" step=".1" data-prop="xMm" /></label><label>Y<input type="number" step=".1" data-prop="yMm" /></label><label>Largura<input type="number" step=".1" min="1" data-prop="widthMm" /></label><label>Altura<input type="number" step=".1" min="1" data-prop="heightMm" /></label><label>Rotação<input type="number" step="1" data-prop="rotationDeg" /></label><label>Camada<input type="number" step="1" data-prop="zIndex" /></label></div></fieldset></details>
   <details class="inspector-group"><summary>Aparência</summary><fieldset><legend class="visually-hidden">Aparência</legend><label>Fonte<select data-prop="style.fontFamily"><option>Arial</option><option>Helvetica</option><option>Verdana</option><option>Times New Roman</option></select></label><div class="property-grid"><label>Tamanho (pt)<input type="number" min="5" max="72" step=".5" data-prop="style.fontSizePt" /></label><label>Peso<select data-prop="style.fontWeight"><option value="400">Regular</option><option value="600">Semibold</option><option value="700">Negrito</option></select></label><label>Estilo<select data-prop="style.fontStyle"><option value="normal">Normal</option><option value="italic">Itálico</option></select></label><label>Decoração<select data-prop="style.textDecoration"><option value="none">Nenhuma</option><option value="underline">Sublinhado</option><option value="line-through">Tachado</option></select></label><label>Alinhamento<select data-prop="style.align"><option value="left">Esquerda</option><option value="center">Centro</option><option value="right">Direita</option></select></label><label>Vertical<select data-prop="style.verticalAlign"><option value="top">Topo</option><option value="middle">Centro</option><option value="bottom">Base</option></select></label><label>Altura linha<input type="number" min=".5" max="3" step=".1" data-prop="style.lineHeight" /></label><label>Espaçamento<input type="number" min="-2" max="10" step=".1" data-prop="style.letterSpacing" /></label><label>Opacidade<input type="number" min="0" max="1" step=".05" data-prop="style.opacity" /></label><label>Padding (mm)<input type="number" min="0" step=".5" data-prop="style.paddingMm" /></label><label>Cor<input type="color" data-prop="style.color" /></label><label>Fundo<input type="color" data-prop="style.backgroundColor" /></label></div><label>Borda<select data-prop="style.border"><option value="none">Sem borda</option><option value="1px solid #111111">Linha fina</option><option value="1px dashed #111111">Tracejada</option><option value="2px solid #111111">Linha forte</option></select></label></fieldset></details>
   <details class="inspector-group"><summary>Comportamento</summary><fieldset><legend class="visually-hidden">Comportamento</legend><label class="check"><input type="checkbox" data-prop="visible" /> Visível</label><label class="check"><input type="checkbox" data-prop="locked" /> Bloqueado</label><label class="check"><input type="checkbox" data-prop="style.wrap" /> Quebrar linha</label><label class="check"><input type="checkbox" data-prop="validation.required" /> Obrigatório</label><label class="check"><input type="checkbox" data-prop="validation.showOnlyWhenValue" /> Mostrar apenas se houver valor</label><label>Máximo de caracteres<input type="number" min="1" data-prop="validation.maxCharacters" /></label><label>Visibilidade<select data-prop="visibilityCondition.operator"><option>ALWAYS</option><option>HAS_VALUE</option><option>EQUALS</option><option>NOT_EQUALS</option></select></label><label>Campo da condição<select data-prop="visibilityCondition.field"><option value="">Selecione</option>@foreach(var f in Model.Fields){<option value="@f.Key">@f.Label</option>}</select></label><label>Valor comparado<input data-prop="visibilityCondition.value" /></label></fieldset></details>
  </div></aside>
 </section>
 <nav class="canvas-floating-tools" aria-label="Ações de alinhamento"><button data-action="align-left">Alinhar esquerda</button><button data-action="align-center">Centralizar</button><button data-action="align-right">Alinhar direita</button><button data-action="distribute-h">Distribuir H</button><button data-action="distribute-v">Distribuir V</button><button data-action="front">Frente</button><button data-action="back">Trás</button><button data-action="group">Agrupar</button><button data-action="ungroup">Desagrupar</button></nav>
 <div class="designer-mobile-note">Para editar o layout com precisão, recomendamos uma tela maior.</div><section class="designer-validation" aria-labelledby="validation-title"><h2 id="validation-title">Verificação do modelo</h2><ul data-validation-list>@if(Model.Validation.Issues.Count==0){<li class="is-ok">OK · Nenhum problema encontrado pelo renderizador.</li>}@foreach(var issue in Model.Validation.Issues){<li class="is-@issue.Severity.ToLowerInvariant()" data-element-id="@issue.ElementId"><button type="button">@(issue.Severity=="ERROR"?"ERRO":issue.Severity=="WARNING"?"ATENÇÃO":"OK") · @issue.Message</button></li>}</ul></section><div class="designer-tour" data-designer-tour hidden role="dialog" aria-modal="true" aria-labelledby="tour-title"><div><small data-tour-progress></small><h2 id="tour-title" data-tour-title></h2><p data-tour-text></p><button type="button" data-tour-skip>Pular</button><button type="button" data-tour-next>Próximo</button></div></div><div class="designer-toast" data-toast role="status" aria-live="polite"></div><dialog data-confirm><form method="dialog"><h2 data-confirm-title>Confirmar</h2><p data-confirm-message></p><div><button value="cancel">Cancelar</button><button value="confirm" class="ig-button ig-button--primary">Confirmar</button></div></form></dialog><dialog data-publish-dialog aria-labelledby="publish-title"><form method="dialog"><h2 id="publish-title">Publicar nova versão</h2><dl><div><dt>Modelo</dt><dd>@Model.Design.TemplateName</dd></div><div><dt>Nova versão</dt><dd>@(Model.Design.CurrentVersion+1)</dd></div><div><dt>Tamanho</dt><dd>@Model.Design.WidthMm × @Model.Design.HeightMm mm</dd></div></dl><label>Descrição da alteração<textarea data-publish-summary rows="3" required placeholder="Ex.: Ajuste do QR Code e inclusão da classificação."></textarea></label><div><button value="cancel">Cancelar</button><button value="confirm" class="ig-button ig-button--primary">Publicar versão</button></div></form></dialog><dialog data-live-preview style="width:min(1100px,95vw);height:min(800px,92vh)"><form method="dialog" style="display:flex;justify-content:space-between;align-items:center"><h2>Prévia operacional</h2><button>Fechar</button></form><p data-live-preview-summary></p><iframe title="Prévia do template" data-live-preview-frame style="width:100%;height:calc(100% - 80px);border:1px solid #d5dae2"></iframe></dialog>
</main>
@section Scripts { <script src="~/js/labels-help.js" asp-append-version="true"></script><script src="~/js/labels-designer.js" asp-append-version="true"></script> }
