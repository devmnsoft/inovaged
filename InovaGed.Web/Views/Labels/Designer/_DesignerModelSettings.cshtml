@using System.Globalization
@model InovaGed.Web.Models.Labels.LabelCanvasDesignerPageViewModel
@{ var canEdit=Model.IsNew||Model.Design.CanEdit; var purposes=new[]{("Box","Caixa"),("Document","Documento"),("Folder","Pasta"),("MedicalRecord","Prontuário"),("Process","Processo"),("ManualLabel","Avulsa")}; }
<dialog class="designer-settings-drawer" data-model-settings aria-labelledby="model-settings-title">
 <form method="dialog"><header><h2 id="model-settings-title">Configurações do modelo</h2><button value="cancel" aria-label="Fechar">Fechar</button></header></form>
 <div class="settings-sections">
  <details open><summary>Geral</summary><div class="canvas-meta"><label>Nome<input data-meta="templateName" value="@Model.Design.TemplateName" @(canEdit?null:"readonly") /></label><label>Finalidade<select data-meta="subjectType" @(canEdit?null:"disabled")>@foreach(var purpose in purposes){<option value="@purpose.Item1" selected="@(Model.Design.SubjectType==purpose.Item1)">@purpose.Item2</option>}</select></label></div></details>
  <details><summary>Tamanho</summary><section class="label-size-settings"><strong>Tamanho da etiqueta</strong><output data-size-summary>@Model.Design.WidthMm × @Model.Design.HeightMm mm</output><label>Formato conhecido<small>Use um tamanho pronto ou escolha Personalizado para informar as medidas.</small><select data-size-preset><option value="100x70">100 × 70 mm</option><option value="100x50">100 × 50 mm</option><option value="70x40">70 × 40 mm</option><option value="custom">Personalizado</option></select></label><label>Tipo de papel<small>Define a mídia usada como referência na impressão.</small><select data-meta="paperKind"><option>A4</option><option>A5</option><option value="CUSTOM">Personalizado</option></select></label><label>Largura da etiqueta <span>(mm)</span><small>Medida horizontal, em milímetros. Confira o tamanho do papel ou rolo.</small><input type="number" min="20" max="500" step=".1" data-meta="widthMm" value="@Model.Design.WidthMm.ToString(CultureInfo.InvariantCulture)" /></label><label>Altura da etiqueta <span>(mm)</span><small>Medida vertical, em milímetros. Confira o tamanho do papel ou rolo.</small><input type="number" min="20" max="500" step=".1" data-meta="heightMm" value="@Model.Design.HeightMm.ToString(CultureInfo.InvariantCulture)" /></label><label>Orientação<small>Altera a disposição no editor sem mudar as medidas físicas.</small><select data-meta="orientation"><option value="portrait">Retrato</option><option value="landscape">Paisagem</option></select></label></section></details>
  <partial name="~/Views/Labels/Designer/_DesignerBranding.cshtml" model="Model" />
  <input type="hidden" data-meta="templateKey" value="@Model.Design.TemplateKey" /><input type="hidden" data-meta="brandingBindingKey" value="@Model.Design.BrandingBindingKey" /><input type="hidden" data-meta="labelContext" value="GENERIC" /><input type="hidden" data-meta="clientNameFallback" value="@Model.Design.ClientNameFallback" /><input type="hidden" data-meta="contractNameFallback" value="@Model.Design.ContractNameFallback" /><input type="hidden" data-meta="organizationNameFallback" value="@Model.Design.OrganizationNameFallback" />
 </div>
</dialog>
