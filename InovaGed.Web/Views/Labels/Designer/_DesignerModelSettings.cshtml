@using System.Globalization
@model InovaGed.Web.Models.Labels.LabelCanvasDesignerPageViewModel
@{ var canEdit=Model.IsNew||Model.Design.CanEdit; var purposes=new[]{("Box","Caixa"),("Document","Documento"),("Folder","Pasta"),("MedicalRecord","Prontuário"),("Process","Processo"),("ManualLabel","Avulsa")}; }
<dialog class="designer-settings-drawer" data-model-settings aria-labelledby="model-settings-title">
 <form method="dialog"><header><h2 id="model-settings-title">Configurações do modelo</h2><button value="cancel" aria-label="Fechar">Fechar</button></header></form>
 <div class="settings-sections">
  <details open><summary>Geral</summary><div class="canvas-meta"><label>Nome<input data-meta="templateName" value="@Model.Design.TemplateName" @(canEdit?null:"readonly") /></label><label>Finalidade<select data-meta="subjectType" @(canEdit?null:"disabled")>@foreach(var purpose in purposes){<option value="@purpose.Item1" selected="@(Model.Design.SubjectType==purpose.Item1)">@purpose.Item2</option>}</select></label></div></details>
  <details><summary>Tamanho</summary><section class="label-size-settings"><strong>Tamanho da etiqueta</strong><output data-size-summary>@Model.Design.WidthMm × @Model.Design.HeightMm mm</output><label>Preset<select data-size-preset><option value="100x70">100 × 70 mm</option><option value="100x50">100 × 50 mm</option><option value="70x40">70 × 40 mm</option><option value="custom">Personalizado</option></select></label><label>Papel<select data-meta="paperKind"><option>A4</option><option>A5</option><option value="CUSTOM">Personalizado</option></select></label><label>Largura (mm)<input type="number" min="20" max="500" step=".1" data-meta="widthMm" value="@Model.Design.WidthMm.ToString(CultureInfo.InvariantCulture)" /></label><label>Altura (mm)<input type="number" min="20" max="500" step=".1" data-meta="heightMm" value="@Model.Design.HeightMm.ToString(CultureInfo.InvariantCulture)" /></label><label>Orientação<select data-meta="orientation"><option value="portrait">Retrato</option><option value="landscape">Paisagem</option></select></label></section></details>
  <partial name="_DesignerBranding" model="Model" />
  <details class="settings-advanced"><summary>Avançado</summary><div class="canvas-meta"><label>Identificador técnico<input data-meta="templateKey" value="@Model.Design.TemplateKey" readonly /></label><label>Binding key<input data-meta="brandingBindingKey" value="@Model.Design.BrandingBindingKey" /></label><label>Contexto<select data-meta="labelContext"><option value="GENERIC">Genérico</option><option value="LEGACY">Compatibilidade</option></select></label><label>Cliente alternativo<input data-meta="clientNameFallback" value="@Model.Design.ClientNameFallback" /></label><label>Contrato alternativo<input data-meta="contractNameFallback" value="@Model.Design.ContractNameFallback" /></label><label>Organização alternativa<input data-meta="organizationNameFallback" value="@Model.Design.OrganizationNameFallback" /></label></div></details>
 </div>
</dialog>
