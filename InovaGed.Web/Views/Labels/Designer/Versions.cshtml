@model InovaGed.Web.Models.Labels.LabelCanvasVersionsPageViewModel
@{ViewData["Title"]="Versões · "+Model.Design.TemplateName;}
@section Styles { <link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" /> }
<main class="label-designer-page"><header class="label-designer-hero"><div><span>@Model.Design.TemplateKey</span><h1>Histórico de versões</h1><p>Snapshots publicados são imutáveis; uma restauração sempre cria um novo rascunho.</p></div><a class="ig-button ig-button--secondary" asp-action="Details" asp-route-templateKey="@Model.Design.TemplateKey">Voltar</a></header><section class="label-designer-table"><div class="table-responsive"><table class="table"><thead><tr><th>Versão</th><th>Status</th><th>Criada por / em</th><th>Publicada por / em</th><th>Resumo</th><th>Hash</th><th>Ações</th></tr></thead><tbody>@if(!Model.Versions.Any()){<tr><td colspan="7">Nenhuma versão publicada.</td></tr>}@foreach(var item in Model.Versions){<tr><td><strong>v@item.VersionNo</strong></td><td><span class="designer-status is-published">@item.Status</span></td><td>@(item.CreatedByName??"Sistema")<small>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></td><td>@(item.PublishedByName??"—")<small>@(item.PublishedAt?.ToString("dd/MM/yyyy HH:mm")??"—")</small></td><td>@(item.ChangeSummary??"Sem resumo")</td><td><code>@(item.SnapshotHash?[..Math.Min(12,item.SnapshotHash.Length)]??"—")</code></td><td><div class="designer-actions"><a asp-action="PreviewVersion" asp-route-templateKey="@Model.Design.TemplateKey" asp-route-versionId="@item.Id">Visualizar</a><form data-version-duplicate-form data-template-key="@Model.Design.TemplateKey" data-version-id="@item.Id">@Html.AntiForgeryToken()<button type="submit">Duplicar</button></form><form data-restore-form data-template-key="@Model.Design.TemplateKey" data-version-id="@item.Id">@Html.AntiForgeryToken()<button type="submit">Restaurar como rascunho</button></form></div></td></tr>}</tbody></table></div><div class="designer-toast" data-toast></div></section></main>
@section Scripts { <script src="~/js/labels-designer.js" asp-append-version="true"></script> }
