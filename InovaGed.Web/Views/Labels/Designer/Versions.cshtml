@model IReadOnlyList<InovaGed.Web.Models.Labels.LabelDesignVersionViewModel>
@{var template=(InovaGed.Web.Models.Labels.LabelDesignViewModel)ViewBag.Template;ViewData["Title"]="Versões · "+template.TemplateName;}
@section Styles { <link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" /> }
<main class="label-designer-page"><header class="label-designer-hero"><div><span>@template.TemplateCode</span><h1>Versões publicadas</h1><p>Snapshots imutáveis preservam a configuração utilizada na impressão.</p></div><a class="ig-button ig-button--secondary" asp-action="Details" asp-route-templateCode="@template.TemplateCode">Voltar</a></header><section class="label-designer-table"><table class="table"><thead><tr><th>Versão</th><th>Status</th><th>Publicada em</th><th>Notas</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="4">Nenhuma versão publicada.</td></tr>}@foreach(var item in Model){<tr><td>v@item.VersionNumber</td><td>@item.Status</td><td>@item.PublishedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@(item.Notes??"—")</td></tr>}</tbody></table></section></main>
