@model InovaGed.Web.Models.Labels.LabelDesignViewModel
@{ViewData["Title"]="Preview · "+Model.TemplateName;}
@section Styles { <link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" /> }
<main class="label-designer-page"><header class="label-designer-hero"><div><span>Dados de exemplo · não persistidos</span><h1>Preview de @Model.TemplateName</h1><p>Dimensão real @Model.WidthMm × @Model.HeightMm mm.</p></div><div class="designer-actions"><a class="ig-button ig-button--secondary" asp-action="Edit" asp-route-templateCode="@Model.TemplateCode">Voltar ao editor</a><a class="ig-button ig-button--primary" asp-action="PrintTest" asp-route-templateCode="@Model.TemplateCode">Imprimir teste</a></div></header><partial name="~/Views/Labels/Designer/_Canvas.cshtml" model="Model" /><section class="label-designer-validation"><h2>Validações visuais</h2><p>@(Model.Validations.Any(x=>x.Status=="OPEN")?$"{Model.Validations.Count(x=>x.Status=="OPEN")} alerta(s) requerem revisão.":"Nenhum alerta aberto no último ciclo de validação.")</p></section></main>
