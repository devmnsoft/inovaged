@model InovaGed.Web.Models.Labels.LabelCanvasDesignerPageViewModel
@{ViewData["Title"]="Preview · "+Model.Design.TemplateName;}
@section Styles { <link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" /> }
<main class="label-designer-page"><header class="label-designer-hero"><div><span>Dados de exemplo · snapshot não persistido</span><h1>Pré-visualização</h1><p>@Model.Design.TemplateName · @Model.Design.WidthMm × @Model.Design.HeightMm mm</p></div><div class="designer-actions"><a class="ig-button ig-button--secondary" asp-action="Edit" asp-route-templateKey="@Model.Design.TemplateKey">Voltar ao editor</a><a class="ig-button ig-button--primary" asp-action="TestPrint" asp-route-templateKey="@Model.Design.TemplateKey" target="_blank">Testar impressão</a></div></header><section class="designer-preview-shell"><iframe title="Pré-visualização da etiqueta" srcdoc="@Model.RenderHtml"></iframe></section><section class="designer-detail-grid"><article><h2>Resultado da validação</h2><p>@(Model.Validation.HasErrors?"Há erros críticos que bloqueiam publicação.":Model.Validation.HasWarnings?"Preview gerado com alertas de layout.":"Renderização validada sem alertas.")</p></article><article><h2>Fidelidade</h2><p>O preview utiliza as mesmas unidades em milímetros e o mesmo snapshot do renderizador de impressão.</p></article></section></main>
