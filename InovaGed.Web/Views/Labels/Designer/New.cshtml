@model InovaGed.Web.Models.Labels.LabelCanvasNewModelInput
@{ ViewData["Title"]="Criar modelo de etiqueta"; ViewData["LabelHelpContext"]="DESIGNER_LIBRARY"; }
@section Styles { <link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/labels-studio.css" asp-append-version="true" /> }
<main class="labels-page label-new-model">
 <header class="labels-hero"><div><span class="labels-eyebrow"><app-icon name="layout-template" size="16" decorative="true" /> Modelos</span><h1>Criar modelo de etiqueta</h1><p>Defina a finalidade, escolha um layout inicial neutro e confira antes de abrir o editor.</p></div><partial name="~/Views/Labels/Shared/_LabelHelpDrawer.cshtml" /></header>
 <form method="post" class="label-create-wizard">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
  <fieldset><legend><span>1</span> O que você quer identificar?</legend><div class="choice-grid">@foreach(var option in new[]{("Box","Caixa"),("Document","Documento"),("Folder","Pasta"),("MedicalRecord","Prontuário"),("Process","Processo"),("ManualLabel","Etiqueta avulsa")}){<label><input asp-for="SubjectType" type="radio" value="@option.Item1" /><strong>@option.Item2</strong></label>}</div></fieldset>
  <fieldset><legend><span>2</span> Como deseja começar?</legend><div class="choice-grid">@foreach(var option in new[]{("BLANK","Em branco"),("INSTITUTIONAL","Institucional"),("IDENTIFICATION_QR","Identificação + QR"),("CLASSIFICATION","Identificação + classificação"),("TRACEABILITY","Rastreabilidade completa")}){<label><input asp-for="StarterKind" type="radio" value="@option.Item1" /><strong>@option.Item2</strong></label>}</div></fieldset>
  <fieldset><legend><span>3</span> Identidade e tamanho</legend><div class="label-origin-grid"><label>Nome do modelo<input asp-for="Name" class="form-control" placeholder="Etiqueta de caixas administrativas" /></label><label>Perfil visual (opcional)<select asp-for="BrandingProfileId" class="form-select"><option value="">Sem identidade definida</option>@foreach(var p in Model.BrandingProfiles){<option value="@p.ProfileId">@p.ProfileName — @(p.ClientName??"perfil padrão")</option>}</select></label><label>Tamanho<select data-label-size class="form-select"><option value="100,70">100 × 70 mm</option><option value="100,50">100 × 50 mm</option><option value="70,40">70 × 40 mm</option><option value="50,30">50 × 30 mm</option><option value="custom">Personalizado</option></select></label><label>Papel de referência<select asp-for="PaperKind" class="form-select"><option value="A4">A4</option><option value="A5">A5</option><option value="LETTER">Carta</option></select></label><label>Largura (mm)<input asp-for="WidthMm" class="form-control" type="number" min="20" max="500" step=".1" /></label><label>Altura (mm)<input asp-for="HeightMm" class="form-control" type="number" min="20" max="500" step=".1" /></label></div></fieldset>
  <section class="label-create-summary" aria-live="polite"><h2>Confira antes de criar</h2><p>O identificador técnico será gerado com segurança pelo servidor e ficará disponível apenas nas configurações avançadas.</p></section><button class="ig-button ig-button--primary" type="submit">Criar e abrir editor <app-icon name="arrow-right" size="16" decorative="true" /></button>
 </form>
</main>
@section Scripts { <script>document.querySelector('[data-label-size]')?.addEventListener('change',function(){if(this.value==='custom')return;const size=this.value.split(',');document.querySelector('[name="WidthMm"]').value=size[0];document.querySelector('[name="HeightMm"]').value=size[1];});</script><script src="~/js/labels-help.js" asp-append-version="true"></script> }
