@model InovaGed.Web.Models.Labels.LabelCanvasNewModelInput
@{ ViewData["Title"]="Criar modelo no editor visual"; ViewData["LabelHelpContext"]="DESIGNER_LIBRARY"; }
@section Styles { <link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/labels-studio.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" /> }
<main class="labels-page label-new-model label-create-simple">
 <header class="label-create-header"><a asp-action="Index">← Voltar para modelos</a><span>Novo modelo</span><h1>Criar modelo no editor visual</h1><p>Informe somente o essencial. Depois de criar, o modelo será aberto diretamente no Canvas.</p></header>
 <form method="post" class="label-create-form" data-label-simple-create>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div><input asp-for="PaperKind" type="hidden" value="A4" />
  <section aria-labelledby="model-info"><h2 id="model-info">1. Identificação</h2><div class="label-create-grid">
   <div class="field-help"><label asp-for="Name">Nome do modelo <span>obrigatório</span></label><input asp-for="Name" class="form-control" maxlength="120" required aria-describedby="name-help" placeholder="Ex.: Etiqueta de caixas administrativas" /><small id="name-help">Use um nome que ajude sua equipe a reconhecer este modelo.</small><span asp-validation-for="Name" class="text-danger"></span></div>
   <div class="field-help"><label asp-for="SubjectType">Finalidade <span>obrigatório</span></label><select asp-for="SubjectType" class="form-select" required aria-describedby="purpose-help"><option value="">Selecione</option><option value="Document">Documento</option><option value="Box">Caixa</option><option value="ManualLabel">Etiqueta manual</option><option value="Folder">Pasta</option><option value="MedicalRecord">Prontuário</option><option value="Process">Processo</option></select><small id="purpose-help">Define quais campos do cadastro poderão ser usados no modelo.</small><span asp-validation-for="SubjectType" class="text-danger"></span></div>
  </div></section>
  <section aria-labelledby="model-start"><h2 id="model-start">2. Ponto de partida</h2><div class="choice-grid choice-grid--compact">@foreach(var option in new[]{("BLANK","Em branco","Comece com uma etiqueta vazia."),("IDENTIFICATION_QR","Identificação + QR Code","Use uma composição pronta e personalize no Canvas."),("INSTITUTIONAL","Institucional","Comece com espaço para identidade visual."),("TRACEABILITY","Rastreabilidade","Comece com identificação e código de rastreio.")}){<label><input asp-for="StarterKind" type="radio" value="@option.Item1" required /><strong>@option.Item2</strong><small>@option.Item3</small></label>}</div><span asp-validation-for="StarterKind" class="text-danger"></span></section>
  <section aria-labelledby="model-size"><h2 id="model-size">3. Tamanho da etiqueta</h2><div class="label-create-grid"><div class="field-help"><label for="label-size">Tamanho</label><select id="label-size" data-label-size class="form-select"><option value="100,70">Grande — 100 × 70 mm</option><option value="100,50">Média — 100 × 50 mm</option><option value="70,40">Compacta — 70 × 40 mm</option><option value="50,30">Pequena — 50 × 30 mm</option><option value="custom">Tamanho personalizado</option></select><small>Escolha um tamanho usado pelo seu papel ou rolo.</small></div><div></div>
   <div class="field-help"><label asp-for="WidthMm">Largura da etiqueta <span>mm · obrigatório</span></label><div class="input-unit"><input asp-for="WidthMm" class="form-control" type="number" min="20" max="500" step=".1" required aria-describedby="width-help" /><span>mm</span></div><small id="width-help">Medida horizontal da etiqueta. Deve corresponder ao papel ou rolo utilizado.</small><span asp-validation-for="WidthMm" class="text-danger"></span></div>
   <div class="field-help"><label asp-for="HeightMm">Altura da etiqueta <span>mm · obrigatório</span></label><div class="input-unit"><input asp-for="HeightMm" class="form-control" type="number" min="20" max="500" step=".1" required aria-describedby="height-help" /><span>mm</span></div><small id="height-help">Medida vertical da etiqueta, em milímetros.</small><span asp-validation-for="HeightMm" class="text-danger"></span></div>
  </div></section>
  <div class="label-create-actions"><a class="ig-button ig-button--secondary" asp-action="Index">Cancelar</a><button class="ig-button ig-button--primary" type="submit" data-create-submit>Criar e abrir no Canvas</button></div><p class="form-text">O modelo será salvo como rascunho. Nada será publicado ou impresso automaticamente.</p>
 </form>
</main>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/labels-create-simple.js" asp-append-version="true"></script> }
