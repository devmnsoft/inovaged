@model InovaGed.Web.Models.Labels.LabelCanvasNewModelInput
@{ ViewData["Title"]="Criar modelo de etiqueta"; ViewData["LabelHelpContext"]="DESIGNER_LIBRARY"; }
@section Styles { <link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/labels-studio.css" asp-append-version="true" /> }
<main class="labels-page label-new-model">
 <header class="labels-hero"><div><span class="labels-eyebrow"><app-icon name="layout-template" size="16" decorative="true" /> Modelos</span><h1>Criar modelo de etiqueta</h1><p>Prepare o modelo em cinco passos rápidos. Você poderá ajustar tudo no editor.</p></div><partial name="~/Views/Labels/Shared/_LabelHelpDrawer.cshtml" /></header>
 <form method="post" class="label-create-wizard" data-label-wizard novalidate>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
  <nav class="d-flex flex-wrap gap-2 mb-4" aria-label="Etapas do assistente">@foreach(var step in new[]{"Finalidade","Layout","Tamanho","Identidade","Confirmar"}){<button type="button" class="btn btn-sm btn-outline-secondary" data-wizard-indicator aria-current="false">@step</button>}</nav>
  <fieldset data-wizard-step><legend><span>1</span> O que você quer identificar?</legend><div class="choice-grid">@foreach(var option in new[]{("Box","Caixa"),("Document","Documento"),("Folder","Pasta"),("MedicalRecord","Prontuário"),("Process","Processo"),("ManualLabel","Etiqueta avulsa")}){<label><input asp-for="SubjectType" type="radio" value="@option.Item1" required /><strong>@option.Item2</strong></label>}</div></fieldset>
  <fieldset data-wizard-step hidden><legend><span>2</span> Como deseja começar?</legend><div class="choice-grid">@foreach(var option in new[]{("BLANK","Em branco"),("INSTITUTIONAL","Institucional"),("IDENTIFICATION_QR","Identificação + QR"),("CLASSIFICATION","Classificação"),("TRACEABILITY","Rastreabilidade")}){<label><input asp-for="StarterKind" type="radio" value="@option.Item1" required /><strong>@option.Item2</strong></label>}</div></fieldset>
  <fieldset data-wizard-step hidden><legend><span>3</span> Qual será o tamanho?</legend><div class="label-origin-grid"><label>Tamanho<select data-label-size class="form-select"><option value="100,70">100 × 70 mm</option><option value="100,50">100 × 50 mm</option><option value="70,40">70 × 40 mm</option><option value="50,30">50 × 30 mm</option><option value="custom">Personalizado</option></select></label><label>Papel de referência<select asp-for="PaperKind" class="form-select" required><option value="A4">A4</option><option value="A5">A5</option><option value="LETTER">Carta</option></select></label><label>Largura (mm)<input asp-for="WidthMm" class="form-control" type="number" min="20" max="500" step=".1" required /></label><label>Altura (mm)<input asp-for="HeightMm" class="form-control" type="number" min="20" max="500" step=".1" required /></label></div></fieldset>
  <fieldset data-wizard-step hidden><legend><span>4</span> Identidade</legend><div class="label-origin-grid"><label>Nome do modelo<input asp-for="Name" class="form-control" maxlength="120" required placeholder="Etiqueta de caixas administrativas" /></label><label>Perfil visual (opcional)<select asp-for="BrandingProfileId" class="form-select"><option value="">Sem identidade definida</option>@foreach(var p in Model.BrandingProfiles){<option value="@p.ProfileId">@p.ProfileName — @(p.ClientName??"perfil padrão")</option>}</select></label></div><p class="form-text">Logo, cliente, contrato e organização serão resolvidos pelo perfil escolhido, sem copiar dados sensíveis para o layout.</p></fieldset>
  <fieldset data-wizard-step hidden><legend><span>5</span> Confirmar</legend><section class="label-create-summary" aria-live="polite"><h2>Confira antes de criar</h2><dl data-wizard-summary></dl><p>O modelo será criado como rascunho. Nada será publicado ou impresso automaticamente.</p></section></fieldset>
  <div class="d-flex justify-content-between gap-2 mt-4"><button class="ig-button ig-button--secondary" type="button" data-wizard-back>Voltar</button><button class="ig-button ig-button--primary" type="button" data-wizard-next>Continuar</button><button class="ig-button ig-button--primary" type="submit" data-wizard-submit hidden>Criar modelo</button></div>
  <p class="text-danger mt-2" data-wizard-error role="alert" aria-live="assertive"></p>
 </form>
</main>
@section Scripts { <script src="~/js/labels-new-wizard.js" asp-append-version="true"></script><script src="~/js/labels-help.js" asp-append-version="true"></script> }
