@model InovaGed.Web.Models.Labels.LabelCanvasDesignerPageViewModel
<nav class="canvas-floating-tools" aria-label="Ações da seleção"><button data-action="align-left">Alinhar esquerda</button><button data-action="align-center">Centralizar</button><button data-action="align-right">Alinhar direita</button><button data-action="distribute-h">Distribuir horizontal</button><button data-action="distribute-v">Distribuir vertical</button><button data-action="front">Frente</button><button data-action="back">Trás</button><button data-action="group">Agrupar</button><button data-action="ungroup">Desagrupar</button><button data-action="save-block" hidden>Salvar como bloco</button></nav>
<dialog data-block-dialog aria-labelledby="block-title"><form method="dialog"><h2 id="block-title">Salvar como bloco</h2><p>O bloco guardará somente o layout, sem valores da prévia.</p><label>Nome do bloco<input data-block-name minlength="3" maxlength="160" required /></label><label>Categoria<select data-block-category><option>Cabeçalho</option><option>Identificação</option><option>Classificação</option><option>Temporalidade</option><option>Rastreabilidade</option><option>Localização</option><option>Personalizado</option></select></label><p data-block-preview></p><div><button value="cancel">Cancelar</button><button value="confirm" class="ig-button ig-button--primary">Salvar bloco</button></div></form></dialog>
<partial name="_DesignerModelSettings" model="Model" />
<partial name="_DesignerValidation" model="Model" />
<dialog data-autofix-dialog aria-labelledby="autofix-title"><form method="dialog"><h2 id="autofix-title">Confirmar correção</h2><p data-autofix-problem></p><dl class="autofix-comparison"><div><dt>Antes</dt><dd data-autofix-before></dd></div><div><dt>Depois</dt><dd data-autofix-after></dd></div></dl><p>A alteração será registrada como uma única operação e poderá ser desfeita com Ctrl+Z.</p><div><button value="cancel">Cancelar</button><button value="confirm" class="ig-button ig-button--primary">Aplicar correção</button></div></form></dialog>
<dialog data-resize-dialog aria-labelledby="resize-title"><form method="dialog"><h2 id="resize-title">Alterar tamanho</h2><p data-resize-message></p><div><button value="cancel">Cancelar</button><button value="keep">Manter posições</button><button value="adapt" class="ig-button ig-button--primary">Adaptar layout</button></div></form></dialog>
<div class="designer-mobile-note">Para editar posições e tamanhos com precisão, use uma tela maior.</div><div class="designer-toast" data-toast role="status" aria-live="polite"></div>
<dialog data-confirm><form method="dialog"><h2 data-confirm-title>Confirmar</h2><p data-confirm-message></p><div><button value="cancel">Cancelar</button><button value="confirm" class="ig-button ig-button--primary">Confirmar</button></div></form></dialog>
<dialog data-publish-dialog aria-labelledby="publish-title"><form method="dialog"><h2 id="publish-title">Publicar nova versão</h2><p>As alterações desta revisão serão registradas no histórico.</p><section data-publish-diff><strong>Mudanças</strong><p data-publish-diff-summary>Carregando alterações…</p></section><section data-publish-validation><strong>Problemas de validação</strong><p data-publish-validation-summary>Nenhum problema encontrado.</p></section><label>O que mudou nesta versão?<textarea data-publish-summary rows="3" required></textarea></label><div><button value="cancel">Cancelar</button><button value="confirm" class="ig-button ig-button--primary">Publicar versão</button></div></form></dialog>
<dialog data-live-preview class="designer-preview-dialog"><form method="dialog"><h2>Prévia operacional</h2><button>Fechar</button></form><p data-live-preview-summary></p><iframe title="Prévia do template" data-live-preview-frame></iframe></dialog>
<dialog data-layout-preview aria-labelledby="layout-preview-title"><form method="dialog"><h2 id="layout-preview-title">Prévia da organização</h2><p data-layout-preview-message>Compare o posicionamento sugerido. Elementos bloqueados não serão alterados.</p><div><button value="cancel">Manter layout atual</button><button value="confirm" class="ig-button ig-button--primary">Aplicar organização</button></div></form></dialog>
<dialog data-command-palette aria-labelledby="command-title"><form method="dialog"><h2 id="command-title">Comandos do Label Studio</h2><input type="search" data-command-search placeholder="Buscar comando" autocomplete="off" /><div data-command-list role="listbox"></div><button value="cancel">Fechar</button></form></dialog>
<aside data-onboarding hidden aria-label="Primeiros passos"><h2>Comece seu modelo</h2><ol><li>Adicione campos</li><li>Organize o layout</li><li>Teste com dados reais</li><li>Publique</li></ol><button type="button" data-hide-onboarding>Não mostrar novamente</button></aside>
<dialog data-conflict-dialog aria-labelledby="conflict-title"><form method="dialog"><h2 id="conflict-title">Este modelo foi atualizado</h2><p>Outra pessoa salvou alterações enquanto você estava editando.</p><p>Suas alterações locais estão preservadas até você escolher como resolver.</p><div><button value="cancel">Cancelar</button><button value="compare">Comparar alterações</button><button value="reload">Recarregar versão atual</button><button value="duplicate" class="ig-button ig-button--primary">Criar cópia com minhas alterações</button></div></form></dialog>
<aside data-diff-drawer hidden aria-label="Comparar versão"><div><h2 data-diff-title>Alterações desta revisão</h2><button type="button" data-close-diff>Fechar</button></div><p data-diff-summary></p><div data-diff-list></div></aside>
<aside class="designer-test-lab" data-test-lab hidden role="dialog" aria-modal="true" aria-labelledby="test-lab-title" tabindex="-1">
    <header><div><small>VALIDAÇÃO COM DADOS REAIS</small><h2 id="test-lab-title">Laboratório de testes</h2><p>Teste esta etiqueta com registros reais antes de publicá-la.</p></div><button type="button" data-test-lab-close>Fechar</button></header>
    <label>Buscar registros<input type="search" data-test-lab-search placeholder="Código, título ou descrição" autocomplete="off" aria-controls="test-lab-options" /></label>
    <div id="test-lab-options" data-test-lab-options role="listbox" aria-label="Registros encontrados"></div>
    <p data-test-lab-limit>Selecione até 5 registros.</p><div data-test-lab-selected></div>
    <button type="button" class="ig-button ig-button--primary" data-test-lab-run disabled>Executar testes</button>
    <section data-test-lab-summary aria-live="polite"></section><div data-test-lab-results></div>
</aside>
