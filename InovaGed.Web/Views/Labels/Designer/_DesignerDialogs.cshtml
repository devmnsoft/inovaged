@model InovaGed.Web.Models.Labels.LabelCanvasDesignerPageViewModel
<nav class="canvas-floating-tools" aria-label="Ações da seleção"><button data-action="align-left">Alinhar esquerda</button><button data-action="align-center">Centralizar</button><button data-action="align-right">Alinhar direita</button><button data-action="distribute-h">Distribuir horizontal</button><button data-action="distribute-v">Distribuir vertical</button><button data-action="front">Frente</button><button data-action="back">Trás</button><button data-action="group">Agrupar</button><button data-action="ungroup">Desagrupar</button></nav>
<partial name="_DesignerModelSettings" model="Model" />
<partial name="_DesignerValidation" model="Model" />
<dialog data-resize-dialog aria-labelledby="resize-title"><form method="dialog"><h2 id="resize-title">Alterar tamanho</h2><p data-resize-message></p><div><button value="cancel">Cancelar</button><button value="keep">Manter posições</button><button value="adapt" class="ig-button ig-button--primary">Adaptar layout</button></div></form></dialog>
<div class="designer-mobile-note">Para editar posições e tamanhos com precisão, use uma tela maior.</div><div class="designer-toast" data-toast role="status" aria-live="polite"></div>
<dialog data-confirm><form method="dialog"><h2 data-confirm-title>Confirmar</h2><p data-confirm-message></p><div><button value="cancel">Cancelar</button><button value="confirm" class="ig-button ig-button--primary">Confirmar</button></div></form></dialog>
<dialog data-publish-dialog aria-labelledby="publish-title"><form method="dialog"><h2 id="publish-title">Publicar nova versão</h2><p>As alterações desta revisão serão registradas no histórico.</p><section data-publish-diff><strong>Mudanças</strong><p data-publish-diff-summary>Carregando alterações…</p></section><section data-publish-validation><strong>Problemas de validação</strong><p data-publish-validation-summary>Nenhum problema encontrado.</p></section><label>O que mudou nesta versão?<textarea data-publish-summary rows="3" required></textarea></label><div><button value="cancel">Cancelar</button><button value="confirm" class="ig-button ig-button--primary">Publicar versão</button></div></form></dialog>
<dialog data-live-preview class="designer-preview-dialog"><form method="dialog"><h2>Prévia operacional</h2><button>Fechar</button></form><p data-live-preview-summary></p><iframe title="Prévia do template" data-live-preview-frame></iframe></dialog>
<dialog data-conflict-dialog aria-labelledby="conflict-title"><form method="dialog"><h2 id="conflict-title">Este modelo foi atualizado</h2><p>Outra pessoa salvou alterações enquanto você estava editando.</p><p>Suas alterações locais estão preservadas até você escolher como resolver.</p><div><button value="cancel">Cancelar</button><button value="compare">Comparar alterações</button><button value="reload">Recarregar versão atual</button><button value="duplicate" class="ig-button ig-button--primary">Criar cópia com minhas alterações</button></div></form></dialog>
<aside data-diff-drawer hidden aria-label="Comparar versão"><div><h2 data-diff-title>Alterações desta revisão</h2><button type="button" data-close-diff>Fechar</button></div><p data-diff-summary></p><div data-diff-list></div></aside>
