@model IReadOnlyList<InovaGed.Web.Models.Labels.LabelDesignViewModel>
@{ ViewData["Title"]="Editor Visual de Etiquetas";var official=Model.Count(x=>x.IsSystemTemplate);var custom=Model.Count-official;var draft=Model.Count(x=>x.Status=="DRAFT");var published=Model.Count(x=>x.Status=="PUBLISHED");var alerts=Model.Count(x=>x.Validations.Any(v=>v.Status=="OPEN"));var last=Model.Where(x=>x.Status=="PUBLISHED").Select(x=>x.UpdatedAt??x.CreatedAt).DefaultIfEmpty().Max(); }
@section Styles { <link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" /> }
<main class="label-designer-page"><header class="label-designer-hero"><div><span>Labels Visual Designer 2.0</span><h1>Editor Visual de Etiquetas</h1><p>Configure modelos, campos, dimensões, versões e validações de impressão das etiquetas do InovaGED.</p></div><a class="ig-button ig-button--secondary" asp-controller="Labels" asp-action="Index">Central de Etiquetas</a></header>
@if(!Model.Any()){<div class="label-designer-validation"><strong>Migration pendente.</strong> Aplique <code>2026_08_31_label_visual_designer_2.sql</code> para carregar os modelos oficiais.</div>}
<section class="label-designer-kpis" aria-label="Indicadores"><article><small>Modelos oficiais</small><strong>@official</strong></article><article><small>Modelos personalizados</small><strong>@custom</strong></article><article><small>Rascunhos</small><strong>@draft</strong></article><article><small>Publicados</small><strong>@published</strong></article><article><small>Com alerta visual</small><strong>@alerts</strong></article><article><small>Última publicação</small><strong>@(last==default?"—":last.ToString("dd/MM/yyyy"))</strong></article></section>
<section class="label-designer-table"><h2>Modelos disponíveis</h2><div class="table-responsive"><table class="table"><thead><tr><th>Modelo</th><th>Tipo</th><th>Modo</th><th>Status</th><th>Versão</th><th>Dimensão</th><th>Oficial?</th><th>Última alteração</th><th>Ações</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>@item.TemplateName</strong><code>@item.TemplateCode</code></td><td>@item.SubjectType</td><td>@item.PrintMode</td><td><span class="designer-status">@item.Status</span></td><td>v@item.CurrentVersion</td><td>@item.WidthMm × @item.HeightMm mm</td><td>@(item.IsSystemTemplate?"Sim":"Não")</td><td>@(item.UpdatedAt??item.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td><td><div class="designer-actions"><a asp-action="Details" asp-route-templateCode="@item.TemplateCode">Visualizar</a><a asp-action="Edit" asp-route-templateCode="@item.TemplateCode">Editar</a><a asp-action="Preview" asp-route-templateCode="@item.TemplateCode">Preview</a><a asp-action="PrintTest" asp-route-templateCode="@item.TemplateCode">Imprimir teste</a><a asp-action="Versions" asp-route-templateCode="@item.TemplateCode">Versões</a></div></td></tr>}</tbody></table></div></section></main>
