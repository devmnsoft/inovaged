@using InovaGed.Web.Models.Labels
@using InovaGed.Web.Security
@using Microsoft.AspNetCore.Authorization
@model LabelDesignerIndexViewModel
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Modelos de etiqueta";
    ViewData["LabelHelpContext"] = "DESIGNER";
    var canCreate = (await AuthorizationService.AuthorizeAsync(User, AppPolicies.LabelDesignerCreate)).Succeeded;
    var isAdministrator = (await AuthorizationService.AuthorizeAsync(User, AppPolicies.Administracao)).Succeeded;
    var groups = new[]
    {
        (Key: "mine", Title: "Meus modelos", Items: Model.Items.Where(x => !x.IsSystem && !x.IsLegacy)),
        (Key: "system", Title: "Modelos padrão", Items: Model.Items.Where(x => x.IsSystem && !x.IsLegacy)),
        (Key: "legacy", Title: "Modelos antigos", Items: Model.Items.Where(x => x.IsLegacy))
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/labels-studio.css" asp-append-version="true" />
}

<main class="label-designer-page">
    <header class="label-designer-hero">
        <div>
            <small>Modelos de etiqueta</small>
            <h1>Seus modelos</h1>
            <p>Crie, edite e publique layouts sem expor configurações técnicas.</p>
        </div>
        <div class="designer-actions">
            <partial name="~/Views/Labels/Shared/_LabelHelpDrawer.cshtml" />
            <a class="ig-button ig-button--secondary" asp-controller="Labels" asp-action="Index">Voltar</a>
            @if (canCreate && Model.SchemaActionAllowed)
            {
                <button type="button" class="ig-button ig-button--secondary" data-import-open>Importar modelo</button>
                <a class="ig-button ig-button--primary" asp-action="New">Novo modelo</a>
            }
        </div>
    </header>

    @if (!Model.SchemaReady)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Módulo de etiquetas precisa ser atualizado</strong><p class="mb-1">@Model.SchemaMessage</p>@if (isAdministrator) { <a class="btn btn-sm btn-warning" href="/DatabaseReadiness">Ver atualizações do banco</a> } else { <span>Entre em contato com o administrador.</span> }
        </div>
    }

    @if (Model.SchemaReady && Model.Items.Count == 0)
    {
        <section class="label-designer-table">
            <p>Nenhum modelo de etiqueta encontrado.</p>
            @if (canCreate)
            {
                <a class="ig-button ig-button--primary" asp-action="New">Novo modelo</a>
            }
        </section>
    }
    else if (Model.SchemaReady)
    {
        <section class="designer-filters">
            <label>
                <span class="visually-hidden">Buscar modelo</span>
                <input type="search" placeholder="Buscar por nome, cliente, finalidade ou perfil..." data-model-search />
            </label>
            <nav aria-label="Filtros">
                <button class="is-active" data-model-filter="all">Todos</button>
                <button data-model-filter="draft">Rascunhos</button>
                <button data-model-filter="published">Publicados</button>
                <button data-model-filter="mine">Meus modelos</button>
                <button data-model-filter="system">Modelos padrão</button>
                <button data-model-filter="legacy">Antigos</button>
            </nav>
            <div class="d-flex flex-wrap gap-2">
                <select class="form-select form-select-sm" data-purpose-filter aria-label="Filtrar por finalidade"><option value="">Todas as finalidades</option>@foreach(var value in Model.Items.Select(x=>x.Purpose).Distinct().Order()){<option value="@value.ToLowerInvariant()">@value</option>}</select>
                <select class="form-select form-select-sm" data-client-filter aria-label="Filtrar por cliente"><option value="">Todos os clientes</option>@foreach(var value in Model.Items.Select(x=>x.ClientName).Distinct().Order()){<option value="@value.ToLowerInvariant()">@value</option>}</select>
                <select class="form-select form-select-sm" data-status-filter aria-label="Filtrar por status"><option value="">Todos os status</option><option value="draft">Rascunho</option><option value="published">Publicado</option></select>
            </div>
            <div class="btn-group btn-group-sm" aria-label="Modo de visualização"><button type="button" data-designer-view="cards">Cards</button><button type="button" data-designer-view="list">Lista</button></div>
        </section>

        @foreach (var group in groups)
        {
            <section class="label-designer-table" data-model-group="@group.Key">
                <header><h2>@group.Title</h2></header>
                <div class="row g-3" data-designer-cards>
                    @foreach (var item in group.Items)
                    {
                        var normalizedStatus = item.Status.ToLowerInvariant();
                        var search = $"{item.Name} {item.ClientName} {item.Purpose} {item.BrandingProfileName}".ToLowerInvariant();
                        var aspectRatio = (item.WidthMm / item.HeightMm).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
                        <article class="col-md-6 col-xl-4 designer-card" data-model-row data-status="@normalizedStatus" data-purpose="@item.Purpose.ToLowerInvariant()" data-client="@item.ClientName.ToLowerInvariant()" data-system="@item.IsSystem.ToString().ToLowerInvariant()" data-legacy="@item.IsLegacy.ToString().ToLowerInvariant()" data-search="@search">
                            <div class="card h-100"><div class="card-body"><div class="bg-light rounded mb-3 overflow-hidden" style="aspect-ratio:@aspectRatio"><iframe class="w-100 h-100 border-0" loading="lazy" title="Miniatura de @item.Name" data-thumbnail-src="@Url.Action("Thumbnail", new { templateKey = item.TemplateKey })"></iframe></div><h3 class="h6">@item.Name</h3><p class="small text-muted mb-2">@item.ClientName · @item.Purpose</p><p class="small">@item.Dimensions · versão @item.Version · @(normalizedStatus == "draft" ? "Rascunho" : "Publicado")</p><div class="d-flex flex-wrap gap-2 small"><a asp-action="Edit" asp-route-templateKey="@item.TemplateKey">Editar</a><details class="row-more"><summary aria-label="Mais ações">···</summary><a asp-action="Preview" asp-route-templateKey="@item.TemplateKey">Prévia</a><a asp-action="Versions" asp-route-templateKey="@item.TemplateKey">Versões</a><a asp-action="Export" asp-route-templateKey="@item.TemplateKey">Exportar</a></details></div></div></div>
                        </article>
                    }
                </div>
                <div class="table-responsive d-none" data-designer-list>
                    <table class="table">
                        <thead><tr><th>Modelo</th><th>Finalidade</th><th>Cliente</th><th>Status</th><th>Versão</th><th>Dimensões</th><th>Última alteração</th><th>Ações</th></tr></thead>
                        <tbody>
                        @foreach (var item in group.Items)
                        {
                            var normalizedStatus = item.Status.ToLowerInvariant();
                            var search = $"{item.Name} {item.ClientName} {item.Purpose} {item.BrandingProfileName}".ToLowerInvariant();
                            <tr data-model-row
                                data-status="@normalizedStatus"
                                data-name="@item.Name.ToLowerInvariant()"
                                data-client="@item.ClientName.ToLowerInvariant()"
                                data-system="@item.IsSystem.ToString().ToLowerInvariant()"
                                data-legacy="@item.IsLegacy.ToString().ToLowerInvariant()"
                                data-search="@search">
                                <td><strong>@item.Name</strong><small>@item.Health</small></td>
                                <td>@item.Purpose</td>
                                <td><strong>@item.ClientName</strong><small>@item.BrandingProfileName</small></td>
                                <td><span class="designer-status is-@normalizedStatus">@(normalizedStatus == "draft" ? "Rascunho" : $"Publicado · versão {item.Version}")</span></td>
                                <td>@item.Version</td>
                                <td>@item.Dimensions</td>
                                <td>@item.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a asp-action="Edit" asp-route-templateKey="@item.TemplateKey">@(item.CanEdit ? "Editar" : "Visualizar")</a>
                                    <details class="row-more">
                                        <summary aria-label="Mais ações">···</summary>
                                        <a asp-action="Preview" asp-route-templateKey="@item.TemplateKey">Prévia</a>
                                        <a asp-action="Versions" asp-route-templateKey="@item.TemplateKey">Versões</a>
                                        <a asp-action="Export" asp-route-templateKey="@item.TemplateKey">Exportar</a>
                                    </details>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        <p data-model-empty hidden>Nenhum modelo corresponde aos filtros.</p>
    }
</main>
@if(canCreate){<dialog data-import-dialog><form method="dialog"><button aria-label="Fechar">×</button></form><h2>Importar modelo</h2><p>Selecione um pacote JSON. Nada será criado antes da confirmação.</p><form data-import-form>@Html.AntiForgeryToken()<input type="file" name="file" accept="application/json,.json" required /><button type="submit" class="ig-button ig-button--primary">Validar pacote</button></form><section data-import-preview hidden aria-live="polite"><h3 data-import-name></h3><dl><dt>Finalidade</dt><dd data-import-purpose></dd><dt>Tamanho</dt><dd data-import-size></dd><dt>Elementos</dt><dd data-import-elements></dd></dl><p data-import-error role="alert"></p><button type="button" class="ig-button ig-button--primary" data-import-confirm>Confirmar importação</button></section></dialog>}

@section Scripts {
    <script src="~/js/labels-help.js" asp-append-version="true"></script>
    <script>
        (() => {
            const rows = [...document.querySelectorAll('[data-model-row]')];
            const groups = [...document.querySelectorAll('[data-model-group]')];
            const empty = document.querySelector('[data-model-empty]');
            const search = document.querySelector('[data-model-search]');
            const purpose = document.querySelector('[data-purpose-filter]');
            const client = document.querySelector('[data-client-filter]');
            const status = document.querySelector('[data-status-filter]');
            const viewKey = 'inovaged.labels.designer.indexView.v1';
            let filter = 'all';

            const refresh = () => {
                const term = (search?.value || '').trim().toLocaleLowerCase();
                let visibleCount = 0;
                rows.forEach(row => {
                    const system = row.dataset.system === 'true';
                    const legacy = row.dataset.legacy === 'true';
                    const matchesFilter = filter === 'all'
                        || (filter === 'draft' && row.dataset.status === 'draft')
                        || (filter === 'published' && row.dataset.status === 'published')
                        || (filter === 'mine' && !system && !legacy)
                        || (filter === 'system' && system && !legacy)
                        || (filter === 'legacy' && legacy);
                    const visible = matchesFilter && row.dataset.search.includes(term)
                        && (!purpose?.value || row.dataset.purpose === purpose.value)
                        && (!client?.value || row.dataset.client === client.value)
                        && (!status?.value || row.dataset.status === status.value);
                    row.hidden = !visible;
                    if (visible) visibleCount++;
                });
                groups.forEach(group => group.hidden = !group.querySelector('[data-model-row]:not([hidden])'));
                if (empty) empty.hidden = visibleCount !== 0;
            };

            document.querySelectorAll('[data-model-filter]').forEach(button => button.addEventListener('click', () => {
                filter = button.dataset.modelFilter;
                document.querySelectorAll('[data-model-filter]').forEach(item => item.classList.toggle('is-active', item === button));
                refresh();
            }));
            search?.addEventListener('input', refresh);
            [purpose, client, status].forEach(select => select?.addEventListener('change', refresh));
            const thumbnails = [...document.querySelectorAll('[data-thumbnail-src]')];
            const loadThumbnail = frame => { if (!frame.src) frame.src = frame.dataset.thumbnailSrc; };
            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) { loadThumbnail(entry.target); observer.unobserve(entry.target); } }), { rootMargin: '240px' });
                thumbnails.forEach(frame => observer.observe(frame));
            } else thumbnails.forEach(loadThumbnail);
            const setView = mode => {
                document.querySelectorAll('[data-designer-cards]').forEach(x => x.classList.toggle('d-none', mode !== 'cards'));
                document.querySelectorAll('[data-designer-list]').forEach(x => x.classList.toggle('d-none', mode !== 'list'));
                document.querySelectorAll('[data-designer-view]').forEach(x => x.classList.toggle('is-active', x.dataset.designerView === mode));
                localStorage.setItem(viewKey, mode);
            };
            document.querySelectorAll('[data-designer-view]').forEach(x => x.addEventListener('click', () => setView(x.dataset.designerView)));
            setView(localStorage.getItem(viewKey) || 'cards');
            refresh();
            const dialog=document.querySelector('[data-import-dialog]'),form=document.querySelector('[data-import-form]'),preview=document.querySelector('[data-import-preview]');let selectedFile;
            document.querySelector('[data-import-open]')?.addEventListener('click',()=>dialog.showModal());
            const sendImport=async confirm=>{const body=new FormData();body.append('file',selectedFile);body.append('confirm',String(confirm));const response=await fetch('/Labels/Designer/Import',{method:'POST',headers:{RequestVerificationToken:form.querySelector('[name="__RequestVerificationToken"]').value},body});const data=await response.json();if(!response.ok)throw new Error(data.message||'Não foi possível validar o pacote.');return data;};
            form?.addEventListener('submit',async event=>{event.preventDefault();selectedFile=form.file.files[0];if(!selectedFile)return;preview.hidden=false;preview.querySelector('[data-import-error]').textContent='Validando…';try{const data=await sendImport(false);preview.querySelector('[data-import-name]').textContent=data.name;preview.querySelector('[data-import-purpose]').textContent=data.purpose;preview.querySelector('[data-import-size]').textContent=data.size;preview.querySelector('[data-import-elements]').textContent=data.elementCount;preview.querySelector('[data-import-error]').textContent='Pacote válido. Revise os dados antes de confirmar.';}catch(error){preview.querySelector('[data-import-error]').textContent=error.message;}});
            document.querySelector('[data-import-confirm]')?.addEventListener('click',async event=>{event.currentTarget.disabled=true;try{const data=await sendImport(true);location.href=data.redirectUrl;}catch(error){preview.querySelector('[data-import-error]').textContent=error.message;event.currentTarget.disabled=false;}});
        })();
    </script>
}
