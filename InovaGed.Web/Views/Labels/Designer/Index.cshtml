@model IReadOnlyList<InovaGed.Application.Labels.Canvas.LabelCanvasDesignDto>
@{ ViewData["Title"]="Designer Visual de Etiquetas";var drafts=Model.Count(x=>x.Status=="DRAFT");var published=Model.Count(x=>x.Status=="PUBLISHED");var locdesk=Model.Count(x=>x.TemplateKind is "LOCDESK" or "HOL"); }
@section Styles { <link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true" /> }
<main class="label-designer-page">
 <header class="label-designer-hero"><div><span>Governança documental · RC22</span><h1>Designer Visual de Etiquetas</h1><p>Crie modelos precisos em milímetros, conecte dados do GED e publique versões auditáveis sem alterar os templates clássicos.</p></div><div class="designer-actions"><a class="ig-button ig-button--secondary" asp-controller="Labels" asp-action="Index">Central de Etiquetas</a><a class="ig-button ig-button--primary" asp-action="New">Novo modelo</a></div></header>
 @if(ViewBag.SchemaPending==true){<div class="designer-alert is-error"><strong>Migration do canvas pendente.</strong><span>Aplique <code>2026_09_08_label_canvas_designer_rc22.sql</code> antes de operar o designer.</span></div>}
 <section class="label-designer-kpis" aria-label="Resumo"><article><small>Templates</small><strong>@Model.Count</strong><span>visíveis neste tenant</span></article><article><small>Rascunhos</small><strong>@drafts</strong><span>em preparação</span></article><article><small>Publicados</small><strong>@published</strong><span>disponíveis para impressão</span></article><article><small>LocDesk / HOL</small><strong>@locdesk</strong><span>modelos especializados</span></article></section>
 <section class="label-designer-table"><header><div><span>Biblioteca governada</span><h2>Modelos de etiqueta</h2></div><a asp-action="New">Criar template</a></header><div class="table-responsive"><table class="table"><thead><tr><th>Modelo</th><th>Finalidade</th><th>Status</th><th>Versão</th><th>Formato</th><th>Atualização</th><th>Ações</th></tr></thead><tbody>
 @if(!Model.Any()){<tr><td colspan="7"><div class="designer-empty"><h3>Nenhum template canvas disponível</h3><p>Crie um rascunho ou aplique a migration de dados iniciais.</p><a class="ig-button ig-button--primary" asp-action="New">Novo modelo</a></div></td></tr>}
 @foreach(var item in Model){<tr><td><strong>@item.TemplateName</strong><small>@item.TemplateKey</small></td><td><b>@item.TemplateKind</b><small>@item.SubjectType</small></td><td><span class="designer-status is-@item.Status.ToLowerInvariant()">@item.Status</span></td><td>v@item.CurrentVersion</td><td>@item.WidthMm × @item.HeightMm mm<small>@item.PaperKind · @item.Orientation</small></td><td>@(item.UpdatedAt??item.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td><td><div class="designer-actions"><a asp-action="Edit" asp-route-templateKey="@item.TemplateKey">Abrir</a><a asp-action="Preview" asp-route-templateKey="@item.TemplateKey">Preview</a><a asp-action="Versions" asp-route-templateKey="@item.TemplateKey">Versões</a></div></td></tr>}
 </tbody></table></div></section>
</main>
