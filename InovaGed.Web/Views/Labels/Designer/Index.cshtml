@model IReadOnlyList<InovaGed.Application.Labels.Canvas.LabelCanvasDesignDto>
@{ViewData["Title"]="Modelos de etiqueta";ViewData["LabelHelpContext"]="DESIGNER";string Purpose(string x)=>x switch{"Box"=>"Caixa","Document"=>"Documento","Folder"=>"Pasta","MedicalRecord"=>"Prontuário","Process"=>"Processo","LocDeskFolder"=>"Pasta antiga","LocDeskBox"=>"Caixa antiga",_=>"Uso geral"};}
@section Styles {<link rel="stylesheet" href="~/css/labels-designer.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/labels-studio.css" asp-append-version="true"/>}
<main class="label-designer-page"><header class="label-designer-hero"><div><small>Modelos de etiqueta</small><h1>Seus modelos</h1><p>Crie, edite e publique layouts sem expor configurações técnicas.</p></div><div class="designer-actions"><partial name="~/Views/Labels/Shared/_LabelHelpDrawer.cshtml"/><a class="ig-button ig-button--secondary" asp-controller="Labels" asp-action="Index">Voltar</a><a class="ig-button ig-button--primary" asp-action="New">Novo modelo</a></div></header>
<section class="designer-filters"><label><span class="visually-hidden">Buscar modelo</span><input type="search" placeholder="Buscar modelo..." data-model-search/></label><nav aria-label="Filtros"><button class="is-active" data-model-filter="all">Todos</button><button data-model-filter="draft">Rascunhos</button><button data-model-filter="published">Publicados</button><button data-model-filter="mine">Meus modelos</button><button data-model-filter="system">Modelos do sistema</button><button data-model-filter="legacy">Antigos</button></nav></section>
@foreach(var group in new[]{("mine","Meus modelos",Model.Where(x=>!x.IsSystemTemplate&&x.LabelContext!="LEGACY")),("system","Modelos padrão",Model.Where(x=>x.IsSystemTemplate&&x.LabelContext!="LEGACY")),("legacy","Modelos antigos",Model.Where(x=>x.LabelContext=="LEGACY"))}){<section class="label-designer-table" data-model-group="@group.Item1"><header><h2>@group.Item2</h2></header><div class="table-responsive"><table class="table"><thead><tr><th>Modelo</th><th>Finalidade</th><th>Cliente</th><th>Status</th><th>Última alteração</th><th>Ações</th></tr></thead><tbody>@foreach(var item in group.Item3){<tr data-model-row data-status="@item.Status.ToLowerInvariant()" data-name="@item.TemplateName.ToLowerInvariant()"><td><strong>@item.TemplateName</strong><small>@item.WidthMm × @item.HeightMm mm</small></td><td>@Purpose(item.SubjectType)</td><td>@(item.LabelContext=="LEGACY"?"Compatibilidade":"Perfil visual")</td><td><span class="designer-status is-@item.Status.ToLowerInvariant()">@(item.Status=="DRAFT"?"Rascunho":$"Publicado · versão {item.CurrentVersion}")</span></td><td>@(item.UpdatedAt??item.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td><td><a asp-action="Edit" asp-route-templateKey="@item.TemplateKey">@(item.CanEdit?"Editar":"Visualizar")</a><details class="row-more"><summary aria-label="Mais ações">···</summary><a asp-action="Preview" asp-route-templateKey="@item.TemplateKey">Prévia</a><a asp-action="Versions" asp-route-templateKey="@item.TemplateKey">Versões</a></details></td></tr>}</tbody></table></div></section>}</main>
@section Scripts {<script src="~/js/labels-help.js" asp-append-version="true"></script><script>document.querySelectorAll('[data-model-filter]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-model-filter]').forEach(x=>x.classList.toggle('is-active',x===b));document.querySelectorAll('[data-model-group]').forEach(g=>g.hidden=b.dataset.modelFilter!=='all'&&b.dataset.modelFilter!==g.dataset.modelGroup&&!(b.dataset.modelFilter==='draft'||b.dataset.modelFilter==='published'));document.querySelectorAll('[data-model-row]').forEach(r=>r.hidden=(b.dataset.modelFilter==='draft'||b.dataset.modelFilter==='published')&&r.dataset.status!==b.dataset.modelFilter)});document.querySelector('[data-model-search]')?.addEventListener('input',e=>document.querySelectorAll('[data-model-row]').forEach(r=>r.hidden=!r.dataset.name.includes(e.target.value.toLowerCase())));</script>}
