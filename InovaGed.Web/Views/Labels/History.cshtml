@model IEnumerable<dynamic>
@{ ViewData["Title"]="Histórico de Impressões"; ViewData["WorkspaceVariant"]="wide"; var rows=(Model ?? Enumerable.Empty<dynamic>()).ToList(); var q=(ViewBag.Q as string)??""; var today=rows.Count(r=>Convert.ToDateTime(r.printed_at).Date==DateTime.Today); var reprints=rows.Count(r=>r.reprint_reason!=null); var locdesk=rows.Count(r=>Convert.ToString(r.template_code)?.StartsWith("LOCDESK")==true); var boxes=rows.Count(r=>Convert.ToString(r.label_type)=="BOX"); var documents=rows.Count(r=>Convert.ToString(r.label_type)=="DOCUMENT"); }
@section Styles { <link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true" /> }
<div class="ig-label-page"><section class="ig-page-hero"><div><span class="ig-eyebrow"><app-icon name="history" size="16" decorative="true" /> Auditoria operacional</span><h1>Histórico de Impressões</h1><p>Consulte emissões, modelos, responsáveis e justificativas de reimpressão.</p></div><a class="ig-button ig-button--primary" asp-action="PrintWizard"><app-icon name="print" size="17" decorative="true" /> Nova impressão</a></section>
@if (ViewBag.SchemaPending == true) { <section class="alert alert-warning shadow-sm" role="alert"><h2 class="h5">Estrutura de banco pendente</h2><p>Esta funcionalidade depende de uma migration ainda não aplicada. Acesse a Prontidão do Banco para aplicar as migrations obrigatórias.</p><a class="ig-button ig-button--primary" href="/DatabaseReadiness">Abrir Prontidão do Banco</a></section> }
<section class="ig-label-kpis" aria-label="Indicadores de impressão">@foreach(var kpi in new List<(string Label,int Value)>{("Impressões hoje",today),("Reimpressões",reprints),("Etiquetas LocDesk",locdesk),("Etiquetas de caixa",boxes),("Etiquetas de documento",documents)}){<article class="ig-label-kpi"><small>@kpi.Label</small><strong>@kpi.Value</strong></article>}</section>
<form method="get" class="ig-label-toolbar"><div class="ig-label-toolbar__grid"><div><label class="form-label" for="period">Período</label><select id="period" class="form-select"><option>Todo o período</option><option>Hoje</option><option>Últimos 7 dias</option></select></div><div><label class="form-label" for="type">Tipo de etiqueta</label><select id="type" name="type" class="form-select"><option value="">Todos</option><option value="BOX">Caixa</option><option value="DOCUMENT">Documento</option></select></div><div><label class="form-label" for="template">Modelo</label><select id="template" name="template" class="form-select"><option value="">Todos</option><option>FACTORY_BOX_V1</option><option>FACTORY_DOCUMENT_V1</option><option>LOCDESK_CAIXA_V1</option><option>LOCDESK_PASTA_V1</option></select></div><div><label class="form-label" for="q">Usuário ou referência</label><input id="q" name="q" value="@q" class="form-control" placeholder="Nome, controle ou assunto" /></div><div><label class="form-label" for="mode">Status / modo</label><select id="mode" name="mode" class="form-select"><option value="">Todos</option><option value="FACTORY">Padrão</option><option value="CUSTOM">Personalizado</option></select></div><div class="d-flex gap-2"><button class="ig-button ig-button--primary" type="submit">Filtrar</button><a class="ig-button ig-button--secondary" asp-action="History">Limpar</a></div></div></form>
<section class="ig-premium-table-shell"><header><div><h2>Impressões registradas</h2><p>@rows.Count registro(s) encontrados na auditoria.</p></div></header><div class="ig-premium-table-scroll"><table class="ig-premium-table"><thead><tr><th>Data e hora</th><th>Modelo</th><th>Tipo</th><th>Referência</th><th>Usuário</th><th>Status</th><th class="text-end">Ações</th></tr></thead><tbody>@if(!rows.Any()){<tr><td colspan="7"><partial name="Atlas/_PremiumEmptyState" view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { { "Description", "Quando houver movimentações, elas aparecerão nesta área." }, { "Icon", "history" } }' /></td></tr>}else{@foreach(var r in rows){var type=Convert.ToString(r.label_type);var reference=type=="BOX"?$"Caixa #{r.box_no} — {r.label_code}":$"{r.document_code} — {r.document_title}";<tr><td class="text-nowrap">@Convert.ToDateTime(r.printed_at).ToString("dd/MM/yyyy HH:mm")</td><td><strong>@r.template_name</strong><small class="d-block text-muted">@r.template_code</small></td><td><span class="ig-status-badge">@(type=="BOX"?"Caixa":"Documento")</span></td><td>@reference</td><td>@(r.printed_by_name??"Não informado")</td><td><span class="ig-status-badge @(r.reprint_reason==null?"ig-status-badge--ok":"ig-status-badge--warning")">@(r.reprint_reason==null?"Emitida":"Reimpressão")</span></td><td class="text-end"><a class="ig-button ig-button--secondary" asp-action="PrintDetails" asp-route-id="@r.id">Detalhes</a></td></tr>}}</tbody></table></div></section></div>
