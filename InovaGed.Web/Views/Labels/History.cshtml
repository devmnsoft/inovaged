@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Histórico de Impressões";
    ViewData["WorkspaceVariant"] = "wide";
    var rows = (Model ?? Enumerable.Empty<dynamic>()).ToList();
    var q = (ViewBag.Q as string) ?? "";
    var today = rows.Count(r => Convert.ToDateTime(r.printed_at).Date == DateTime.Today);
    var reprints = rows.Count(r => !string.IsNullOrWhiteSpace(Convert.ToString(r.reprint_reason)));
    var locdesk = rows.Count(r => Convert.ToString(r.template_code)?.StartsWith("LOCDESK", StringComparison.OrdinalIgnoreCase) == true);
    var boxes = rows.Count(r => Convert.ToString(r.label_type) == "BOX");
    var withLogo = rows.Count(r => Convert.ToBoolean(r.has_logo));
    var kpis = new List<(string Label, int Value, string Icon)>
    {
        ("Impressões hoje", today, "recent"),
        ("Reimpressões", reprints, "history"),
        ("Etiquetas LocDesk", locdesk, "tag"),
        ("Etiquetas de caixa", boxes, "box"),
        ("Com logo aplicada", withLogo, "image"),
        ("Total no período", rows.Count, "report")
    };
}
@section Styles { <link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true" /> <link rel="stylesheet" href="~/css/labels-history.css" asp-append-version="true" /> }
<div class="ig-label-page label-history-page">
    <section class="ig-page-hero label-history-hero">
        <div><span class="ig-eyebrow"><app-icon name="history" size="16" decorative="true" /> Auditoria operacional</span><h1>Histórico de Impressões</h1><p>Acompanhe impressões, reimpressões, modelos utilizados, usuários, origens e rastreabilidade das etiquetas.</p></div>
        <nav class="label-history-actions" aria-label="Ações rápidas"><a class="ig-button ig-button--primary" asp-action="PrintWizard"><app-icon name="printer" size="17" decorative="true" /> Nova impressão</a><a class="ig-button ig-button--secondary" asp-action="Templates"><app-icon name="layout-template" size="17" decorative="true" /> Estúdio de Modelos</a><a class="ig-button ig-button--secondary" asp-action="LocDesk"><app-icon name="tag" size="17" decorative="true" /> Etiqueta LocDesk</a><a class="ig-button ig-button--secondary" asp-action="Index"><app-icon name="arrow-left" size="17" decorative="true" /> Central de Etiquetas</a></nav>
    </section>
    @if (ViewBag.SchemaPending == true) { <partial name="Atlas/_PremiumAlert" view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { { "AlertTitle", "Estrutura de banco pendente" }, { "Message", "Esta funcionalidade depende de uma migration ainda não aplicada." }, { "Recommendation", "Valide e aplique as migrations obrigatórias antes de operar o histórico." }, { "Tone", "schema" }, { "ActionLabel", "Abrir Prontidão do Banco" }, { "ActionUrl", "/DatabaseReadiness" } }' /> }
    <section class="ig-label-kpis label-history-kpi-grid" aria-label="Indicadores de impressão">
        @foreach (var kpi in kpis) { <article class="ig-label-kpi"><span><app-icon name="@kpi.Icon" size="19" decorative="true" /></span><div><small>@kpi.Label</small><strong>@kpi.Value</strong><em>Dados do período</em></div><b>Atual</b></article> }
    </section>
    <form method="get" class="ig-label-toolbar label-history-toolbar" aria-label="Filtros do histórico">
        <div class="label-history-toolbar__heading"><div><span>Refine a auditoria</span><h2>Filtros</h2></div><small>Período, tipo, modelo, usuário e texto livre consultam dados reais; novos estados dependem de persistência no backend.</small></div>
        <div class="ig-label-toolbar__grid"><div><label class="form-label" for="startDate">Período inicial</label><input id="startDate" name="startDate" type="date" class="form-control" value="@ViewBag.StartDate" /></div><div><label class="form-label" for="endDate">Período final</label><input id="endDate" name="endDate" type="date" class="form-control" value="@ViewBag.EndDate" /></div><div><label class="form-label" for="type">Tipo de etiqueta</label><select id="type" name="type" class="form-select"><option value="">Todos</option><option value="BOX">Caixa</option><option value="DOCUMENT">Documento</option><option value="BATCH">Lote</option></select></div><div><label class="form-label" for="template">Modelo</label><select id="template" name="template" class="form-select"><option value="">Todos</option><option>FACTORY_BOX_V1</option><option>FACTORY_DOCUMENT_V1</option><option>LOCDESK_CAIXA_V1</option><option>LOCDESK_PASTA_V1</option><option value="LOCDESK_PASTA_HOL_V1">LocDesk - Pasta HOL</option></select></div><div><label class="form-label" for="user">Usuário</label><input id="user" name="user" value="@ViewBag.User" class="form-control" placeholder="Nome do usuário" /></div><div><label class="form-label" for="status">Status</label><select id="status" name="status" class="form-select"><option value="">Todos</option><option value="PRINTED">Impresso</option><option value="REPRINTED">Reimpresso</option></select></div><div><label class="form-label" for="q">Texto livre</label><input id="q" name="q" value="@q" class="form-control" placeholder="Controle, origem ou assunto" /></div><div><label class="form-label" for="mode">Status / modo</label><select id="mode" name="mode" class="form-select"><option value="">Todos</option><option value="FACTORY">Impresso / padrão</option><option value="CUSTOM">LocDesk / personalizado</option></select></div><div class="labels-history-filter-actions"><button class="ig-button ig-button--primary" type="submit"><app-icon name="search" size="16" decorative="true" /> Filtrar</button><a class="ig-button ig-button--secondary" asp-action="History">Limpar</a></div></div>
    </form>
    <section class="ig-premium-table-shell atlas-table-shell label-history-table-shell"><header><div><span class="ig-eyebrow">Trilha auditável</span><h2>Impressões registradas</h2><p>@rows.Count registro(s) encontrados · limite seguro de 500 registros.</p></div><a asp-action="PrintWizard" class="ig-button ig-button--secondary">Nova impressão</a></header><div class="ig-premium-table-scroll"><table class="ig-premium-table atlas-table"><thead><tr><th>Data/Hora</th><th>Modelo</th><th>Tipo</th><th>Origem</th><th>Usuário</th><th>Cópias</th><th>Logo</th><th>Reimpressão</th><th>Status</th><th class="text-end">Ações</th></tr></thead><tbody>
    @if (!rows.Any()) { <tr><td colspan="10"><div class="label-history-empty"><span><app-icon name="print" size="34" decorative="true" /></span><h3>Nenhuma impressão encontrada.</h3><p>As impressões realizadas pelo assistente ou pelos modelos LocDesk aparecerão nesta área.</p><a class="ig-button ig-button--primary" asp-action="PrintWizard">Nova impressão</a></div></td></tr> }
    else { @foreach (var r in rows) { var type = Convert.ToString(r.label_type) ?? ""; var isReprint = !string.IsNullOrWhiteSpace(Convert.ToString(r.reprint_reason)); var code = Convert.ToString(r.template_code) ?? ""; var version = Convert.ToString(r.template_version); var isDesigner = Convert.ToBoolean(r.is_designer_template); var isHol = code.Equals("LOCDESK_PASTA_HOL_V1", StringComparison.OrdinalIgnoreCase); var isLocDesk = code.StartsWith("LOCDESK", StringComparison.OrdinalIgnoreCase); var hasLogo = Convert.ToBoolean(r.has_logo); var reference = type == "BOX" ? $"Caixa #{r.box_no} — {r.label_code}" : type == "DOCUMENT" ? $"{r.document_code} — {r.document_title}" : Convert.ToString(r.control_number) ?? "Lote"; <tr><td class="text-nowrap"><strong>@Convert.ToDateTime(r.printed_at).ToString("dd/MM/yyyy")</strong><small>@Convert.ToDateTime(r.printed_at).ToString("HH:mm")</small></td><td><strong>@r.template_name</strong><small class="d-block text-muted">@code · @(string.IsNullOrWhiteSpace(version)?"Versão não registrada":$"v{version}") @(isDesigner?"· Designer":"")</small></td><td><span class="ig-status-badge @(isLocDesk ? "is-locdesk" : type == "BOX" ? "is-box" : "is-document")">@(isHol ? "LocDesk HOL" : isLocDesk ? "LocDesk" : type == "BOX" ? "Caixa" : type == "BATCH" ? "Lote" : "Documento")</span></td><td>@reference</td><td>@(r.printed_by_name ?? "Não informado")</td><td><strong>@r.copies</strong></td><td><span class="ig-status-badge @(hasLogo ? "ig-status-badge--ok" : "is-muted")">@(hasLogo ? "Com logo" : "Sem logo")</span></td><td><span class="ig-status-badge @(isReprint ? "ig-status-badge--warning" : "is-muted")">@(isReprint ? "Reimpresso" : "Não")</span></td><td><span class="ig-status-badge ig-status-badge--ok">Impresso</span></td><td class="text-end"><div class="label-history-actions"><a title="Visualizar" asp-action="HistoryDetails" asp-route-id="@r.id"><app-icon name="preview" size="16" decorative="true" /><span>Visualizar</span></a><a title="Reimprimir" asp-action="PrintWizard" asp-route-subjectType="@type" asp-route-subjectId="@r.subject_id" asp-route-templateCode="@code"><app-icon name="print" size="16" decorative="true" /><span>Reimprimir</span></a><a title="Rastrear" asp-action="TraceIndex"><app-icon name="qr-code" size="16" decorative="true" /><span>Rastrear</span></a><a title="Abrir origem" asp-action="HistoryDetails" asp-route-id="@r.id"><app-icon name="arrow-right" size="16" decorative="true" /><span>Abrir origem</span></a></div></td></tr> } }
    </tbody></table></div></section>
    <footer class="labels-history-guidance"><app-icon name="information" size="20" decorative="true" /><p><strong>Rastreabilidade preservada.</strong> Reimpressões exigem justificativa e cada emissão mantém usuário, origem, modelo e evidência técnica.</p><a asp-action="Index">Abrir Central de Etiquetas</a></footer>
</div>
