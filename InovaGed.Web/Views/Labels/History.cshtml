@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Histórico de Impressão de Etiquetas";
    ViewData["Subtitle"] = "Auditoria de etiquetas impressas para caixas e documentos.";
    var q = (ViewBag.Q as string) ?? "";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0">@ViewData["Title"]</h4>
        <div class="text-muted small">@ViewData["Subtitle"]</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Labels" asp-action="Boxes">
            Etiquetas de Caixas
        </a>

        <a class="btn btn-outline-secondary btn-sm" asp-controller="Labels" asp-action="Documents">
            Etiquetas de Documentos
        </a>
    </div>
</div>

<form method="get" class="card mb-3">
    <div class="card-body row g-2">
        <div class="col-md-2"><select name="mode" class="form-select"><option value="">Todos os modos</option><option value="FACTORY">Padrão de fábrica</option><option value="CUSTOM">Personalizado</option></select></div>
        <div class="col-md-2"><select name="template" class="form-select"><option value="">Todos os modelos</option><option>FACTORY_BOX_V1</option><option>FACTORY_DOCUMENT_V1</option><option>LOCDESK_CAIXA_V1</option><option>LOCDESK_PASTA_V1</option></select></div>
        <div class="col-md-2"><select name="type" class="form-select"><option value="">Todos os tipos</option><option value="BOX">Caixa</option><option value="DOCUMENT">Documento/Pasta</option><option value="MANUAL_LABEL">Manual</option><option value="BATCH">Lote</option></select></div>
        <div class="col-md-4">
            <input name="q"
                   value="@q"
                   class="form-control"
                   placeholder="Buscar por controle, localização, assunto, classificação, template ou usuário..." />
        </div>

        <div class="col-md-2 d-flex gap-2"><button class="btn btn-primary" type="submit">
            <app-icon name="search"></app-icon>Pesquisar
        </button>

        <a class="btn btn-outline-secondary" asp-action="History">Limpar</a></div>
    </div>
</form>

<div class="card">
    <div class="card-header">
        <strong>Impressões registradas</strong>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Data/Hora</th>
                    <th>Modo / modelo</th><th>Tipo</th>
                    <th>Referência</th>
                    <th>Usuário</th>
                    <th>IP</th>
                    <th>Template / hash</th>
                    <th>Motivo</th><th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var r in Model ?? Enumerable.Empty<dynamic>())
                {
                    var type = Convert.ToString(r.label_type);

                    var reference = type == "BOX"
                    ? $"Caixa #{r.box_no} — {r.label_code}"
                    : $"{r.document_code} — {r.document_title}";

                    <tr>
                        <td class="text-nowrap">
                            @Convert.ToDateTime(r.printed_at).ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td><span class="badge @(Convert.ToString(r.print_mode)=="CUSTOM"?"text-bg-dark":"text-bg-primary")">@(Convert.ToString(r.print_mode)=="CUSTOM"?"Personalizado":"Padrão de fábrica")</span><div class="small mt-1">@r.template_name</div></td>

                        <td>
                            <span class="badge @(type == "BOX" ? "text-bg-primary" : "text-bg-success")">
                                @(type == "BOX" ? "Caixa" : "Documento")
                            </span>
                        </td>

                        <td><div>@reference</div>@if (r.control_number != null){<small><strong>Controle:</strong> @r.control_number · <strong>Local:</strong> @r.location</small>}</td>

                        <td>@(r.printed_by_name ?? "—")</td>

                        <td class="text-muted small">
                            @(r.ip_address ?? "—")
                        </td>
                        <td class="small"><strong>@r.template_code</strong><br /><code>@Convert.ToString(r.snapshot_sha256)?.Substring(0, 12)…</code></td>
                        <td>@(r.reprint_reason ?? "Primeira impressão")</td><td><a class="btn btn-sm btn-outline-primary text-nowrap" asp-action="PrintDetails" asp-route-id="@r.id">Ver detalhes da impressão</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
