@model InovaGed.Web.Models.Labels.LocDeskLabelRenderModel
@{ Layout = null; }
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Etiqueta LocDesk de Pasta</title><link rel="stylesheet" href="~/css/labels-print.css" asp-append-version="true"><link rel="stylesheet" href="~/css/print-branding.css" asp-append-version="true"><link rel="stylesheet" href="~/css/locdesk-labels.css" asp-append-version="true"><link rel="stylesheet" href="~/css/locdesk-brand.css" asp-append-version="true"></head>
<body class="locdesk-print-body"><div class="print-toolbar no-print"><a asp-action="LocDesk">Voltar e editar</a><button type="button" data-label-print-now>Imprimir agora</button><span class="print-mode-note">Modo impressão: menus e controles serão ocultados.</span><span class="print-status">@(Model.PrintRegistered ? "Impressão registrada com sucesso." : "Pré-visualização — ainda não registrada")</span></div>
@if(!string.IsNullOrWhiteSpace(Model.PrintLogoWarning)){<div class="label-logo-warning no-print" role="alert">@Model.PrintLogoWarning</div>}
<main class="print-sheet"><partial name="_LocDeskLabel" model="Model" /></main><script src="~/js/labels-print-page.js" asp-append-version="true"></script></body></html>
