@{ ViewData["Title"]="Guia de Etiquetas";ViewData["WorkspaceVariant"]="wide";var topics=new[]{
("Imprimir","Emitir uma etiqueta confiável","Abra Nova impressão, escolha origem, modelo e identidade, configure as cópias e confira.","Uma prévia igual ao resultado final e histórico após a emissão.","Se a prévia não abrir, revise origem e modelo."),
("Criar modelo","Montar uma apresentação reutilizável","Escolha finalidade, layout inicial neutro, identidade e tamanho; confirme e use o editor.","Um rascunho com chave técnica automática.","Publique somente depois de corrigir erros da verificação."),
("Cliente e logo","Aplicar a identidade correta","Cadastre o perfil visual, vincule cliente, contrato e logos e selecione-o no fluxo.","Identidade resolvida pelo servidor para o cliente atual.","Em modelos visuais, posição e tamanho da logo pertencem ao modelo."),
("QR e rastreabilidade","Permitir conferência e auditoria","Use o campo QR de rastreabilidade, confira a prévia e emita.","O token definitivo nasce somente na impressão.","A prévia nunca cria histórico ou token definitivo."),
("Lote","Emitir várias etiquetas juntas","Filtre, selecione registros visíveis, configure e confira quantidades e até três amostras.","Um job rastreável sem centenas de prévias.","Itens já impressos exigem justificativa."),
("Calibração","Corrigir o alinhamento físico","Escolha impressora e papel, imprima o teste, informe X/Y e salve o perfil.","O perfil ficará disponível na etapa Impressão.","Se saiu 2 mm à direita, reduza o deslocamento horizontal em 2 mm."),
("Problemas","Diagnosticar uma impressão incorreta","Confira papel, escala 100%, perfil, modelo, origem e identidade.","Uma correção específica sem alterar o modelo desnecessariamente.","Não compense geometria do modelo com ajustes de logo do assistente.")};}
@section Styles {<link rel="stylesheet" href="~/css/labels-studio.css" asp-append-version="true"/>}
<main class="label-guide"><header class="label-guide-hero"><div><small>Manual do usuário</small><h1>Guia de Etiquetas</h1><p>Encontre uma tarefa sem precisar conhecer termos técnicos.</p></div><a class="ig-button ig-button--secondary" asp-action="Index">Voltar à central</a></header><label class="label-guide-search">O que você quer fazer?<input type="search" data-guide-search placeholder="Ex.: minha etiqueta saiu deslocada"/></label><nav class="label-guide-shortcuts" aria-label="Atalhos">@foreach(var topic in topics){<a href="#topic-@topic.Item1.ToLowerInvariant().Replace(" ","-")">@topic.Item1</a>}</nav><section class="label-guide-grid" data-guide-topics>@foreach(var topic in topics){<article class="label-guide-card" id="topic-@topic.Item1.ToLowerInvariant().Replace(" ","-")" data-guide-topic><h2>@topic.Item1</h2><h3>Objetivo</h3><p>@topic.Item2</p><h3>Passos</h3><p>@topic.Item3</p><h3>O que esperar</h3><p>@topic.Item4</p><details><summary>Problemas comuns</summary><p>@topic.Item5</p></details></article>}</section></main>
@section Scripts {<script>document.querySelector('[data-guide-search]')?.addEventListener('input',function(){const value=this.value.toLowerCase();document.querySelectorAll('[data-guide-topic]').forEach(x=>x.hidden=!x.textContent.toLowerCase().includes(value));});</script>}
