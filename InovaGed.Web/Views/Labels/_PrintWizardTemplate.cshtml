@model InovaGed.Web.Models.Labels.LabelPrintWizardInputModel
@using InovaGed.Application.PhysicalArchive
@{ var templates=ViewBag.Templates as IReadOnlyList<LabelTemplateOption> ?? Array.Empty<LabelTemplateOption>(); }
<section class="label-wizard-card" data-wizard-step="2"><header class="label-wizard-card__header"><h2><span>2</span> Qual modelo usar?</h2><p>Escolha a apresentação adequada. O sistema define automaticamente o modo compatível.</p></header><div class="label-wizard-card__body"><input asp-for="PrintMode" type="hidden" id="print-mode"/><label asp-for="TemplateCode" class="visually-hidden">Modelo de etiqueta</label><select asp-for="TemplateCode" class="form-select label-template-select" required><option value="">Selecione um modelo</option>@foreach(var template in templates){<option value="@template.Code" data-mode="@template.Mode">@template.Name — @template.Description</option>}</select><span asp-validation-for="TemplateCode" class="text-danger"></span><div class="label-template-grid">@foreach(var template in templates){var old=template.Code.StartsWith("LOCDESK",StringComparison.OrdinalIgnoreCase)||template.Code.Contains("HOL",StringComparison.OrdinalIgnoreCase);<button class="label-template-card" type="button" data-template-code="@template.Code" data-template-mode="@template.Mode"><span class="label-template-thumbnail" aria-hidden="true"></span><strong>@template.Name</strong><small>@template.Description</small><span class="atlas-badge atlas-badge-muted">@(old?"Antigo":template.Mode=="CUSTOM"?"Personalizado":"Padrão")</span></button>}</div><section data-manual-fields hidden><h3>Preencha a etiqueta</h3><p>Somente os campos usados pelo modelo aparecem aqui. Dados de identidade, QR e rastreio são automáticos.</p><div class="label-origin-grid" data-manual-field-list></div></section></div></section>
