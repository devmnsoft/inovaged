@model InovaGed.Application.Labels.Printing.LabelPrintJobDetails
@using InovaGed.Application.Labels.Printing
@{ ViewData["Title"]="Detalhes da impressão"; var actions=(IReadOnlyList<LabelPrintJobActionDto>)ViewBag.Actions; var timeline=(IReadOnlyList<LabelPrintJobTimelineDto>)ViewBag.Timeline; var itemCount=Model.Items.Count==0?1:Model.Items.Count; var shortHash=!string.IsNullOrEmpty(Model.ArtifactSha256)&&Model.ArtifactSha256.Length>=12?Model.ArtifactSha256[..12]:Model.ArtifactSha256; string Size(long? bytes)=>bytes switch{null=>"—",<1024=>$"{bytes} B",<1048576=>$"{bytes/1024d:N0} KB",_=>$"{bytes/1048576d:N1} MB"}; bool Has(string key)=>actions.Any(x=>x.Key==key); var currentReprintUrl=Url.Action("PrintWizard",new{subjectType=Model.SubjectType,subjectId=Model.SubjectId}); }
@section Styles { <link rel="stylesheet" href="~/css/labels-operations-rc40.css" asp-append-version="true" /> }
<header class="label-job-header"><div><a asp-action="PrintQueue">Central de impressão</a><h1>@Model.JobNumber</h1><p>Solicitada por @(Model.RequestedByName??"usuário não informado") em @Model.RequestedAt.ToLocalTime().ToString("g").</p></div><span class="badge text-bg-primary">@LabelPrintStatusDisplay.Humanize(Model.Status)</span></header>
<section class="card label-job-timeline"><div class="card-body"><h2>Andamento real</h2><ol aria-label="Linha do tempo">@foreach(var item in timeline){<li class="@(item.IsCurrent?"is-current":"") @(item.IsError?"is-error":"")"><span class="timeline-marker"><app-icon name="@(item.IsError?"warning":"check")" size="16" decorative="true" /></span><div><strong>@item.Title</strong><time datetime="@item.At.ToString("O")">@item.At.ToLocalTime().ToString("g")</time><small>@item.User · @item.Detail</small></div></li>}</ol></div></section>
<div class="row g-4"><div class="col-lg-8"><section class="card mb-4"><div class="card-body"><h2 class="h5">Resumo da emissão</h2><dl class="row mb-0"><dt class="col-sm-4">Modelo</dt><dd class="col-sm-8">@(Model.TemplateName??Model.TemplateCode)</dd><dt class="col-sm-4">Versão / registro</dt><dd class="col-sm-8">Snapshot preservado · @(Model.ControlNumber??"—")</dd><dt class="col-sm-4">Quantidade</dt><dd class="col-sm-8">@itemCount item(ns), @Model.Copies cópia(s)</dd><dt class="col-sm-4">Impressora</dt><dd class="col-sm-8">@Model.PrintMode</dd><dt class="col-sm-4">Tipo de emissão</dt><dd class="col-sm-8">@(Model.OperationType=="REPRINT_EXACT"?"Reimpressão exata":Model.ReprintReason is null?"Nova etiqueta":"Etiqueta com dados atuais")</dd></dl></div></section>
@if(Model.ArtifactGeneratedAt.HasValue){<section class="card"><div class="card-body"><h2 class="h5">Artefato imutável</h2><dl class="row"><dt class="col-sm-4">Formato</dt><dd class="col-sm-8">@Model.ArtifactContentType</dd><dt class="col-sm-4">Tamanho</dt><dd class="col-sm-8">@Size(Model.ArtifactSizeBytes)</dd><dt class="col-sm-4">SHA-256</dt><dd class="col-sm-8"><code>@shortHash…</code> <button type="button" class="btn btn-link btn-sm" data-copy-hash="@Model.ArtifactSha256">Copiar SHA-256 completo</button></dd></dl><div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="GeneratePdf" asp-route-id="@Model.Id">Baixar artefato</a><form asp-action="VerifyArtifact" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-secondary">Verificar integridade</button></form></div></div></section>}</div>
<aside class="col-lg-4"><section class="card label-job-actions"><div class="card-body"><small>Ação recomendada</small><h2>Próximo passo</h2>@if(Has("preview")){<a class="btn btn-primary" asp-action="PrintPreview" asp-route-id="@Model.Id">Abrir prévia</a>}@if(Has("prepare")){<a class="btn btn-primary" asp-action="PrintPreview" asp-route-id="@Model.Id">Preparar impressão</a>}@if(Has("artifact")){<a class="btn btn-primary" asp-action="GeneratePdf" asp-route-id="@Model.Id">Gerar artefato</a>}@if(Has("mark-printed")){<button type="button" class="btn btn-primary" data-dialog-open="confirm-print">Confirmar impressão</button>}@if(Has("retry")){<form asp-action="RetryPrintJob" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary">Tentar novamente</button></form>}@if(Has("trace")){<a class="btn btn-primary" asp-action="TraceIndex">Ver rastreabilidade</a>}@if(Has("reprint")){<hr/><h3>Ações secundárias</h3><button type="button" class="btn btn-outline-primary" data-dialog-open="reprint">Reimprimir</button>}@if(Has("cancel")){<hr/><h3>Operações administrativas</h3><button type="button" class="btn btn-outline-danger" data-dialog-open="cancel-print">Cancelar impressão</button>}@if(actions.Count==0){<p class="text-muted">Job finalizado. Nenhuma ação operacional disponível.</p>}</div></section></aside></div>
<dialog id="confirm-print" class="atlas-dialog"><form asp-action="MarkPrinted" asp-route-id="@Model.Id" method="post"><h2>Confirmar impressão física</h2><p>Confirme somente depois que as etiquetas tiverem sido impressas.</p><dl><dt>Job</dt><dd>@Model.JobNumber</dd><dt>Quantidade</dt><dd>@itemCount × @Model.Copies</dd><dt>Modelo</dt><dd>@(Model.TemplateName??Model.TemplateCode)</dd><dt>Impressora</dt><dd>@Model.PrintMode</dd></dl><footer><button type="button" class="btn btn-outline-secondary" data-dialog-close>Voltar</button><button class="btn btn-primary">Confirmar impressão</button></footer></form></dialog>
<dialog id="cancel-print" class="atlas-dialog"><form asp-action="CancelPrintJob" asp-route-id="@Model.Id" method="post"><h2>Cancelar impressão</h2><p>Esta operação encerra o job e será auditada.</p><label>Motivo<textarea class="form-control" name="reason" required maxlength="500"></textarea></label><footer><button type="button" class="btn btn-outline-secondary" data-dialog-close>Voltar</button><button class="btn btn-danger">Cancelar impressão</button></footer></form></dialog>
<dialog id="reprint" class="atlas-dialog"><form asp-action="ReprintExact" asp-route-id="@Model.Id" method="post" data-reprint-form data-current-url="@currentReprintUrl"><input type="hidden" name="clientActionId" value="@Guid.NewGuid()"/><h2>Reimprimir etiqueta</h2><p>O que você deseja fazer?</p><label class="reprint-option"><input type="radio" name="mode" value="exact" checked/> <strong>Reimprimir exatamente esta etiqueta</strong><small>Repete exatamente o conteúdo originalmente emitido.</small></label><label class="reprint-option"><input type="radio" name="mode" value="current"/> <strong>Gerar nova etiqueta com os dados atuais</strong><small>Usa o modelo e os dados atuais. O conteúdo pode ser diferente da etiqueta original.</small></label><label>Motivo obrigatório<textarea class="form-control" name="reason" required maxlength="500"></textarea></label><div class="reprint-preview">Prévia: o modo exato preserva o snapshot e o SHA-256 originais; o modo atual será conferido no assistente.</div><footer><button type="button" class="btn btn-outline-secondary" data-dialog-close>Voltar</button><button class="btn btn-primary" data-reprint-submit>Continuar com reimpressão</button></footer></form></dialog>
@section Scripts { <script src="~/js/labels-operations-rc40.js" asp-append-version="true"></script> }
