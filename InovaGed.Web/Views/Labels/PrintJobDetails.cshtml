@model InovaGed.Application.Labels.Printing.LabelPrintJobDetails
@using InovaGed.Application.Labels.Printing
@{ ViewData["Title"]="Detalhes da impressão"; var stateMachine=new LabelPrintStateMachine(); var itemCount=Model.Items.Count==0?1:Model.Items.Count; var shortHash=!string.IsNullOrEmpty(Model.ArtifactSha256)&&Model.ArtifactSha256.Length>=12?Model.ArtifactSha256[..12]:Model.ArtifactSha256; }
<header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><a asp-action="PrintQueue" class="text-decoration-none">← Central de impressão</a><h1 class="h2 mt-2 mb-1">@Model.JobNumber</h1><p class="text-muted mb-0">Solicitada por @(Model.RequestedByName??"usuário não informado") em @Model.RequestedAt.ToLocalTime().ToString("g").</p></div><span class="badge text-bg-primary fs-6">@LabelPrintStatusDisplay.Humanize(Model.Status)</span></header>
<section class="card mb-4"><div class="card-body"><h2 class="h5">Andamento</h2><ol class="d-flex flex-wrap gap-4 list-unstyled mb-0" aria-label="Linha do tempo"><li>Criado</li><li>Prévia</li><li>Pronto</li><li>Artefato</li><li>Impresso</li></ol></div></section>
<div class="row g-4"><div class="col-lg-8"><section class="card mb-4"><div class="card-body"><h2 class="h5">Resumo da emissão</h2><dl class="row mb-0"><dt class="col-sm-4">Modelo</dt><dd class="col-sm-8">@(Model.TemplateName??Model.TemplateCode)</dd><dt class="col-sm-4">Versão / registro</dt><dd class="col-sm-8">Snapshot preservado · @(Model.ControlNumber??"—")</dd><dt class="col-sm-4">Quantidade</dt><dd class="col-sm-8">@itemCount item(ns), @Model.Copies cópia(s)</dd><dt class="col-sm-4">Perfil de impressão</dt><dd class="col-sm-8">@Model.PrintMode</dd><dt class="col-sm-4">Reimpressão</dt><dd class="col-sm-8">@(Model.ReprintReason??"Primeira emissão")</dd></dl></div></section>
@if(Model.ArtifactGeneratedAt.HasValue){<section class="card"><div class="card-body"><h2 class="h5">Artefato imutável</h2><dl class="row mb-0"><dt class="col-sm-4">Formato</dt><dd class="col-sm-8">@Model.ArtifactContentType</dd><dt class="col-sm-4">Gerado em</dt><dd class="col-sm-8">@Model.ArtifactGeneratedAt.Value.ToLocalTime().ToString("g")</dd><dt class="col-sm-4">Hash SHA-256</dt><dd class="col-sm-8"><code>@shortHash…</code></dd><dt class="col-sm-4">Tamanho</dt><dd class="col-sm-8">@Model.ArtifactSizeBytes bytes</dd></dl></div></section>}</div>
<aside class="col-lg-4"><div class="card"><div class="card-body d-grid gap-2"><a class="btn btn-primary" asp-action="PrintPreview" asp-route-id="@Model.Id">Abrir prévia</a>@if(Model.Status is "READY_TO_PRINT" or "PDF_GENERATED"){<a class="btn btn-outline-primary" asp-action="GeneratePdf" asp-route-id="@Model.Id">Baixar artefato</a>}@if(stateMachine.CanMarkPrinted(Model.Status)){<form asp-action="MarkPrinted" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Confirme que a impressão física foi concluída.')"><button class="btn btn-success w-100">Marcar como impresso</button></form>}@if(stateMachine.CanRetry(Model.Status)){<form asp-action="RetryPrintJob" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-primary w-100">Tentar novamente</button></form>}@if(Model.Status==LabelPrintJobStatus.Printed){<hr/><h2 class="h6">Reimpressão</h2><form asp-action="ReprintExact" asp-route-id="@Model.Id" method="post"><input type="hidden" name="clientActionId" value="@Guid.NewGuid()"/><label class="form-label">Motivo obrigatório</label><select class="form-select mb-2" name="reason" required><option value="">Selecione</option><option>Etiqueta danificada</option><option>Impressão ilegível</option><option>Perda</option><option>Substituição física</option><option>Erro operacional</option><option>Outro</option></select><button class="btn btn-outline-primary w-100">Reimprimir exatamente</button></form><a class="btn btn-outline-secondary" asp-action="PrintWizard" asp-route-subjectType="@Model.SubjectType" asp-route-subjectId="@Model.SubjectId">Gerar etiqueta atualizada</a>}@if(stateMachine.CanCancel(Model.Status)){<form asp-action="CancelPrintJob" asp-route-id="@Model.Id" method="post"><label class="form-label mt-3">Motivo do cancelamento</label><textarea class="form-control mb-2" name="reason" required maxlength="500"></textarea><button class="btn btn-outline-danger w-100">Cancelar impressão</button></form>}</div></div></aside></div>
