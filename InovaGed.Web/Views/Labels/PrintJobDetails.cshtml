@model InovaGed.Application.Labels.Printing.LabelPrintJobDetails
@{ViewData["Title"]="Detalhes da impressão";}
<div class="d-flex justify-content-between align-items-start mb-4"><div><a asp-action="PrintQueue" class="text-decoration-none">← Fila</a><h1 class="h2 mt-2">@Model.JobNumber</h1><p class="text-muted">Esta impressão será registrada para auditoria e rastreabilidade.</p></div><span class="badge text-bg-primary fs-6">@Model.Status</span></div>
<div class="row g-4"><div class="col-lg-8"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Resumo</h2><dl class="row mb-0"><dt class="col-sm-4">Modelo</dt><dd class="col-sm-8">@(Model.TemplateName??Model.TemplateCode)</dd><dt class="col-sm-4">Modo</dt><dd class="col-sm-8">@Model.PrintMode</dd><dt class="col-sm-4">Solicitante</dt><dd class="col-sm-8">@Model.RequestedByName</dd><dt class="col-sm-4">Solicitado em</dt><dd class="col-sm-8">@Model.RequestedAt.ToLocalTime().ToString("g")</dd><dt class="col-sm-4">Impresso em</dt><dd class="col-sm-8">@(Model.PrintedAt?.ToLocalTime().ToString("g")??"—")</dd><dt class="col-sm-4">Itens/cópias</dt><dd class="col-sm-8">@(Model.Items.Count==0?1:Model.Items.Count) / @Model.Copies</dd><dt class="col-sm-4">Motivo reimpressão</dt><dd class="col-sm-8">@(Model.ReprintReason??"—")</dd></dl>@if(Model.Items.Count>0){<hr><table class="table"><thead><tr><th>Controle</th><th>Localização</th><th>Status</th></tr></thead><tbody>@foreach(var i in Model.Items){<tr><td>@i.ControlNumber</td><td>@i.Location</td><td>@i.Status</td></tr>}</tbody></table>}</div></div></div><aside class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body d-grid gap-2"><a class="btn btn-primary" asp-action="PrintPreview" asp-route-id="@Model.Id">Abrir prévia</a><a class="btn btn-outline-primary" asp-action="GeneratePdf" asp-route-id="@Model.Id">Gerar HTML/PDF</a>@if(Model.Status is not "PRINTED" and not "CANCELLED"){<form asp-action="MarkPrinted" asp-route-id="@Model.Id" method="post"><button class="btn btn-success w-100">Marcar como impresso</button></form><form asp-action="CancelPrintJob" asp-route-id="@Model.Id" method="post"><label class="form-label mt-3">Motivo do cancelamento</label><textarea class="form-control mb-2" name="reason" required maxlength="500"></textarea><button class="btn btn-outline-danger w-100">Cancelar job</button></form>}</div></div></aside></div>
