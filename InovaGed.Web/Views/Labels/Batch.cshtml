@model InovaGed.Web.Models.Labels.CreateBatchPrintJobInput
@{ ViewData["Title"] = "Impressão em lote"; ViewData["WorkspaceVariant"] = "wide"; var rows = (IEnumerable<dynamic>)ViewBag.Rows; }
@section Styles { <link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true" /> }
<main class="labels-page label-batch-page">
<header class="labels-hero atlas-page-hero"><div><span class="labels-eyebrow"><app-icon name="layers" size="16" decorative="true" /> Operação em lote</span><h1>Impressão em lote</h1><p>Selecione registros, modelo e perfil; confira a quantidade antes de gerar uma prévia rastreável.</p></div><a class="ig-button ig-button--secondary" asp-action="Index">Voltar à central</a></header>
<nav class="label-batch-tabs" aria-label="Tipo de origem"><a class="ig-button @(Model.SubjectType=="BOX"?"ig-button--primary":"ig-button--secondary")" asp-action="BatchPrint" asp-route-subjectType="BOX">Caixas</a><a class="ig-button @(Model.SubjectType=="DOCUMENT"?"ig-button--primary":"ig-button--secondary")" asp-action="BatchPrint" asp-route-subjectType="DOCUMENT">Documentos e pastas</a></nav>
<form action="/Labels/Batch/Preview" method="post">@Html.AntiForgeryToken()<input asp-for="SubjectType" type="hidden" />
<section class="label-batch-config" aria-labelledby="batch-config-title"><header><span class="labels-eyebrow">Etapa 1</span><h2 id="batch-config-title">Configure a impressão</h2></header><div class="label-batch-fields"><div><label asp-for="PrintMode">Modo</label><select asp-for="PrintMode"><option value="FACTORY">Padrão de fábrica</option><option value="CUSTOM">Personalizado</option></select></div><div><label asp-for="TemplateCode">Modelo compatível</label><select asp-for="TemplateCode" required><option value="">Selecione um modelo</option>@foreach(var t in ViewBag.Templates){<option value="@t.Code">@t.Name</option>}</select></div><div><label asp-for="Copies">Cópias por item</label><input asp-for="Copies" type="number" min="1" max="500" required /></div><div><label asp-for="ReprintReason">Justificativa de reimpressão</label><input asp-for="ReprintReason" placeholder="Obrigatória para itens já impressos" /></div></div></section>
<section class="label-batch-records" aria-labelledby="batch-items-title"><header><div><span class="labels-eyebrow">Etapa 2</span><h2 id="batch-items-title">Selecione os itens</h2><p>Não é necessário informar IDs manualmente.</p></div><div class="label-batch-tools"><label for="batchSearch">Pesquisar na lista</label><input id="batchSearch" type="search" placeholder="Código, assunto ou localização" /><button type="button" class="ig-button ig-button--secondary" id="selectAll">Selecionar visíveis</button></div></header><div class="ig-premium-table-scroll"><table class="ig-premium-table"><thead><tr><th>Selecionar</th><th>Código/controle</th><th>Assunto/título</th><th>Caixa</th><th>Localização</th><th>Classificação</th><th>Status</th><th>Histórico</th></tr></thead><tbody>@foreach(var r in rows){<tr class="batch-row"><td><input class="pick" type="checkbox" name="SubjectIds" value="@r.id" aria-label="Selecionar @r.control_number" /></td><td>@r.control_number</td><td>@r.subject</td><td>@r.box_no</td><td>@r.location</td><td>@r.classification</td><td>@r.status</td><td>@if(r.already_printed){<span class="ig-status-badge ig-status-badge--warning">Já impressa</span>}else{<span class="ig-status-badge ig-status-badge--ok">Nova</span>}</td></tr>}</tbody></table></div><footer><div aria-live="polite"><strong id="selectedCount">0 itens selecionados</strong><span id="pageEstimate"> · 0 etiquetas previstas</span></div><button type="submit" class="ig-button ig-button--primary">Gerar prévia do lote</button></footer></section>
</form></main>
@section Scripts { <script>document.addEventListener('DOMContentLoaded',()=>{const rows=[...document.querySelectorAll('.batch-row')],search=document.querySelector('#batchSearch'),copies=document.querySelector('#Copies'),count=document.querySelector('#selectedCount'),estimate=document.querySelector('#pageEstimate');const update=()=>{const n=document.querySelectorAll('.pick:checked').length;count.textContent=`${n} ${n===1?'item selecionado':'itens selecionados'}`;estimate.textContent=` · ${n*(Number(copies?.value)||1)} etiquetas previstas`};search?.addEventListener('input',()=>rows.forEach(row=>row.hidden=!row.textContent.toLowerCase().includes(search.value.trim().toLowerCase())));document.querySelector('#selectAll')?.addEventListener('click',()=>{rows.filter(row=>!row.hidden).forEach(row=>row.querySelector('.pick').checked=true);update()});document.querySelectorAll('.pick').forEach(input=>input.addEventListener('change',update));copies?.addEventListener('input',update);update()});</script> }
