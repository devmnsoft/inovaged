@model InovaGed.Web.Models.Labels.LabelCalibrationInput
@{ ViewData["Title"]="Calibração de etiquetas"; }
@section Styles { <link rel="stylesheet" href="~/css/labels-print.css" asp-append-version="true" /> }
<section class="p-4 rounded-4 text-white mb-4" style="background:#173f5f"><h1 class="h2">Calibração de impressão</h1><p class="mb-0">Ajuste a saída física em milímetros para o usuário e a impressora atuais.</p></section>
<div class="row g-4"><div class="col-lg-6"><form asp-action="SaveCalibration" method="post" class="card border-0 shadow-sm"><div class="card-body">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
<div class="col-12"><label asp-for="TemplateCode" class="form-label">Modelo</label><select asp-for="TemplateCode" class="form-select"><option value="FACTORY_BOX_V1">Padrão caixa</option><option value="FACTORY_DOCUMENT_V1">Padrão documento</option><option value="LOCDESK_CAIXA_V1">LocDesk caixa</option><option value="LOCDESK_PASTA_V1">LocDesk pasta</option><option value="LOCDESK_PASTA_HOL_V1">LocDesk pasta HOL</option></select></div>
<div class="col-7"><label asp-for="PrinterName" class="form-label">Nome da impressora</label><input asp-for="PrinterName" class="form-control" placeholder="Impressora padrão" /></div><div class="col-5"><label asp-for="PaperSize" class="form-label">Tamanho do papel</label><select asp-for="PaperSize" class="form-select"><option>A4</option><option>LETTER</option></select></div>
<div class="col-6"><label asp-for="MarginTopMm" class="form-label">Margem superior (mm)</label><input asp-for="MarginTopMm" class="form-control" step="0.01" /></div><div class="col-6"><label asp-for="MarginRightMm" class="form-label">Margem direita (mm)</label><input asp-for="MarginRightMm" class="form-control" step="0.01" /></div>
<div class="col-6"><label asp-for="MarginBottomMm" class="form-label">Margem inferior (mm)</label><input asp-for="MarginBottomMm" class="form-control" step="0.01" /></div><div class="col-6"><label asp-for="MarginLeftMm" class="form-label">Margem esquerda (mm)</label><input asp-for="MarginLeftMm" class="form-control" step="0.01" /></div>
<div class="col-4"><label asp-for="ScalePercent" class="form-label">Escala (%)</label><input asp-for="ScalePercent" class="form-control" step="0.01" /></div><div class="col-4"><label asp-for="HorizontalOffsetMm" class="form-label">Deslocamento horizontal</label><input asp-for="HorizontalOffsetMm" class="form-control" step="0.01" /></div><div class="col-4"><label asp-for="VerticalOffsetMm" class="form-label">Deslocamento vertical</label><input asp-for="VerticalOffsetMm" class="form-control" step="0.01" /></div>
<div class="col-12 form-check ms-2"><input asp-for="IsDefault" class="form-check-input" /><label asp-for="IsDefault" class="form-check-label">Definir como padrão</label></div>
</div></div><div class="card-footer bg-white d-flex gap-2 flex-wrap"><button class="btn btn-primary">Salvar calibração</button><a class="btn btn-outline-dark" asp-action="TestSheet" target="_blank">Imprimir folha de teste</a><a class="btn btn-outline-secondary" asp-action="Calibration" asp-route-templateCode="@Model.TemplateCode">Restaurar padrão</a></div></form></div>
<div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Referência A4</h2><p>Use a folha de teste para conferir régua, marcas de canto, centro e quadrados de 20 mm sem redimensionamento do navegador.</p><div class="label-print-preview border mx-auto" style="width:210px;height:297px"><div class="label-print-calibration" style="transform:scale(.1);transform-origin:top left"></div></div></div></div></div></div>
