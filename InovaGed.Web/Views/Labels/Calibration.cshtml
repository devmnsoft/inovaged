@model InovaGed.Web.Models.Labels.LabelCalibrationInput
@{ViewData["Title"]="Calibração de etiquetas";}
<section class="p-4 rounded-4 text-white mb-4" style="background:#173f5f"><h1 class="h2">Calibração de impressão</h1><p class="mb-0">Use a calibração para ajustar margens conforme a impressora utilizada.</p></section>
<div class="row g-4"><div class="col-lg-5"><form method="post" class="card border-0 shadow-sm"><div class="card-body"><div class="mb-3"><label asp-for="TemplateCode" class="form-label">Modelo</label><select asp-for="TemplateCode" class="form-select"><option value="FACTORY_BOX_V1">Padrão caixa</option><option value="FACTORY_DOCUMENT_V1">Padrão documento</option><option value="LOCDESK_CAIXA_V1">LocDesk caixa (personalizado)</option><option value="LOCDESK_PASTA_V1">LocDesk pasta (personalizado)</option></select></div><div class="mb-3"><label asp-for="PrinterName" class="form-label">Impressora (opcional)</label><input asp-for="PrinterName" class="form-control" placeholder="DEFAULT"></div><div class="row g-3">@foreach(var x in new[]{("MarginTopMm","Margem superior (mm)"),("MarginLeftMm","Margem esquerda (mm)"),("ScalePercent","Escala (%)"),("LabelWidthMm","Largura (mm)"),("LabelHeightMm","Altura (mm)"),("GapXMm","Espaço horizontal (mm)"),("GapYMm","Espaço vertical (mm)"),("LabelsPerPage","Quantidade por página")}){<div class="col-6"><label class="form-label" for="@x.Item1">@x.Item2</label><input class="form-control calibration" type="number" step="0.01" name="@x.Item1" id="@x.Item1" value="@Model.GetType().GetProperty(x.Item1)?.GetValue(Model)"></div>}</div></div><div class="card-footer bg-white d-flex gap-2 flex-wrap"><button class="btn btn-primary">Salvar calibração</button><a class="btn btn-outline-secondary" asp-action="Calibration" asp-route-templateCode="@Model.TemplateCode">Restaurar padrão</a><a class="btn btn-outline-dark" asp-action="TestSheet" target="_blank">Imprimir folha de teste</a></div></form></div><div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Régua visual A4</h2><div class="a4"><div class="ruler-x">0　50　100　150　200 mm</div><div class="sample" id="sample">ETIQUETA DE TESTE<br><small>100 × 100 mm</small></div></div></div></div></div></div>
<style>.a4{position:relative;width:min(100%,420px);aspect-ratio:210/297;margin:auto;background:white;border:1px solid #bac7d5;box-shadow:0 8px 30px #ccd;overflow:hidden}.ruler-x{font:10px monospace;border-bottom:1px solid #789;padding:4px}.sample{position:absolute;top:8%;left:8%;width:45%;height:18%;border:2px dashed #176b87;display:grid;place-items:center;text-align:center;background:#eef8ff}</style>
<script>document.querySelectorAll('.calibration').forEach(x=>x.addEventListener('input',()=>{const s=document.getElementById('sample'),n=id=>Number(document.getElementById(id).value||0);s.style.top=(n('MarginTopMm')/2.97)+'%';s.style.left=(n('MarginLeftMm')/2.1)+'%';s.style.width=(n('LabelWidthMm')/2.1)+'%';s.style.height=(n('LabelHeightMm')/2.97)+'%';s.style.transform=`scale(${n('ScalePercent')/100})`;s.querySelector('small').textContent=`${n('LabelWidthMm')} × ${n('LabelHeightMm')} mm`}))</script>
