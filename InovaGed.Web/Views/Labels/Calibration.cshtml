@model InovaGed.Web.Models.Labels.LabelCalibrationPageViewModel
@{ ViewData["Title"]="Calibração de Impressão"; var editing=Model.Form.Id.HasValue; }
@section Styles { <link rel="stylesheet" href="~/css/labels-premium.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/labels-print.css" asp-append-version="true" /> }
<main class="label-fidelity-page">
 <header class="atlas-page-hero"><div><span class="labels-eyebrow">Labels Print Fidelity 2.0</span><h1>Calibração de Impressão</h1><p>Ajuste margens, deslocamento, escala e perfil de impressão para garantir que as etiquetas saiam alinhadas no papel.</p></div><div><a class="ig-button ig-button--secondary" asp-action="PrintSheet">Prévia A4</a><a class="ig-button ig-button--secondary" asp-action="Quality">Qualidade visual</a></div></header>
 <section class="label-calibration-kpis" aria-label="Indicadores"><article><small>Perfil padrão</small><strong>@(Model.Profiles.FirstOrDefault(x=>x.IsDefault)?.ProfileName ?? "Não definido")</strong></article><article><small>Total de perfis</small><strong>@Model.Profiles.Count</strong></article><article><small>Última calibração</small><strong>@(Model.Profiles.Count>0?"Disponível":"Não registrada")</strong></article><article><small>Modelos validados</small><strong>@Model.ValidatedTemplates</strong></article><article><small>Alertas visuais</small><strong>@Model.VisualAlerts</strong></article><article><small>Teste de impressão</small><strong>@(Model.Profiles.Count>0?"Pronto":"Crie um perfil")</strong></article></section>
 <div class="label-calibration-layout"><section class="label-fidelity-card"><header><h2>@(editing?"Editar perfil":"Novo perfil")</h2><p>Os limites seguros impedem correções acidentais fora da folha.</p></header><form method="post" action="@(editing?$"/Labels/Calibration/{Model.Form.Id}/Update":"/Labels/Calibration/Create")">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="label-profile-form">
 <label>Nome do perfil<input asp-for="Form.ProfileName" name="ProfileName" required /></label><label>Nome da impressora<input asp-for="Form.PrinterName" name="PrinterName" /></label><label>Tamanho do papel<select asp-for="Form.PaperSize" name="PaperSize"><option>A4</option><option>LETTER</option></select></label><label>Orientação<select asp-for="Form.Orientation" name="Orientation"><option value="PORTRAIT">Retrato</option><option value="LANDSCAPE">Paisagem</option></select></label>
 <label>Margem superior em mm<input asp-for="Form.MarginTopMm" name="MarginTopMm" type="number" min="0" max="30" step=".1" /></label><label>Margem esquerda em mm<input asp-for="Form.MarginLeftMm" name="MarginLeftMm" type="number" min="0" max="30" step=".1" /></label><label>Deslocamento X em mm<input asp-for="Form.OffsetXMm" name="OffsetXMm" type="number" min="-20" max="20" step=".1" /></label><label>Deslocamento Y em mm<input asp-for="Form.OffsetYMm" name="OffsetYMm" type="number" min="-20" max="20" step=".1" /></label><label>Escala em %<input asp-for="Form.ScalePercent" name="ScalePercent" type="number" min="80" max="120" step=".1" /></label><label>Espaço horizontal entre etiquetas<input asp-for="Form.LabelGapXMm" name="LabelGapXMm" type="number" min="0" max="30" step=".1" /></label><label>Espaço vertical entre etiquetas<input asp-for="Form.LabelGapYMm" name="LabelGapYMm" type="number" min="0" max="30" step=".1" /></label><label class="wide">Observações<textarea asp-for="Form.Notes" name="Notes" rows="3"></textarea></label></div><footer><button class="ig-button ig-button--primary">@(editing?"Salvar alterações":"Criar perfil")</button><a class="ig-button ig-button--secondary" asp-action="Calibration">Limpar</a></footer></form></section>
 <section class="label-fidelity-card"><header><h2>Perfis por impressora</h2><p>O perfil padrão é aplicado automaticamente.</p></header>@if(!Model.Profiles.Any()){<div class="label-empty">Nenhum perfil cadastrado. A impressão continuará com o padrão do navegador.</div>}else{<div class="label-profile-list">@foreach(var p in Model.Profiles){<article><div><strong>@p.ProfileName</strong>@if(p.IsDefault){<span>Padrão</span>}<small>@(p.PrinterName??"Impressora não informada") · @p.ScalePercent% · X @p.OffsetXMm mm / Y @p.OffsetYMm mm</small></div><nav><a href="/Labels/Calibration/@p.Id">Editar</a><a href="/Labels/Calibration/@p.Id/TestPage" target="_blank">Teste</a>@if(!p.IsDefault){<form method="post" action="/Labels/Calibration/@p.Id/SetDefault">@Html.AntiForgeryToken()<button>Definir padrão</button></form>}</nav></article>}</div>}</section></div>
</main>
