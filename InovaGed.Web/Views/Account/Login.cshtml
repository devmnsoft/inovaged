@model InovaGed.Web.Models.Auth.LoginVM
@{
    ViewData["Title"] = "Entrar";
    Layout = "_LayoutAuth";
}

<div class="login-page">
    <div class="login-shell">
        <aside class="login-info" aria-labelledby="login-product-title">
            <div class="login-brand">
                <img class="login-logo" src="~/images/brand/atlas-brand-mark.svg" width="40" height="40" alt="" aria-hidden="true" />
                <div>
                    <h1 id="login-product-title">InovaGED</h1>
                    <p>Gestão Eletrônica de Documentos</p>
                </div>
            </div>

            <div class="login-message">
                <span class="login-eyebrow"><app-icon name="health" size="16" decorative="true" /> Ambiente institucional</span>
                <h2>Gestão documental com mais controle, velocidade e segurança.</h2>
                <p>Centralize documentos, automatize processos, acompanhe o histórico e encontre informações com rapidez em um único ambiente.</p>
                <atlas-illustration name="login-ged-workspace" size="hero" class="login-workspace-illustration" decorative="true" eager="true" />
                <div class="login-live-flow" aria-label="Fluxo protegido: captura, OCR, classificação e auditoria">
                    <span><app-icon name="upload-cloud" size="18" decorative="true" /> Captura</span><i aria-hidden="true"></i>
                    <span><app-icon name="ocr" size="18" decorative="true" /> OCR</span><i aria-hidden="true"></i>
                    <span><app-icon name="classification" size="18" decorative="true" /> Classificação</span><i aria-hidden="true"></i>
                    <span><app-icon name="certificate-validation" size="18" decorative="true" /> Custódia</span>
                </div>
                <div class="login-capabilities" aria-label="Recursos da plataforma">
                    <span><app-icon name="documents" size="16" decorative="true" /> Documentos</span><span><app-icon name="ocr" size="16" decorative="true" /> OCR</span>
                    <span><app-icon name="classification" size="16" decorative="true" /> Indexação</span><span><app-icon name="document-history" size="16" decorative="true" /> Histórico</span>
                    <span><app-icon name="workspace" size="16" decorative="true" /> Fluxos</span><span><app-icon name="audit" size="16" decorative="true" /> Segurança</span>
                </div>
            </div>

            <small>InovaGED · Gestão documental segura</small>
        </aside>

        <main class="login-panel">
            <div class="login-card">
                <div class="login-mobile-brand">
                    <img class="login-logo" src="~/images/brand/atlas-brand-mark.svg" width="40" height="40" alt="" aria-hidden="true" />
                    <div><strong>InovaGED</strong><small>Gestão documental</small></div>
                </div>
                <header class="login-card-header">
                    <span class="login-card-icon" aria-hidden="true"><app-icon name="users" size="24" decorative="true" /></span>
                    <h2>Acesse seu ambiente</h2>
                    <p>Entre com seu e-mail ou CPF para continuar.</p>
                </header>

                <form id="loginForm" asp-action="Login" method="post" novalidate aria-busy="false">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="TenantSlug" value="default" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">E-mail ou CPF</label>
                        <div class="input-group">
                            <span class="input-group-text" aria-hidden="true"><app-icon name="users" size="18" decorative="true" /></span>
                            <input asp-for="Email" class="form-control" autocomplete="username" placeholder="Digite seu e-mail ou CPF" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" aria-hidden="true"><app-icon name="permissions" size="18" decorative="true" /></span>
                            <input asp-for="Password" type="password" class="form-control" id="passwordInput" autocomplete="current-password" placeholder="Digite sua senha" />
                            <button type="button" class="btn btn-outline-secondary password-toggle" aria-label="Mostrar senha" aria-pressed="false"><app-icon name="preview" size="18" decorative="true" /></button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="ig-alert ig-alert--error small mt-3" role="alert" aria-live="assertive">
                            <app-icon name="warning" size="18" class="me-1" decorative="true" />
                            @Html.ValidationSummary(excludePropertyErrors: true)
                        </div>
                    }

                    <button id="loginBtn" type="submit" class="btn btn-primary w-100 mt-3">
                        <span class="btn-text"><app-icon name="arrow-right" size="18" decorative="true" /> Entrar no InovaGED</span>
                        <span class="btn-wait"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Validando acesso...</span>
                    </button>
                    <a class="forgot-link" href="@Url.Action("ForgotPassword", "Account")">Esqueci minha senha</a>
                </form>
                <footer class="login-security"><app-icon name="audit" size="18" decorative="true" /> Seus dados são protegidos durante o acesso.</footer>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login.js" asp-append-version="true"></script>
}
