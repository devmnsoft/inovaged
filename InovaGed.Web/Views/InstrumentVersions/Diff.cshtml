@using InovaGed.Web.Models.Atlas
@model InstrumentDiffResult
@{
    var type = (string)ViewData["Type"]!;
    ViewData["Title"] = $"Comparação {type}";
    var header = new AtlasPageHeaderVm(
        $"Comparação de versões — {type}",
        "A diferença usa o código e o nome da classe gravados em cada snapshot. Inclusão, remoção e alteração não movem documentos.",
        "history",
        "Gestão documental",
        [new AtlasPageAction("Voltar", $"/Instruments/Versions/{type}", "arrow-left")]);
    string Label(string change) => change switch
    {
        "ADDED" => "Inclusão",
        "REMOVED" => "Remoção",
        "UPDATED" => "Alteração",
        _ => change
    };
}
<partial name="Atlas/_PageHeader" model="header" />
<section class="card border-0 shadow-sm atlas-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 atlas-table">
                <thead>
                    <tr><th>Mudança</th><th>Código</th><th>Classe</th><th>Classe pai</th><th>Ordem</th></tr>
                </thead>
                <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="5" class="text-center py-4">Nenhuma diferença de classe entre as versões escolhidas.</td></tr>
                }
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td class="fw-semibold">@Label(row.Change)</td>
                        <td>@row.Code</td>
                        <td>@row.Title</td>
                        <td>@(row.Parent_Code ?? "—")</td>
                        <td>@row.Sort_Order</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
