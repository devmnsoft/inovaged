@using InovaGed.Web.Models.Atlas
@model InovaGed.Application.Reports.DispositionKpiVM
@{
    ViewData["Title"] = "Temporalidade";
    var header = new AtlasPageHeaderVm(
        "Temporalidade",
        "Prazos de guarda, destinação e termos do acervo. Os números vêm da fila operacional já persistida.",
        "calendar",
        "Gestão documental",
        [
            new AtlasPageAction("Ver fila", "/Disposition/Queue", "list", true),
            new AtlasPageAction("Termos", "/Disposition/Terms", "documents", false),
            new AtlasPageAction("Tabela de temporalidade", "/ClassificationPlan/RetentionRules", "settings", false),
            new AtlasPageAction("Revisão da IA", "/SmartGed/ReviewQueue?kind=retention", "stars", false)
        ]);
    var metrics = new[]
    {
        new AtlasMetricVm("Eliminação pronta", Model.EliminationReady.ToString(), "prazo encerrado com destinação de eliminação", "danger", "warning", "/Disposition/Queue?status=ELIMINATION_READY"),
        new AtlasMetricVm("Transferência pronta", Model.TransferReady.ToString(), "prazo encerrado com destinação de transferência", "info", "share", "/Disposition/Queue?status=TRANSFER_READY"),
        new AtlasMetricVm("Revisão requerida", Model.ReviewRequired.ToString(), "aguardam decisão antes da destinação", "warning", "history", "/Disposition/Queue?status=REVIEW_REQUIRED"),
        new AtlasMetricVm("Baixados em 30 dias", Model.DisposedLast30D.ToString(), "destinação já registrada", "success", "check", "/Disposition/Queue?status=DISPOSED")
    };
}
<partial name="Atlas/_PageHeader" model="header" />
<partial name="Atlas/_PageMetrics" model="metrics" />
<section class="card border-0 shadow-sm">
    <div class="card-body">
        <h2 class="h5">Como ler estes prazos</h2>
        <p class="mb-2">A fase e o destino saem da regra vinculada à classificação do documento. A data de vencimento é a persistida em <span class="font-monospace">retention_due_at</span>.</p>
        <p class="mb-2">As sugestões da IA ficam na <a href="/SmartGed/ReviewQueue?kind=retention">fila de revisão de temporalidade</a>. Aceitar uma sugestão só pede o recálculo do prazo já persistido. Não elimina nem transfere o documento.</p>
        <p class="text-muted mb-0">Um documento sem regra, sem evento inicial ou com impedimento permanece em revisão. Esta tela não executa eliminação nem transferência.</p>
    </div>
</section>
