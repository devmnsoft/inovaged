@model InovaGed.Web.Models.Labels.LogoLayoutEditorVm
@{ ViewData["Title"]=$"Ajustar logo — {Model.TemplateName}"; var positions = new List<string>{"TOP_LEFT","TOP_CENTER","TOP_RIGHT","MIDDLE_LEFT","MIDDLE_CENTER","MIDDLE_RIGHT","BOTTOM_LEFT","BOTTOM_CENTER","BOTTOM_RIGHT","CENTER_HEADER","CUSTOM"}; }
<link rel="stylesheet" href="~/css/logo-layout-studio.css" asp-append-version="true" />
<main class="logo-layout-page atlas-page-shell" data-logo-layout-studio>
 <header class="logo-layout-hero"><span>@Model.TemplateCode</span><h1>Ajuste Visual da Logo</h1><p>@Model.TemplateName · @Model.Dimensions</p></header>
 @if(!Model.SchemaReady){<div class="logo-layout-validation is-high">Banco não preparado. Aplique a migration obrigatória antes de salvar.</div>}
 <form method="post" action="/Labels/LogoLayout/@Model.TemplateCode/Save" id="logo-layout-form"><input type="hidden" name="Enabled" value="true" />
  <div class="logo-layout-editor">
   <aside class="logo-layout-sidebar"><h2>Selecionar logo</h2><label class="logo-layout-asset @(Model.Layout.LogoAssetId is null?"is-selected":"")"><input type="radio" name="LogoAssetId" value="" data-logo-url="" checked="@(Model.Layout.LogoAssetId is null)" /> Sem logo</label>@foreach(var asset in Model.Assets){<label class="logo-layout-asset @(Model.Layout.LogoAssetId==asset.Id?"is-selected":"")"><input type="radio" name="LogoAssetId" value="@asset.Id" data-logo-url="@asset.FileUrl" checked="@(Model.Layout.LogoAssetId==asset.Id)" /><span class="logo-layout-logo-frame"><img src="@asset.FileUrl" alt="@asset.AssetName" /></span><strong>@asset.AssetName</strong><small>@asset.BrandName @(asset.IsDefault?"· padrão do tenant":"")</small></label>}<a class="atlas-btn atlas-btn-secondary" href="/Administration/BrandAssets/Create?returnUrl=/Labels/LogoLayout/@Model.TemplateCode">Enviar nova logo</a></aside>
   <section class="logo-layout-preview-stage"><h2>Preview real</h2><div class="logo-layout-preview-paper" data-template="@Model.TemplateCode"><div class="logo-layout-logo-frame" id="logo-preview-frame">@if(Model.SelectedLogoUrl is not null){<img id="logo-preview-image" src="@Model.SelectedLogoUrl" alt="Logo selecionada" />}else{<img id="logo-preview-image" alt="Logo selecionada" hidden />}</div><div class="logo-layout-sample"><b>@Model.TemplateName</b><span>N° Controle: 0001 · Volume 1/3</span><span>Campos arquivísticos e localização</span><span class="logo-layout-qr">QR CODE</span></div></div><p class="logo-layout-hint">O teste usa exatamente tamanho, encaixe e posição exibidos aqui.</p></section>
   <aside class="logo-layout-properties"><h2>Propriedades</h2><label>Largura da logo em mm<input name="WidthMm" id="logo-width" type="number" min="10" max="90" step=".1" value="@Model.Layout.WidthMm" /></label><label>Altura da logo em mm<input name="HeightMm" id="logo-height" type="number" min="5" max="60" step=".1" value="@Model.Layout.HeightMm" /></label><label class="logo-layout-check"><input name="PreserveAspectRatio" id="logo-preserve" type="checkbox" value="true" checked="@Model.Layout.PreserveAspectRatio" /> Manter proporção</label><label>Modo de encaixe<select name="FitMode" id="logo-fit"><option selected="@(Model.Layout.FitMode=="CONTAIN")">CONTAIN</option><option selected="@(Model.Layout.FitMode=="COVER")">COVER</option><option selected="@(Model.Layout.FitMode=="FILL")">FILL</option></select></label><label>Posição<select name="Position" id="logo-position">@foreach(var p in positions){<option selected="@(Model.Layout.Position==p)">@p</option>}</select></label><div class="logo-layout-pair"><label>Offset X (mm)<input name="PositionXMm" id="logo-x" type="number" min="-30" max="30" step=".5" value="@Model.Layout.PositionXMm" /></label><label>Offset Y (mm)<input name="PositionYMm" id="logo-y" type="number" min="-30" max="30" step=".5" value="@Model.Layout.PositionYMm" /></label></div><div class="logo-layout-pair"><label>Margem superior<input name="MarginTopMm" id="logo-margin-top" type="number" min="0" max="60" step=".5" value="@Model.Layout.MarginTopMm" /></label><label>Margem esquerda<input name="MarginLeftMm" id="logo-margin-left" type="number" min="0" max="90" step=".5" value="@Model.Layout.MarginLeftMm" /></label></div><label class="logo-layout-check"><input name="ApplyToAllCopies" type="checkbox" value="true" checked="@Model.Layout.ApplyToAllCopies" /> Aplicar como padrão deste modelo</label><div class="logo-layout-position-controls"><button type="button" data-move-y="-1" aria-label="Mover para cima">↑</button><button type="button" data-move-x="-1" aria-label="Mover para esquerda">←</button><button type="button" data-center>Centralizar</button><button type="button" data-move-x="1" aria-label="Mover para direita">→</button><button type="button" data-move-y="1" aria-label="Mover para baixo">↓</button><button type="button" data-reset>Restaurar padrão</button></div></aside>
  </div>
  <footer class="logo-layout-footer"><div>@foreach(var validation in Model.Validations){<div class="logo-layout-validation is-@validation.Severity.ToLowerInvariant()"><strong>@validation.Title</strong><span>@validation.Description</span></div>}<div class="logo-layout-validation is-high" id="logo-live-warning" hidden></div></div><div class="logo-layout-actions"><a href="/Labels/LogoLayout" class="atlas-btn atlas-btn-secondary">Voltar</a><a href="/Labels/LogoLayout/@Model.TemplateCode/PrintTest" class="atlas-btn atlas-btn-secondary">Testar impressão</a><button type="submit" class="atlas-btn atlas-btn-primary" disabled="@(!Model.SchemaReady)">Salvar configuração</button></div></footer>
 </form>
</main><script src="~/js/logo-layout-studio.js" asp-append-version="true"></script>
