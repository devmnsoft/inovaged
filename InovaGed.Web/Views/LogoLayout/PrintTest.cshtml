@model InovaGed.Web.Models.Labels.LogoLayoutEditorVm
@{ ViewData["Title"]="Teste de impressão da logo"; }
<link rel="stylesheet" href="~/css/logo-layout-studio.css" asp-append-version="true" /><main class="logo-layout-page logo-layout-print-test"><div class="logo-layout-preview-paper"><div class="print-logo-frame" style="width:@(Model.Layout.WidthMm)mm;height:@(Model.Layout.HeightMm ?? 20)mm;transform:translate(@(Model.Layout.PositionXMm)mm,@(Model.Layout.PositionYMm)mm)">@if(Model.SelectedLogoUrl is not null){<img class="print-brand-logo" src="@Model.SelectedLogoUrl" alt="Logo do teste" style="object-fit:@Model.Layout.FitMode.ToLowerInvariant()" />}</div><h1>@Model.TemplateName</h1><p>TESTE DE IMPRESSÃO · não registra impressão real</p></div><div class="logo-layout-actions no-print"><a class="atlas-btn atlas-btn-secondary" href="/Labels/LogoLayout/@Model.TemplateCode">Voltar ao ajuste</a><button class="atlas-btn atlas-btn-primary" type="button" onclick="window.print()">Imprimir teste</button></div></main>
