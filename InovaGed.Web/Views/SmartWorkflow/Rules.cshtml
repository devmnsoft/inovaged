@model IReadOnlyList<InovaGed.Application.SmartWorkflow.SmartWorkflowRuleItem>
@{ViewData["Title"]="Regras do workflow";ViewData["Subtitle"]="Detecções locais que apenas criam tarefas para revisão humana.";}<div class="atlas-page"><partial name="Atlas/_AtlasPageHero"/><table class="table"><thead><tr><th>Regra</th><th>Origem</th><th>Tipo</th><th>Prioridade</th><th>SLA</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Title</strong><br/><small>@x.Code</small></td><td>@x.SourceType</td><td>@x.TaskType</td><td>@x.Priority</td><td>@x.SlaHours h</td><td>@(x.Enabled?"Ativa":"Inativa")</td></tr>}</tbody></table></div>
