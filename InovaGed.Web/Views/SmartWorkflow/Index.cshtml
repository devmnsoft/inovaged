@model InovaGed.Application.SmartWorkflow.SmartWorkflowDashboard
@{ViewData["Title"]="Workflow Inteligente";ViewData["Subtitle"]="Transforme pendências documentais, sugestões inteligentes, incidentes e revisões em tarefas operacionais rastreáveis.";ViewData["Icon"]="diagram-3";}
<div class="atlas-page"><partial name="Atlas/_AtlasPageHero"/><div class="alert alert-info">O workflow organiza e recomenda trabalho. Ações críticas sempre exigem confirmação humana.</div><div class="row g-3">
@{var kpis=new Dictionary<string,int>{{"Tarefas abertas",Model.OpenTasks},{"Atrasadas",Model.OverdueTasks},{"Críticas",Model.CriticalTasks},{"Em andamento",Model.InProgressTasks},{"Concluídas hoje",Model.CompletedToday},{"Pendências de classificação",Model.ClassificationPending},{"Pendências de temporalidade",Model.RetentionPending},{"Ações do assistente",Model.AssistantPending}};}
@foreach(var k in kpis){<div class="col-6 col-lg-3"><div class="card atlas-card h-100"><div class="card-body"><div class="text-muted">@k.Key</div><strong class="fs-2">@k.Value</strong></div></div></div>}</div><div class="d-flex gap-2 mt-4"><a class="btn btn-primary" href="/SmartWorkflow/Tasks">Ver tarefas</a><a class="btn btn-outline-secondary" href="/SmartWorkflow/Rules">Regras</a><a class="btn btn-outline-secondary" href="/SmartWorkflow/Report">Relatório</a><form method="post" action="/SmartWorkflow/Generate"><button class="btn btn-success">Gerar tarefas</button></form></div></div>
