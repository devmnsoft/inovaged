@model IReadOnlyList<InovaGed.Application.SmartWorkflow.SmartWorkflowTaskItem>
@{ViewData["Title"]="Tarefas documentais";ViewData["Subtitle"]="Fila operacional com prioridade, responsável e SLA.";}
<div class="atlas-page"><partial name="Atlas/_AtlasPageHero"/><form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-md"><select class="form-select" name="status"><option value="">Todos os status</option><option>OPEN</option><option>IN_PROGRESS</option><option>WAITING</option><option>COMPLETED</option></select></div><div class="col-md"><select class="form-select" name="priority"><option value="">Todas as prioridades</option><option>CRITICAL</option><option>HIGH</option><option>MEDIUM</option><option>LOW</option></select></div><div class="col-md"><input class="form-control" name="taskType" placeholder="Tipo"/></div><div class="col-md"><input class="form-control" name="sourceType" placeholder="Origem"/></div><div class="col-md-auto form-check pt-2"><input class="form-check-input" type="checkbox" name="overdueOnly" value="true"/><label class="form-check-label">Atrasadas</label></div><div class="col-md-auto"><button class="btn btn-primary">Filtrar</button></div></div></form>
@if(Model.Count==0){<div class="alert alert-light">Nenhuma tarefa encontrada.</div>}else{<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Número</th><th>Prioridade</th><th>Tipo</th><th>Título</th><th>Origem</th><th>Responsável</th><th>SLA</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.TaskNumber</td><td><span class="badge text-bg-warning">@x.Priority</span></td><td>@x.TaskType</td><td>@x.Title</td><td>@x.SourceType</td><td>@(x.AssignedToName??"Não atribuído")</td><td>@x.SlaLabel</td><td>@x.Status</td><td><a class="btn btn-sm btn-outline-primary" href="/SmartWorkflow/Task/@x.Id">Abrir</a></td></tr>}</tbody></table></div>}</div>
