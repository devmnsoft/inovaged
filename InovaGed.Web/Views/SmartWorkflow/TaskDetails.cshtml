@model InovaGed.Application.SmartWorkflow.SmartWorkflowTaskDetails
@{ViewData["Title"]=$"Tarefa {Model.Task.TaskNumber}";ViewData["Subtitle"]=Model.Task.Title;}
<div class="atlas-page"><partial name="Atlas/_AtlasPageHero"/><div class="row g-3"><div class="col-lg-8"><div class="card atlas-card"><div class="card-body"><h2 class="h5">Resumo</h2><p>@Model.Description</p><dl class="row"><dt class="col-sm-4">Origem</dt><dd class="col-sm-8">@Model.Task.SourceType</dd><dt class="col-sm-4">Documento relacionado</dt><dd class="col-sm-8">@(Model.RelatedDocumentId?.ToString()??"—")</dd><dt class="col-sm-4">Caixa relacionada</dt><dd class="col-sm-8">@(Model.RelatedBoxId?.ToString()??"—")</dd><dt class="col-sm-4">Incidente relacionado</dt><dd class="col-sm-8">@(Model.RelatedIncidentId?.ToString()??"—")</dd><dt class="col-sm-4">Ação recomendada</dt><dd class="col-sm-8">@Model.RecommendedAction</dd><dt class="col-sm-4">SLA</dt><dd class="col-sm-8">@Model.Task.SlaLabel</dd></dl></div></div><h2 class="h5 mt-4">Histórico</h2>@foreach(var e in Model.Events){<div class="border-start border-3 ps-3 mb-3"><strong>@e.EventType</strong><div>@e.Message</div><small class="text-muted">@e.OccurredAt.ToLocalTime()</small></div>}</div><div class="col-lg-4"><div class="card card-body"><form method="post" asp-action="Assign" asp-route-id="@Model.Task.Id"><button class="btn btn-outline-primary w-100 mb-2">Assumir</button></form><form method="post" asp-action="Start" asp-route-id="@Model.Task.Id"><button class="btn btn-primary w-100 mb-2">Iniciar</button></form><form method="post" asp-action="Complete" asp-route-id="@Model.Task.Id"><textarea required class="form-control mb-2" name="notes" placeholder="Notas de conclusão"></textarea><button class="btn btn-success w-100 mb-2">Concluir</button></form><form method="post" asp-action="Cancel" asp-route-id="@Model.Task.Id"><textarea required class="form-control mb-2" name="reason" placeholder="Motivo"></textarea><button class="btn btn-outline-danger w-100">Cancelar</button></form></div></div></div></div>
