@model InovaGed.Web.Controllers.ArchiveProductivityController.RegisterInput
@{var services=(IReadOnlyList<InovaGed.Application.PhysicalArchive.Productivity.ArchiveServiceCatalogItem>)ViewBag.Catalog;}
<h1>Registrar produção</h1><form method="post" class="card p-4"><div asp-validation-summary="All"></div><label>Serviço</label><select asp-for="ServiceCatalogId" class="form-select">@foreach(var s in services.Where(x=>x.IsActive)){<option value="@s.Id">@s.Name</option>}</select><label>Competência</label><input asp-for="CompetenceMonth" type="month" class="form-control"/><label>Quantidade</label><input asp-for="Quantity" class="form-control"/><label>UST (regra manual)</label><input asp-for="UstQuantity" class="form-control"/><label>Observações</label><textarea asp-for="Notes" class="form-control"></textarea><button class="btn btn-primary mt-3">Registrar e enviar</button></form>
