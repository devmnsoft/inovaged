@using InovaGed.Application.Contracts.Fiscalization
@{var fiscal=ViewBag.Fiscalization as ContractFiscalizationPeriodItem;}
@model InovaGed.Application.PhysicalArchive.Productivity.ArchiveBillingPreview
<div class="alert alert-secondary"><strong>Fiscalização vinculada:</strong> @(fiscal is null ? "Não criada" : fiscal.Status) @if(fiscal is not null){<span> · Medido @fiscal.TotalMeasuredAmount.ToString("C") · Glosado @fiscal.TotalGlossedAmount.ToString("C") · Aprovado @fiscal.TotalApprovedAmount.ToString("C")</span>}</div><h2>Pré-faturamento — @Model.CompetenceMonth.ToString("MM/yyyy")</h2><div class="alert alert-info">A competência fechada bloqueia alterações para preservar a integridade da medição.</div><table class="table"><thead><tr><th>Serviço</th><th>Quantidade</th><th>UST</th><th>Valor unitário</th><th>Total</th></tr></thead><tbody>@foreach(var x in Model.Lines){<tr><td>@x.Service</td><td>@x.Quantity</td><td>@x.UstQuantity</td><td>@x.UnitPrice.ToString("C")</td><td>@x.TotalAmount.ToString("C")</td></tr>}</tbody><tfoot><tr><th>Total</th><th>@Model.TotalQuantity</th><th>@Model.TotalUst</th><th></th><th>@Model.TotalAmount.ToString("C")</th></tr></tfoot></table><form method="post" asp-action="Close"><input type="hidden" name="competence" value="@Model.CompetenceMonth.ToString("yyyy-MM-dd")"/><input name="notes" class="form-control" placeholder="Justificativa, se houver pendências"/><button class="btn btn-warning mt-2">Fechar competência</button></form><form method="post" asp-action="ApproveBilling" class="mt-2"><input type="hidden" name="competence" value="@Model.CompetenceMonth.ToString("yyyy-MM-dd")"/><button class="btn btn-success">Aprovar competência</button></form>
