@using InovaGed.Application.Contracts.Fiscalization
@{var f=ViewBag.Fiscalization as ContractFiscalizationPeriodItem;var competence=(DateOnly)ViewBag.Competence;}
<h1>Faturamento operacional</h1><p>Selecione a competência para gerar a prévia auditável.</p><div class="card p-4 mb-3"><h2 class="h5">Fiscalização vinculada</h2>@if(f is null){<span class="badge bg-secondary">Não criada</span><a asp-controller="ContractFiscalization" asp-action="Create">Criar fiscalização</a>}else{<span class="badge bg-info">@(f.Status switch{"WITH_GLOSA"=>"Com glosa","APPROVED"=>"Aprovada","CLOSED"=>"Fechada",_=>"Em conferência"})</span><p>Medido: @f.TotalMeasuredAmount.ToString("C") · Glosado: @f.TotalGlossedAmount.ToString("C") · Aprovado: @f.TotalApprovedAmount.ToString("C")</p><a asp-controller="ContractFiscalization" asp-action="Details" asp-route-id="@f.Id">Abrir fiscalização</a>}</div><form method="get" asp-action="BillingPreview" class="card p-4"><input type="month" name="competence" value="@competence.ToString("yyyy-MM")" class="form-control"/><button class="btn btn-primary mt-3">Gerar prévia</button></form>
