@model IReadOnlyList<InovaGed.Application.PhysicalArchive.Productivity.ArchiveProductivityEntryItem>
<h1>Apontamentos de produção</h1><a class="btn btn-primary" asp-action="Register">Registrar</a> <a class="btn btn-outline-secondary" asp-action="Export">Exportar CSV</a><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Serviço</th><th>Origem</th><th>Quantidade</th><th>UST</th><th>Valor</th><th>Status</th><th>Ações</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.ServiceName</td><td>@(x.SourceType??"MANUAL")</td><td>@x.Quantity</td><td>@x.UstQuantity</td><td>@x.TotalAmount.ToString("C")</td><td><span class="badge bg-secondary">@x.Status</span></td><td><form method="post" asp-action="Approve" asp-route-id="@x.Id" class="d-inline"><button class="btn btn-sm btn-success">Aprovar</button></form><form method="post" asp-action="Reject" asp-route-id="@x.Id" class="d-inline"><input name="reason" required placeholder="Motivo"/><button class="btn btn-sm btn-danger">Rejeitar</button></form></td></tr>}</tbody></table></div>
