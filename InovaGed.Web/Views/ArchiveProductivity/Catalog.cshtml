@model IReadOnlyList<InovaGed.Application.PhysicalArchive.Productivity.ArchiveServiceCatalogItem>
<h1>Catálogo de serviços medíveis</h1><a class="btn btn-primary mb-3" asp-action="CatalogCreate">Novo serviço</a><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Código</th><th>Serviço</th><th>Regra</th><th>UST padrão</th><th>Valor</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><code>@x.Code</code></td><td>@x.Name</td><td>@x.CalculationRule</td><td>@x.DefaultUstQuantity</td><td>@x.UnitPrice.ToString("C")</td><td><a asp-action="CatalogEdit" asp-route-id="@x.Id">Editar</a></td></tr>}</tbody></table></div>
