@using InovaGed.Application.Billing
@using InovaGed.Web.Models.Atlas
@model BillingExtractionDto
@{ViewData["Title"]="Revisar extração";var header=new AtlasPageHeaderVm("Revisão financeira","Corrija os campos reconhecidos e aprove ou marque divergência.","edit","Faturamento",new[]{new AtlasPageAction("Cancelar",Url.Action("Details","Billing",new{id=Model.Id})!,"close",false)});}
<partial name="Atlas/_PageHeader" model="header" />
<form method="post" class="card border-0 shadow-sm"><div class="card-body row g-3">@Html.AntiForgeryToken()
@foreach(var p in new[]{("SupplierName","Fornecedor",Model.SupplierName),("SupplierDocument","CPF / CNPJ",Model.SupplierDocument),("InvoiceNumber","Número da nota",Model.InvoiceNumber),("InvoiceSeries","Série",Model.InvoiceSeries),("CompetenceMonth","Competência",Model.CompetenceMonth),("ContractNumber","Contrato",Model.ContractNumber),("PurchaseOrder","Ordem de serviço / compra",Model.PurchaseOrder),("CostCenter","Centro de custo",Model.CostCenter),("ServiceDescription","Descrição do serviço",Model.ServiceDescription)}){<div class="col-md-6"><label class="form-label">@p.Item2</label><input class="form-control" name="@p.Item1" value="@p.Item3" /></div>}
<div class="col-md-4"><label class="form-label">Valor bruto</label><input class="form-control" name="GrossAmount" value="@Model.GrossAmount" type="number" step=".01" /></div><div class="col-md-4"><label class="form-label">Valor líquido</label><input class="form-control" name="NetAmount" value="@Model.NetAmount" type="number" step=".01" /></div><div class="col-md-4"><label class="form-label">Impostos</label><input class="form-control" name="TaxAmount" value="@Model.TaxAmount" type="number" step=".01" /></div>
<div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" name="HasDivergence" value="true" id="divergence"><label class="form-check-label" for="divergence">Marcar divergência para tratamento</label></div></div><div class="card-footer text-end"><button class="btn btn-primary">Salvar revisão</button></div></form>
