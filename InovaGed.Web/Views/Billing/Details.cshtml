@using InovaGed.Application.Billing
@using InovaGed.Web.Models.Atlas
@model BillingExtractionDto
@{ViewData["Title"]="Detalhes da extração";var header=new AtlasPageHeaderVm("Documento de faturamento",Model.DocumentTitle,"report","Faturamento",new[]{new AtlasPageAction("Revisar",Url.Action("Review","Billing",new{id=Model.Id})!,"edit",true),new AtlasPageAction("Voltar",Url.Action("Index","Billing")!,"arrow-left",false)});}
<partial name="Atlas/_PageHeader" model="header" />
@if(TempData["Ok"] is string ok){<div class="alert alert-success">@ok</div>}
<div class="row g-3"><div class="col-lg-8"><div class="card border-0 shadow-sm"><div class="card-body"><h5>Campos extraídos</h5><dl class="row mb-0"><dt class="col-sm-4">Fornecedor</dt><dd class="col-sm-8">@Model.SupplierName — @Model.SupplierDocument</dd><dt class="col-sm-4">Nota / série</dt><dd class="col-sm-8">@Model.InvoiceNumber / @Model.InvoiceSeries</dd><dt class="col-sm-4">Emissão / vencimento</dt><dd class="col-sm-8">@Model.IssueDate?.ToShortDateString() / @Model.DueDate?.ToShortDateString()</dd><dt class="col-sm-4">Valores</dt><dd class="col-sm-8">Bruto @Model.GrossAmount?.ToString("C") · Líquido @Model.NetAmount?.ToString("C") · Impostos @Model.TaxAmount?.ToString("C")</dd><dt class="col-sm-4">Contrato / ordem</dt><dd class="col-sm-8">@Model.ContractNumber / @Model.PurchaseOrder</dd><dt class="col-sm-4">UST</dt><dd class="col-sm-8">@Model.UstQuantity × @Model.UstUnitValue?.ToString("C")</dd></dl></div></div></div><div class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body"><h5>Qualidade</h5><div class="display-6">@Model.Confidence.ToString("N0")%</div><span class="badge text-bg-info">@Model.ExtractionStatus</span></div></div></div></div>
