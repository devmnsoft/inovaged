@using InovaGed.Application.Billing
@using InovaGed.Web.Models.Atlas
@model IReadOnlyList<BillingExtractionDto>
@{
 ViewData["Title"]="Faturamento"; var k=(BillingKpis)ViewBag.Kpis; var f=(BillingFilter)ViewBag.Filter;
 var header=new AtlasPageHeaderVm("Faturamento", "Extração e conferência de dados fiscais a partir do OCR documental.", "report", "Operação financeira",
  new[]{new AtlasPageAction("Checklist", Url.Action("Checklist","Billing")!, "list", true),new AtlasPageAction("Extrair documento", Url.Action("Extraction","Billing")!, "ocr", false),new AtlasPageAction("Regras",Url.Action("Rules","Billing")!,"settings",false)});
 var metrics=new[]{new AtlasMetricVm("Extraídos",k.Extracted.ToString(),"documentos nos filtros atuais","info","documents"),new AtlasMetricVm("Pendentes",k.PendingReview.ToString(),"aguardando revisão","warning","history"),new AtlasMetricVm("Aprovados",k.Approved.ToString(),"revisados","success","check"),new AtlasMetricVm("Divergências",k.Divergent.ToString(),"exigem atenção","danger","warning"),new AtlasMetricVm("Valor identificado",k.TotalAmount.ToString("C"),"valor bruto acumulado","info","report"),new AtlasMetricVm("Sem OCR",k.WithoutOcr.ToString(),"entre os documentos filtrados","warning","ocr")};
}
<partial name="Atlas/_PageHeader" model="header" />
<partial name="Atlas/_PageMetrics" model="metrics" />
@if(TempData["Ok"] is string ok){<div class="alert alert-success">@ok</div>} @if(TempData["Err"] is string err){<div class="alert alert-danger">@err</div>}
<form method="get" class="card border-0 shadow-sm mb-3"><div class="card-body row g-2">
 <div class="col-md"><input class="form-control" name="supplier" value="@f.Supplier" placeholder="Fornecedor" /></div><div class="col-md"><input class="form-control" name="supplierDocument" value="@f.SupplierDocument" placeholder="CNPJ / CPF" /></div>
 <div class="col-md"><input class="form-control" name="competence" value="@f.Competence" placeholder="Competência MM/AAAA" /></div><div class="col-md"><select class="form-select" name="status"><option value="">Todos os status</option><option value="PENDING_REVIEW" selected="@(f.Status=="PENDING_REVIEW")">Pendente</option><option value="APPROVED" selected="@(f.Status=="APPROVED")">Aprovado</option><option value="DIVERGENT" selected="@(f.Status=="DIVERGENT")">Divergente</option></select></div>
 <div class="col-md"><label for="responsibleUserId">Responsável</label><select id="responsibleUserId" name="responsibleUserId" class="form-select"><option value="">Todos</option>@foreach(var person in (IReadOnlyList<BillingAssignee>)ViewBag.Assignees){<option value="@person.Id" selected="@(f.ResponsibleUserId==person.Id)">@person.Name</option>}</select></div>
 <div class="col-md"><label for="minimumAmount">Valor mínimo</label><input id="minimumAmount" type="number" step="0.01" min="0" name="minimumAmount" value="@f.MinimumAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control"/></div>
 <div class="col-auto"><label><input type="checkbox" name="overdue" value="true" checked="@(f.Overdue==true)"/> Revisões vencidas</label></div>
 <div class="col-auto"><button class="btn btn-primary" type="submit"><app-icon name="search" size="16" decorative="true" /> Filtrar</button></div></div></form>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle text-nowrap mb-0"><thead><tr><th>Documento</th><th>Fornecedor</th><th>Nota</th><th>Competência</th><th>Valor</th><th>Confiança</th><th>Status</th><th></th></tr></thead><tbody>
@if(Model.Count==0){<tr><td colspan="8" class="text-center py-5"><app-icon name="report" size="32" decorative="true" /><h5 class="mt-2">Nenhuma extração encontrada</h5><p class="text-muted">Execute a extração em um documento com OCR fiscal ou financeiro.</p></td></tr>}
@foreach(var x in Model){<tr><td><strong>@x.DocumentTitle</strong><div class="small text-muted">@x.DocumentKind</div>@if(x.PendingCandidateJson is not null){<span class="badge text-bg-info">Nova extração para comparar</span>}@if(x.DuplicateCount>0){<span class="badge text-bg-warning">Possível duplicidade</span>}<small class="d-block">Prioridade @x.Priority · Prazo @(x.ReviewDueDate?.ToString("dd/MM/yyyy")??"não definido")</small></td><td>@(x.SupplierName??"—")<div class="small text-muted">@x.SupplierDocument</div></td><td>@(x.InvoiceNumber??"—")</td><td>@(x.CompetenceMonth??"—")</td><td>@(x.GrossAmount?.ToString("C")??"—")</td><td>@x.Confidence.ToString("N0")%</td><td><span class="badge @(x.ExtractionStatus=="APPROVED"?"text-bg-success":x.ExtractionStatus=="DIVERGENT"?"text-bg-danger":"text-bg-warning")">@x.ExtractionStatus</span></td><td><a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@x.Id"><app-icon name="view" size="15" decorative="true" /> Ver</a></td></tr>}
</tbody></table></div></div>

@{ var routes = new Dictionary<string,string> { ["supplier"]=f.Supplier??"",["supplierDocument"]=f.SupplierDocument??"",["competence"]=f.Competence??"",["status"]=f.Status??"",["minimumAmount"]=f.MinimumAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture)??"",["responsibleUserId"]=f.ResponsibleUserId?.ToString()??"",["overdue"]=f.Overdue?.ToString()??"",["pageSize"]=f.PageSize.ToString() }; }
<nav class="d-flex gap-3 align-items-center mt-3" aria-label="Paginação do faturamento">
@if(f.Page>1){routes["page"]=(f.Page-1).ToString();<a asp-action="Index" asp-all-route-data="routes">Anterior</a>}
<span>Página @f.Page · @k.Extracted resultado(s)</span>
@if((long)f.Page*f.PageSize<k.Extracted){routes["page"]=(f.Page+1).ToString();<a asp-action="Index" asp-all-route-data="routes">Próxima</a>}
<a asp-action="Export" asp-all-route-data="routes">Exportar resultados filtrados</a></nav>
