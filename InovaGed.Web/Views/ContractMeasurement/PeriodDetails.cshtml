@model InovaGed.Application.ContractMeasurement.ContractMeasurementPeriodDetails
@{ViewData["Title"]=$"Medição {Model?.Period.PeriodCode}";ViewData["Subtitle"]="Resumo, itens, evidências, glosas, aceite e histórico da competência.";ViewData["Icon"]="receipt";}
<link rel="stylesheet" href="~/css/contract-measurement.css"/><main class="atlas-page contract-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/>@if(Model is not null){<div class="contract-period-card"><div><span>Status</span><strong>@Model.Period.Status</strong></div><div><span>Bruto</span><strong>@Model.Period.GrossAmount.ToString("C")</strong></div><div><span>Glosas</span><strong>@Model.Period.GlosaAmount.ToString("C")</strong></div><div><span>Líquido</span><strong>@Model.Period.NetAmount.ToString("C")</strong></div></div><nav class="contract-tabs"><a href="#summary">Resumo</a><a href="#items">Itens</a><a href="#evidence">Evidências</a><a href="#glosas">Glosas</a><a href="#acceptance">Aceite</a><a href="#history">Histórico</a></nav><section id="acceptance" class="contract-acceptance-panel"><form asp-action="GenerateItems" asp-route-id="@Model.Period.Id" method="post">@Html.AntiForgeryToken()<button>Gerar itens</button></form><form asp-action="SubmitAcceptance" asp-route-id="@Model.Period.Id" method="post">@Html.AntiForgeryToken()<button>Submeter aceite</button></form><form asp-action="Approve" asp-route-id="@Model.Period.Id" method="post">@Html.AntiForgeryToken()<input name="notes" placeholder="Justificativa se houver glosa"/><button>Aprovar</button></form><form asp-action="Reject" asp-route-id="@Model.Period.Id" method="post">@Html.AntiForgeryToken()<input name="reason" placeholder="Motivo obrigatório" required/><button>Rejeitar</button></form><form asp-action="Close" asp-route-id="@Model.Period.Id" method="post">@Html.AntiForgeryToken()<button>Fechar</button></form></section><section id="items" class="contract-table"><h2>Itens de faturamento</h2><table><thead><tr><th>Serviço</th><th>Natureza</th><th>Quantidade</th><th>Unitário</th><th>Bruto</th><th>Glosa</th><th>Líquido</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Description</td><td>@x.Nature</td><td>@x.Quantity</td><td>@x.UnitValue.ToString("C")</td><td>@x.GrossAmount.ToString("C")</td><td>@x.GlosaAmount.ToString("C")</td><td>@x.NetAmount.ToString("C")</td></tr>}</tbody></table></section><section id="evidence" class="contract-evidence-list"><h2>Evidências</h2><form asp-action="RegisterEvidence" asp-route-id="@Model.Period.Id" method="post" class="contract-form compact">@Html.AntiForgeryToken()<select name="itemId"><option value="">Período completo</option>@foreach(var x in Model.Items){<option value="@x.Id">@x.Description</option>}</select><select name="sourceType"><option>PERIOD</option><option>DOCUMENT</option><option>BOX</option><option>LABEL</option><option>WORKFLOW</option></select><input name="title" placeholder="Título" required/><input name="description" placeholder="Descrição sem dados sensíveis"/><input name="evidenceHash" placeholder="Hash opcional"/><button>Registrar</button></form>@foreach(var e in Model.Evidence){<article><strong>@e.Title</strong><span>@e.RegisteredAt.ToString("g") · @(e.RegisteredByName??"Sistema")</span><p>@e.Description</p></article>}</section><section id="history"><h2>Histórico</h2>@foreach(var e in Model.Events){<p><strong>@e.Title</strong> · @e.OccurredAt.ToString("g")<br/>@e.Description</p>}</section>}</main>
