@model IReadOnlyList<InovaGed.Application.ContractMeasurement.ContractMeasurementPeriodItem>
@{ViewData["Title"]="Períodos de Medição";ViewData["Subtitle"]="Competências mensais, geração de itens e valores para aceite.";ViewData["Icon"]="calendar";}
<link rel="stylesheet" href="~/css/contract-measurement.css"/><main class="atlas-page contract-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/><form asp-action="CreatePeriod" method="post" class="contract-toolbar">@Html.AntiForgeryToken()<select name="referenceMonth" required>@for(var m=1;m<=12;m++){<option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>}</select><input name="referenceYear" type="number" value="@DateTime.Today.Year" min="2000" required/><input name="notes" placeholder="Observação opcional"/><button class="contract-button">Abrir período</button></form><div class="contract-table"><table><thead><tr><th>Período</th><th>Mês/Ano</th><th>Status</th><th>Valor bruto</th><th>Glosas</th><th>Valor líquido</th><th>Fechado em</th><th>Ações</th></tr></thead><tbody>@foreach(var x in Model??[]){<tr><td>@x.PeriodCode</td><td>@x.ReferenceMonth.ToString("00")/@x.ReferenceYear</td><td><span class="contract-status">@x.Status</span></td><td>@x.GrossAmount.ToString("C")</td><td>@x.GlosaAmount.ToString("C")</td><td>@x.NetAmount.ToString("C")</td><td>@x.ClosedAt?.ToString("dd/MM/yyyy")</td><td><a asp-action="PeriodDetails" asp-route-id="@x.Id">Abrir</a></td></tr>}</tbody></table></div></main>
