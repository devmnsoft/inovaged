@model IReadOnlyList<InovaGed.Application.ContractMeasurement.ContractMeasurementPeriodItem>
@{ViewData["Title"]="Aceite do Fiscal";ViewData["Subtitle"]="Períodos submetidos para conferência, aprovação ou rejeição fundamentada.";ViewData["Icon"]="shield-check";}
<link rel="stylesheet" href="~/css/contract-measurement.css"/><main class="atlas-page contract-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/><div class="contract-action-grid">@foreach(var p in (Model??[]).Where(x=>x.Status=="SUBMITTED")){<article class="contract-report-card"><span>@p.PeriodCode</span><strong>@p.NetAmount.ToString("C")</strong><small>Bruto @p.GrossAmount.ToString("C") · Glosas @p.GlosaAmount.ToString("C")</small><a asp-action="PeriodDetails" asp-route-id="@p.Id">Conferir evidências e decidir</a></article>}</div>@if(Model is null||!Model.Any(x=>x.Status=="SUBMITTED")){<div class="contract-empty"><strong>Nenhum aceite pendente</strong><p>Períodos submetidos aparecerão nesta central.</p></div>}</main>
