@model InovaGed.Application.ContractMeasurement.ContractMeasurementDashboard
@{ViewData["Title"]="Medição e Faturamento";ViewData["Subtitle"]="Controle produtividade, UST, medições, evidências, glosas e aceite contratual dos serviços executados no GED.";ViewData["Icon"]="receipt";var kpis=new Dictionary<string,string>{{"Período atual",Model?.CurrentPeriod??"—"},{"Valor bruto",(Model?.GrossAmount??0).ToString("C")},{"Glosas",(Model?.GlosaAmount??0).ToString("C")},{"Valor líquido",(Model?.NetAmount??0).ToString("C")},{"Lançamentos pendentes",(Model?.PendingEntries??0).ToString()},{"Itens medidos",(Model?.MeasuredItems??0).ToString()},{"Aceites pendentes",(Model?.PendingAcceptances??0).ToString()},{"Relatórios exportados",(Model?.ExportedReports??0).ToString()}};var actions=new Dictionary<string,string>{{"Catálogo de Serviços","ServiceCatalog"},{"Produtividade","Productivity"},{"Períodos de Medição","Periods"},{"Itens de Faturamento","Periods"},{"Evidências","Periods"},{"Glosas","Glosas"},{"Aceite do Fiscal","Acceptance"},{"Relatórios","Reports"}};}
<link rel="stylesheet" href="~/css/contract-measurement.css" asp-append-version="true"/><main class="atlas-page contract-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/><div class="contract-kpi-grid">@foreach(var k in kpis){<partial name="Atlas/_AtlasKpiCard" view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData){{"Label",k.Key},{"Value",k.Value}}'/>}</div><div class="contract-action-grid">@foreach(var a in actions){<a class="contract-report-card" asp-action="@a.Value"><app-icon name="receipt" size="24" decorative="true"/><strong>@a.Key</strong><span>Acesso isolado por tenant e auditável</span></a>}</div></main>
