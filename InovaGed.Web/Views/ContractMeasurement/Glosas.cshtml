@model IReadOnlyList<InovaGed.Application.ContractMeasurement.ContractGlosaItem>
@using InovaGed.Application.ContractMeasurement
@{ViewData["Title"]="Glosas Contratuais";ViewData["Subtitle"]="Registre, acompanhe e resolva divergências da medição.";ViewData["Icon"]="warning";var periods=ViewBag.Periods as IReadOnlyList<ContractMeasurementPeriodItem>??[];}
<link rel="stylesheet" href="~/css/contract-measurement.css"/><main class="atlas-page contract-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/><form asp-action="CreateGlosa" method="post" class="contract-toolbar">@Html.AntiForgeryToken()<select name="periodId" required><option value="">Selecione o período</option>@foreach(var p in periods){<option value="@p.Id">@p.PeriodCode</option>}</select><input name="reason" placeholder="Motivo obrigatório" required/><input name="amount" type="number" min="0" step="0.01" placeholder="Valor" required/><button>Criar glosa</button></form><div class="contract-table"><table><thead><tr><th>Número</th><th>Motivo</th><th>Valor</th><th>Status</th><th>Aberta em</th><th>Resolver</th></tr></thead><tbody>@foreach(var x in Model??[]){<tr><td>@x.Number</td><td>@x.Reason</td><td>@x.Amount.ToString("C")</td><td><span class="contract-glosa-badge">@x.Status</span></td><td>@x.OpenedAt.ToString("g")</td><td>@if(x.Status=="OPEN"){<form asp-action="ResolveGlosa" asp-route-id="@x.Id" method="post">@Html.AntiForgeryToken()<input name="notes" placeholder="Observação obrigatória" required/><button>Resolver</button></form>}</td></tr>}</tbody></table></div></main>
