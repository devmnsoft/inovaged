@model IReadOnlyList<InovaGed.Application.ContractMeasurement.ContractProductivityItem>
@{ViewData["Title"]="Produtividade Contratual";ViewData["Subtitle"]="Lançamentos revisáveis de serviços executados e respectivas evidências.";ViewData["Icon"]="activity";}
<link rel="stylesheet" href="~/css/contract-measurement.css"/><main class="atlas-page contract-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/><div class="contract-toolbar"><form method="get"><input name="search" placeholder="Buscar serviço ou observação"/><select name="status"><option value="">Todos os status</option><option>DRAFT</option><option>APPROVED</option></select><button>Filtrar</button></form><div><a class="contract-button" asp-action="ProductivityCreate">Novo lançamento</a><a class="contract-button secondary" asp-action="Export" asp-route-reportType="productivity-by-service">Exportar CSV</a></div></div><div class="contract-table"><table><thead><tr><th>Data</th><th>Serviço</th><th>Origem</th><th>Quantidade</th><th>Valor unitário</th><th>Valor total</th><th>Responsável</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model??[]){<tr><td>@x.PerformedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@x.Service</td><td>@(x.SourceType??"Manual")</td><td>@x.Quantity</td><td>@x.UnitValue.ToString("C")</td><td>@x.TotalValue.ToString("C")</td><td>@(x.PerformedByName??"Não informado")</td><td><span class="contract-status">@x.Status</span></td></tr>}</tbody></table>@if(Model is null||Model.Count==0){<div class="contract-empty"><strong>Nenhum lançamento encontrado</strong><p>Registre a produção executada para iniciar a medição.</p></div>}</div></main>
