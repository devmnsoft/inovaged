@model InovaGed.Web.Controllers.ContractMeasurementController.ProductivityInput
@using InovaGed.Application.ContractMeasurement
@{ViewData["Title"]="Novo lançamento de produtividade";ViewData["Subtitle"]="Registre quantidade, valor e origem sem informar identificadores técnicos.";ViewData["Icon"]="activity";var services=ViewBag.Services as IReadOnlyList<ContractServiceCatalogItem>??[];}
<link rel="stylesheet" href="~/css/contract-measurement.css"/><main class="atlas-page contract-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/><form method="post" class="contract-form">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><label>Serviço<select asp-for="ServiceId" required><option value="">Selecione</option>@foreach(var s in services){<option value="@s.Id" data-value="@s.UnitValue">@s.ServiceCode — @s.Description</option>}</select></label><label>Origem<select asp-for="SourceType"><option value="MANUAL">Lançamento manual</option><option value="DOCUMENT">Documento GED</option><option value="BOX">Caixa do acervo</option><option value="LABEL">Etiqueta</option><option value="WORKFLOW">Workflow</option></select></label><div class="contract-form-grid"><label>Quantidade<input asp-for="Quantity" type="number" min="0.01" step="0.01" required/></label><label>Valor unitário<input asp-for="UnitValue" type="number" min="0" step="0.01" required/></label><label>Data da execução<input asp-for="PerformedAt" type="datetime-local" required/></label></div><label>Observações<textarea asp-for="Notes"></textarea></label><label class="check"><input asp-for="EvidenceRequired"/> Evidência obrigatória para revisão</label><div><button class="contract-button">Salvar lançamento</button><a asp-action="Productivity">Cancelar</a></div></form></main>
