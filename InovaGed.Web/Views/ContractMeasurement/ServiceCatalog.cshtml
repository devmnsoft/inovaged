@model IReadOnlyList<InovaGed.Application.ContractMeasurement.ContractServiceCatalogItem>
@{ViewData["Title"]="Catálogo de Serviços e UST";ViewData["Subtitle"]="Serviços contratuais disponíveis no tenant e valores unitários configurados.";ViewData["Icon"]="receipt";}
<link rel="stylesheet" href="~/css/contract-measurement.css"/><main class="atlas-page contract-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/><div class="contract-table"><table><thead><tr><th>Código</th><th>Descrição</th><th>Natureza</th><th>Unidade</th><th>Valor unitário</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model??[]){<tr><td><code>@x.ServiceCode</code></td><td>@x.Description</td><td>@x.Nature</td><td>@x.UnitName</td><td>@x.UnitValue.ToString("C")</td><td><span class="contract-status">@(x.Active?"Ativo":"Inativo")</span></td></tr>}</tbody></table></div></main>
