@{ViewData["Title"]="Relatórios Contratuais";ViewData["Subtitle"]="Exportações CSV validadas e isoladas por tenant.";ViewData["Icon"]="file-text";var reports=new Dictionary<string,string>{{"Produtividade por serviço","productivity-by-service"},{"Produtividade por usuário","productivity-by-user"},{"Medição mensal","monthly-measurement"},{"Glosas por período","glosas-by-period"},{"Valor bruto x líquido","gross-vs-net"},{"Serviços sem evidência","services-without-evidence"},{"Aceites pendentes","pending-acceptances"}};}
