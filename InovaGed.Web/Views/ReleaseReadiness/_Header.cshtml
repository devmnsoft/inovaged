    <form method="post" action="/ReleaseReadiness/Refresh">@Html.AntiForgeryToken()<button class="btn btn-primary"><app-icon name="recent" decorative="true" /> Atualizar diagnóstico</button></form>
</header>
<nav class="nav nav-pills gap-2 mb-4" aria-label="Seções de prontidão">
 <a class="nav-link" href="/ReleaseReadiness">Visão geral</a><a class="nav-link" href="/ReleaseReadiness/Modules">Módulos</a><a class="nav-link" href="/ReleaseReadiness/Checklist">Checklist</a><a class="nav-link" href="/ReleaseReadiness/Smoke">Smoke</a><a class="nav-link" href="/ReleaseReadiness/Report">Relatório</a>
</nav>
