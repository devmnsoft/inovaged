@model InovaGed.Web.Models.ReleaseReadiness.ReleaseReadinessViewModel
<div class="card shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Módulo</th><th>Status</th><th>Permissão</th><th>Dependências</th><th>Incidente</th><th>Ação</th></tr></thead><tbody>
@foreach (var item in Model.Modules) { var target = item.Status == "NEEDS_MIGRATION" ? "/DatabaseReadiness" : item.Status == "BLOCKED" ? "/SystemIncidents" : item.MainRoute; <tr><td><strong>@item.Name</strong><div class="small text-muted">@item.Description</div></td><td><span class="badge @(item.Status == "READY" ? "bg-success" : item.Status == "BLOCKED" ? "bg-danger" : "bg-warning text-dark")">@item.Status</span></td><td><code>@item.RequiredPermission</code></td><td><small>DB: @item.DatabaseDependencies<br/>DI: @item.DiDependencies</small></td><td>@(item.LastIncident ?? "Nenhum incidente crítico registrado")</td><td><div class="small mb-2">@item.RecommendedAction</div>@if(item.Status is "IN_IMPLEMENTATION" or "DISABLED"){<button class="btn btn-sm btn-outline-secondary" disabled title="@item.RecommendedAction">Em implantação</button>}else{<a class="btn btn-sm btn-outline-primary" href="@target">Abrir</a>}</td></tr> }
</tbody></table></div></div>
