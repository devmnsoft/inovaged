@model IReadOnlyList<InovaGed.Application.Labels.Intelligence.LabelAlertItem>
@{ViewData["Title"]="Alertas de etiquetas";}<link rel="stylesheet" href="~/css/label-intelligence.css" />
@await Html.PartialAsync("_Header",("Alertas operacionais","Resolva o alerta somente após conferir fisicamente o acervo."))
<div class="li-toolbar"><form method="post" asp-action="Detect">@Html.AntiForgeryToken()<button class="btn btn-primary">Detectar alertas agora</button></form><a class="btn btn-outline-primary" asp-action="Export" asp-route-report="alerts">Exportar abertos</a></div><div class="li-alerts">@foreach(var x in Model){<article class="li-alert severity-@x.Severity.ToLowerInvariant()"><div><span class="badge li-severity">@x.Severity</span><span class="badge text-bg-light">@x.Status</span><small>@x.DetectedAt.ToString("g")</small><h2>@x.Title</h2><p>@x.Message</p><div class="text-muted">@x.SubjectType · @x.ControlNumber · @x.Location</div></div>@if(x.Status is "OPEN" or "IN_PROGRESS"){<div class="li-resolution"><form action="/ArchiveWorkOrders/FromAlert/@x.Id" method="post">@Html.AntiForgeryToken()<button class="btn btn-primary">Criar Ordem de Serviço</button></form><form method="post" asp-action="Resolve" asp-route-id="@x.Id">@Html.AntiForgeryToken()<input class="form-control" name="notes" required minlength="3" placeholder="Observação da conferência"><button class="btn btn-success">Resolver</button></form><form method="post" asp-action="Ignore" asp-route-id="@x.Id">@Html.AntiForgeryToken()<input class="form-control" name="notes" required minlength="3" placeholder="Motivo obrigatório"><button class="btn btn-outline-secondary">Ignorar</button></form></div>}</article>}</div>
