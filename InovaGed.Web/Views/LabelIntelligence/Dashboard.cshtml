@model InovaGed.Application.Labels.Intelligence.LabelIntelligenceDashboard
@{ViewData["Title"]="Inteligência de Etiquetas";}
<link rel="stylesheet" href="~/css/label-intelligence.css" />
<section class="li-hero"><div><span class="li-eyebrow">ETIQUETAS · INTELIGÊNCIA OPERACIONAL</span><h1>Inteligência de Etiquetas</h1><p>Monitore impressões, leituras, divergências, movimentações e a cadeia de custódia do acervo físico.</p></div><div class="li-actions"><a class="btn btn-light" asp-action="Custody">Cadeia de custódia</a><a class="btn btn-warning" asp-action="Alerts">Ver alertas</a></div></section>
<form method="get" class="li-filter"><label>De<input class="form-control" type="date" name="from"></label><label>Até<input class="form-control" type="date" name="to"></label><label>Localização<input class="form-control" name="location" placeholder="Prédio, sala, estante..."></label><button class="btn btn-primary">Aplicar filtros</button></form>
<div class="li-kpis">@foreach(var k in new[]{("Etiquetas impressas",Model.Printed,"primary","Dashboard"),("Etiquetas lidas",Model.Scanned,"success","Dashboard"),("Impressas e nunca lidas",Model.NeverScanned,"warning","NeverScanned"),("Divergências de localização",Model.Divergences,"danger","Divergences"),("Etiquetas substituídas",Model.Replacements,"secondary","Dashboard"),("Caixas sem etiqueta",Model.BoxesWithoutLabel,"info","WithoutLabel?subjectType=BOX"),("Documentos sem etiqueta",Model.DocumentsWithoutLabel,"info","WithoutLabel?subjectType=DOCUMENT"),("Alertas abertos",Model.OpenAlerts,"danger","Alerts")}){<a class="li-kpi" href="/LabelIntelligence/@k.Item4"><span class="li-dot bg-@k.Item3"></span><strong>@k.Item1</strong><b>@k.Item2</b><small>Ver detalhes →</small></a>}</div>
<div class="row g-4 mt-1">@foreach(var table in new[]{("Leituras por dia",Model.ScansByDay),("Top 10 localizações com divergência",Model.DivergencesByLocation),("Modelos mais usados",Model.Templates),("Impressões por usuário",Model.PrintsByUser),("Alertas por severidade",Model.AlertsBySeverity)}){<div class="col-lg-6"><section class="li-panel"><h2>@table.Item1</h2>@if(table.Item2.Count==0){<p class="text-muted">Nenhum dado para o período.</p>}else{<div class="li-bars">@foreach(var row in table.Item2){<div><span>@row.Label</span><progress value="@row.Value" max="@Math.Max(1,table.Item2.Max(x=>x.Value))"></progress><b>@row.Value</b></div>}</div>}</section></div>}</div>
