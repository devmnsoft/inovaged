@model InovaGed.Application.Labels.Intelligence.LabelCustodyTimeline
@{ViewData["Title"]="Cadeia de custódia";}<link rel="stylesheet" href="~/css/label-intelligence.css" />
@await Html.PartialAsync("_Header",("Cadeia de custódia","A cadeia de custódia consolida todos os eventos relevantes do objeto físico."))
<form class="li-custody-search" method="get" asp-action="CustodyByControl"><label>Número de controle, caixa, documento ou QR payload<input class="form-control" name="controlNumber" value="@Model.ControlNumber" required></label><button class="btn btn-primary">Buscar histórico</button></form>
@if(Model.Events.Count==0){<div class="li-empty"><h2>Nenhum evento para exibir</h2><p>Informe um número de controle para consultar impressão, leitura, inventário, movimentação, empréstimo, devolução e substituição.</p></div>}else{<div class="li-timeline">@foreach(var x in Model.Events){<article><span class="li-marker"></span><time>@x.PerformedAt.ToString("dd/MM/yyyy HH:mm:ss")</time><h2>@x.EventTitle</h2><span class="badge text-bg-primary">@x.EventType</span><p>@x.EventDescription</p>@if(x.LocationFrom is not null||x.LocationTo is not null){<div class="li-route"><b>@x.LocationFrom</b><span>→</span><b>@x.LocationTo</b></div>}<small>Usuário: @(x.PerformedBy?.ToString()??"Sistema") · IP: @(x.IpAddress??"—")</small></article>}</div>}
