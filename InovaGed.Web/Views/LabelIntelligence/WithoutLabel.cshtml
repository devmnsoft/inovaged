@model IReadOnlyList<InovaGed.Application.Labels.Intelligence.LabelWithoutPrintItem>
@{ViewData["Title"]="Objetos sem etiqueta";}<link rel="stylesheet" href="~/css/label-intelligence.css" />
@await Html.PartialAsync("_Header",("Objetos sem etiqueta",ViewBag.SubjectType=="BOX"?"Esta caixa ainda não possui etiqueta impressa.":"Documentos físicos que aguardam identificação por etiqueta."))
<div class="li-toolbar"><a class="btn btn-outline-secondary" asp-action="WithoutLabel" asp-route-subjectType="BOX">Caixas</a><a class="btn btn-outline-secondary" asp-action="WithoutLabel" asp-route-subjectType="DOCUMENT">Documentos</a><a class="btn btn-outline-primary" asp-action="Export" asp-route-report="without-label" asp-route-subjectType="@ViewBag.SubjectType">Exportar CSV</a></div><div class="table-responsive li-panel"><table class="table"><thead><tr><th>Tipo</th><th>Controle</th><th>Localização</th><th>Criado em</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.SubjectType</td><td>@x.ControlNumber</td><td>@x.Location</td><td>@x.CreatedAt?.ToString("g")</td></tr>}</tbody></table></div>
