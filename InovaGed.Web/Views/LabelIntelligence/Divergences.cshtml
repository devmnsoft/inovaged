@model IReadOnlyList<InovaGed.Application.Labels.Intelligence.LabelDivergenceItem>
@{ViewData["Title"]="Divergências de localização";}<link rel="stylesheet" href="~/css/label-intelligence.css" />
@await Html.PartialAsync("_Header",("Divergências de localização","A localização encontrada não confere com a localização esperada."))
<div class="li-toolbar"><a class="btn btn-outline-primary" asp-action="Export" asp-route-report="divergences">Exportar CSV</a></div><div class="table-responsive li-panel"><table class="table align-middle"><thead><tr><th>Data</th><th>Objeto</th><th>Controle</th><th>Esperada</th><th>Encontrada</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.DetectedAt.ToString("g")</td><td><span class="badge text-bg-light">@x.SubjectType</span></td><td>@x.ControlNumber</td><td>@x.ExpectedLocation</td><td><span class="badge text-bg-danger">@x.FoundLocation</span></td><td>@if(x.SubjectId.HasValue){<a asp-action="Custody" asp-route-subjectType="@x.SubjectType" asp-route-subjectId="@x.SubjectId">Ver custódia</a>}</td></tr>}</tbody></table></div>
