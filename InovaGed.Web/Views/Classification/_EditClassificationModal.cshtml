@model InovaGed.Web.Models.Classification.EditClassificationVM

<form id="formEditClassification" method="post" action="@Url.Action("SaveManual", "Classification")">
    @Html.AntiForgeryToken()

    <input type="hidden" name="documentId" value="@Model.DocumentId" />

    <div class="modal-header">
        <h5 class="modal-title">
            <i class="bi bi-tags me-1"></i> Classificar documento
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
    </div>

    <div class="modal-body">
        <div class="alert alert-light border small text-muted mb-3 py-2 px-3">
            <strong><i class="bi bi-info-circle me-1 text-primary"></i> Como usar:</strong>
            Selecione a classe arquivística do PCD vigente para determinar a temporalidade (TTD) e a destinação final. O tipo documental e as tags refinam a identificação. É possível salvar tags e metadados mantendo a classificação atual.
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-diagram-3 me-1 text-primary"></i> Classificação arquivística (PCD)
            </label>
            <input type="hidden" name="classificationAction" id="classificationAction" value="Keep" />
            <input type="hidden" name="confirmClassificationRemoval" id="confirmClassificationRemoval" value="false" />

            @if (Model.ClassificationId.HasValue)
            {
                <div class="alert alert-secondary py-2 small">
                    Atual: <strong>@(Model.ClassificationLabel ?? "Classificação histórica vinculada")</strong>
                    @if (!Model.CurrentClassificationIsSelectable)
                    {
                        <span class="badge text-bg-warning ms-1">histórica</span>
                    }
                </div>
            }

            @if (Model.AvailableClassifications == null || Model.AvailableClassifications.Count == 0)
            {
                <div class="alert alert-warning mb-2 py-2">
                    <small>Nenhuma classe ativa encontrada no Plano de Classificação vigente.</small>
                </div>

                @if (Model.ClassificationId.HasValue)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" id="btnRemoveClassification">
                        <i class="bi bi-exclamation-triangle me-1"></i> Remover classificação
                    </button>
                }
            }
            else
            {
                <select class="form-select" id="selectArchivalClassification">
                    <option value="">Manter classificação atual</option>

                    @foreach (var c in Model.AvailableClassifications)
                    {
                        <option value="@c.Id">@c.DisplayLabel</option>
                    }
                </select>

                <div class="form-text">
                    Classes históricas são preservadas ao salvar tags e metadados. Selecione uma classe vigente somente quando desejar substituir.
                </div>

                @if (Model.ClassificationId.HasValue)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger mt-2" id="btnRemoveClassification">
                        <i class="bi bi-exclamation-triangle me-1"></i> Remover classificação
                    </button>
                }
            }
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-file-earmark-text me-1 text-secondary"></i> Tipo documental
            </label>
            <input type="hidden" name="documentTypeAction" id="documentTypeAction" value="Keep" />

            @if (Model.DocumentTypeId.HasValue)
            {
                <div class="alert alert-secondary py-2 small">
                    Atual: <strong>@(Model.DocumentTypeLabel ?? "Tipo documental vinculado")</strong>
                    @if (!Model.CurrentDocumentTypeIsSelectable)
                    {
                        <span class="badge text-bg-warning ms-1">inativo/histórico</span>
                    }
                </div>
            }

            @if (Model.AvailableTypes == null || Model.AvailableTypes.Count == 0)
            {
                <div class="alert alert-warning mb-0 py-2">
                    <small>Nenhum tipo documental cadastrado.</small>
                </div>
            }
            else
            {
                <select class="form-select" id="selectDocumentType">
                    <option value="">Manter tipo atual</option>

                    @foreach (var t in Model.AvailableTypes)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>

                <div class="form-text">
                    Identifica a espécie/tipo específico do documento para indexação e busca.
                </div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Tags</label>
            <input class="form-control"
                   name="tagsCsv"
                   value="@Model.TagsCsv"
                   placeholder="Formato: prontuário, contrato, financeiro, 2026" />
            <div class="form-text">Separe as tags por vírgula.</div>
        </div>

        <div class="mb-0">
            <label class="form-label">Metadados</label>
            <textarea class="form-control"
                      rows="5"
                      name="metadataLines"
                      placeholder="chave=valor, uma linha por item">@Model.MetadataLines</textarea>
            <div class="form-text">
                Referência: numero=12345
            </div>
        </div>

        <div id="classificationSaveError" class="alert alert-danger d-none mt-3 mb-0"></div>
    </div>

    <div class="modal-footer">
        <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">
            Cancelar
        </button>

        <button class="btn btn-primary" type="submit">
            <span class="btn-text">
                <i class="bi bi-check2 me-1"></i> Salvar
            </span>
            <span class="btn-loading d-none">
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                Salvando...
            </span>
        </button>
    </div>
</form>

<script>
    (function () {
        const form = document.getElementById('formEditClassification');
        if (!form) return;
        const classificationSelect = document.getElementById('selectArchivalClassification');
        const classificationAction = document.getElementById('classificationAction');
        const classificationRemoval = document.getElementById('confirmClassificationRemoval');
        const removeClassification = document.getElementById('btnRemoveClassification');
        const typeSelect = document.getElementById('selectDocumentType');
        const typeAction = document.getElementById('documentTypeAction');

        classificationSelect?.addEventListener('change', function () {
            if (classificationAction) classificationAction.value = this.value ? 'Replace' : 'Keep';
            if (classificationRemoval) classificationRemoval.value = 'false';
        });

        removeClassification?.addEventListener('click', function () {
            if (!confirm('Remover a classificação arquivística pode alterar temporalidade, destinação e trilha de auditoria. Confirma a remoção?')) return;
            if (classificationSelect) classificationSelect.value = '';
            if (classificationAction) classificationAction.value = 'Remove';
            if (classificationRemoval) classificationRemoval.value = 'true';
        });

        typeSelect?.addEventListener('change', function () {
            if (typeAction) typeAction.value = this.value ? 'Replace' : 'Keep';
        });

        form.addEventListener('submit', async function (e) {
            e.preventDefault();

            const btn = form.querySelector('button[type="submit"]');
            const err = document.getElementById('classificationSaveError');

            if (err) {
                err.classList.add('d-none');
                err.innerText = '';
            }

            if (btn && window.setBtnLoading) {
                window.setBtnLoading(btn, true);
            }

            try {
                const body = new FormData(form);
                if (classificationAction?.value === 'Replace' && classificationSelect?.value) {
                    body.set('classificationId', classificationSelect.value);
                }
                if (typeAction?.value === 'Replace' && typeSelect?.value) {
                    body.set('documentTypeId', typeSelect.value);
                }

                const resp = await fetch(form.action, {
                    method: 'POST',
                    body,
                    credentials: 'include',
                    cache: 'no-store',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
                    redirect: 'manual'
                });

                if (!resp.ok) {
                    const txt = await resp.text().catch(() => 'Erro ao salvar classificação.');
                    if (err) {
                        err.innerText = txt || 'Erro ao salvar classificação.';
                        err.classList.remove('d-none');
                    }
                    return;
                }

                const json = await resp.json().catch(() => null);
                if (!json || json.success !== true) {
                    if (err) {
                        err.innerText = json?.message || 'O servidor não confirmou a gravação.';
                        err.classList.remove('d-none');
                    }
                    return;
                }

                const modalEl = document.getElementById('modalClassify');
                if (modalEl && window.bootstrap) {
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    modal && modal.hide();
                }

                if (window.refreshClassificationPanel) {
                    await window.refreshClassificationPanel();
                }

                if (window.InovaGedSidePanel && typeof window.InovaGedSidePanel.reload === 'function') {
                    await window.InovaGedSidePanel.reload();
                }

                const audit = document.getElementById('classificationAudit')
                    || document.getElementById('classification-audit-container');

                if (audit) {
                    audit.innerHTML = '';
                    audit.setAttribute('data-loaded', '0');
                    audit.classList.add('d-none');
                }
            }
            finally {
                if (btn && window.setBtnLoading) {
                    window.setBtnLoading(btn, false);
                }
            }
        });
    })();
</script>
