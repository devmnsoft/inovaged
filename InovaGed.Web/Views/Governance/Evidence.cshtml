@model IReadOnlyList<InovaGed.Application.Governance.GovernanceEvidenceItem>
@{ViewData["Title"]="Evidências e cadeia probatória";ViewData["Subtitle"]="Registros imutáveis, identificados e protegidos por hash.";}
<link rel="stylesheet" href="~/css/governance.css"/><main class="atlas-page governance-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/><section class="governance-report-card"><h2>Registrar evidência</h2><form method="post" asp-action="RegisterEvidence" class="governance-toolbar"><select name="sourceType" required><option>DOCUMENT</option><option>BOX</option><option>LABEL</option><option>WORKFLOW</option><option>INCIDENT</option><option>REPORT</option><option>CLASSIFICATION</option><option>RETENTION</option></select><input name="title" required placeholder="Título da evidência"/><input name="description" placeholder="Descrição sem dados sensíveis"/><button class="btn btn-primary">Registrar evidência</button></form></section><div class="atlas-table-shell governance-evidence-table"><table class="table atlas-table"><thead><tr><th>Código</th><th>Fonte</th><th>Título</th><th>Hash</th><th>Registrado por</th><th>Registrado em</th></tr></thead><tbody>@foreach(var x in Model??[]){<tr><td><code>@x.EvidenceCode</code></td><td>@x.SourceType</td><td>@x.Title</td><td><code>@(x.EvidenceHash is null?"—":x.EvidenceHash[..Math.Min(16,x.EvidenceHash.Length)]+"…")</code></td><td>@(x.RegisteredByName??"Sistema")</td><td>@x.RegisteredAt.ToLocalTime().ToString("g")</td></tr>}</tbody></table></div></main>
