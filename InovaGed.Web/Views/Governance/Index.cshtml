@model InovaGed.Application.Governance.GovernanceDashboard
@{ ViewData["Title"]="Governança Documental"; ViewData["Subtitle"]="Acompanhe auditoria, riscos, LGPD, evidências, alertas e indicadores críticos da operação documental."; ViewData["Icon"]="shield-check"; }
<link rel="stylesheet" href="~/css/governance.css" asp-append-version="true"/><main class="atlas-page governance-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/>
<div class="governance-kpi-grid">@foreach(var k in new Dictionary<string,int>{{"Documentos sem OCR",Model?.DocumentsWithoutOcr??0},{"Documentos sem classificação",Model?.DocumentsWithoutClassification??0},{"Dados sensíveis detectados",Model?.SensitiveDocuments??0},{"Temporalidade pendente",Model?.RetentionPending??0},{"Caixas sem localização",Model?.BoxesWithoutLocation??0},{"Empréstimos vencidos",Model?.OverdueLoans??0},{"Tarefas atrasadas",Model?.OverdueTasks??0},{"Incidentes críticos",Model?.CriticalIncidents??0}}){<partial name="Atlas/_AtlasKpiCard" view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData){{"Label",k.Key},{"Value",k.Value.ToString()}}'/>}</div>
<div class="governance-action-grid">@foreach(var a in new Dictionary<string,string>{{"Auditoria","Audit"},{"LGPD","Lgpd"},{"Riscos operacionais","Risks"},{"Relatórios","Reports"},{"Evidências","Evidence"},{"Alertas","Alerts"},{"Linha do tempo","Timeline"},{"Exportações","Reports"}}){<a class="governance-action-card" asp-action="@a.Value"><app-icon name="shield-check" size="24" decorative="true"/><strong>@a.Key</strong><span>Visão rastreável e isolada por tenant</span></a>}</div></main>
<section class="governance-action-card"><app-icon name="receipt" size="24" decorative="true"/><strong>Governança contratual</strong><span>Medições abertas, itens sem evidência, glosas abertas, aceite pendente e relatórios exportados.</span><small>Alertas: MEASUREMENT_WITHOUT_EVIDENCE · GLOSA_OPEN · ACCEPTANCE_PENDING · PERIOD_NOT_CLOSED</small><a asp-controller="ContractMeasurement" asp-action="Index">Abrir Medição Contratual</a></section>
