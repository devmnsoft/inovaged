@model IReadOnlyList<InovaGed.Application.Governance.GovernanceAuditItem>
@{ViewData["Title"]="Linha do tempo documental";ViewData["Subtitle"]="Eventos consolidados por período e módulo, preservando sua origem.";}
<link rel="stylesheet" href="~/css/governance.css"/><main class="atlas-page governance-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/><form method="get" class="atlas-toolbar governance-toolbar"><input type="date" name="from"/><input type="date" name="to"/><select name="module"><option value="">Todas as origens</option><option>DOCUMENT</option><option>LABEL</option><option>PHYSICAL</option><option>WORKFLOW</option><option>ASSISTANT</option></select><button class="btn btn-primary">Filtrar</button></form><div class="governance-timeline">@foreach(var x in Model??[]){<article><span class="timeline-icon"><app-icon name="shield-check" decorative="true"/></span><div><time>@x.OccurredAt.ToLocalTime().ToString("g")</time><h2>@x.EventType</h2><p>@x.Description</p><small>@x.Module · @x.UserName · @x.Origin</small></div></article>}</div></main>
