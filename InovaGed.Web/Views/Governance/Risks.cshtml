@model InovaGed.Application.Governance.GovernanceDashboard
@{ViewData["Title"]="Riscos operacionais";ViewData["Subtitle"]="Severidade, tendência e ação recomendada para cada pendência documental.";var risks=new[]{("Documento sem OCR",Model?.DocumentsWithoutOcr??0,"HIGH","Reprocessar OCR","/Ocr"),("Documento sem classificação",Model?.DocumentsWithoutClassification??0,"HIGH","Abrir Documento 360","/Ged"),("Temporalidade pendente",Model?.RetentionPending??0,"MEDIUM","Revisar temporalidade","/Retention"),("Caixa sem localização",Model?.BoxesWithoutLocation??0,"HIGH","Abrir Acervo Físico","/Physical/Boxes"),("Empréstimo vencido",Model?.OverdueLoans??0,"HIGH","Revisar empréstimos","/Loans"),("Tarefa workflow atrasada",Model?.OverdueTasks??0,"CRITICAL","Abrir Workflow","/SmartWorkflow/Tasks"),("Incidente crítico aberto",Model?.CriticalIncidents??0,"CRITICAL","Abrir incidentes","/SystemIncidents"),("Migration pendente",Model?.SchemaReady==false?1:0,"CRITICAL","Abrir Database Readiness","/DatabaseReadiness")};}
<link rel="stylesheet" href="~/css/governance.css"/><main class="atlas-page governance-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/><div class="governance-action-grid">@foreach(var x in risks){<article class="governance-risk-card"><span class="atlas-status-badge severity-@x.Item3.ToLowerInvariant()">@x.Item3</span><h2>@x.Item1</h2><strong>@x.Item2</strong><small>Tendência: estável</small><p>@x.Item4</p><a class="btn btn-sm btn-outline-primary" href="@x.Item5">Abrir origem</a></article>}</div></main>
