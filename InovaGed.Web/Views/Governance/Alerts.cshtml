@model IReadOnlyList<InovaGed.Application.Governance.GovernanceAlertItem>
@{ViewData["Title"]="Alertas de governança";ViewData["Subtitle"]="Pendências operacionais priorizadas, com resolução auditável.";}
<link rel="stylesheet" href="~/css/governance.css"/><main class="atlas-page governance-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/><form method="get" class="atlas-toolbar governance-toolbar"><select name="status"><option value="">Todos os status</option><option>OPEN</option><option>IN_REVIEW</option><option>RESOLVED</option></select><select name="severity"><option value="">Todas as severidades</option><option>CRITICAL</option><option>HIGH</option><option>MEDIUM</option><option>LOW</option></select><input name="type" placeholder="Tipo"/><input name="sourceType" placeholder="Origem"/><button class="btn btn-primary">Filtrar</button></form><div class="atlas-table-shell governance-alert-table"><table class="table atlas-table"><thead><tr><th>Severidade</th><th>Tipo</th><th>Título</th><th>Origem</th><th>Criado em</th><th>Status</th><th>Ação recomendada</th><th>Ações</th></tr></thead><tbody>@foreach(var x in Model??[]){<tr><td><span class="atlas-status-badge severity-@x.Severity.ToLowerInvariant()">@x.Severity</span></td><td>@x.AlertType</td><td><strong>@x.Title</strong><small>@x.Description</small></td><td>@(x.SourceType??"—")</td><td>@x.CreatedAt.ToLocalTime().ToString("g")</td><td>@x.Status</td><td>@(x.RecommendedAction??"Revisar")</td><td>@if(x.Status is "OPEN" or "IN_REVIEW"){<form method="post" asp-action="Resolve" asp-route-id="@x.Id"><input name="notes" required placeholder="Observação obrigatória"/><button class="btn btn-sm btn-success">Resolver</button></form>}</td></tr>}</tbody></table></div></main>
