@model IReadOnlyList<InovaGed.Application.Governance.GovernanceAlertItem>
@{ViewData["Title"]="Painel LGPD";ViewData["Subtitle"]="Dados pessoais protegidos, revisões humanas e acessos rastreáveis.";}
<link rel="stylesheet" href="~/css/governance.css"/><main class="atlas-page governance-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/><div class="governance-kpi-grid"><article class="atlas-kpi-card"><small>Documentos com dado sensível</small><strong>@(Model?.Count??0)</strong><span>Conteúdo sempre mascarado</span></article><article class="atlas-kpi-card"><small>Pendências de revisão</small><strong>@(Model?.Count(x=>x.Status!="RESOLVED")??0)</strong></article><article class="atlas-kpi-card"><small>Acesso</small><strong>Restrito</strong><span>Toda consulta é auditada</span></article></div><div class="atlas-alert alert alert-info">CPF e CNPJ nunca são exibidos integralmente. Detalhes exigem autorização e toda visualização é registrada.</div><div class="atlas-table-shell"><table class="table atlas-table"><thead><tr><th>Documento</th><th>Indicador</th><th>Proteção</th><th>Revisão</th></tr></thead><tbody>@foreach(var x in Model??[]){<tr><td>@x.Title</td><td><span class="atlas-status-badge">Sensível</span></td><td><span class="atlas-status-badge">Mascarado</span></td><td>@x.Status</td></tr>}</tbody></table></div></main>
