@model IReadOnlyList<InovaGed.Application.Governance.GovernanceAuditItem>
@{ViewData["Title"]="Auditoria avançada";ViewData["Subtitle"]="Rastreabilidade consolidada de documentos, etiquetas, acervo, workflow e assistente.";}
<link rel="stylesheet" href="~/css/governance.css"/><main class="atlas-page governance-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/><form method="get" class="atlas-toolbar governance-toolbar"><input type="date" name="from" aria-label="Início"/><input type="date" name="to" aria-label="Fim"/><input name="user" placeholder="Usuário"/><input name="eventType" placeholder="Tipo de evento"/><input name="module" placeholder="Módulo"/><input name="ip" placeholder="IP"/><input name="correlationId" placeholder="CorrelationId"/><input name="search" placeholder="Texto livre"/><button class="btn btn-primary">Filtrar</button></form><div class="atlas-table-shell"><table class="table atlas-table"><thead><tr><th>Data/Hora</th><th>Evento</th><th>Módulo</th><th>Usuário</th><th>Origem</th><th>Descrição</th><th>IP</th><th>CorrelationId</th></tr></thead><tbody>@foreach(var x in Model??[]){<tr><td>@x.OccurredAt.ToLocalTime().ToString("g")</td><td><span class="atlas-status-badge">@x.EventType</span></td><td>@x.Module</td><td>@x.UserName</td><td>@x.Origin</td><td>@x.Description</td><td>@(x.Ip??"—")</td><td><code>@(x.CorrelationId??"—")</code></td></tr>}</tbody></table>@if(Model is null||Model.Count==0){<div class="atlas-empty-state">Nenhum evento encontrado. <a href="/DatabaseReadiness">Verificar estrutura</a></div>}</div></main>
