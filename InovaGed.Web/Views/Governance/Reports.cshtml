@model InovaGed.Application.Governance.GovernanceReportResult
@{ViewData["Title"]="Relatórios executivos";ViewData["Subtitle"]="Indicadores operacionais exportáveis, mascarados e isolados por tenant.";var types=new Dictionary<string,string>{{"documents-without-ocr","Documentos sem OCR"},{"documents-without-classification","Documentos sem classificação"},{"sensitive-documents","Documentos sensíveis"},{"retention-pending","Temporalidade pendente"},{"labels-printed","Etiquetas impressas"},{"label-reprints","Reimpressões por período"},{"boxes-without-location","Caixas sem localização"},{"overdue-loans","Empréstimos vencidos"},{"overdue-tasks","Tarefas atrasadas"},{"critical-incidents","Incidentes críticos"}};}
<link rel="stylesheet" href="~/css/governance.css"/><main class="atlas-page governance-page"><partial name="Atlas/_AtlasPageHero"/><partial name="_Readiness"/><form method="get" class="atlas-toolbar governance-toolbar"><select name="reportType">@foreach(var t in types){@if(Model?.ReportType==t.Key){<option value="@t.Key" selected>@t.Value</option>}else{<option value="@t.Key">@t.Value</option>}}</select><button class="btn btn-primary">Gerar</button>@if(Model is not null){<a class="btn btn-outline-primary" asp-action="Export" asp-route-reportType="@Model.ReportType">Exportar CSV</a>}</form><section class="governance-report-card"><h2>@(Model?.Title??"Relatório")</h2><div class="atlas-table-shell"><table class="table atlas-table"><thead><tr><th>Referência</th><th>Descrição</th><th>Status</th><th>Data</th></tr></thead><tbody>@foreach(var x in Model?.Rows??[]){<tr><td>@x.Reference</td><td>@x.Description</td><td><span class="atlas-status-badge">@x.Status</span></td><td>@x.Date?.ToLocalTime().ToString("g")</td></tr>}</tbody></table></div></section></main>
