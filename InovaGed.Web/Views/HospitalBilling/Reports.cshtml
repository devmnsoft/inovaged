@using InovaGed.Application.HospitalBilling
@using InovaGed.Web.Models.Atlas
@model HospitalBillingReports
@{ ViewData["Title"]="Relatórios hospitalares";
var header=new AtlasPageHeaderVm("Relatórios hospitalares","Conciliação real por convênio, competência, prestador, revisão e motivo de glosa, sempre no escopo da organização.","report","Faturamento Hospitalar",new[]{new AtlasPageAction("Voltar ao painel",Url.Action("Index")!,"arrow-left",true),new AtlasPageAction("Exportar relatório",Url.Action("ExportReports",new{report="all"})!,"download")}); }
@section Styles{<link rel="stylesheet" href="~/css/pages/hospital-billing.css" asp-append-version="true" />}
<partial name="Atlas/_PageHeader" model="header"/>
<div class="hospital-report-intro" role="note"><app-icon name="security" size="20" decorative="true"/><div><strong>Conferência financeira protegida</strong><p>Os totais consideram somente registros ativos do tenant autenticado. Nenhum dado de paciente é exibido.</p></div></div>
<div class="d-flex flex-wrap gap-2 mb-3" aria-label="Exportações disponíveis"><a class="btn btn-sm btn-outline-primary" asp-action="ExportReports" asp-route-report="insurer"><app-icon name="download" size="15" decorative="true"/> Convênios</a><a class="btn btn-sm btn-outline-primary" asp-action="ExportReports" asp-route-report="competence"><app-icon name="download" size="15" decorative="true"/> Competências</a><a class="btn btn-sm btn-outline-primary" asp-action="ExportReports" asp-route-report="provider"><app-icon name="download" size="15" decorative="true"/> Prestadores</a><a class="btn btn-sm btn-outline-primary" asp-action="ExportReports" asp-route-report="review-status"><app-icon name="download" size="15" decorative="true"/> Revisões</a><a class="btn btn-sm btn-outline-primary" asp-action="ExportReports" asp-route-report="denials"><app-icon name="download" size="15" decorative="true"/> Glosas</a></div>
<div class="hospital-report-grid">
@foreach(var report in new[]{("Por convênio","Compara valores apresentados, aprovados, glosados e recuperados.",Model.ByInsurer),("Por competência","Evolução financeira por período de atendimento.",Model.ByCompetence),("Por prestador","Conciliação por prestador sem expor dados do paciente.",Model.ByProvider),("Por status de revisão","Distribuição financeira da conferência humana.",Model.ByReviewStatus),("Glosas e recuperação","Motivos com saldo ainda disponível para recuperação.",Model.Denials)}){
<section class="card border-0 shadow-sm"><div class="card-header bg-transparent"><h2>@report.Item1</h2><p>@report.Item2</p></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Grupo</th><th>Docs.</th><th>Apresentado</th><th>Aprovado</th><th>Glosado</th><th>Recuperado</th><th>Saldo</th></tr></thead><tbody>
@if(report.Item3.Count==0){<tr><td colspan="7"><div class="hospital-empty"><app-icon name="report" size="36" decorative="true"/><h3>Sem evidências para este relatório</h3><p>Os indicadores serão exibidos quando documentos hospitalares forem extraídos.</p></div></td></tr>}
@foreach(var row in report.Item3){<tr><td><strong>@row.Label</strong></td><td>@row.Documents</td><td>@row.Presented.ToString("C")</td><td class="text-success">@row.Approved.ToString("C")</td><td class="text-danger">@row.Denied.ToString("C")</td><td class="text-success">@row.Recovered.ToString("C")</td><td><span class="badge @(row.PendingRecovery>0?"text-bg-warning":"text-bg-success")">@row.PendingRecovery.ToString("C")</span></td></tr>}
</tbody></table></div></section>}
</div>
