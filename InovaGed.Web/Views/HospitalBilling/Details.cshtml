@using InovaGed.Application.HospitalBilling
@using InovaGed.Web.Models.Atlas
@model HospitalBillingDetails
@{var item=Model.Document;ViewData["Title"]="Detalhes do faturamento hospitalar";var header=new AtlasPageHeaderVm(item.Title,"Revisão rastreável dos campos extraídos do documento hospitalar.","report","Faturamento Hospitalar",new[]{new AtlasPageAction("Abrir documento",Url.Action("Details","Documents",new{id=item.DocumentId})!,"documents",true),new AtlasPageAction("Voltar ao painel",Url.Action("Index")!,"arrow-left")});}
@section Styles{<link rel="stylesheet" href="~/css/pages/hospital-billing.css" asp-append-version="true" />}
<partial name="Atlas/_PageHeader" model="header"/>
<div class="hospital-detail-grid">
<section class="card border-0 shadow-sm"><div class="card-header bg-transparent"><h2>Identificação assistencial</h2><p>Dados sensíveis são protegidos nesta visão.</p></div><div class="card-body hospital-fields"><div><strong>Tipo</strong><p>@item.DocumentType</p></div><div><strong>Convênio</strong><p>@(item.Insurer??"Não identificado")</p></div><div><strong>Prestador</strong><p>@(item.Provider??"Não identificado")</p></div><div><strong>CNPJ / CNES</strong><p>@(item.ProviderCnpj??"Não informado") · @(item.Cnes??"Não informado")</p></div><div><strong>Paciente protegido</strong><p><app-icon name="security" size="15" decorative="true"/> @item.MaskedPatient</p></div><div><strong>Guia / autorização</strong><p>@(item.GuideNumber??"Não informada") · @(item.AuthorizationNumber??"Não informada")</p></div><div><strong>Lote / fatura</strong><p>@(item.BatchNumber??"Não informado") · @(item.InvoiceNumber??"Não informada")</p></div><div><strong>Competência</strong><p>@(item.Competence??"Não identificada")</p></div><div><strong>Procedimento / código</strong><p>@(item.ProcedureName??"Não identificado") · @(item.ProcedureCode??"TUSS/SIGTAP não identificado")</p></div><div><strong>Vencimento</strong><p>@(item.DueDate?.ToString("dd/MM/yyyy")??"Não identificado")</p></div></div></section>
<aside class="card border-0 shadow-sm hospital-review-summary"><div class="card-header bg-transparent"><h2>Qualidade da extração</h2><p>Indicadores para a revisão humana.</p></div><div class="card-body"><span class="hospital-confidence-value">@item.Confidence.ToString("N0")%</span><span class="badge @(item.Confidence < 70 ? "text-bg-danger" : "text-bg-success")">@(item.Confidence < 70 ? "Revisão prioritária" : "Boa evidência")</span><hr/><strong>Status</strong><p>@item.Status</p></div></aside>
</div>
@if(item.Status=="DIVERGENT" || item.DivergenceAlerts!="[]"){<div class="hospital-divergence" role="alert"><app-icon name="warning" size="20" decorative="true"/><div><strong>Divergências exigem validação humana</strong><p>Compare os campos extraídos com o documento-fonte antes de aprovar. Evidências técnicas: @item.DivergenceAlerts</p></div></div>}
<section class="card border-0 shadow-sm mt-3"><div class="card-header bg-transparent"><h2>Conciliação financeira</h2><p>Valores identificados no documento e seus demonstrativos.</p></div><div class="card-body hospital-money-grid"><div><span>Apresentado</span><strong>@item.PresentedAmount.ToString("C")</strong></div><div><span>Aprovado</span><strong>@item.ApprovedAmount.ToString("C")</strong></div><div class="is-denial"><span>Glosado</span><strong>@item.DeniedAmount.ToString("C")</strong></div><div class="is-recovered"><span>Recuperado</span><strong>@item.RecoveredAmount.ToString("C")</strong></div></div>@if(item.DeniedAmount>0){<div class="hospital-denial-note"><app-icon name="warning" size="18" decorative="true"/><div><strong>Motivo da glosa</strong><p>@(item.DenialReason??"Motivo ainda não identificado; valide no documento-fonte.")</p></div></div>}</section>

@if(TempData["Success"] is string success){<div class="alert alert-success mt-3" role="status"><app-icon name="check" size="18" decorative="true"/> @success</div>}
@if(TempData["Error"] is string error){<div class="alert alert-danger mt-3" role="alert"><app-icon name="warning" size="18" decorative="true"/> @error</div>}
<div class="hospital-detail-grid mt-3">
<section class="card border-0 shadow-sm"><div class="card-header bg-transparent"><h2>Registrar revisão</h2><p>Confirme os valores contra o documento-fonte. Toda alteração fica auditada.</p></div><form asp-action="SaveReview" method="post" class="card-body hospital-review-form"><input type="hidden" name="Id" value="@item.Id"/><div><label for="reviewStatus">Status da revisão</label><select id="reviewStatus" name="Status" class="form-select" required><option value="PENDING_REVIEW" selected="@(item.Status=="PENDING_REVIEW")">Pendente</option><option value="APPROVED" selected="@(item.Status=="APPROVED")">Aprovado</option><option value="DIVERGENT" selected="@(item.Status=="DIVERGENT")">Divergente</option><option value="DENIED" selected="@(item.Status=="DENIED")">Glosado</option><option value="APPEAL_IN_REVIEW" selected="@(item.Status=="APPEAL_IN_REVIEW")">Recurso em análise</option><option value="RECOVERED" selected="@(item.Status=="RECOVERED")">Recuperado</option><option value="CLOSED" selected="@(item.Status=="CLOSED")">Encerrado</option></select></div><div><label for="denialStatus">Status da glosa</label><select id="denialStatus" name="DenialStatus" class="form-select"><option value="">Sem glosa</option><option value="OPEN" selected="@(item.DenialStatus=="OPEN")">Aberta</option><option value="IN_APPEAL" selected="@(item.DenialStatus=="IN_APPEAL")">Em recurso</option><option value="ANSWERED" selected="@(item.DenialStatus=="ANSWERED")">Respondida</option><option value="RECOVERED" selected="@(item.DenialStatus=="RECOVERED")">Recuperada</option><option value="CLOSED" selected="@(item.DenialStatus=="CLOSED")">Encerrada</option></select></div><div><label for="approvedAmount">Valor aprovado</label><input id="approvedAmount" name="ApprovedAmount" type="number" min="0" step="0.01" class="form-control" value="@item.ApprovedAmount.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" required/></div><div><label for="deniedAmount">Valor glosado</label><input id="deniedAmount" name="DeniedAmount" type="number" min="0" step="0.01" class="form-control" value="@item.DeniedAmount.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" required/></div><div><label for="denialReason">Motivo da glosa</label><input id="denialReason" name="DenialReason" maxlength="500" class="form-control" value="@item.DenialReason" placeholder="Código e descrição do motivo"/></div><div><label for="appealDueDate">Prazo do recurso</label><input id="appealDueDate" name="AppealDueDate" type="date" class="form-control" value="@item.DueDate?.ToString("yyyy-MM-dd")"/></div><div><label for="recoveredAmount">Valor recuperado</label><input id="recoveredAmount" name="RecoveredAmount" type="number" min="0" step="0.01" class="form-control" value="@item.RecoveredAmount.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" required/></div><div class="hospital-review-notes"><label for="notes">Parecer da revisão</label><textarea id="notes" name="Notes" maxlength="1000" minlength="5" rows="3" class="form-control" required placeholder="Descreva conferências, divergências e providências"></textarea></div><div class="hospital-review-actions"><button type="submit" class="btn btn-primary"><app-icon name="check" size="16" decorative="true"/> Salvar revisão</button></div></form></section>
<aside class="card border-0 shadow-sm"><div class="card-header bg-transparent"><h2>Histórico de revisão</h2><p>@Model.History.Count registro(s)</p></div><div class="card-body hospital-history">@if(Model.History.Count==0){<div class="hospital-empty"><app-icon name="history" size="32" decorative="true"/><h3>Nenhuma revisão registrada</h3><p>O primeiro parecer aparecerá aqui.</p></div>}else{@foreach(var h in Model.History){<article><strong>@h.PreviousStatus → @h.Status</strong><time datetime="@h.ReviewedAt.ToString("O")">@h.ReviewedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time><p>Aprovado @h.ApprovedAmount.ToString("C") · Glosado @h.DeniedAmount.ToString("C") · Recuperado @h.RecoveredAmount.ToString("C")</p><small>Responsável: @h.ReviewedBy</small>@if(h.ChangedFields!="{}"){<details><summary>Campos alterados</summary><code>@h.ChangedFields</code></details>}@if(!string.IsNullOrWhiteSpace(h.Notes)){<p>@h.Notes</p>}</article>}}</div></aside>
</div>
