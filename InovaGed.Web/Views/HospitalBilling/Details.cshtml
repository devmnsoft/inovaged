@using InovaGed.Application.HospitalBilling
@using InovaGed.Web.Models.Atlas
@model HospitalBillingDocumentDto
@{ViewData["Title"]="Detalhes do faturamento hospitalar";var header=new AtlasPageHeaderVm(Model.Title,"Revisão rastreável dos campos extraídos do documento hospitalar.","report","Faturamento Hospitalar",new[]{new AtlasPageAction("Abrir documento",Url.Action("Details","Documents",new{id=Model.DocumentId})!,"documents",true),new AtlasPageAction("Voltar ao painel",Url.Action("Index")!,"arrow-left")});}
@section Styles{<link rel="stylesheet" href="~/css/pages/hospital-billing.css" asp-append-version="true" />}
<partial name="Atlas/_PageHeader" model="header"/>
<div class="hospital-detail-grid">
<section class="card border-0 shadow-sm"><div class="card-header bg-transparent"><h2>Identificação assistencial</h2><p>Dados sensíveis são protegidos nesta visão.</p></div><div class="card-body hospital-fields"><div><strong>Tipo</strong><p>@Model.DocumentType</p></div><div><strong>Convênio</strong><p>@(Model.Insurer??"Não identificado")</p></div><div><strong>Prestador</strong><p>@(Model.Provider??"Não identificado")</p></div><div><strong>CNPJ / CNES</strong><p>@(Model.ProviderCnpj??"Não informado") · @(Model.Cnes??"Não informado")</p></div><div><strong>Paciente protegido</strong><p><app-icon name="security" size="15" decorative="true"/> @Model.MaskedPatient</p></div><div><strong>Guia / autorização</strong><p>@(Model.GuideNumber??"Não informada") · @(Model.AuthorizationNumber??"Não informada")</p></div><div><strong>Lote / fatura</strong><p>@(Model.BatchNumber??"Não informado") · @(Model.InvoiceNumber??"Não informada")</p></div><div><strong>Competência</strong><p>@(Model.Competence??"Não identificada")</p></div><div><strong>Procedimento / código</strong><p>@(Model.ProcedureName??"Não identificado") · @(Model.ProcedureCode??"TUSS/SIGTAP não identificado")</p></div><div><strong>Vencimento</strong><p>@(Model.DueDate?.ToString("dd/MM/yyyy")??"Não identificado")</p></div></div></section>
<aside class="card border-0 shadow-sm hospital-review-summary"><div class="card-header bg-transparent"><h2>Qualidade da extração</h2><p>Indicadores para a revisão humana.</p></div><div class="card-body"><span class="hospital-confidence-value">@Model.Confidence.ToString("N0")%</span><span class="badge @(Model.Confidence < 70 ? "text-bg-danger" : "text-bg-success")">@(Model.Confidence < 70 ? "Revisão prioritária" : "Boa evidência")</span><hr/><strong>Status</strong><p>@Model.Status</p></div></aside>
</div>
@if(Model.Status=="DIVERGENT" || Model.DivergenceAlerts!="[]"){<div class="hospital-divergence" role="alert"><app-icon name="warning" size="20" decorative="true"/><div><strong>Divergências exigem validação humana</strong><p>Compare os campos extraídos com o documento-fonte antes de aprovar. Evidências técnicas: @Model.DivergenceAlerts</p></div></div>}
<section class="card border-0 shadow-sm mt-3"><div class="card-header bg-transparent"><h2>Conciliação financeira</h2><p>Valores identificados no documento e seus demonstrativos.</p></div><div class="card-body hospital-money-grid"><div><span>Apresentado</span><strong>@Model.PresentedAmount.ToString("C")</strong></div><div><span>Aprovado</span><strong>@Model.ApprovedAmount.ToString("C")</strong></div><div class="is-denial"><span>Glosado</span><strong>@Model.DeniedAmount.ToString("C")</strong></div><div class="is-recovered"><span>Recuperado</span><strong>@Model.RecoveredAmount.ToString("C")</strong></div></div>@if(Model.DeniedAmount>0){<div class="hospital-denial-note"><app-icon name="warning" size="18" decorative="true"/><div><strong>Motivo da glosa</strong><p>@(Model.DenialReason??"Motivo ainda não identificado; valide no documento-fonte.")</p></div></div>}</section>
