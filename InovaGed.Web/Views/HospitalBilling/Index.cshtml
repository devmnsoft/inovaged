@using InovaGed.Application.HospitalBilling
@using InovaGed.Web.Models.Atlas
@model HospitalBillingDashboard
@{ ViewData["Title"]="Faturamento Hospitalar"; var f=(HospitalBillingFilter)ViewBag.Filter; var mode=(string)(ViewBag.Mode??"dashboard");
var title=mode=="review"?"Revisão hospitalar":mode=="denials"?"Gestão de glosas":mode=="documents"?"Documentos hospitalares":"Faturamento Hospitalar";
var subtitle=mode=="review"?"Fila priorizada para conferência humana, divergências e baixa confiança.":mode=="denials"?"Glosas abertas, prazos de recurso e valores com potencial de recuperação.":"Contas, guias TISS e glosas com rastreabilidade, revisão e proteção LGPD.";
var header=new AtlasPageHeaderVm(title,subtitle,"report","Inteligência assistencial",new[]{new AtlasPageAction("Pendências",Url.Content("~/HospitalBilling/Review"),"history",true),new AtlasPageAction("Glosas",Url.Content("~/HospitalBilling/Glosas"),"warning"),new AtlasPageAction("Relatórios",Url.Action("Reports")!,"report"),new AtlasPageAction("Exportar CSV",Url.Action("Export",new{f.Insurer,f.Competence,f.Status,f.HasDenial,f.Term})!,"download")});
var k=Model.Kpis; var metrics=new[]{new AtlasMetricVm("Documentos",k.Total.ToString(),"no escopo do tenant","info","documents"),new AtlasMetricVm("Pendentes",k.Pending.ToString(),"aguardam revisão","warning","history"),new AtlasMetricVm("Aprovados",k.Approved.ToString(),"conferidos","success","check"),new AtlasMetricVm("Com glosa",k.WithDenial.ToString(),k.Denied.ToString("C"),"danger","warning"),new AtlasMetricVm("Apresentado",k.Presented.ToString("C"),"valor total","info","report"),new AtlasMetricVm("Recuperado",k.Recovered.ToString("C"),"após recursos","success","report"),new AtlasMetricVm("Sem OCR",k.WithoutOcr.ToString(),"requer processamento","warning","ocr"),new AtlasMetricVm("Baixa confiança",k.LowConfidence.ToString(),"revisão prioritária","danger","security")}; }
@section Styles{<link rel="stylesheet" href="~/css/pages/hospital-billing.css" asp-append-version="true" />}
<partial name="Atlas/_PageHeader" model="header"/><partial name="Atlas/_PageMetrics" model="metrics"/>
<nav class="hospital-nav" aria-label="Áreas do faturamento hospitalar"><a class="@(mode=="dashboard"?"is-active":null)" asp-action="Index"><app-icon name="health" size="16" decorative="true"/> Dashboard</a><a class="@(mode=="documents"?"is-active":null)" asp-action="Documents"><app-icon name="documents" size="16" decorative="true"/> Documentos</a><a class="@(mode=="review"?"is-active":null)" href="@Url.Content("~/HospitalBilling/Review")"><app-icon name="history" size="16" decorative="true"/> Revisão <span>@k.Pending</span></a><a class="@(mode=="denials"?"is-active":null)" href="@Url.Content("~/HospitalBilling/Glosas")"><app-icon name="warning" size="16" decorative="true"/> Glosas <span>@k.WithDenial</span></a><a asp-action="Rules"><app-icon name="settings" size="16" decorative="true"/> Regras</a><a asp-action="Reports"><app-icon name="report" size="16" decorative="true"/> Relatórios</a></nav>
<form method="get" class="hospital-filter card border-0 shadow-sm"><div class="card-body"><div class="hospital-filter-term"><label for="term">Busca hospitalar</label><div class="input-group"><span class="input-group-text"><app-icon name="search" size="16" decorative="true"/></span><input id="term" class="form-control" name="term" value="@f.Term" placeholder="Guia, autorização, CNES, prestador, lote ou procedimento"/></div></div><div><label for="insurer">Convênio</label><input id="insurer" class="form-control" name="insurer" value="@f.Insurer" placeholder="Nome do convênio"/></div><div><label for="competence">Competência</label><input id="competence" class="form-control" name="competence" value="@f.Competence" placeholder="07/2026"/></div><div><label for="status">Status</label><select id="status" class="form-select" name="status"><option value="">Todos</option><option value="PENDING_REVIEW" selected="@(f.Status=="PENDING_REVIEW")">Pendente</option><option value="APPROVED" selected="@(f.Status=="APPROVED")">Aprovado</option><option value="DIVERGENT" selected="@(f.Status=="DIVERGENT")">Divergente</option><option value="DENIED" selected="@(f.Status=="DENIED")">Glosado</option><option value="APPEAL_IN_REVIEW" selected="@(f.Status=="APPEAL_IN_REVIEW")">Recurso em análise</option><option value="RECOVERED" selected="@(f.Status=="RECOVERED")">Recuperado</option><option value="CLOSED" selected="@(f.Status=="CLOSED")">Encerrado</option></select></div><button class="btn btn-primary" type="submit"><app-icon name="filter" size="16" decorative="true"/> Filtrar</button><a class="btn btn-outline-secondary" asp-action="Index"><app-icon name="delete" size="16" decorative="true"/> Limpar</a></div></form>
<section class="card border-0 shadow-sm mt-3"><div class="card-header bg-transparent"><h2>@(mode=="review"?"Pendências de revisão":mode=="denials"?"Glosas em acompanhamento":"Documentos hospitalares")</h2><p>@(mode=="denials"?"Priorize recursos pelo prazo e pelo saldo recuperável. Dados de paciente permanecem protegidos.":"Pacientes aparecem mascarados nesta visão operacional.")</p></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Documento</th><th>Convênio / competência</th><th>Paciente protegido</th><th>Valores</th><th>Prazo do recurso</th><th>Confiança</th><th>Status</th><th>Ação</th></tr></thead><tbody>
@if(Model.Documents.Count==0){<tr><td colspan="8"><div class="hospital-empty"><app-icon name="report" size="40" decorative="true"/><h3>Nenhum documento hospitalar encontrado</h3><p>Ajuste os filtros ou processe o OCR de contas, guias TISS, AIH, APAC ou BPA.</p></div></td></tr>}
@foreach(var x in Model.Documents){var deadlineClass=x.AppealDeadlineStatus is "OVERDUE" or "CRITICAL"?"is-critical":x.AppealDeadlineStatus=="ATTENTION"?"is-warning":"is-ok";var deadlineLabel=x.DaysUntilAppealDue switch{null=>"Não informado",<0=> $"Vencido há {Math.Abs(x.DaysUntilAppealDue.Value)} dia(s)",0=>"Vence hoje",1=>"Vence amanhã",_=>$"{x.DaysUntilAppealDue} dias restantes"};<tr><td><strong>@x.Title</strong><small>@x.DocumentType · Guia @(x.GuideNumber??"não informada")</small>@if(!string.IsNullOrWhiteSpace(x.Cnes)){<small>CNES @x.Cnes</small>}</td><td>@(x.Insurer??"Não identificado")<small>@(x.Competence??"Sem competência")</small></td><td><span class="badge text-bg-light"><app-icon name="security" size="14" decorative="true"/> @x.MaskedPatient</span></td><td>@x.PresentedAmount.ToString("C")@if(x.DeniedAmount>0){<small class="text-danger">Glosa @x.DeniedAmount.ToString("C")</small><small>Saldo @Math.Max(0,x.DeniedAmount-x.RecoveredAmount).ToString("C")</small>}</td><td><span class="hospital-deadline @deadlineClass"><app-icon name="history" size="14" decorative="true"/> @deadlineLabel</span>@if(x.DueDate is not null){<small>@x.DueDate.Value.ToString("dd/MM/yyyy")</small>}</td><td><span class="confidence">@x.Confidence.ToString("N0")%</span></td><td><span class="badge @(x.Status=="APPROVED"?"text-bg-success":x.Status=="DIVERGENT"?"text-bg-danger":"text-bg-warning")">@x.Status</span></td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.Id"><app-icon name="documents" size="15" decorative="true"/> Revisar</a></td></tr>}</tbody></table></div></section>
