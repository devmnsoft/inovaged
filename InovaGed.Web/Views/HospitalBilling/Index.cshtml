@using InovaGed.Application.HospitalBilling
@using InovaGed.Web.Models.Atlas
@model HospitalBillingDashboard
@{ ViewData["Title"]="Faturamento Hospitalar"; var f=(HospitalBillingFilter)ViewBag.Filter;
var header=new AtlasPageHeaderVm("Faturamento Hospitalar","Contas, guias TISS e glosas com rastreabilidade, revisão e proteção LGPD.","report","Inteligência assistencial",new[]{new AtlasPageAction("Pendências",Url.Action("WorkQueue",new{status="PENDING_REVIEW"})!,"history",true),new AtlasPageAction("Glosas",Url.Action("WorkQueue",new{hasDenial=true})!,"warning"),new AtlasPageAction("Regras",Url.Action("Rules")!,"settings")});
var k=Model.Kpis; var metrics=new[]{new AtlasMetricVm("Documentos",k.Total.ToString(),"no escopo do tenant","info","documents"),new AtlasMetricVm("Pendentes",k.Pending.ToString(),"aguardam revisão","warning","history"),new AtlasMetricVm("Aprovados",k.Approved.ToString(),"conferidos","success","check"),new AtlasMetricVm("Com glosa",k.WithDenial.ToString(),k.Denied.ToString("C"),"danger","warning"),new AtlasMetricVm("Apresentado",k.Presented.ToString("C"),"valor total","info","report"),new AtlasMetricVm("Recuperado",k.Recovered.ToString("C"),"após recursos","success","report"),new AtlasMetricVm("Sem OCR",k.WithoutOcr.ToString(),"requer processamento","warning","ocr"),new AtlasMetricVm("Baixa confiança",k.LowConfidence.ToString(),"revisão prioritária","danger","security")}; }
@section Styles{<link rel="stylesheet" href="~/css/pages/hospital-billing.css" asp-append-version="true" />}
<partial name="Atlas/_PageHeader" model="header"/><partial name="Atlas/_PageMetrics" model="metrics"/>
<form method="get" class="hospital-filter card border-0 shadow-sm"><div class="card-body"><div class="hospital-filter-term"><label for="term">Busca hospitalar</label><div class="input-group"><span class="input-group-text"><app-icon name="search" size="16" decorative="true"/></span><input id="term" class="form-control" name="term" value="@f.Term" placeholder="Guia, autorização, CNES, prestador, lote ou procedimento"/></div></div><div><label for="insurer">Convênio</label><input id="insurer" class="form-control" name="insurer" value="@f.Insurer" placeholder="Nome do convênio"/></div><div><label for="competence">Competência</label><input id="competence" class="form-control" name="competence" value="@f.Competence" placeholder="07/2026"/></div><div><label for="status">Status</label><select id="status" class="form-select" name="status"><option value="">Todos</option><option value="PENDING_REVIEW" selected="@(f.Status=="PENDING_REVIEW")">Pendente</option><option value="APPROVED" selected="@(f.Status=="APPROVED")">Aprovado</option><option value="DIVERGENT" selected="@(f.Status=="DIVERGENT")">Divergente</option></select></div><button class="btn btn-primary" type="submit"><app-icon name="filter" size="16" decorative="true"/> Filtrar</button><a class="btn btn-outline-secondary" asp-action="Index"><app-icon name="delete" size="16" decorative="true"/> Limpar</a></div></form>
<section class="card border-0 shadow-sm mt-3"><div class="card-header bg-transparent"><h2>Documentos hospitalares</h2><p>Pacientes aparecem mascarados nesta visão operacional.</p></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Documento</th><th>Convênio / competência</th><th>Paciente protegido</th><th>Valores</th><th>Confiança</th><th>Status</th><th>Ação</th></tr></thead><tbody>
@if(Model.Documents.Count==0){<tr><td colspan="7"><div class="hospital-empty"><app-icon name="report" size="40" decorative="true"/><h3>Nenhum documento hospitalar encontrado</h3><p>Ajuste os filtros ou processe o OCR de contas, guias TISS, AIH, APAC ou BPA.</p></div></td></tr>}
@foreach(var x in Model.Documents){<tr><td><strong>@x.Title</strong><small>@x.DocumentType · Guia @(x.GuideNumber??"não informada")</small>@if(!string.IsNullOrWhiteSpace(x.Cnes)){<small>CNES @x.Cnes</small>}</td><td>@(x.Insurer??"Não identificado")<small>@(x.Competence??"Sem competência")</small></td><td><span class="badge text-bg-light"><app-icon name="security" size="14" decorative="true"/> @x.MaskedPatient</span></td><td>@x.PresentedAmount.ToString("C")@if(x.DeniedAmount>0){<small class="text-danger">Glosa @x.DeniedAmount.ToString("C")</small>}</td><td><span class="confidence">@x.Confidence.ToString("N0")%</span></td><td><span class="badge @(x.Status=="APPROVED"?"text-bg-success":x.Status=="DIVERGENT"?"text-bg-danger":"text-bg-warning")">@x.Status</span></td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.Id"><app-icon name="documents" size="15" decorative="true"/> Revisar</a></td></tr>}</tbody></table></div></section>
