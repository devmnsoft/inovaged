@model InovaGed.Application.Ged.Physical.PhysicalLocationFormVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    var isEdit = Model != null && Model.Id != Guid.Empty;
    ViewData["Title"] ??= isEdit ? "Editar Localização Física" : "Nova Localização Física";
    ViewData["Subtitle"] ??= "Cadastre o endereço físico onde caixas e documentos ficam armazenados.";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0">
            <app-icon class="me-2" name="location" size="18" decorative="true" />@ViewData["Title"]
        </h4>
        <div class="text-muted small">@ViewData["Subtitle"]</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/Physical/Locations">
            <app-icon class="me-1" name="arrow-left" size="16" decorative="true" />Voltar
        </a>
    </div>
</div>

@if (TempData["Ok"] is string ok && !string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Err"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger">@err</div>
}

<form asp-action="SaveLocation" method="post" class="card shadow-sm">
    @Html.AntiForgeryToken()

    <div class="card-body">
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Imóvel / unidade</label>
                <input asp-for="UnitName" class="form-control" required placeholder="Ex.: Unidade Centro" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Código da caixa/posição</label>
                <input asp-for="LocationCode" class="form-control" placeholder="Ex.: CX-0042" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Logradouro</label>
                <input asp-for="AddressStreet" class="form-control" placeholder="Rua, avenida..." />
            </div>
            <div class="col-md-3"><label class="form-label">Número</label><input asp-for="AddressNumber" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">Bairro</label><input asp-for="AddressDistrict" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">Cidade / UF</label><div class="input-group"><input asp-for="AddressCity" class="form-control" /><input asp-for="AddressState" class="form-control" maxlength="2" style="max-width:4rem" /></div></div>
            <div class="col-md-3"><label class="form-label">CEP</label><input asp-for="AddressZip" class="form-control" /></div>
            <div class="col-md-4">
                <label class="form-label">Prédio</label>
                <input asp-for="Building" class="form-control" placeholder="Formato: Prédio A" />
                <span asp-validation-for="Building" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label">Sala</label>
                <input asp-for="Room" class="form-control" placeholder="Formato: Sala 02" />
                <span asp-validation-for="Room" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label">Corredor</label>
                <input asp-for="Aisle" class="form-control" placeholder="Formato: Corredor 1" />
                <span asp-validation-for="Aisle" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label">Estante</label>
                <input asp-for="Rack" class="form-control" placeholder="Formato: Estante 03" />
                <span asp-validation-for="Rack" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label">Prateleira</label>
                <input asp-for="Shelf" class="form-control" placeholder="Formato: Prateleira B" />
                <span asp-validation-for="Shelf" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label">Palete</label>
                <input asp-for="Pallet" class="form-control" placeholder="Formato: Palete 10" />
                <span asp-validation-for="Pallet" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label class="form-label">Observações</label>
                <textarea asp-for="Notes" class="form-control" rows="3"
                          placeholder="Informações adicionais..."></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-3 text-muted small">
            Dica: preencha o que fizer sentido. Campos vazios podem ser usados como “não aplicável”.
        </div>
    </div>

    <div class="card-footer d-flex gap-2 justify-content-end">
        <a class="btn btn-outline-secondary" href="/Physical/Locations">
            <app-icon class="me-1" name="close" size="16" decorative="true" />Cancelar
        </a>
        <button type="submit" class="btn btn-primary">
            <app-icon class="me-1" name="save" size="16" decorative="true" />Salvar
        </button>
    </div>
</form>

@if (ViewBag.History is IReadOnlyList<InovaGed.Application.Ged.Physical.PhysicalLocationHistoryDto> history && history.Count > 0)
{
    <section class="card shadow-sm mt-4"><div class="card-header"><strong>Histórico de alterações</strong></div>
    <div class="table-responsive"><table class="table mb-0"><thead><tr><th>Data/hora</th><th>Evento</th><th>Responsável</th><th>Justificativa</th></tr></thead><tbody>
    @foreach (var h in history) { <tr><td>@h.ChangedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@h.Action</td><td>@(h.ChangedBy?.ToString() ?? "Sistema")</td><td>@(h.Reason ?? "—")</td></tr> }
    </tbody></table></div></section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
