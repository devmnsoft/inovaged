@model IReadOnlyList<InovaGed.Application.PhysicalArchive2.PhysicalActivity>
@{ViewData["Title"]="Inventário físico";var locations=(IReadOnlyList<InovaGed.Application.PhysicalArchive2.PhysicalOption>)ViewBag.Locations;}
<link rel="stylesheet" href="~/css/physical-archive.css"/><main class="physical-page"><header class="physical-hero"><div><h1>Inventário físico</h1><p>Compare o acervo esperado com caixas encontradas por leitura ou seleção.</p></div></header><form method="post" action="/Physical/Inventory/Start" class="physical-form">@Html.AntiForgeryToken()<label>Título<input name="title" required maxlength="200"/></label><label>Localização<select name="locationId"><option value="">Todo o acervo</option>@foreach(var x in locations){<option value="@x.Id">@x.Code — @x.Name</option>}</select></label><button class="btn btn-primary">Iniciar inventário</button></form><section class="physical-inventory-board">@foreach(var x in Model){<a href="/Physical/Inventory/@x.Id"><b>@x.Code</b><span>@x.Title</span><em>@x.Status</em></a>}@if(Model.Count==0){<p class="physical-empty">Nenhuma sessão. Inicie a primeira conferência.</p>}</section></main>
