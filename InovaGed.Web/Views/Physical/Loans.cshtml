@model IReadOnlyList<InovaGed.Application.PhysicalArchive2.PhysicalActivity>
@{ViewData["Title"]="Empréstimos físicos";var boxes=(IReadOnlyList<InovaGed.Application.PhysicalArchive2.PhysicalOption>)ViewBag.Boxes;}
<link rel="stylesheet" href="~/css/physical-archive.css"/><main class="physical-page"><header class="physical-hero"><div><h1>Empréstimos</h1><p>Controle a entrega, o prazo e a devolução de caixas.</p></div></header><form method="post" action="/Physical/Loans/Create" class="physical-form">@Html.AntiForgeryToken()<label>Caixa<select name="boxId" required><option value="">Selecione</option>@foreach(var x in boxes){<option value="@x.Id">@x.Code — @x.Name</option>}</select></label><label>Solicitante<input name="requester" required/></label><label>Setor<input name="department"/></label><label>Prazo<input type="datetime-local" name="dueAt"/></label><label>Motivo<input name="reason"/></label><button class="btn btn-primary">Registrar empréstimo</button></form><div class="physical-loan-table"><table><thead><tr><th>Número</th><th>Solicitante</th><th>Caixa</th><th>Status</th><th>Data</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Code</td><td>@x.Title</td><td>@x.Location</td><td><span class="physical-badge">@x.Status</span></td><td>@x.OccurredAt.ToLocalTime().ToString("g")</td><td>@if(x.Status is "OPEN" or "OVERDUE"){<form method="post" action="/Physical/Loans/@x.Id/Return">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-primary">Registrar devolução</button></form>}</td></tr>}</tbody></table></div></main>
