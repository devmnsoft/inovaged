@model IReadOnlyList<InovaGed.Application.PhysicalArchive2.PhysicalActivity>
@{ViewData["Title"]="Movimentações";var boxes=(IReadOnlyList<InovaGed.Application.PhysicalArchive2.PhysicalOption>)ViewBag.Boxes;var locations=(IReadOnlyList<InovaGed.Application.PhysicalArchive2.PhysicalOption>)ViewBag.Locations;}
<link rel="stylesheet" href="~/css/physical-archive.css"/><main class="physical-page"><header class="physical-hero"><div><h1>Movimentações</h1><p>Transfira caixas com registro automático da cadeia de custódia.</p></div></header>
<form method="post" action="/Physical/Movements/Create" class="physical-form">@Html.AntiForgeryToken()<label>Caixa<select name="boxId" required><option value="">Selecione</option>@foreach(var x in boxes){<option value="@x.Id">@x.Code — @x.Name</option>}</select></label><label>Destino<select name="toLocationId" required><option value="">Selecione</option>@foreach(var x in locations){<option value="@x.Id">@x.Code — @x.Name</option>}</select></label><label>Tipo<select name="movementType"><option value="TRANSFER">Transferência</option><option value="CHECK">Conferência</option><option value="INVENTORY">Inventário</option><option value="CORRECTION">Correção</option></select></label><label>Motivo<input name="reason" maxlength="1000"/></label><button class="btn btn-primary">Registrar movimentação</button></form>
<section class="physical-movement-timeline">@foreach(var x in Model){<article><time>@x.OccurredAt.ToLocalTime().ToString("g")</time><div><b>@x.Code · @x.Title</b><p>@x.Location — @x.Detail</p></div></article>}@if(Model.Count==0){<p class="physical-empty">Nenhuma movimentação registrada.</p>}</section></main>
