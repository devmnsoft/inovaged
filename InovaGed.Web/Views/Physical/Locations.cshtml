@model IReadOnlyList<InovaGed.Application.Ged.Physical.PhysicalLocationRowDto>
@{
    ViewData["Title"] = "Localizações físicas";
    var q = (ViewBag.Q as string) ?? "";
    var total = Model?.Count ?? 0;
    var buildings = Model?.Select(x => x.Building).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x).ToList() ?? new List<string>();
}
@section Styles { <link rel="stylesheet" href="~/css/pages/physical-locations.css" asp-append-version="true" /> }

<div class="physical-locations-page" data-physical-locations>
    <header class="physical-locations-hero">
        <div>
            <span class="physical-eyebrow"><app-icon name="location" size="15" decorative="true" /> Guarda física</span>
            <h1>Localizações físicas</h1>
            <p>Organize a rastreabilidade do acervo por prédio, sala e endereço de guarda, do recebimento à retirada.</p>
        </div>
        <div class="physical-hero-actions">
            <a class="btn btn-outline-secondary" href="/Physical/PhysicalMap"><app-icon name="map" size="17" decorative="true" /> Mapa de guarda</a>
            <a class="btn btn-primary" href="/Physical/Locations/New"><app-icon name="add" size="17" decorative="true" /> Nova localização</a>
        </div>
    </header>

    @if (TempData["Ok"] is string ok && !string.IsNullOrWhiteSpace(ok))
    { <div class="alert alert-success physical-feedback" role="status"><app-icon name="check" size="18" decorative="true" /> @ok</div> }
    @if (TempData["Err"] is string err && !string.IsNullOrWhiteSpace(err))
    { <div class="alert alert-danger physical-feedback" role="alert"><app-icon name="warning" size="18" decorative="true" /> @err</div> }

    <section class="physical-filter-card" aria-label="Busca e filtros">
        <form method="get" class="physical-filter-grid">
            <div class="physical-search-field">
                <label for="physicalSearch">Buscar endereço</label>
                <div class="physical-input-icon"><app-icon name="search" size="17" decorative="true" /><input id="physicalSearch" name="q" value="@q" class="form-control" placeholder="Prédio, sala, corredor, estante, prateleira ou palete" /></div>
            </div>
            <div>
                <label for="buildingFilter">Prédio</label>
                <select id="buildingFilter" class="form-select" data-building-filter><option value="">Todos os prédios</option>@foreach (var building in buildings) { <option value="@building">@building</option> }</select>
            </div>
            <div>
                <label for="statusFilter">Status</label>
                <select id="statusFilter" class="form-select"><option>Ativas</option></select>
            </div>
            <button class="btn btn-primary" type="submit"><app-icon name="search" size="16" decorative="true" /> Pesquisar</button>
            @if (!string.IsNullOrWhiteSpace(q)) { <a class="btn btn-ghost" href="/Physical/Locations">Limpar</a> }
        </form>
    </section>

    <div class="physical-list-heading"><div><h2>Endereços cadastrados</h2><p>Selecione uma localização para editar seus campos de forma segura.</p></div><span class="physical-count">@total resultado(s)</span></div>

    @if (total == 0)
    {
        <section class="physical-empty-state">
            <app-icon name="location" size="36" decorative="true" />
            <h2>Nenhuma localização cadastrada</h2>
            <p>Cadastre o primeiro endereço físico para rastrear caixas e documentos.</p>
            <a class="btn btn-primary" href="/Physical/Locations/New">Cadastrar primeira localização</a>
        </section>
    }
    else
    {
        <section class="physical-location-list" aria-label="Localizações cadastradas">
        @foreach (var r in Model!)
        {
            <article class="physical-location-card" data-building="@r.Building">
                <div class="physical-location-mark"><app-icon name="building" size="22" decorative="true" /></div>
                <div class="physical-location-primary"><div class="physical-title-row"><h3>@r.Building</h3><span class="physical-status">Ativa</span></div><p><app-icon name="location" size="14" decorative="true" /> @(string.IsNullOrWhiteSpace(r.Room) ? "Sala não informada" : r.Room)</p></div>
                <dl class="physical-address-grid">
                    <div><dt>Corredor</dt><dd>@(r.Aisle ?? "—")</dd></div><div><dt>Estante</dt><dd>@(r.Rack ?? "—")</dd></div><div><dt>Prateleira</dt><dd>@(r.Shelf ?? "—")</dd></div><div><dt>Palete</dt><dd>@(r.Pallet ?? "—")</dd></div>
                </dl>
                <div class="physical-notes"><span>Observações</span><p>@(string.IsNullOrWhiteSpace(r.Notes) ? "Nenhuma observação operacional." : r.Notes)</p></div>
                <div class="physical-card-actions">
                    <a class="btn btn-sm btn-outline-primary" href="/Physical/Locations/@r.Id"><app-icon name="edit" size="15" decorative="true" /> Editar</a>
                    <button class="btn btn-sm btn-ghost-danger" type="button" data-delete-location data-location-id="@r.Id" data-location-name="@r.Building, @r.Room"><app-icon name="delete" size="15" decorative="true" /><span>Excluir</span></button>
                </div>
            </article>
        }
        </section>
    }
</div>

<div class="modal fade" id="deleteLocationModal" tabindex="-1" aria-labelledby="deleteLocationTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered"><div class="modal-content physical-confirm-modal"><div class="modal-header"><div><span class="physical-eyebrow">Ação de segurança</span><h2 class="modal-title fs-5" id="deleteLocationTitle">Excluir localização?</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><p>Você está prestes a excluir <strong data-delete-name></strong>. Continue somente se não houver caixas vinculadas.</p></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><form method="post" data-delete-form>@Html.AntiForgeryToken()<button class="btn btn-danger" type="submit"><app-icon name="delete" size="16" decorative="true" /> Excluir localização</button></form></div></div></div>
</div>

@section Scripts { <script src="~/js/physical-locations.js" asp-append-version="true"></script> }
