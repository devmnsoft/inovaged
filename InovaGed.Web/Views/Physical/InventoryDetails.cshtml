@model InovaGed.Application.PhysicalArchive2.PhysicalInventoryDetails
@{ViewData["Title"]=$"Inventário {Model.Number}";var locations=(IReadOnlyList<InovaGed.Application.PhysicalArchive2.PhysicalOption>)ViewBag.Locations;}
<link rel="stylesheet" href="~/css/physical-archive.css"/><main class="physical-page"><header class="physical-hero"><div><span>@Model.Status</span><h1>@Model.Title</h1><p>@Model.Number · @(Model.Location??"Todo o acervo")</p></div></header>@if(Model.Status=="OPEN"){<form method="post" action="/Physical/Inventory/@Model.Id/Scan" class="physical-form">@Html.AntiForgeryToken()<label>Código da caixa ou QR<input name="code" required autofocus autocomplete="off"/></label><label>Local encontrado<select name="foundLocationId"><option value="">Sem localização</option>@foreach(var x in locations){<option value="@x.Id" selected="@(x.Id==Model.LocationId)">@x.Code — @x.Name</option>}</select></label><button class="btn btn-primary">Conferir</button></form><form method="post" action="/Physical/Inventory/@Model.Id/Close" class="physical-close">@Html.AntiForgeryToken()<input name="notes" placeholder="Observações de fechamento"/><button class="btn btn-outline-danger">Fechar inventário</button></form>}<section class="physical-inventory-board">@foreach(var x in Model.Items){<article><b>@x.Code</b><span>@x.Location</span><em>@x.Status</em></article>}@if(Model.Items.Count==0){<p class="physical-empty">Aguardando a primeira leitura.</p>}</section></main>
