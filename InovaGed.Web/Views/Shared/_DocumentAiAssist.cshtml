@model InovaGed.Web.Models.DocumentAiAssistVm
@inject Microsoft.Extensions.Options.IOptions<InovaGed.Application.ArtificialIntelligence.DocumentAiOptions> AiOptions
@if (string.Equals(AiOptions.Value.Provider, "Deterministic", StringComparison.OrdinalIgnoreCase))
{
    <div class="alert alert-warning" role="status">Provedor determinístico de homologação. Estes resultados não homologam provedores reais.</div>
}
<section class="side-section card card-body mb-3" data-ai-assist>
    <div class="side-title h6">Resumo assistido <span class="badge bg-warning text-dark">Sugestão</span></div>
    <p class="small text-muted">Como usar: gere o resumo, confira cada trecho no original e use Tab para percorrer os botões. O documento não é alterado. Cancelar interrompe a espera e descarta a resposta atrasada.</p>
    <form data-document-summary action="@Url.Action("Summarize", "HospitalDocuments")" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="versionId" value="@Model.VersionId" />
        <input type="hidden" name="idempotencyKey" />
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary btn-sm">Resumir documento</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-cancel data-cancel-summary hidden>Cancelar</button>
        </div>
    </form>
    <div data-summary-status class="small mt-2" role="status" aria-live="polite"></div>
    <div data-summary-result class="mt-3" hidden tabindex="-1"></div>
</section>
<section class="side-section card card-body mb-3" data-ai-assist>
    <div class="side-title h6">Preenchimento assistido <span class="badge bg-warning text-dark">Sugestão</span></div>
    <p class="small text-muted">Como usar: compare atual, sugerido e corrigido. Aceite, corrija ou mantenha cada campo. A gravação só aparece depois da resposta do servidor.</p>
    <form data-metadata-suggest action="@Url.Action("SuggestMetadata", "HospitalDocuments")" method="post" data-apply-url="@Url.Action("ApplyMetadataSuggestion", "HospitalDocuments")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="versionId" value="@Model.VersionId" />
        <input type="hidden" name="documentId" value="@Model.DocumentId" />
        <input type="hidden" name="idempotencyKey" />
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary btn-sm">Sugerir preenchimento</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-cancel data-cancel-metadata hidden>Cancelar</button>
        </div>
    </form>
    <div data-metadata-status class="small mt-2" role="status" aria-live="polite"></div>
    <div data-metadata-result class="mt-3" hidden tabindex="-1"></div>
</section>
<section class="side-section card card-body mb-3" data-ai-assist>
    <div class="side-title h6">Sugerir tipo documental <span class="badge bg-warning text-dark">Sugestão</span></div>
    <p class="small text-muted">Esta jornada usa os tipos de ged.document_type. Ela não escolhe a classe do plano de classificação.</p>
    <form data-document-type-suggest data-classification-suggest action="@Url.Action("SuggestClassification", "HospitalDocuments")" method="post" data-apply-url="@Url.Action("ApplyClassification", "HospitalDocuments")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="versionId" value="@Model.VersionId" />
        <input type="hidden" name="documentId" value="@Model.DocumentId" />
        <input type="hidden" name="idempotencyKey" />
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary btn-sm">Sugerir tipo documental</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-cancel data-cancel-classification hidden>Cancelar</button>
        </div>
    </form>
    <div data-document-type-status data-classification-status class="small mt-2" role="status" aria-live="polite"></div>
    <div data-document-type-result data-classification-result class="mt-3" hidden tabindex="-1"></div>
</section>
<section class="side-section card card-body mb-3" data-ai-assist>
    <div class="side-title h6">Sugerir classificação arquivística <span class="badge bg-warning text-dark">Sugestão</span></div>
    <p class="small text-muted">As classes vêm do plano vigente. A ausência de sugestão é válida. A confirmação usa o serviço canônico e não inventa prazo, evento ou destino. HOLD, empréstimos e impedimentos permanecem.</p>
    <form data-archival-suggest action="@Url.Action("SuggestArchivalClassification", "HospitalDocuments")" method="post" data-apply-url="@Url.Action("ApplyArchivalClassification", "HospitalDocuments")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="versionId" value="@Model.VersionId" />
        <input type="hidden" name="documentId" value="@Model.DocumentId" />
        <input type="hidden" name="idempotencyKey" />
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary btn-sm">Sugerir classe do plano</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-cancel hidden>Cancelar</button>
        </div>
    </form>
    <div data-archival-status class="small mt-2" role="status" aria-live="polite"></div>
    <div data-archival-result class="mt-3" hidden tabindex="-1"></div>
</section>
<section class="side-section card card-body mb-3" data-ai-review-history data-document-id="@Model.DocumentId" data-history-url="@Url.Action("ReviewHistory", "HospitalDocuments")" data-pending-url="@Url.Action("RetentionPending", "HospitalDocuments")" data-retry-url="@Url.Action("RetryRetention", "HospitalDocuments")">
    @Html.AntiForgeryToken()
    <div class="side-title h6">Histórico de revisões de IA</div>
    <p class="small text-muted">Como usar: consulte a decisão registrada, o efeito em cada campo e a situação do recálculo. A autorização é a do documento, agora. Um resultado de IA expirado deixa de mostrar o texto do modelo e conserva a decisão humana.</p>
    <div class="d-flex flex-wrap gap-2 mb-2">
        <button type="button" class="btn btn-outline-primary btn-sm" data-history-refresh>Atualizar histórico</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-history-prev>Anterior</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-history-next>Próxima</button>
    </div>
    <div data-history-status class="small" role="status" aria-live="polite">Carregando histórico…</div>
    <div data-history-list class="mt-2" tabindex="-1"></div>
    <div class="side-title h6 mt-3">Pendências de temporalidade</div>
    <div data-pending-status class="small" role="status" aria-live="polite"></div>
    <div data-pending-list class="mt-2"></div>
</section>
