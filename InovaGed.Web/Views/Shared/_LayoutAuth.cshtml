@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - InovaGED</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />

    <link href="~/css/atlas/atlas-tokens.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/atlas-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/inovaged.atlas.illustrations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/atlas-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/atlas-overlays.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/inovaged.atlas.icons.css" asp-append-version="true" />
    <link href="~/css/atlas/atlas-navigation.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/atlas/atlas-shell.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/atlas/atlas-responsive.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pages/login.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link href="~/css/inovaged.utilities.css" rel="stylesheet" asp-append-version="true" />
</head>

<body data-theme="inovaged-classic">
    <partial name="Icons/_AtlasAssets" />
    <main class="auth-page-root">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/atlas-icon.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
