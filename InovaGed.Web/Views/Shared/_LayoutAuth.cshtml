@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - InovaGED</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />

    <link rel="stylesheet"
          href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />

    <link href="~/css/inovaged.tokens.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/inovaged.base.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/inovaged.shell.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/inovaged.components.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pages/login.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link href="~/css/inovaged.utilities.css" rel="stylesheet" asp-append-version="true" />
</head>

<body data-theme="inovaged-classic">
    <main class="auth-page-root">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
