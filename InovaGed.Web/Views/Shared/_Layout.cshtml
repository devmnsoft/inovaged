@using InovaGed.Web.Services
@inject IUserShellContextService ShellContext
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var shell = isAuthenticated
        ? ShellContext.Create(User, ViewData["Title"]?.ToString(), ViewData["Subtitle"]?.ToString())
        : null;
    var workspaceVariant = ViewData["WorkspaceVariant"]?.ToString() ?? "standard";
    var allowedWorkspaceVariants = new[] { "standard", "wide", "full", "workbench", "focus" };
    if (!allowedWorkspaceVariants.Contains(workspaceVariant, StringComparer.OrdinalIgnoreCase))
    {
        workspaceVariant = "standard";
    }
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InovaGED</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/atlas-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/atlas-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/inovaged.atlas.illustrations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/inovaged.atlas.icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/atlas-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/atlas-navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/atlas-command-palette.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/atlas-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/atlas-overlays.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/atlas-feedback.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atlas/atlas-responsive.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/inovaged.utilities.css" asp-append-version="true" />
</head>
<body class="@(isAuthenticated ? "layout-app" : "layout-auth")">
    <partial name="Icons/_AtlasAssets" />
    <a class="skip-link" href="#main-content">Pular para o conteúdo</a>
    @if (shell is not null)
    {
        <div class="wrapper app-shell">
            <partial name="AppShell/_Sidebar" model="shell" />
            <partial name="AppShell/_MobileNavigation" model="shell" />
            <div class="main app-main">
                <partial name="AppShell/_Topbar" model="shell" />
                <partial name="AppShell/_ContextHeader" model="shell" />
                <div class="atlas-work-context-strip" data-work-context-strip aria-label="Contextos de trabalho abertos"></div>
                <main id="main-content" class="content app-content" tabindex="-1">
                    <div class="atlas-workspace-canvas atlas-workspace-canvas--@workspaceVariant.ToLowerInvariant()">
                        @RenderBody()
                    </div>
                </main>
            </div>
        </div>
        <div id="atlasOverlayRoot" class="atlas-overlay-root">
            <partial name="Feedback/_FeedbackLayer" />
            <partial name="Feedback/_ConfirmDialog" />
        </div>
    }
    else
    {
        <main id="main-content">@RenderBody()</main>
    }
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
    <script src="~/js/inovaged-feedback.js" asp-append-version="true"></script>
    <script src="~/js/app-shell.js" asp-append-version="true"></script>
    <script src="~/js/global-search.js" asp-append-version="true"></script>
    <script src="~/js/quick-create.js" asp-append-version="true"></script>
    <script src="~/js/workspace-command-palette.js" asp-append-version="true"></script>
    <script src="~/js/workspace-shortcuts.js" asp-append-version="true"></script>
    <script src="~/js/workspace-undo.js" asp-append-version="true"></script>
    <script src="~/js/workspace-onboarding.js" asp-append-version="true"></script>
    <script src="~/js/workspace-connectivity.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
