@model IReadOnlyList<InovaGed.Web.Models.AppShell.AppQuickActionVM>

@if (Model.Count > 0)
{
    <div class="dropdown quick-create">
        <button class="btn btn-primary" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            <span>Criar</span>
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><h2 class="dropdown-header">Criar nova atividade</h2></li>
            @foreach (var actionItem in Model)
            {
                <li>
                    <a class="dropdown-item" asp-controller="@actionItem.Controller" asp-action="@actionItem.Action">
                        <i class="bi @actionItem.Icon" aria-hidden="true"></i>
                        <span>
                            <strong>@actionItem.Label</strong>
                            <small>@actionItem.Description</small>
                        </span>
                    </a>
                </li>
            }
        </ul>
    </div>
}
