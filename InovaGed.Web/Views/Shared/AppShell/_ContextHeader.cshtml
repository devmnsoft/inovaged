@model InovaGed.Web.Models.AppShell.AppShellVM
<section class="context-header" aria-labelledby="context-page-title"><div><nav aria-label="Breadcrumb"><ol class="context-breadcrumb"><li>InovaGED</li><li aria-current="page">@Model.PageTitle</li></ol></nav><h1 id="context-page-title">@Model.PageTitle</h1>@if (!string.IsNullOrWhiteSpace(Model.PageSubtitle)) { <p>@Model.PageSubtitle</p> }</div>@if (Model.PrimaryAction is not null) { <a class="btn btn-primary context-primary" asp-controller="@Model.PrimaryAction.Controller" asp-action="@Model.PrimaryAction.Action"><i class="bi @Model.PrimaryAction.Icon"></i> @Model.PrimaryAction.Label</a> }</section>
