@model InovaGed.Web.Models.AppShell.AppUserShellVM
<div class="dropdown">
    <button class="topbar-user-button" data-bs-toggle="dropdown" aria-expanded="false"><span class="topbar-user-avatar">@Model.Initials</span><span class="topbar-user-summary"><strong>@Model.DisplayName</strong><small>@Model.RoleLabel</small></span><app-icon name="chevron-down" decorative="true" size="16" /></button>
    <ul class="dropdown-menu dropdown-menu-end shadow-sm user-menu">
        <li class="user-menu-details"><strong>@Model.DisplayName</strong><span>@Model.RoleLabel</span>@if (!string.IsNullOrWhiteSpace(Model.Sector)) { <span>Setor: @Model.Sector</span> } else if (Model.ShowSectorWarning) { <span class="text-warning"><app-icon name="warning" decorative="true" size="16" /> Setor não configurado</span> }</li>
        <li><hr class="dropdown-divider" /></li>
        <li><form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="dropdown-item" type="submit"><app-icon name="arrow-right" decorative="true" size="16" /> Sair</button></form></li>
    </ul>
</div>
