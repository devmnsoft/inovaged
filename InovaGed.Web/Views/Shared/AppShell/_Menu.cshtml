@model InovaGed.Web.Models.AppShell.AppShellVM

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentRouteValues = ViewContext.RouteData.Values.ToDictionary(
        pair => pair.Key,
        pair => pair.Value?.ToString(),
        StringComparer.OrdinalIgnoreCase);
}

@for (
    var menuSectionIndex = 0;
    menuSectionIndex < Model.Menu.Count;
    menuSectionIndex++)
{
    var menuSection =
        Model.Menu[menuSectionIndex];

    var menuSectionId = $"sidebar-menu-section-{menuSection.Id}";
    var menuSectionPanelId = $"{menuSectionId}-items";
    var sectionActive = menuSection.Items.Any(item => item.ActiveRouteRule.Matches(currentController, currentAction, currentRouteValues));

    <section class="sidebar-menu-section" data-menu-section
             aria-labelledby="@menuSectionId">

        <h2 class="sidebar-section-title" id="@menuSectionId">
            <button type="button" data-menu-section-toggle aria-expanded="@(sectionActive ? "true" : "false")"
                    aria-controls="@menuSectionPanelId">
                <span>@menuSection.Label</span><app-icon name="chevron-down" decorative="true" size="14" />
            </button>
        </h2>

        <div id="@menuSectionPanelId" data-menu-section-items hidden="@(!sectionActive)">
        @foreach (var item in menuSection.Items) {
            var active = item.ActiveRouteRule.Matches(currentController, currentAction, currentRouteValues);

            <a asp-controller="@item.Controller" data-menu-item data-menu-label="@item.Label"
               asp-action="@item.Action"
               asp-all-route-data="@item.RouteValues"
               data-menu-description="@item.Description"
               title="@($"{item.Label} — {item.Description}")"
               class="@(active ? "active" : null)"
               aria-current="@(active ? "page" : null)">

                <app-icon name="@item.Icon" decorative="true" size="19" />

                <span>@item.Label</span>
            </a>
        }
        </div>
    </section>
}
