@model InovaGed.Web.Models.AppShell.AppShellVM

@{
    var currentController =
        ViewContext.RouteData.Values["controller"]
            ?.ToString()
        ?? string.Empty;
}

@for (
    var menuSectionIndex = 0;
    menuSectionIndex < Model.Menu.Count;
    menuSectionIndex++)
{
    var menuSection =
        Model.Menu[menuSectionIndex];

    var menuSectionId =
        $"sidebar-menu-section-{menuSectionIndex}";

    <section class="sidebar-menu-section"
             aria-labelledby="@menuSectionId">

        <h2 class="sidebar-section-title"
            id="@menuSectionId">
            @menuSection.Label
        </h2>

        @foreach (var item in menuSection.Items)
        {
            var active =
                item.ActiveControllers?.Any(
                    controller =>
                        controller.Equals(
                            currentController,
                            StringComparison.OrdinalIgnoreCase))
                ?? false;

            <a asp-controller="@item.Controller"
               asp-action="@item.Action"
               class="@(active ? "active" : null)"
               aria-current="@(active ? "page" : null)">

                <i class="bi @item.Icon"
                   aria-hidden="true"></i>

                <span>@item.Label</span>
            </a>
        }
    </section>
}
