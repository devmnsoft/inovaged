@model InovaGed.Web.Models.AppShell.AppShellVM
<aside class="sidebar app-sidebar d-none d-lg-flex" aria-label="Navegação principal">
    <partial name="AppShell/_WorkspaceBrand" />
    <div class="sidebar-search" role="search">
        <app-icon name="search" decorative="true" size="18" />
        <input type="search" data-menu-search placeholder="Pesquisar no menu" aria-label="Pesquisar no menu" autocomplete="off" />
        <button type="button" data-menu-search-clear aria-label="Limpar pesquisa" hidden><app-icon name="close" decorative="true" size="16" /></button>
    </div>
    <nav class="sidebar-menu" aria-label="Módulos">
        <partial name="AppShell/_Menu" model="Model" />
        <p class="sidebar-empty" data-menu-empty hidden>Nenhuma função corresponde à pesquisa.</p>
    </nav>
    <div class="sidebar-account">
        <div class="sidebar-section-title">Conta</div>
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="sidebar-logout"><app-icon name="arrow-right" decorative="true" size="18" /><span>Sair</span></button>
        </form>
    </div>
    <footer class="sidebar-footer">© @DateTime.UtcNow.Year InovaGED</footer>
    <div class="sidebar-preferences" aria-label="Densidade do menu"><button type="button" data-sidebar-density="comfortable">Confortável</button><button type="button" data-sidebar-density="compact">Compacto</button></div>
    <button class="sidebar-collapse" type="button" data-sidebar-toggle aria-expanded="true" title="Recolher menu"><app-icon name="panel-left" decorative="true" size="18" /><span>Recolher menu</span></button>
</aside>
