@{var title=ViewData["Title"]?.ToString()??"Ação";var description=ViewData["Description"]?.ToString()??"Acesse este recurso.";var url=ViewData["Url"]?.ToString()??"#";var badge=ViewData["Badge"]?.ToString();var disabled=ViewData["Disabled"] is true;}<article class="atlas-action-card @(disabled?"is-disabled":null)"><header class="d-flex justify-content-between"><app-icon name="@(ViewData["Icon"]?.ToString()??"layout")" size="24" decorative="true" />@if(badge is not null){<span class="atlas-badge atlas-badge-info">@badge</span>}</header><h3>@title</h3><p>@description</p><a class="atlas-btn atlas-btn-secondary" href="@url" aria-disabled="@disabled">Abrir</a></article>
