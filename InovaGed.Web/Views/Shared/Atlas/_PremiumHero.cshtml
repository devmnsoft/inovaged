@{ var title = ViewData["Title"]?.ToString() ?? "InovaGED"; var eyebrow = ViewData["Eyebrow"]?.ToString(); var description = ViewData["Description"]?.ToString(); var icon = ViewData["Icon"]?.ToString() ?? "activity"; }
<section class="ig-premium-hero" aria-labelledby="premium-hero-title"><div class="ig-premium-hero__content"><span class="ig-eyebrow"><app-icon name="@icon" size="17" decorative="true" /> @eyebrow</span><h1 id="premium-hero-title">@title</h1><p>@description</p></div>@if (ViewData["ActionUrl"] is string actionUrl) { <a class="ig-button ig-button--primary" href="@actionUrl"><app-icon name="arrow-right" size="17" decorative="true" /> @ViewData["ActionLabel"]</a> }</section>
