@{var title=ViewData["TableTitle"]?.ToString()??"Registros";}<section class="atlas-table-shell" aria-label="@title"><header class="atlas-table-header"><div><strong>@title</strong><small class="d-block text-muted">@ViewData["Description"]</small></div></header>@if(ViewData["Content"] is Microsoft.AspNetCore.Html.IHtmlContent content){<div class="table-responsive">@content</div>}else{<partial name="Atlas/_AtlasEmptyState"/>}</section>
