<section class="atlas-preview-shell"><header><div><span class="atlas-eyebrow">Pré-visualização</span><h2>@(ViewData["Title"]??"Etiqueta")</h2></div><span class="atlas-badge atlas-badge-info">Prévia</span></header><div class="atlas-preview-shell__canvas">@if(ViewData["Content"] is Microsoft.AspNetCore.Html.IHtmlContent content){@content}else{<span class="text-muted">O conteúdo aparecerá aqui.</span>}</div><footer><app-icon name="info" size="16" decorative="true"/> A impressão preserva dimensões, bordas e contraste.</footer></section>
