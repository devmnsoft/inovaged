@{ var title=ViewData["CardTitle"]?.ToString(); var description=ViewData["Description"]?.ToString(); var icon=ViewData["Icon"]?.ToString() ?? "tag"; var url=ViewData["Url"]?.ToString() ?? "#"; var action=ViewData["Action"]?.ToString() ?? "Abrir"; var status=ViewData["Status"]?.ToString() ?? "Disponível"; }
<article class="ig-label-operation-card"><header><span class="ig-label-operation-card__icon"><app-icon name="@icon" size="22" decorative="true" /></span><span class="ig-status-badge ig-status-badge--ok">@status</span></header><h2>@title</h2><p>@description</p><a class="ig-button ig-button--secondary" href="@url">@action <app-icon name="arrow-right" size="16" decorative="true" /></a></article>
