@{var steps=ViewData["Steps"] as IReadOnlyList<string>??Array.Empty<string>();var current=ViewData["Current"] is int n?n:1;}<ol class="atlas-stepper" style="--atlas-steps:@steps.Count" aria-label="@(ViewData["StepperTitle"]?.ToString()??"Etapas")">@for(var i=0;i<steps.Count;i++){var number=i+1;<li class="@(number<current?"is-complete":number==current?"is-active":null)" aria-current="@(number==current?"step":null)"><strong>@number</strong><span>@steps[i]</span></li>}</ol>
