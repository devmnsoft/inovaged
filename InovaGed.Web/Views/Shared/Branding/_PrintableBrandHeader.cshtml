@model InovaGed.Web.Models.Branding.PrintBrandingPreviewVm
<header class="printable-brand-header">@if(Model.PrimaryLogoUrl is not null){<img src="@Model.PrimaryLogoUrl" alt="Logo principal oficial" style="width:@(Model.Branding.PrimaryLogoWidthMm)mm" />}<div><h1>@(Model.Branding.HeaderTitle??Model.Branding.ProfileName??"Documento institucional")</h1>@if(Model.Branding.HeaderSubtitle is not null){<p>@Model.Branding.HeaderSubtitle</p>}@if(Model.Branding.HeaderExtraLine is not null){<small>@Model.Branding.HeaderExtraLine</small>}</div>@if(Model.SecondaryLogoUrl is not null){<img src="@Model.SecondaryLogoUrl" alt="Logo secundária oficial" style="width:@(Model.Branding.SecondaryLogoWidthMm)mm" />}</header>
