@using InovaGed.Web.Models.Branding
@model LocDeskLogoViewModel
@{
    var officialLogo = new PrintLogoViewModel
    {
        LogoUrl = BrandAssets.LocDeskLogoWebPath,
        PrintImageSource = BrandAssets.LocDeskLogoWebPath,
        Alt = Model?.Decorative == true ? string.Empty : "Logo oficial LocDesk",
        CssClass = Model?.CssClass,
        WidthMm = 38,
        PreserveAspectRatio = true,
        HasLogo = true,
        ImageLoaded = true
    };
}
@* Compatibilidade: nunca simula a marca; apenas mostra a imagem oficial existente. *@
<partial name="Branding/_PrintLogo" model="officialLogo" />
