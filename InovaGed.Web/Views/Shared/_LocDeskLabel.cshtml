@model InovaGed.Web.Models.Labels.LocDeskLabelRenderModel
@{ var item=Model.Label;var cfg=Model.Template?.Config;var fields=Model.Template?.Fields.Where(x=>x.IsVisible).ToDictionary(x=>x.FieldKey,StringComparer.OrdinalIgnoreCase);bool Show(string key)=>fields is null||fields.ContainsKey(key);string Label(string key,string fallback)=>fields is not null&&fields.TryGetValue(key,out var f)?f.FieldLabel:fallback; }
<section class="locdesk-label locdesk-standard-label @(item.LabelKind == "BOX" ? "locdesk-box-label" : "locdesk-folder-label")" style="--locdesk-primary:@(cfg?.PrimaryColor??"#008a9a");--locdesk-secondary:@(cfg?.SecondaryColor??"#6fc7c8");--locdesk-border:@(cfg?.BorderColor??"#111111");--locdesk-text:@(cfg?.TextColor??"#111111");--locdesk-accent:@(cfg?.AccentColor??"#d60000")">
 <header class="locdesk-label-header"><div class="locdesk-logo"><partial name="_LocDeskLogo" model='new InovaGed.Web.Models.Branding.LocDeskLogoViewModel { CssClass = "locdesk-brand-logo--print" }' /></div><div class="locdesk-title-area"><h1>@(cfg?.HeaderText??item.ArchiveTitle)</h1>@if(Show("control_number")){<div class="locdesk-control-row"><span>@Label("control_number","N° de Controle"):</span><strong class="locdesk-red">@item.ControlNumber</strong></div>}@if(Show("volume")){<div class="locdesk-control-row"><span>@Label("volume","Volume"):</span><strong class="locdesk-red">@item.VolumeNumber / @item.VolumeTotal</strong></div>}</div><div class="locdesk-qr" role="img" aria-label="QR Code para rastreio">@Html.Raw(Model.QrSvg)@if(ViewBag.TraceCode is string traceCode){<small>Conferir etiqueta<br/><strong>@traceCode</strong></small>}</div></header>
 <dl class="locdesk-fields">@if(!string.IsNullOrWhiteSpace(item.ProcessNumber)){<div><dt>Processo nº:</dt><dd>@item.ProcessNumber</dd></div>}@if(Show("subject")){<div><dt>@Label("subject","Assunto"):</dt><dd>@item.Subject</dd></div>}@if(Show("details")){<div><dt>@Label("details","Detalhamento"):</dt><dd>@item.Details</dd></div>}@if(Show("activity")){<div><dt>@Label("activity","Atividade"):</dt><dd>@item.Activity</dd></div>}@if(Show("classification")){<div><dt>@Label("classification","Classificação"):</dt><dd>@item.Classification</dd></div>}@if(Show("support")){<div><dt>@Label("support","Suporte"):</dt><dd>@item.Support</dd></div>}@if(Show("document_period")){<div><dt>@Label("document_period","Período do Documento"):</dt><dd>@item.DocumentPeriod</dd></div>}@if(Show("current_phase")){<div><dt>@Label("current_phase","Fase Atual"):</dt><dd>@item.CurrentPhase</dd></div>}@if(Show("disposal_forecast")){<div><dt>@Label("disposal_forecast","Previsão Eliminação"):</dt><dd>@item.EliminationForecast</dd></div>}@if(Show("disposal_status")){<div><dt>@Label("disposal_status","Situação Eliminação"):</dt><dd>@item.EliminationStatus</dd></div>}@if(Show("led_number")){<div><dt>@Label("led_number","Nº LED"):</dt><dd>@item.LedNumber</dd></div>}@if(Show("location")){<div class="locdesk-location"><dt>@Label("location","LOCALIZAÇÃO"):</dt><dd><strong>@item.Location</strong></dd></div>}</dl>
</section>
