@using Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using InovaGed.Web.Security

@{
    var ctrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var act = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? string.Empty;

    string Active(string controller, params string[] actions)
    {
        if (!string.Equals(ctrl, controller.ToLowerInvariant(), StringComparison.OrdinalIgnoreCase)) return string.Empty;
        return actions.Length == 0 || actions.Any(a => string.Equals(act, a.ToLowerInvariant(), StringComparison.OrdinalIgnoreCase)) ? "active" : string.Empty;
    }

    string ActiveAny(params string[] controllers) => controllers.Any(c => string.Equals(ctrl, c.ToLowerInvariant(), StringComparison.OrdinalIgnoreCase)) ? "active" : string.Empty;
    string ActivePathStarts(string startsWith) => path.StartsWith((startsWith ?? string.Empty).ToLowerInvariant()) ? "active" : string.Empty;

    var isFullAdmin = AppMenuPolicy.IsFullAdmin(User);
    var isAdministradorOphir = AppMenuPolicy.IsAdministradorOphir(User) && !isFullAdmin;
    var isArquivistaOphir = AppMenuPolicy.IsArquivistaOphir(User) && !isFullAdmin;
    var isHospital = AppMenuPolicy.IsHospitalUser(User) && !isFullAdmin && !isAdministradorOphir && !isArquivistaOphir;
}

@if (isFullAdmin)
{
    <details class="sidebar-group" open="@(ActiveAny("GedDashboard", "Operations", "HospitalTrends") == "active" ? "open" : null)">
        <summary>Visão Geral</summary>
        <a asp-controller="GedDashboard" asp-action="Index" class="@Active("GedDashboard", "Index")"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
        <a asp-controller="Operations" asp-action="Index" class="@ActivePathStarts("/operations")"><i class="bi bi-command"></i><span>Central Operacional</span></a>
        <a asp-controller="HospitalTrends" asp-action="Index" class="@ActiveAny("HospitalTrends")"><i class="bi bi-bell"></i><span>Alertas</span></a>
    </details>
    <details class="sidebar-group" open="@(ActiveAny("Ged", "GedSearch", "GedUploads", "SmartSearch", "Ocr", "DocumentQuality", "Billing", "GedClassification", "ClassificationDashboard", "Disposition") == "active" ? "open" : null)">
        <summary>Gestão Documental</summary>
        <a asp-controller="Ged" asp-action="Index" class="@ActiveAny("Ged", "GedSearch")"><i class="bi bi-folder2-open"></i><span>GED</span></a>
        <a asp-controller="GedUploads" asp-action="Index" class="@ActiveAny("GedUploads")"><i class="bi bi-cloud-upload"></i><span>Uploads</span></a>
        <a asp-controller="SmartSearch" asp-action="Index" class="@ActiveAny("SmartSearch")"><i class="bi bi-search"></i><span>Busca Inteligente</span></a>
        <a asp-controller="Ocr" asp-action="Index" class="@ActiveAny("Ocr")"><i class="bi bi-filetype-pdf"></i><span>OCR</span></a>
        <a asp-controller="Billing" asp-action="Index" class="@ActiveAny("Billing")"><i class="bi bi-receipt"></i><span>Faturamento</span></a>
        <a asp-controller="DocumentQuality" asp-action="Index" class="@ActiveAny("DocumentQuality")"><i class="bi bi-shield-check"></i><span>Qualidade Documental</span></a>
        <a asp-controller="GedClassification" asp-action="Queue" class="@ActiveAny("GedClassification", "ClassificationDashboard")"><i class="bi bi-tags"></i><span>Classificação</span></a>
        <a asp-controller="Disposition" asp-action="Index" class="@ActiveAny("Disposition")"><i class="bi bi-calendar-check"></i><span>Temporalidade</span></a>
    </details>
    <details class="sidebar-group" open="@(ActiveAny("SmartGed", "SmartAssistant") == "active" ? "open" : null)">
        <summary>Inteligência</summary>
        <a asp-controller="SmartGed" asp-action="Index" class="@ActiveAny("SmartGed")"><i class="bi bi-stars"></i><span>GED Inteligente</span></a>
        <a asp-controller="SmartAssistant" asp-action="Index" class="@ActiveAny("SmartAssistant")"><i class="bi bi-chat-dots"></i><span>Assistente Documental</span></a>
        <a asp-controller="SmartGed" asp-action="ReviewQueue" class="@Active("SmartGed", "ReviewQueue")"><i class="bi bi-inboxes"></i><span>Fila de revisão</span></a>
        <a asp-controller="SmartGed" asp-action="Search" class="@Active("SmartGed", "Search")"><i class="bi bi-search"></i><span>Busca inteligente</span></a>
    </details>
    <details class="sidebar-group" open="@(ActiveAny("Batches", "Physical", "Labels") == "active" ? "open" : null)">
        <summary>Arquivo Físico</summary>
        <a asp-controller="Batches" asp-action="Index" class="@ActiveAny("Batches")"><i class="bi bi-collection"></i><span>Lotes</span></a>
        <a asp-controller="Physical" asp-action="Boxes" class="@Active("Physical", "Boxes")"><i class="bi bi-inbox"></i><span>Caixas</span></a>
        <a asp-controller="Physical" asp-action="Locations" class="@Active("Physical", "Locations")"><i class="bi bi-geo-alt"></i><span>Localizações</span></a>
        <a asp-controller="Labels" asp-action="Boxes" class="@ActiveAny("Labels")"><i class="bi bi-upc-scan"></i><span>Etiquetas</span></a>
        <a asp-controller="Physical" asp-action="PhysicalMap" class="@Active("Physical", "PhysicalMap")"><i class="bi bi-boxes"></i><span>Inventário</span></a>
    </details>
    <details class="sidebar-group" open="@(ActiveAny("Loans", "Solicitacoes", "Protocolo", "Protocols", "ProtocolRequests") == "active" ? "open" : null)">
        <summary>Atendimento</summary>
        <a asp-controller="Loans" asp-action="Index" class="@ActiveAny("Loans", "Solicitacoes")"><i class="bi bi-arrow-left-right"></i><span>Empréstimos</span></a>
        <a asp-controller="Protocolo" asp-action="Index" class="@ActiveAny("Protocolo", "Protocols")"><i class="bi bi-journal-check"></i><span>Protocolos</span></a>
        <a asp-controller="ProtocolRequests" asp-action="My" class="@ActiveAny("ProtocolRequests")"><i class="bi bi-send"></i><span>Solicitações</span></a>
    </details>
    <details class="sidebar-group" open="@(ActiveAny("Signature", "SystemLogs", "Audit", "AuditDashboard", "Reports", "Continuity") == "active" ? "open" : null)">
        <summary>Governança</summary>
        <a asp-controller="Signature" asp-action="Index" class="@ActiveAny("Signature")"><i class="bi bi-pen"></i><span>Assinaturas</span></a>
        <a asp-controller="SystemLogs" asp-action="Index" class="@ActiveAny("SystemLogs", "Audit", "AuditDashboard")"><i class="bi bi-clock-history"></i><span>Auditoria</span></a>
        <a asp-controller="Reports" asp-action="Index" class="@ActiveAny("Reports")"><i class="bi bi-bar-chart"></i><span>Relatórios</span></a>
        <a asp-controller="Continuity" asp-action="Overview" class="@ActiveAny("Continuity")"><i class="bi bi-life-preserver"></i><span>Continuidade</span></a>
    </details>
    <details class="sidebar-group" open="@(ActiveAny("Administration", "Users", "Security", "Parameters", "SystemHealth") == "active" ? "open" : null)">
        <summary>Administração</summary>
        <a asp-controller="Users" asp-action="Index" class="@ActiveAny("Users")"><i class="bi bi-people"></i><span>Usuários</span></a>
        <a asp-controller="Security" asp-action="Roles" class="@ActiveAny("Security")"><i class="bi bi-person-lock"></i><span>Perfis e Permissões</span></a>
        <a asp-controller="Parameters" asp-action="Index" class="@ActiveAny("Parameters")"><i class="bi bi-sliders"></i><span>Parâmetros</span></a>
        <a asp-controller="SystemHealth" asp-action="Index" class="@ActiveAny("SystemHealth")"><i class="bi bi-heart-pulse"></i><span>Saúde do Sistema</span></a>
        <a asp-controller="Administration" asp-action="Readiness" class="@Active("Administration", "Readiness")"><i class="bi bi-clipboard2-check"></i><span>Prontidão do Ambiente</span></a>
        <a href="/UatReadiness" class="@Active("UatReadiness", "Index")"><i class="bi bi-clipboard2-check"></i><span>Homologação e Go-Live</span></a>
    </details>
}
else if (isAdministradorOphir)
{
    <div class="sidebar-section-title">Setor</div>
    <a asp-controller="HospitalDocuments" asp-action="Index" class="@ActiveAny("HospitalDocuments")"><i class="bi bi-search-heart"></i><span>Documentos Hospitalares</span></a>
    <a asp-controller="Loans" asp-action="Index" class="@ActiveAny("Loans")"><i class="bi bi-arrow-left-right"></i><span>Pedidos do Setor</span></a>
    <a href="/Protocols/WorkQueue" class="@ActivePathStarts("/protocols/workqueue")"><i class="bi bi-inboxes"></i><span>Fila de Protocolos</span></a>
    <a href="/Users/Sector" class="@ActivePathStarts("/users/sector")"><i class="bi bi-people"></i><span>Usuários do meu setor</span></a>
}
else if (isArquivistaOphir)
{
    <div class="sidebar-section-title">Solicitações</div>
    <a asp-controller="HospitalDocuments" asp-action="Index" class="@ActiveAny("HospitalDocuments")"><i class="bi bi-search-heart"></i><span>Documentos Hospitalares</span></a>
    <a asp-controller="Loans" asp-action="New" class="@Active("Loans", "New")"><i class="bi bi-file-earmark-plus"></i><span>Novo Pedido de Documento</span></a>
    <a asp-controller="Loans" asp-action="Index" class="@Active("Loans", "Index")"><i class="bi bi-collection"></i><span>Meus Pedidos</span></a>
    <a asp-controller="ProtocolRequests" asp-action="My" class="@Active("ProtocolRequests", "My")"><i class="bi bi-list-check"></i><span>Meus Protocolos</span></a>
}
else if (isHospital)
{
    <div class="sidebar-section-title">Consulta</div>
    <a asp-controller="HospitalDocuments" asp-action="Index" class="@ActiveAny("HospitalDocuments")"><i class="bi bi-search-heart"></i><span>Documentos Hospitalares</span></a>
}
else
{
    <div class="sidebar-section-title">Consulta</div>
    <a asp-controller="HospitalDocuments" asp-action="Index" class="@ActiveAny("HospitalDocuments")"><i class="bi bi-search-heart"></i><span>Buscar Prontuários e Documentos</span></a>
    <a asp-controller="SmartSearch" asp-action="Index" class="@ActiveAny("SmartSearch")"><i class="bi bi-stars"></i><span>Busca Inteligente</span></a>
}
