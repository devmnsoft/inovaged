<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
    <handlers>
      <remove name="aspNetCore" />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <security>
      <requestFiltering>
        <!-- Limite de uma requisição, suficiente para uma parte de 10 MB com envelope multipart. O arquivo de 10 GiB segue em partes; esta chave não aceita o arquivo inteiro. -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
    <aspNetCore processPath="dotnet"
                arguments=".\InovaGed.Web.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                requestTimeout="00:30:00"
                hostingModel="outofprocess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        <environmentVariable name="TEMP" value="F:\InovaGed\temp" />
        <environmentVariable name="TMP" value="F:\InovaGed\temp" />
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
</configuration>
