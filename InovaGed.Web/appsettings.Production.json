{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "SystemSeed": {
    "Enabled": false,
    "AllowPoC": false,
    "FailFastOnSeedError": false,
    "UpdateExistingPasswords": false,
    "NormalizeLegacyRoles": true
  },
  "Auth": {
    "AllowInternalSelfSignedCertificates": false
  },
  "SchemaRepair": {
    "Enabled": false,
    "AllowApplyInProduction": false,
    "RequireConfirmationText": true,
    "ConfirmationText": "APLICAR CORRECAO",
    "CreateBackupRecommendation": true
  },
  "DetailedErrors": false,
  "AllowedHosts": "gedophir.sistemasld.com.br;localhost",
  "App": {
    "LocalTimeZoneId": "America/Belem"
  },
  "DigitalSignature": {
    "Enabled": false,
    "Mode": "AgentCms",
    "SessionTtlSeconds": 300,
    "ContentTokenTtlSeconds": 120,
    "CompletionTokenTtlSeconds": 300,
    "MaxDocumentSizeMb": 100,
    "HashAlgorithm": "SHA256",
    "RequireCertificateIdentityMatch": true,
    "AllowServerSidePfxUpload": false,
    "AllowInternalTestCertificates": false,
    "Agent": {
      "BaseUrl": "https://127.0.0.1:17891",
      "RequireHttps": true,
      "AllowedOrigins": [],
      "AllowedServerHosts": [],
      "PairingTtlSeconds": 300,
      "OperationTtlSeconds": 600
    },
    "RequireLoopbackHttps": true,
    "AgentBaseUrl": "https://127.0.0.1:17891",
    "AllowedAgentOrigins": []
  },
  "Observability": {
    "Enabled": true,
    "ServiceName": "InovaGed.Web",
    "ServiceNamespace": "InovaGed",
    "Environment": "Production",
    "Otlp": {
      "Enabled": false,
      "Endpoint": "",
      "Protocol": "Grpc",
      "Headers": ""
    },
    "Tracing": {
      "Enabled": true,
      "SamplingRatio": 0.1,
      "RecordExceptions": true
    },
    "Metrics": {
      "Enabled": true,
      "PrometheusEndpointEnabled": false
    },
    "Logging": {
      "Structured": true,
      "IncludeScopes": true,
      "MinimumLevel": "Information"
    }
  }
}
